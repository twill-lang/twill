mode systems

# io_test.tw: tests for std/io.tw.
#
# WHY THERE IS NO FILE ROUND TRIP HERE
#
# The obvious test for `write_text` and `read_text` is to write a temporary
# file, read it back, and compare. It is not here, and the reason is a missing
# primitive rather than an oversight: the runtime surface has no `remove` and no
# temporary-directory function (docs/needs.md NEEDS-92), so such a test would
# leave a file in the tree on every run and a second run would be testing
# against the debris of the first. A test that cannot clean up after itself is
# worse than no test, because the failure it eventually causes looks like a bug
# in whatever tripped over the leftover file.
#
# So this file tests the path handling, which is pure string work and is where
# the bugs actually are. The file operations are three lines each over
# primitives that the runtime is responsible for; the path logic is fifty lines
# of off-by-one opportunities.

import "std/io" as io
import "std/text" as tx
import "std/test" as t

fn main() -> I64 {
  # ---- joining -------------------------------------------------------------

  t.equal_str("joining two components inserts one separator",
    io.join2("a", "b"), "a/b")

  # A trailing separator on the first component must not double. This is the
  # case that arrives from configuration, where whether a directory setting ends
  # in a slash is a coin flip.
  t.equal_str("joining does not double a separator that is already there",
    io.join2("a/", "b"), "a/b")

  # An empty component contributes nothing rather than an empty segment.
  t.equal_str("an empty first component is skipped", io.join2("", "b"), "b")
  t.equal_str("an empty second component leaves the first alone",
    io.join2("a", ""), "a")

  # An absolute second component keeps its leading separator, since the join
  # does not add one before a component that already starts with a separator.
  t.equal_str("joining onto a component that begins with a separator adds nothing",
    io.join2("a", "/b"), "a/b")

  let three: Arr[Str] = arr_new()
  push(three, "usr")
  push(three, "local")
  push(three, "bin")
  t.equal_str("joining three components gives two separators",
    io.join(three), "usr/local/bin")

  # ---- dir_name and base_name ----------------------------------------------

  t.equal_str("the directory of a two part path is the first part",
    io.dir_name("a/b"), "a")
  t.equal_str("the base name of a two part path is the last part",
    io.base_name("a/b"), "b")

  # A bare name has no directory. The empty string means "here" and is what
  # joins correctly with anything.
  t.equal_str("a bare name has no directory", io.dir_name("file.tw"), "")
  t.equal_str("a bare name is its own base name", io.base_name("file.tw"), "file.tw")

  # The root is the one directory whose separator cannot be stripped: "" would
  # name the current directory instead.
  t.equal_str("the directory of a path at the root is the root",
    io.dir_name("/a"), "/")

  # A trailing separator names the same directory, so the base name is the
  # directory's own name rather than nothing.
  t.equal_str("a trailing separator does not empty the base name",
    io.base_name("a/b/"), "b")
  t.equal_str("a path of only separators has no base name", io.base_name("//"), "")

  # Backslashes are accepted as separators on input, because a path from a
  # Windows environment contains them and refusing would fail to find the base
  # name of a real path.
  t.equal_str("a backslash is recognised as a separator when splitting",
    io.base_name("dir\\file.tw"), "file.tw")

  # ---- extensions ----------------------------------------------------------

  t.equal_str("the extension includes its dot", io.ext("file.tw"), ".tw")

  # The last dot wins, so a doubled extension gives only the final part.
  t.equal_str("a doubled extension gives only the last part",
    io.ext("archive.tar.gz"), ".gz")

  # A leading dot marks a hidden file and is not an extension.
  t.equal_str("a leading dot is not an extension", io.ext(".gitignore"), "")
  t.equal_str("a name with no dot has no extension", io.ext("README"), "")

  # The dot must be found in the base name, not anywhere in the path. A
  # directory containing a dot would otherwise swallow the whole tail.
  t.equal_str("a dot in a directory name is not an extension",
    io.ext("v1.2/readme"), "")

  t.equal_str("the stem is the base name without its extension",
    io.stem("dir/file.tw"), "file")
  t.equal_str("the stem of a doubled extension keeps the inner one",
    io.stem("archive.tar.gz"), "archive.tar")

  t.equal_str("replacing an extension keeps the directory",
    io.with_ext("dir/file.md", ".tw"), "dir/file.tw")
  t.equal_str("replacing an extension adds the dot when it was left out",
    io.with_ext("file.md", "txt"), "file.txt")
  t.equal_str("replacing the extension of a file that has none appends it",
    io.with_ext("README", ".md"), "README.md")

  # ---- splitting -----------------------------------------------------------

  let parts: Arr[Str] = io.split("/usr/local/bin")
  t.equal_i64("splitting drops the empty component before a leading separator",
    len(parts), 3)
  t.equal_str("the first component of an absolute path is the first name",
    parts[0], "usr")

  # Repeated separators collapse, since an empty component names nothing.
  t.equal_i64("repeated separators do not produce empty components",
    len(io.split("a//b")), 2)
  t.equal_i64("an empty path has no components", len(io.split("")), 0)

  # Mixed separators split the same way, which is what makes a Windows path
  # usable here.
  t.equal_i64("a path mixing both separators splits on both",
    len(io.split("a/b\\c")), 3)

  # ---- absoluteness --------------------------------------------------------

  t.check("a leading separator makes a path absolute", io.is_abs("/a/b"))
  t.check("a bare name is not absolute", not io.is_abs("a/b"))
  t.check("the empty path is not absolute", not io.is_abs(""))

  # A drive letter is recognised on every platform, because a path that looks
  # like this came from Windows and joining it onto a working directory would
  # produce nonsense.
  t.check("a drive letter with a forward slash is absolute", io.is_abs("C:/x"))
  t.check("a drive letter with a backslash is absolute", io.is_abs("C:\\x"))

  # A colon in the second position without a separator after it is not a drive
  # reference, so it stays relative.
  t.check("a colon without a following separator is not a drive letter",
    not io.is_abs("C:x"))

  # ---- normalising ---------------------------------------------------------

  t.equal_str("a single dot component is removed",
    io.normalize("a/./b"), "a/b")
  t.equal_str("a double dot cancels the component before it",
    io.normalize("a/b/../c"), "a/c")
  t.equal_str("several double dots cancel several components",
    io.normalize("a/b/c/../../d"), "a/d")
  t.equal_str("normalising an absolute path keeps it absolute",
    io.normalize("/a/b/../c"), "/a/c")
  t.equal_str("repeated separators collapse when normalising",
    io.normalize("a//b"), "a/b")

  # A path that cancels to nothing is the current directory, spelled ".", not
  # the empty string: the empty string is not a usable path and "." is.
  t.equal_str("a path that cancels entirely becomes the current directory",
    io.normalize("a/.."), ".")

  # A leading double dot on a relative path is kept. Dropping it would turn a
  # path that escapes its starting directory into one that does not, which is a
  # security-relevant difference and not a cosmetic one.
  t.equal_str("a leading double dot on a relative path is preserved",
    io.normalize("../a"), "../a")
  t.equal_str("consecutive leading double dots are all preserved",
    io.normalize("../../a"), "../../a")

  # An absolute path cannot escape above the root, so a double dot there is
  # dropped rather than kept.
  t.equal_str("a double dot at the root is dropped rather than escaping it",
    io.normalize("/../a"), "/a")

  # Normalising twice changes nothing, which is the property that makes it safe
  # to call defensively.
  t.equal_str("normalising an already normalised path is a no-op",
    io.normalize(io.normalize("a/b/../c/./d")), io.normalize("a/b/../c/./d"))

  # ---- the pieces fit together ---------------------------------------------

  # dir_name and base_name rejoin to the original, which is the invariant that
  # holds the two functions together and is where an off-by-one on the
  # separator index would show.
  let path: Str = "std/tests/io_test.tw"
  t.equal_str("the directory and base name rejoin to the original path",
    io.join2(io.dir_name(path), io.base_name(path)), path)

  # The stem and the extension rebuild the base name.
  t.equal_str("the stem and the extension rebuild the base name",
    tx.concat(io.stem(path), io.ext(path)), io.base_name(path))

  t.report("io")
}
