mode systems

# random_test.tw: tests for std/random.tw.
#
# WHAT IS AND IS NOT PINNED HERE
#
# These tests used to assert the exact stream: draws produced by an independent
# splitmix64/xoshiro256** implementation in Python, which was the only honest
# way to test a generator whose algorithm this library specified.
#
# The library no longer specifies the algorithm. std/random draws from the host
# now, because xoshiro256** needs 64-bit wrapping arithmetic and an I64 here
# holds 53 bits, so the twill implementation saturated and returned a constant
# (NEEDS-2, and see random.tw's header). Pinning the host's stream would assert
# an implementation detail of whatever Go ships, and would break on a Go release
# for no reason a reader could act on.
#
# So what is checked here is everything about the stream that a caller can
# actually depend on: that a seed reproduces, that different seeds are
# independent, that each distribution has the right support and moments, that
# `below` is unbiased over its whole range, and that `normal` returns the cached
# partner of a Box-Muller pair rather than discarding it. What is no longer
# checked is which particular numbers come out.

import "std/random" as rnd
import "std/test" as t

fn main() -> I64 {
  # ---- the reproducibility contract ----------------------------------------

  # A seed reproduces, run to run and generator to generator. This is the
  # promise the file makes; the particular values are the host's business.
  let a1: rnd.Rng = rnd.new_rng(42)
  let a2: rnd.Rng = rnd.new_rng(42)
  t.near("the same seed gives the same first draw", rnd.uniform(a1) - rnd.uniform(a2), 0.0, 0.0)
  t.near("and the same second draw", rnd.uniform(a1) - rnd.uniform(a2), 0.0, 0.0)
  t.near("and the same third draw", rnd.uniform(a1) - rnd.uniform(a2), 0.0, 0.0)

  # Adjacent seeds are independent from the first draw, which is the property
  # splitmix64 seeding used to provide and the host provides now.
  let b1: rnd.Rng = rnd.new_rng(1)
  let b2: rnd.Rng = rnd.new_rng(2)
  t.check("adjacent seeds differ on the first draw", rnd.uniform(b1) != rnd.uniform(b2))

  # A draw is in [0, 1), at both ends, over enough draws to catch a scale error.
  let u: rnd.Rng = rnd.new_rng(5)
  let lo: F64 = 1.0
  let hi: F64 = 0.0
  let i: I64 = 0
  while i < 5000 {
    let x: F64 = rnd.uniform(u)
    if x < lo { lo = x }
    if x > hi { hi = x }
    i = i + 1
  }
  t.check("no uniform draw is below zero", lo >= 0.0)
  t.check("no uniform draw reaches one", hi < 1.0)
  t.check("the draws cover the low end", lo < 0.01)
  t.check("the draws cover the high end", hi > 0.99)

  # `normal` draws a Box-Muller pair and caches the second. A dropped cache
  # would still give a correct normal distribution, so this cannot be checked
  # distributionally: it is checked by observing that the spare is held between
  # calls and handed back before any new pair is drawn.
  let n: rnd.Rng = rnd.new_rng(2024)
  let first: F64 = rnd.normal(n)
  t.check("a pair is cached after the first normal draw", n.has_spare)
  let partner: F64 = n.spare
  t.near("the second normal draw is the cached partner of the first",
    rnd.normal(n), partner, 0.0)
  t.check("and the cache is empty again", not n.has_spare)
  t.check("the two draws are different values", first != partner)

  # Six is not a power of two, so `below(_, 6)` is the rejection path: the mask
  # is 7 and values of 6 and 7 are redrawn. Every residue has to appear and none
  # may fall outside, which is what a modulo would get wrong -- a `bits % 6`
  # stays in range and is simply biased, so the range check alone would pass.
  let b: rnd.Rng = rnd.new_rng(7)
  let counts: Arr[I64] = [0, 0, 0, 0, 0, 0]
  let outside: I64 = 0
  let j: I64 = 0
  while j < 6000 {
    let v: I64 = rnd.below(b, 6)
    if v < 0 or v > 5 { outside = outside + 1 } else { counts[v] = counts[v] + 1 }
    j = j + 1
  }
  t.check("no bounded draw falls outside its range", outside == 0)
  let k: I64 = 0
  let thin: I64 = 0
  while k < 6 {
    # A thousand expected each; a biased low residue would run well past 1200.
    if counts[k] < 850 or counts[k] > 1150 { thin = thin + 1 }
    k = k + 1
  }
  t.check("every residue below six appears about equally often", thin == 0)

  # A permutation is a permutation: every index once, none missing, none twice.
  # That is the part a caller depends on, and the part a broken shuffle breaks --
  # the classic upward Fisher-Yates variant is biased but still returns a valid
  # permutation, so the bias is checked separately below.
  let p: rnd.Rng = rnd.new_rng(7)
  let perm: Arr[I64] = rnd.permutation(p, 5)
  t.equal_i64("a permutation of five has five entries", len(perm), 5)
  let present: Arr[I64] = [0, 0, 0, 0, 0]
  let q: I64 = 0
  let bad: I64 = 0
  while q < len(perm) {
    let v: I64 = perm[q]
    if v < 0 or v > 4 { bad = bad + 1 } else { present[v] = present[v] + 1 }
    q = q + 1
  }
  t.check("every entry is in range", bad == 0)
  let missing: I64 = 0
  let w: I64 = 0
  while w < 5 {
    if present[w] != 1 { missing = missing + 1 }
    w = w + 1
  }
  t.check("every index appears exactly once", missing == 0)

  # And the shuffle is unbiased: over many permutations of three, each of the
  # six orderings has to come up about a sixth of the time. The upward variant
  # of Fisher-Yates fails this while still passing every check above -- it
  # produces n^n equally likely paths over n! outcomes, so some orderings come
  # up more often than others.
  let sh: rnd.Rng = rnd.new_rng(99)
  let orders: Dict[Str, I64] = {}
  let trial: I64 = 0
  while trial < 6000 {
    let t3: Arr[I64] = rnd.permutation(sh, 3)
    let key: Str = str(t3[0]) + str(t3[1]) + str(t3[2])
    if dict_has(orders, key) { orders[key] = orders[key] + 1 } else { orders[key] = 1 }
    trial = trial + 1
  }
  t.equal_i64("all six orderings of three appear", len(dict_keys(orders)), 6)
  let ks: Arr[Str] = dict_keys(orders)
  let skewed: I64 = 0
  let z: I64 = 0
  while z < len(ks) {
    # A thousand expected each; the biased variant lands some near 1500.
    let c: I64 = orders[ks[z]]
    if c < 850 or c > 1150 { skewed = skewed + 1 }
    z = z + 1
  }
  t.check("and each about equally often", skewed == 0)

  # ---- the seeding contract ------------------------------------------------

  # The property the whole module exists for. Two generators seeded alike must
  # agree on every draw, and this checks a run of them rather than one, because
  # a state that diverges after the first transition would pass a single-draw
  # test.
  let a1: rnd.Rng = rnd.new_rng(123)
  let a2: rnd.Rng = rnd.new_rng(123)
  let agree: Bool = true
  let i: I64 = 0
  while i < 50 {
    if rnd.uniform(a1) != rnd.uniform(a2) { agree = false }
    i = i + 1
  }
  t.check("two generators with the same seed produce the same fifty draws", agree)

  # Adjacent seeds must not produce near-identical streams. This is the specific
  # failure splitmix64 seeding exists to prevent: a generator seeded directly
  # with 1 and 2 would start from two states differing in one bit and take
  # hundreds of draws to diverge.
  let s1: rnd.Rng = rnd.new_rng(1)
  let s2: rnd.Rng = rnd.new_rng(2)
  t.check("adjacent seeds diverge on the very first draw",
    rnd.uniform(s1) != rnd.uniform(s2))

  # Zero is a valid seed and must not produce a degenerate stream. xoshiro's
  # all-zero state is a fixed point that returns zero forever, and splitmix64
  # seeding is what keeps a seed of 0 away from it.
  let z: rnd.Rng = rnd.new_rng(0)
  let nonzero: Bool = false
  i = 0
  while i < 10 {
    if rnd.uniform(z) != 0.0 { nonzero = true }
    i = i + 1
  }
  t.check("a seed of zero does not give a stuck generator", nonzero)

  # A split draws from the parent, so the child's stream differs from what the
  # parent goes on to produce.
  let parent: rnd.Rng = rnd.new_rng(99)
  let child: rnd.Rng = rnd.split_rng(parent)
  t.check("a split generator does not repeat its parent's next draw",
    rnd.uniform(child) != rnd.uniform(parent))

  # ---- ranges --------------------------------------------------------------

  # Every uniform draw lies in [0, 1). Ten thousand draws is not a proof and it
  # is enough to catch a division by the wrong power of two, which is the
  # realistic bug.
  let u: rnd.Rng = rnd.new_rng(1)
  let in_range: Bool = true
  let total: F64 = 0.0
  i = 0
  while i < 10000 {
    let v: F64 = rnd.uniform(u)
    if v < 0.0 or v >= 1.0 { in_range = false }
    total = total + v
    i = i + 1
  }
  t.check("every uniform draw lies in the half open unit interval", in_range)

  # The reference implementation gives a mean of 0.4977390816489078 over these
  # exact ten thousand draws from seed 1. Asserted loosely against the true
  # expectation of 0.5, because the point of this test is the scale of the
  # output and not the stream, which the exact tests above already pin.
  t.near("ten thousand uniform draws average close to a half",
    total / 10000.0, 0.5, 0.01)

  # `uniform_open` must never return zero, since `normal` takes its logarithm.
  let o: rnd.Rng = rnd.new_rng(5)
  let never_zero: Bool = true
  i = 0
  while i < 1000 {
    let v: F64 = rnd.uniform_open(o)
    if v <= 0.0 or v > 1.0 { never_zero = false }
    i = i + 1
  }
  t.check("the open uniform draw is never zero and never above one", never_zero)

  # Bounded integers stay inside their bound, including for a bound of one,
  # where the mask is zero and the loop must still terminate.
  let bb: rnd.Rng = rnd.new_rng(11)
  let bounded: Bool = true
  i = 0
  while i < 1000 {
    let v: I64 = rnd.below(bb, 7)
    if v < 0 or v >= 7 { bounded = false }
    i = i + 1
  }
  t.check("bounded integer draws stay below their bound", bounded)
  t.equal_i64("a bound of one always gives zero", rnd.below(bb, 1), 0)

  # int_range shifts the bound without changing its width.
  let ir: rnd.Rng = rnd.new_rng(13)
  let shifted: Bool = true
  i = 0
  while i < 1000 {
    let v: I64 = rnd.int_range(ir, -5, 5)
    if v < -5 or v >= 5 { shifted = false }
    i = i + 1
  }
  t.check("an integer range draw stays within its half open bounds", shifted)

  # ---- normal draws --------------------------------------------------------

  # Ten thousand standard normal draws have a sample mean within about
  # 4/sqrt(10000) = 0.04 of zero at any reasonable confidence, and a sample
  # variance near one. The reference implementation gives a mean of
  # 0.006030956914761867 over these exact draws, well inside the bound.
  let nr: rnd.Rng = rnd.new_rng(1)
  let nsum: F64 = 0.0
  let nsq: F64 = 0.0
  i = 0
  while i < 10000 {
    let v: F64 = rnd.normal(nr)
    nsum = nsum + v
    nsq = nsq + v * v
    i = i + 1
  }
  t.near("ten thousand normal draws have a sample mean near zero",
    nsum / 10000.0, 0.0, 0.05)
  t.near("ten thousand normal draws have a sample variance near one",
    nsq / 10000.0, 1.0, 0.05)

  # Mean and standard deviation are applied in the right places: a shift of 100
  # with a spread of 0.001 cannot be confused with the reverse.
  let nw: rnd.Rng = rnd.new_rng(3)
  let far: F64 = rnd.normal_with(nw, 100.0, 0.001)
  t.check("a normal draw with a large mean and a small spread lands near its mean",
    far > 99.99 and far < 100.01)

  # ---- collections ---------------------------------------------------------

  # A permutation is a bijection: every index appears exactly once. This is the
  # property a subtly wrong Fisher-Yates breaks by duplicating one element and
  # dropping another, which no spot check of individual values would catch.
  let pr: rnd.Rng = rnd.new_rng(17)
  let big: Arr[I64] = rnd.permutation(pr, 100)
  let seen: Arr[I64] = arr_new()
  i = 0
  while i < 100 {
    push(seen, 0)
    i = i + 1
  }
  i = 0
  while i < 100 {
    seen[big[i]] = seen[big[i]] + 1
    i = i + 1
  }
  let bijection: Bool = true
  i = 0
  while i < 100 {
    if seen[i] != 1 { bijection = false }
    i = i + 1
  }
  t.check("a permutation of a hundred contains every index exactly once", bijection)
  t.equal_i64("a permutation has the length it was asked for", len(big), 100)

  # A shuffle is a permutation of the values, so the sum is unchanged. Floating
  # point addition is not associative, so the sum is only unchanged to rounding,
  # and the tolerance says so.
  let sh: rnd.Rng = rnd.new_rng(23)
  let vals: Arr[F64] = arr_new()
  i = 0
  while i < 50 {
    push(vals, f64_of_i64(i) * 1.5)
    i = i + 1
  }
  let before: F64 = 0.0
  i = 0
  while i < len(vals) {
    before = before + vals[i]
    i = i + 1
  }
  let after_arr: Arr[F64] = rnd.shuffled(sh, vals)
  let after: F64 = 0.0
  i = 0
  while i < len(after_arr) {
    after = after + after_arr[i]
    i = i + 1
  }
  t.near("shuffling preserves the sum of the values", after, before, 0.0000000001)
  t.equal_i64("shuffling preserves the length", len(after_arr), len(vals))

  # `shuffled` copies; the original must be untouched. An `Arr` parameter
  # aliases the caller's array, so this is a real risk rather than a formality.
  t.check("the copying shuffle leaves the original array in order",
    vals[0] == 0.0 and vals[49] == 73.5)

  # A sample without replacement returns distinct elements. Drawn from 0..19,
  # so a repeat is detectable by counting.
  let sr: rnd.Rng = rnd.new_rng(31)
  let pool: Arr[F64] = arr_new()
  i = 0
  while i < 20 {
    push(pool, f64_of_i64(i))
    i = i + 1
  }
  let picked: Arr[F64] = rnd.sample(sr, pool, 20)
  let counts: Arr[I64] = arr_new()
  i = 0
  while i < 20 {
    push(counts, 0)
    i = i + 1
  }
  i = 0
  while i < len(picked) {
    let idx: I64 = i64_of_f64(picked[i])
    counts[idx] = counts[idx] + 1
    i = i + 1
  }
  let distinct: Bool = true
  i = 0
  while i < 20 {
    if counts[i] != 1 { distinct = false }
    i = i + 1
  }
  t.check("a full sample without replacement is a permutation of the pool", distinct)

  # `choices` draws with replacement, so over a pool of two and forty draws a
  # repeat is a certainty. Asserting the complement of `sample`'s property is
  # what makes the two functions distinguishable by test rather than only by
  # name.
  let cr: rnd.Rng = rnd.new_rng(37)
  let two: Arr[F64] = arr_new()
  push(two, 1.0)
  push(two, 2.0)
  let drawn: Arr[F64] = rnd.choices(cr, two, 40)
  t.equal_i64("drawing with replacement gives as many values as asked", len(drawn), 40)

  t.report("random")
}
