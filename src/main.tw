mode systems

# main.tw: the twill CLI, in twill.
#
# A port of cmd/twill/main.go and cmd/twill/dump.go. The commands are `run`,
# `check`, `fmt`, `repl` and the bare-file form, plus `--dump=canonical` on the
# two run paths.
#
# Everything user-visible here is a contract rather than a convenience, because
# the differential harness runs the two binaries side by side and compares
# stdout and stderr byte for byte. That includes the usage lines, the exit
# codes, the quoting in the error messages and the two-space gutter in the
# source excerpt. Where this file looks pedantic, that is why: a friendlier
# message is a divergence.
#
# The three exit codes are Go's. 0 is success, 2 is "you invoked it wrong" and 1
# is everything else, including a program that failed to check. A separate code
# for diagnostics would be more useful to CI and is not what the reference
# binary does, so it is not what this does.
#
# src/cli/ and src/term/ belong to another agent and this file does not reach
# into them. When they land, the REPL and the diagnostic rendering are what
# should move there.

import "lex.tw" as lex
import "parse.tw" as parse
import "check.tw" as check
import "fmt.tw" as fmt
import "eval.tw" as eval
import "bytes.tw" as bytes

let VERSION: Str = "1.9.0"

let EXIT_OK: I64 = 0
let EXIT_ERROR: I64 = 1
# 2 is reserved for a bad invocation, so a script can tell "you typed the
# command wrong" from "the program you pointed at has a problem".
let EXIT_USAGE: I64 = 2

# Spelled as one token so that adding it cannot change how any existing
# argument is parsed.
let DUMP_CANONICAL: Str = "--dump=canonical"

fn main() -> I64 {
  # Go works from os.Args[1:]. Dropping the program name here rather than
  # offsetting every index below is what keeps this file readable next to it.
  let a: Arr[Str] = drop_first(args())
  if len(a) == 0 {
    return repl()
  }
  let cmd: Str = a[0]

  if bytes.equal(cmd, "-v") or bytes.equal(cmd, "--version") or bytes.equal(cmd, "version") {
    write_out(bytes.concat("Twill ", bytes.concat(VERSION, "\n")))
    return EXIT_OK
  }
  if bytes.equal(cmd, "-h") or bytes.equal(cmd, "--help") or bytes.equal(cmd, "help") {
    write_out(usage())
    return EXIT_OK
  }
  if bytes.equal(cmd, "check") {
    if len(a) < 2 {
      write_err("usage: twill check <file>\n")
      return EXIT_USAGE
    }
    return check_only(a[1])
  }
  if bytes.equal(cmd, "fmt") {
    if len(a) < 2 {
      write_err("usage: twill fmt <file> [--write]\n")
      return EXIT_USAGE
    }
    return format_file(a[1], has_flag(a, "--write") or has_flag(a, "-w"))
  }
  if bytes.equal(cmd, "run") {
    if len(a) < 2 {
      write_err("usage: twill run <file>\n")
      return EXIT_USAGE
    }
    if has_flag(a, DUMP_CANONICAL) {
      return run_file_canonical(a[1], not has_flag(a, "--no-check"))
    }
    return run_file(a[1], not has_flag(a, "--no-check"))
  }
  if bytes.equal(cmd, "repl") {
    return repl()
  }

  # A leading `-` here is a flag nobody recognised. Treating it as a filename
  # instead would report "cannot read file" for a typo in an option, which sends
  # the reader looking for a missing file that was never meant to exist.
  if bytes.has_prefix(cmd, "-") {
    write_err(bytes.concat("twill: unknown flag ", bytes.concat(lex.quote_value(cmd), "\n")))
    return EXIT_USAGE
  }
  if has_flag(a, DUMP_CANONICAL) {
    return run_file_canonical(cmd, not has_flag(a, "--no-check"))
  }
  run_file(cmd, not has_flag(a, "--no-check"))
}

# ---- commands --------------------------------------------------------------

fn run_file(path: Str, do_check: Bool) -> I64 {
  match check_legacy_ext(path) {
    Some(msg) => {
      write_err(bytes.concat("twill: ", bytes.concat(msg, "\n")))
      return EXIT_ERROR
    },
    None => unit,
  }
  let src: Str = ""
  match read_file(path) {
    Ok(b) => src = b,
    Err(_) => {
      write_err(cannot_read(path))
      return EXIT_ERROR
    },
  }

  # `run` type-checks first and refuses to run on a diagnostic. A shape error
  # found statically is the same error the program would hit ten seconds into a
  # training loop, and reporting it before the loop starts is the entire point
  # of having a checker. `--no-check` is the escape hatch, and the message names
  # it so nobody has to find it in the help.
  if do_check {
    let rc: I64 = precheck(path, src)
    if rc != EXIT_OK {
      return rc
    }
  }
  eval_program(path, src)
}

# Parse and evaluate a program's top level, one statement at a time, reporting a
# runtime error the way the bootstrap does. The parse cannot fail here on the
# checked path (precheck already parsed it), but the bare no-check path reaches
# this too, so the Err arm stays.
fn eval_program(path: Str, src: Str) -> I64 {
  match parse.parse(src) {
    Err(e) => {
      report_syntax(path, src, e)
      EXIT_ERROR
    },
    Ok(prog) => {
      let env: eval.Env = eval.new_env(None)
      let i: I64 = 0
      while i < len(prog.body) {
        match eval.exec_stmt(prog.body[i], env) {
          Ok(_) => unit,
          Err(er) => {
            report_runtime(path, src, er)
            return EXIT_ERROR
          },
        }
        i = i + 1
      }
      run_main(path, src, prog, env)
    },
  }
}

# A systems-mode program's entry point is main(), the way Go and Rust spell it,
# and a numeric-mode file is its top-level statements. That is the split the
# bootstrap's RunFileMain documents, and this side did not have it: `twill run`
# on a systems-mode program executed the declarations and stopped, so the
# self-hosted CLI could not run the dialect the self-hosted compiler is itself
# written in. The differential harness never caught it because every program it
# compares is numeric mode, where there is no main to call.
#
# A file with no main, or whose main takes arguments, runs its top level and
# nothing more, which is what the bootstrap does with one too.
fn run_main(path: Str, src: Str, prog: ast.Program, env: eval.Env) -> I64 {
  if prog.mode != "systems" {
    return EXIT_OK
  }
  match eval.env_get(env, "main") {
    None => EXIT_OK,
    Some(v) => match v {
      VClosure(c) => {
        if len(c.params) != 0 {
          return EXIT_OK
        }
        match eval.apply(v, arr_new(), 0) {
          Ok(_) => EXIT_OK,
          Err(er) => {
            report_runtime(path, src, er)
            EXIT_ERROR
          },
        }
      },
      _ => EXIT_OK,
    },
  }
}

# A runtime error, formatted as `path:line: runtime error: msg` with the source
# excerpt, matching cmd/twill's reportError for a RuntimeError.
fn report_runtime(path: Str, src: Str, e: eval.RuntimeError) {
  write_err(bytes.concat(path, bytes.concat(":", bytes.concat(str(e.line),
    bytes.concat(": runtime error: ", bytes.concat(e.msg, "\n"))))))
  show_context(src, e.line, 0)
}

# run_file_canonical mirrors run_file and then dumps. It is a separate function
# rather than a flag inside run_file so that the existing path keeps exactly the
# behaviour it had.
#
# --dump=canonical is the differential harness's entry point, so its output is a
# contract in the strongest sense: it prints the program's result and every
# top-level binding it defined, with floats as hexadecimal bit patterns, which
# is what makes two implementations comparable with no tolerance. Decimal
# formatting would round away exactly the one-ulp differences the dump exists to
# catch.
fn run_file_canonical(path: Str, do_check: Bool) -> I64 {
  match check_legacy_ext(path) {
    Some(msg) => {
      write_err(bytes.concat("twill: ", bytes.concat(msg, "\n")))
      return EXIT_ERROR
    },
    None => unit,
  }
  let src: Str = ""
  match read_file(path) {
    Ok(b) => src = b,
    Err(_) => {
      write_err(cannot_read(path))
      return EXIT_ERROR
    },
  }
  if do_check {
    let rc: I64 = precheck(path, src)
    if rc != EXIT_OK {
      return rc
    }
  }
  dump_canonical(path, src)
}

# Evaluate a program and print the canonical dump: the final value under
# `_result`, then every top-level binding in sorted order, each rendered by
# eval.canonical. This is the differential harness's contract and mirrors
# cmd/twill/dump.go. The evaluator's fresh scope holds exactly the program's own
# bindings -- builtins resolve through is_builtin, not the scope -- so unlike the
# Go dumper there is no set of predefined names to subtract.
fn dump_canonical(path: Str, src: Str) -> I64 {
  match parse.parse(src) {
    Err(e) => {
      report_syntax(path, src, e)
      EXIT_ERROR
    },
    Ok(prog) => {
      let env: eval.Env = eval.new_env(None)
      let last: eval.Value = VUnit
      let i: I64 = 0
      while i < len(prog.body) {
        match eval.exec_stmt(prog.body[i], env) {
          Ok(fl) => last = eval.flow_value(fl),
          Err(er) => {
            report_runtime(path, src, er)
            return EXIT_ERROR
          },
        }
        i = i + 1
      }
      write_out("# canonical v1\n")
      write_out(bytes.concat("_result = ", bytes.concat(eval.canonical(last, 0), "\n")))
      let names: Arr[Str] = eval.canon_sort(dict_keys(env.vars))
      let j: I64 = 0
      while j < len(names) {
        write_out(bytes.concat(names[j], bytes.concat(" = ",
          bytes.concat(eval.canonical(dict_must(env.vars, names[j]), 0), "\n"))))
        j = j + 1
      }
      EXIT_OK
    },
  }
}

# precheck is the parse-and-check block both run paths share, including the
# trailer that names --no-check. It returns EXIT_OK when the program is clear to
# run.
fn precheck(path: Str, src: Str) -> I64 {
  match parse.parse(src) {
    Err(e) => {
      report_syntax(path, src, e)
      return EXIT_ERROR
    },
    Ok(prog) => {
      let diags: Arr[check.Diagnostic] = check.check_file(prog, path)
      if len(diags) > 0 {
        print_diags(path, src, diags)
        # Only an error refuses. A warning describes the program the author
        # wrote and is printed above; the program still runs.
        let n: I64 = count_errors(diags)
        if n > 0 {
          write_err(bytes.concat("twill: ", bytes.concat(str(n),
            " shape error(s); not running (use --no-check to run anyway)\n")))
          return EXIT_ERROR
        }
      }
      EXIT_OK
    },
  }
}

fn check_only(path: Str) -> I64 {
  match check_legacy_ext(path) {
    Some(msg) => {
      write_err(bytes.concat("twill: ", bytes.concat(msg, "\n")))
      return EXIT_ERROR
    },
    None => unit,
  }
  let src: Str = ""
  match read_file(path) {
    Ok(b) => src = b,
    Err(_) => {
      write_err(cannot_read(path))
      return EXIT_ERROR
    },
  }
  match parse.parse(src) {
    Err(e) => {
      report_syntax(path, src, e)
      EXIT_ERROR
    },
    Ok(prog) => {
      let diags: Arr[check.Diagnostic] = check.check_file(prog, path)
      if len(diags) == 0 {
        write_out(bytes.concat(path, ": no shape problems found\n"))
        return EXIT_OK
      }
      # No --no-check trailer here: `check` was asked to report, not to run, so
      # there is nothing to offer to run anyway.
      print_diags(path, src, diags)
      # A file whose only findings are warnings has nothing wrong with it, so
      # the check passes. They are still printed: that is the whole point.
      if count_errors(diags) > 0 { return EXIT_ERROR }
      EXIT_OK
    },
  }
}

# format_file prints canonically formatted source, or rewrites the file with
# --write.
#
# The rule that matters most, because it is the one people notice: --write never
# renames a file. The legacy-extension check runs before anything is read or
# written, so a retired extension is refused and the file is left exactly as it
# was. A formatter that renames files is a formatter people stop trusting.
fn format_file(path: Str, write: Bool) -> I64 {
  match check_legacy_ext(path) {
    Some(msg) => {
      write_err(bytes.concat("twill: ", bytes.concat(msg, "\n")))
      return EXIT_ERROR
    },
    None => unit,
  }
  let src: Str = ""
  match read_file(path) {
    Ok(b) => src = b,
    Err(_) => {
      write_err(cannot_read(path))
      return EXIT_ERROR
    },
  }
  let out: Str = ""
  match fmt.source(src) {
    Ok(text) => out = text,
    Err(e) => {
      report_format_error(path, src, e)
      return EXIT_ERROR
    },
  }
  if write {
    match write_file(path, out) {
      Ok(_) => return EXIT_OK,
      Err(_) => {
        write_err(bytes.concat("twill: cannot write file ",
          bytes.concat(lex.quote_value(path), "\n")))
        return EXIT_ERROR
      },
    }
  }
  write_out(out)
  EXIT_OK
}

# The REPL is src/cli/repl.tw's, and the line editing it needs is NEEDS-47: the
# host reads a line and hands it over. Until that seam exists there is nothing
# to start, and saying so beats printing a prompt that cannot read.
fn repl() -> I64 {
  write_err("the REPL needs a line reader (NEEDS-47)\n")
  EXIT_ERROR
}

# ---- diagnostics -----------------------------------------------------------

fn cannot_read(path: Str) -> Str =
  bytes.concat("twill: cannot read file ", bytes.concat(lex.quote_value(path), "\n"))

# Diagnostics print one per line, prefixed with the file and line so an editor
# can jump to them, each followed by the offending source line. The checker
# already dedupes, so a mistake in a function called three times appears once.
fn print_diags(path: Str, src: Str, diags: Arr[check.Diagnostic]) {
  let i: I64 = 0
  while i < len(diags) {
    let d: check.Diagnostic = diags[i]
    # A warning says so rather than calling itself a shape error, which it is
    # not: the program means what it says and will run.
    let label: Str = "shape error"
    if d.severity != check.SEV_ERROR { label = "warning" }
    write_err(bytes.concat(path, bytes.concat(":", bytes.concat(str(d.line),
      bytes.concat(": ", bytes.concat(label, bytes.concat(": ", bytes.concat(d.msg, "\n"))))))))
    show_context(src, d.line, 0)
    i = i + 1
  }
}

# How many of a run's diagnostics are errors. A caller deciding whether to run
# the program asks this rather than len(diags), because a warning is not a
# refusal. check.SEV_* is the same pair of codes the Go checker uses.
fn count_errors(diags: Arr[check.Diagnostic]) -> I64 {
  let n: I64 = 0
  for d in diags {
    if d.severity == check.SEV_ERROR { n = n + 1 }
  }
  n
}

fn report_syntax(path: Str, src: Str, e: lex.SyntaxError) {
  write_err(bytes.concat(path, bytes.concat(":", bytes.concat(str(e.line),
    bytes.concat(":", bytes.concat(str(e.col),
      bytes.concat(": syntax error: ", bytes.concat(e.msg, "\n"))))))))
  show_context(src, e.line, e.col)
}

# A formatter refusal is not a position in the file, so it gets the plain
# `error: ...` form rather than the file:line:col treatment. Go reaches the same
# two shapes through a type switch on `error`; here the enum makes the two cases
# the signature.
fn report_format_error(path: Str, src: Str, e: fmt.FormatError) {
  match e {
    FSyntax(s) => report_syntax(path, src, s),
    FRefused(m) => write_err(bytes.concat("error: ", bytes.concat(m, "\n"))),
  }
}

# show_context prints the source line and, when col > 0, a caret beneath it. The
# gutter is `  N | `, and the caret is placed by the gutter's rendered width, so
# a four-digit line number does not shift the caret off the character it names.
fn show_context(src: Str, line: I64, col: I64) {
  if len(src) == 0 or line < 1 {
    return
  }
  let lines: Arr[Str] = split_lines(src)
  if line > len(lines) {
    return
  }
  let prefix: Str = bytes.concat("  ", bytes.concat(str(line), " | "))
  write_err(bytes.concat(prefix, bytes.concat(lines[line - 1], "\n")))
  if col > 0 {
    write_err(bytes.concat(bytes.repeat(" ", len(prefix) + col - 1), "^\n"))
  }
}

# Go's strings.Split on "\n": a trailing newline yields a final empty element,
# which is what makes `line > len(lines)` the right bound rather than an
# off-by-one.
fn split_lines(s: Str) -> Arr[Str] {
  let out: Arr[Str] = arr_new()
  let start: I64 = 0
  let i: I64 = 0
  while i < len(s) {
    if s[i] == 10 {
      push(out, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  push(out, s[start:len(s)])
  out
}

# ---- usage -----------------------------------------------------------------

fn usage() -> Str {
  let b: Bytes = bytes.new()
  bytes.push_text(b, bytes.concat("Twill ", bytes.concat(VERSION, "\n")))
  bytes.push_text(b, "\n")
  bytes.push_text(b, "Usage:\n")
  bytes.push_text(b, "  twill <file.tw>            Shape-check, then run a program\n")
  bytes.push_text(b, "  twill run <file.tw>        Same as above\n")
  bytes.push_text(b, "  twill run <file> --no-check   Run without the static shape check\n")
  bytes.push_text(b, "  twill run <file> --dump=canonical   Run, then dump top-level bindings exactly\n")
  bytes.push_text(b, "  twill check <file.tw>      Shape-check only, no execution\n")
  bytes.push_text(b, "  twill fmt <file.tw>        Print canonically formatted source\n")
  bytes.push_text(b, "  twill fmt <file> --write   Format the file in place\n")
  bytes.push_text(b, "  twill                      Start the REPL\n")
  bytes.push_text(b, "  twill --version            Print the version\n")
  bytes.push_text(b, "\n")
  bytes.push_text(b, "In the REPL: :help, :quit\n")
  bytes.to_str(b)
}

# ---- argument handling -----------------------------------------------------

fn drop_first(argv: Arr[Str]) -> Arr[Str] {
  let out: Arr[Str] = arr_new()
  let i: I64 = 1
  while i < len(argv) {
    push(out, argv[i])
    i = i + 1
  }
  out
}

# Scans every argument, including the command word, which is Go's hasFlag over
# os.Args[1:]. A file literally named `--write` would be read as the flag; that
# is the reference behaviour and not worth diverging over.
fn has_flag(a: Arr[Str], flag: Str) -> Bool {
  let i: I64 = 0
  while i < len(a) {
    if bytes.equal(a[i], flag) { return true }
    i = i + 1
  }
  false
}

# ---- the retired extension -------------------------------------------------

# The extension is checked on the name alone, before the file is opened, so that
# a retired-extension path is refused ahead of a missing-file error. The
# extension is the user's real problem and "cannot read file" would hide it. See
# section 4 of docs/self-hosting.md: this is a hard break with no deprecation
# window, and the file is refused outright rather than read anyway, so that
# there is exactly one source extension to explain.
#
# Case insensitive, and on the name alone. A file called `helpers.RA` is the
# same mistake as the lowercase spelling and deserves the same message.
fn check_legacy_ext(path: Str) -> Opt[Str] {
  if len(path) < 3 { return None }
  let ext: Str = lower(path[len(path) - 3:len(path)])
  if not bytes.equal(ext, ".ra") { return None }
  let renamed: Str = bytes.concat(path[0:len(path) - 3], ".tw")
  Some(bytes.concat(lex.quote_value(path),
    bytes.concat(" uses the retired .ra extension: Twill source files are .tw, so rename it to ",
      lex.quote_value(renamed))))
}

fn lower(s: Str) -> Str {
  let b: Bytes = bytes.new()
  let i: I64 = 0
  while i < len(s) {
    let c: I64 = s[i]
    if c >= 65 and c <= 90 {
      c = c + 32
    }
    bytes.push(b, c)
    i = i + 1
  }
  bytes.to_str(b)
}
