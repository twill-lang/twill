mode systems

# parse.tw: the twill parser, in twill.
#
# A port of internal/parser/parser.go: recursive descent with a Pratt loop for
# binary operators. Every production, every precedence, every error message and
# every lookahead rule is the Go parser's, because the two parsers are compared
# node for node over the corpus in testdata/ and a difference in either
# direction is a bug in this file rather than an improvement.
#
# Two rules in here are subtle enough to be worth finding before reading the
# code, because both are about a newline and neither is visible in the grammar:
#
#   - A `+` or `-` that starts a line continues the previous expression when it
#     is indented past the statement, and begins a new statement when it lines
#     up with it. See parse_binary.
#   - A `(` or `[` that starts a line begins a new expression, it is not a call
#     or an index on the previous line. See parse_postfix.
#
# Both exist because twill has no statement terminator, and both are documented
# in docs/language-guide.md as the newline-continuation rule.

import "lex.tw" as lex
import "ast.tw" as ast
import "bytes.tw" as bytes
import "std/float" as flt

# ---- precedence ------------------------------------------------------------
#
# The table from internal/parser/parser.go, unchanged. `^` is the only
# right-associative operator; `@` binds like `*`, which is what makes
# `a @ b + c` mean `(a @ b) + c`.

fn precedence_table() -> Dict[Str, I64] {
  let d: Dict[Str, I64] = dict_new()
  dict_set(d, "or", 1)
  dict_set(d, "||", 1)
  dict_set(d, "and", 2)
  dict_set(d, "&&", 2)
  dict_set(d, "==", 3)
  dict_set(d, "!=", 3)
  dict_set(d, "<", 4)
  dict_set(d, "<=", 4)
  dict_set(d, ">", 4)
  dict_set(d, ">=", 4)
  dict_set(d, "+", 5)
  dict_set(d, "-", 5)
  dict_set(d, "xor", 5)
  dict_set(d, "bor", 5)
  dict_set(d, "*", 6)
  dict_set(d, "/", 6)
  dict_set(d, "//", 6)
  dict_set(d, "%", 6)
  dict_set(d, "@", 6)
  dict_set(d, "shl", 6)
  dict_set(d, "shr", 6)
  dict_set(d, "band", 6)
  dict_set(d, "^", 7)
  d
}

let PRECEDENCE: Dict[Str, I64] = precedence_table()

fn precedence_of(op: Str) -> Opt[I64] = dict_get(PRECEDENCE, op)

fn is_right_assoc(op: Str) -> Bool = bytes.equal(op, "^")

# The operators spelled as a word rather than a symbol. Each is a keyword, so
# each is also callable, `xor(a, b)`, and parse_primary turns a leading one
# back into an identifier for that form.
fn is_bitwise_word(op: Str) -> Bool =
  bytes.equal(op, "and") or bytes.equal(op, "or") or bytes.equal(op, "band")
    or bytes.equal(op, "bor") or bytes.equal(op, "xor") or bytes.equal(op, "shl")
    or bytes.equal(op, "shr")

# ---- the cursor ------------------------------------------------------------

struct Parser {
  toks: Arr[lex.Token],
  pos: I64,
  ids: ast.NodeIds,
  # How many enclosing `(...)` or `[...]` the cursor is inside. The newline
  # rules that end a statement (a line starting `+`/`-`, or `and(`/`or(`) apply
  # only at group_depth 0: inside a grouping there is no statement to end, so
  # `f(a\n  + b)` continues the expression rather than breaking mid-argument.
  group_depth: I64,
  # The column of the first token of the statement being parsed. A line that
  # opens with `+`/`-` continues that statement when it is indented past this
  # column, and starts a new one when it lines up with it. Indentation is what a
  # reader already uses to tell the two apart, so the parser reads it the same
  # way. See parse_stmt, which sets it, and parse_binary, which consults it.
  stmt_col: I64,
}

# Signature is the three-part result of parsing a parameter list and an optional
# return annotation. Go returns a tuple; twill returns one value, so the tuple
# gets a name.
struct Signature {
  params: Arr[ast.Param],
  ret: Opt[ast.ShapeAnno],
  ret_unit: Opt[ast.UnitAnno],
  ret_type: Str,
}

# parse tokenizes and parses src into a Program.
fn parse(src: Str) -> Res[ast.Program, lex.SyntaxError] {
  let toks: Arr[lex.Token] = lex.tokenize(src)?
  let p: Parser = Parser { toks: toks, pos: 0, ids: ast.new_ids(), group_depth: 0, stmt_col: 0 }
  parse_program(p)
}

# ParseWithComments in Go returns the comments alongside, for the formatter.
struct Parsed {
  program: ast.Program,
  comments: Arr[lex.Comment],
  ids: ast.NodeIds,
}

fn parse_with_comments(src: Str) -> Res[Parsed, lex.SyntaxError] {
  let sc: lex.Scan = lex.tokenize_with_comments(src)?
  let p: Parser = Parser { toks: sc.tokens, pos: 0, ids: ast.new_ids(), group_depth: 0, stmt_col: 0 }
  let prog: ast.Program = parse_program(p)?
  Ok(Parsed { program: prog, comments: sc.comments, ids: p.ids })
}

# peek clamps to the last token, which is always EOF, so a lookahead past the
# end returns EOF rather than failing. Every caller relies on that: `peek(2)` in
# looks_like_record is allowed to run off the end of the file.
fn peek(p: Parser, o: I64) -> lex.Token {
  let idx: I64 = p.pos + o
  if idx >= len(p.toks) {
    idx = len(p.toks) - 1
  }
  p.toks[idx]
}

fn next_tok(p: Parser) -> lex.Token {
  let t: lex.Token = p.toks[p.pos]
  p.pos = p.pos + 1
  t
}

fn at_end(p: Parser) -> Bool = peek(p, 0).kind == lex.KIND_EOF

# check tests the *text* of the next token, and only for the three kinds where
# the text is the whole meaning. An IDENT named "and" would otherwise be
# indistinguishable from the keyword, which is why IDENT is not in the set.
fn check(p: Parser, value: Str) -> Bool {
  let t: lex.Token = peek(p, 0)
  let kindable: Bool = t.kind == lex.KIND_OP or t.kind == lex.KIND_PUNCT or t.kind == lex.KIND_KEYWORD
  kindable and bytes.equal(t.value, value)
}

fn accept(p: Parser, value: Str) -> Bool {
  if check(p, value) {
    next_tok(p)
    return true
  }
  false
}

fn expect(p: Parser, value: Str) -> Res[lex.Token, lex.SyntaxError] {
  if check(p, value) {
    return Ok(next_tok(p))
  }
  let t: lex.Token = peek(p, 0)
  Err(err_at(t, bytes.concat("expected ", bytes.concat(quoted(value),
    bytes.concat(" but found ", quoted(token_text(t)))))))
}

fn expect_ident(p: Parser) -> Res[Str, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  if t.kind == lex.KIND_IDENT {
    next_tok(p)
    return Ok(t.value)
  }
  Err(err_at(t, bytes.concat("expected identifier but found ", quoted(token_text(t)))))
}

fn err_at(t: lex.Token, msg: Str) -> lex.SyntaxError =
  lex.SyntaxError { msg: msg, line: t.line, col: t.col }

# quoted renders a string the way Go's %q verb does, which is what every
# diagnostic in internal/parser uses. Shared with the lexer's token dump so the
# two cannot drift apart. See NEEDS-20 for the parts of %q not covered.
fn quoted(s: Str) -> Str = lex.quote_value(s)

# An EOF token has an empty value, and "expected \")\" but found \"\"" is a
# worse message than naming the end of the file.
fn token_text(t: lex.Token) -> Str {
  if len(t.value) > 0 { return t.value }
  if t.kind == lex.KIND_EOF { return "end of input" }
  "?"
}

# A tuple holds between two and eight values. Two because one is the value
# itself and the comma would be decoration; eight because past that the
# positions stop being readable and the thing wanted a struct, which is the same
# judgement docs/roadmap.md entry 1 makes about naming them.
fn max_tuple_arity() -> I64 = 8

# The two refusals a tuple can earn, spelled once so the expression form and the
# type form say the same thing. internal/parser prints these same bytes.
fn one_element_tuple_msg() -> Str =
  "a tuple holds at least two values: (x,) is not a one-element tuple, and (x) is x in parentheses"

fn tuple_arity_msg(n: I64) -> Str =
  bytes.concat("a tuple holds at most ",
    bytes.concat(str(max_tuple_arity()),
      bytes.concat(" values, but this one has ",
        bytes.concat(str(n),
          "; a value with that many parts wants a struct, whose fields have names"))))

# A `;` is an optional statement separator and never carries meaning, so it is
# skipped wherever a statement may start.
fn skip_separators(p: Parser) {
  while accept(p, ";") {
  }
}

# ---- program ---------------------------------------------------------------

fn parse_program(p: Parser) -> Res[ast.Program, lex.SyntaxError] {
  let body: Arr[ast.Stmt] = arr_new()
  skip_separators(p)
  # A leading `mode <name>` is a file-level declaration, not a statement. `mode`
  # is not a keyword, so it is recognised only here, only first, and only when
  # an identifier follows it, which leaves it usable as an ordinary name after.
  let mode: Str = ""
  let t: lex.Token = peek(p, 0)
  if t.kind == lex.KIND_IDENT and bytes.equal(t.value, "mode") and peek(p, 1).kind == lex.KIND_IDENT {
    next_tok(p)
    mode = next_tok(p).value
    skip_separators(p)
  }
  while not at_end(p) {
    push(body, parse_stmt(p)?)
    skip_separators(p)
  }
  Ok(ast.Program { mode: mode, body: body })
}

# ---- statements ------------------------------------------------------------

# parse_stmt records the column this statement starts at, for the continuation
# rule in parse_binary, and restores the enclosing one on the way out. Statements
# nest, and twill has no `defer`, so the body lives in parse_stmt_body and this
# wrapper holds the save and the restore around it. The result is passed through
# rather than unwrapped with `?` so that an error restores the column too.
fn parse_stmt(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let outer_col: I64 = p.stmt_col
  p.stmt_col = peek(p, 0).col
  let r: Res[ast.Stmt, lex.SyntaxError] = parse_stmt_body(p)
  p.stmt_col = outer_col
  r
}

fn parse_stmt_body(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)

  if t.kind == lex.KIND_KEYWORD {
    if bytes.equal(t.value, "let") { return parse_let(p) }
    if bytes.equal(t.value, "const") { return parse_let(p) }
    # A `fn` followed by a name is a declaration; a `fn` followed by `(` is a
    # lambda in expression position, and falls through to parse_expr below.
    if bytes.equal(t.value, "fn") and peek(p, 1).kind == lex.KIND_IDENT {
      return parse_fn_decl(p)
    }
    if bytes.equal(t.value, "while") { return parse_while(p) }
    if bytes.equal(t.value, "for") { return parse_for(p) }
    if bytes.equal(t.value, "return") { return parse_return(p) }
    if bytes.equal(t.value, "break") { return Ok(ast.break_stmt(p.ids, next_tok(p).line)) }
    if bytes.equal(t.value, "continue") { return Ok(ast.continue_stmt(p.ids, next_tok(p).line)) }
    if bytes.equal(t.value, "import") { return parse_import(p) }
    if bytes.equal(t.value, "enum") { return parse_enum_decl(p) }
    if bytes.equal(t.value, "struct") { return parse_struct_decl(p) }
  }

  # `type <name> = ...` declares a record type. Like `unit`, `type` is not a
  # keyword, so it stays usable as a field name (`res.type`, `{ type: x }`);
  # only a leading `type` with an identifier after it is the declaration.
  if t.kind == lex.KIND_IDENT and bytes.equal(t.value, "type") and peek(p, 1).kind == lex.KIND_IDENT {
    return parse_type_decl(p)
  }

  # `unit <name>` declares a unit. `unit` is not a keyword, so it stays an
  # ordinary identifier everywhere else, most importantly as a field name
  # (`unit: Opt[UnitAnno]`); only a leading `unit` with an identifier after it
  # is the declaration.
  if t.kind == lex.KIND_IDENT and bytes.equal(t.value, "unit") and peek(p, 1).kind == lex.KIND_IDENT {
    return parse_unit_decl(p)
  }

  let x: ast.Expr = parse_expr(p)?
  # Assignment: `<lvalue> = expr`. `=` is not a binary operator, so parse_expr
  # stopped in front of it (and `==` was consumed as a comparison, so it never
  # reaches here). The target must be an lvalue: a name, a field, or an index.
  if peek(p, 0).kind == lex.KIND_OP and bytes.equal(peek(p, 0).value, "=") {
    next_tok(p)
    let v: ast.Expr = parse_expr(p)?
    if not is_assignable(x) {
      return Err(err_at(t, "cannot assign to this expression; the left of `=` must be a name, a field, or an index"))
    }
    return Ok(ast.assign_stmt(p.ids, x, v, t.line))
  }
  Ok(ast.expr_stmt(p.ids, x, t.line))
}

# is_assignable reports whether an expression may sit on the left of `=`: a bare
# name, a field access, or an index, the forms that name a storage location.
fn is_assignable(x: ast.Expr) -> Bool {
  match x {
    EIdent(_) => true,
    EField(_) => true,
    EIndex(_) => true,
    _ => false,
  }
}

# parse_let reads `let` and `const`, which differ only in whether the binding
# may be assigned to afterwards. The two spell the same statement, so they share
# a node and a parser and part company in the checker.
fn parse_let(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let kw: lex.Token = next_tok(p)
  let line: I64 = kw.line
  let is_const: Bool = bytes.equal(kw.value, "const")
  # `let (lo, hi) = span(xs)` destructures a tuple. The names are positional and
  # `_` drops the one it stands for; there is no annotation, because the thing
  # being annotated would be the tuple and the binding is the parts.
  if check(p, "(") {
    if is_const {
      return Err(err_at(kw, "a destructuring binding is written with let, not const: const binds one name, and the rule that a const name is bound only once is checked over single names"))
    }
    return parse_let_tuple(p, line)
  }
  let name: Str = expect_ident(p)?
  # An annotation on a `let` introduces a unit: `let px: USD/share = ...`. It is
  # not a type annotation today, and in systems mode it has to become one, which
  # is NEEDS-1's sharpest edge.
  # A unit introduces a quantity (`let px: USD/share`); a name followed by `.` or
  # `[` is a type (`let d: Arr[I64]`), advisory and kept as text, the same
  # disambiguation a parameter makes.
  let unit: Opt[ast.UnitAnno] = None
  let type_name: Str = ""
  if accept(p, ":") {
    if at_fn_type(p) {
      type_name = parse_fn_type(p)?
    } else if check(p, "(") {
      type_name = parse_tuple_type(p)?
    } else {
      let u: ast.UnitAnno = parse_unit_expr(p)?
      if (check(p, ".") or check(p, "[")) and len(u.factors) == 1 and u.factors[0].exp == 1 {
        type_name = type_suffix(p, u.factors[0].name)?
      } else {
        unit = Some(u)
      }
    }
  }
  expect(p, "=")?
  let v: ast.Expr = parse_expr(p)?
  Ok(ast.let_stmt(p.ids, name, unit, type_name, v, is_const, line))
}

# parse_let_tuple reads the `(a, b) = value` half of a destructuring binding.
# The cursor is on the `(`.
fn parse_let_tuple(p: Parser, line: I64) -> Res[ast.Stmt, lex.SyntaxError] {
  next_tok(p)
  let names: Arr[Str] = arr_new()
  while true {
    if check(p, ")") {
      return Err(err_at(peek(p, 0), one_element_tuple_msg()))
    }
    let t: lex.Token = peek(p, 0)
    if t.kind != lex.KIND_IDENT {
      return Err(err_at(t, bytes.concat("expected a name in a destructuring let but found ", quoted(token_text(t)))))
    }
    next_tok(p)
    push(names, t.value)
    if not accept(p, ",") { break }
  }
  expect(p, ")")?
  if len(names) < 2 {
    return Err(err_at(peek(p, 0), one_element_tuple_msg()))
  }
  if len(names) > max_tuple_arity() {
    return Err(err_at(peek(p, 0), tuple_arity_msg(len(names))))
  }
  expect(p, "=")?
  let v: ast.Expr = parse_expr(p)?
  Ok(ast.let_tuple_stmt(p.ids, names, v, line))
}

fn parse_fn_decl(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let name: Str = expect_ident(p)?
  let type_params: Arr[Str] = parse_type_params(p)?
  let sig: Signature = parse_signature(p)?
  let body: ast.Expr = parse_fn_body(p)?
  Ok(SFn(ast.fn_decl(p.ids, name, type_params, sig.params, sig.ret, sig.ret_unit, sig.ret_type, body, line)))
}

fn parse_while(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let cond: ast.Expr = parse_expr(p)?
  let body: ast.Block = parse_block(p)?
  Ok(ast.while_stmt(p.ids, cond, body, line))
}

fn parse_for(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let name: Str = expect_ident(p)?
  expect(p, "in")?
  let iter: ast.Expr = parse_expr(p)?
  let body: ast.Block = parse_block(p)?
  Ok(ast.for_stmt(p.ids, name, iter, body, line))
}

# A bare `return` is one at the end of a block, at a separator, or at the end of
# the file. Anything else starts an expression, including a `-` on the next line:
# `return` does not use the newline rule, so `return` followed by a value on the
# next line still returns that value.
fn parse_return(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  # A value-less `return` is followed by the end of its block or statement, or,
  # when it is a match arm body, by the arm-separating `,` (`_ => return,`).
  if check(p, "}") or check(p, ";") or check(p, ",") or at_end(p) {
    return Ok(ast.return_stmt(p.ids, None, line))
  }
  let v: ast.Expr = parse_expr(p)?
  Ok(ast.return_stmt(p.ids, Some(v), line))
}

fn parse_import(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let t: lex.Token = peek(p, 0)
  if t.kind != lex.KIND_STRING {
    return Err(err_at(t, "import expects a string path"))
  }
  next_tok(p)
  let alias: Str = ""
  # `as` is not a keyword: it is an ordinary identifier that only means
  # something here. Making it a keyword would break every program with a
  # variable called `as`, for no gain, since the position is unambiguous.
  if peek(p, 0).kind == lex.KIND_IDENT and bytes.equal(peek(p, 0).value, "as") {
    next_tok(p)
    alias = expect_ident(p)?
  }
  Ok(ast.import_stmt(p.ids, t.value, alias, line))
}

fn parse_unit_decl(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let name: Str = expect_ident(p)?
  Ok(ast.unit_decl(p.ids, name, line))
}

fn parse_type_decl(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let name: Str = expect_ident(p)?
  expect(p, "=")?
  expect(p, "{")?
  let fields: Arr[ast.TypeField] = arr_new()
  while not check(p, "}") and not at_end(p) {
    let field_name: Str = expect_ident(p)?
    expect(p, ":")?
    let shape: ast.ShapeAnno = parse_shape_anno(p)?
    push(fields, ast.TypeField { name: field_name, shape: shape })
    if not accept(p, ",") {
      break
    }
  }
  expect(p, "}")?
  Ok(ast.type_decl(p.ids, name, fields, line))
}

# parse_type_params parses the `[T, U]` a declaration may carry after its name.
# It returns an empty list when there is none, which is the shape of every
# declaration written before 1.7. The names are ordinary identifiers; what makes
# one a type parameter is being listed here, and it is in scope for the
# declaration only.
fn parse_type_params(p: Parser) -> Res[Arr[Str], lex.SyntaxError] {
  let names: Arr[Str] = arr_new()
  if not check(p, "[") { return Ok(names) }
  next_tok(p)
  while true {
    push(names, expect_ident(p)?)
    if accept(p, ",") { continue }
    expect(p, "]")?
    break
  }
  Ok(names)
}

# parse_enum_decl parses `enum Name { Case, Case(Payload), ... }`. A case is a
# name with an optional single payload type in parentheses; cases are separated
# by commas and a trailing comma is allowed. The payload type is read with
# parse_type_ref and kept only as advisory text, the way the Go parser keeps it.
fn parse_enum_decl(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let name: Str = expect_ident(p)?
  let type_params: Arr[Str] = parse_type_params(p)?
  expect(p, "{")?
  let variants: Arr[ast.EnumVariant] = arr_new()
  while not check(p, "}") and not at_end(p) {
    let vname: Str = expect_ident(p)?
    let has_payload: Bool = false
    let payload: Str = ""
    if accept(p, "(") {
      payload = parse_type_ref(p)?
      expect(p, ")")?
      has_payload = true
    }
    push(variants, ast.EnumVariant { name: vname, has_payload: has_payload, payload: payload })
    if not accept(p, ",") {
      break
    }
  }
  expect(p, "}")?
  Ok(ast.enum_decl(p.ids, name, type_params, variants, line))
}

# parse_struct_decl parses `struct Name { field: Type, ... }`. A field's type is
# a full type reference (name, qualified, or generic), kept as advisory text;
# fields are comma-separated and a trailing comma is allowed.
fn parse_struct_decl(p: Parser) -> Res[ast.Stmt, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let name: Str = expect_ident(p)?
  let type_params: Arr[Str] = parse_type_params(p)?
  expect(p, "{")?
  let fields: Arr[ast.StructField] = arr_new()
  while not check(p, "}") and not at_end(p) {
    let fname: Str = expect_ident(p)?
    expect(p, ":")?
    let ftype: Str = parse_type_expr(p)?
    push(fields, ast.StructField { name: fname, type_name: ftype })
    if not accept(p, ",") {
      break
    }
  }
  expect(p, "}")?
  Ok(ast.struct_decl(p.ids, name, type_params, fields, line))
}

# ---- expressions -----------------------------------------------------------

fn parse_expr(p: Parser) -> Res[ast.Expr, lex.SyntaxError] = parse_binary(p, 0)

fn parse_binary(p: Parser, min_prec: I64) -> Res[ast.Expr, lex.SyntaxError] {
  let left: ast.Expr = parse_unary(p)?
  while true {
    let t: lex.Token = peek(p, 0)
    let op: Str = t.value
    # `and` and `or` are keywords but behave as binary operators; `&&` and `||`
    # arrive as OP and are handled by the same table.
    let is_op: Bool = t.kind == lex.KIND_OP or
      (t.kind == lex.KIND_KEYWORD and is_bitwise_word(op))
    if not is_op {
      break
    }
    # A '+' or '-' that opens a new line is ambiguous: it either continues this
    # expression or starts a new statement whose first token is a unary minus
    # (`-mean(x)`). Indentation decides, the same way a reader decides. Indented
    # past the column the statement began at, the operator continues:
    #
    #   let a = first_term
    #     + second_term        # continues: indented past `let`
    #
    # Lined up with it (or further left), it begins a new statement:
    #
    #   let a = first_term
    #   -mean(x)               # a new statement
    #
    # Ending the previous line with the operator continues an expression too,
    # and always did; this rule adds the leading-operator form beside it.
    let leading_pm: Bool = bytes.equal(op, "+") or bytes.equal(op, "-")
    let broke_line: Bool = p.pos > 0 and t.line > p.toks[p.pos - 1].line
    if p.group_depth == 0 and leading_pm and broke_line and t.col <= p.stmt_col {
      break
    }
    # A line that begins `and(`, `xor(`, `shr(` and so on is a call starting a
    # new statement, not this expression continued by that operator. Every
    # bitwise word is both an infix operator and a callable builtin, so the
    # following `(` distinguishes the call from a genuine continuation, and
    # indentation separates them for the same reason it does above. Like the
    # `+`/`-` rule, only at statement level: inside a grouping it continues.
    let leading_bool: Bool = is_bitwise_word(op)
    let call_form: Bool = bytes.equal(peek(p, 1).value, "(")
    if p.group_depth == 0 and leading_bool and broke_line and call_form and t.col <= p.stmt_col {
      break
    }
    let prec: I64 = 0
    match precedence_of(op) {
      Some(v) => prec = v,
      None => break,
    }
    if prec < min_prec {
      break
    }
    next_tok(p)
    # Left-associative operators parse their right side at one level tighter, so
    # `a - b - c` groups as `(a - b) - c`. `^` does not, so `a ^ b ^ c` groups
    # as `a ^ (b ^ c)`.
    let next_min: I64 = prec + 1
    if is_right_assoc(op) {
      next_min = prec
    }
    let right: ast.Expr = parse_binary(p, next_min)?
    left = ast.binary(p.ids, op, left, right, t.line)
  }
  Ok(left)
}

fn parse_unary(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  let is_unary: Bool =
    (t.kind == lex.KIND_OP and (bytes.equal(t.value, "-") or bytes.equal(t.value, "!"))) or
    (t.kind == lex.KIND_KEYWORD and bytes.equal(t.value, "not"))
  if is_unary {
    next_tok(p)
    # Recursing into parse_unary rather than parse_postfix is what makes `--x`
    # and `not not b` parse, and what makes `-x[0]` mean `-(x[0])`.
    let operand: ast.Expr = parse_unary(p)?
    return Ok(ast.unary(p.ids, t.value, operand, t.line))
  }
  parse_postfix(p)
}

fn parse_postfix(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let x: ast.Expr = parse_primary(p)?
  while true {
    # A '(' or '[' that starts a new line begins a new expression rather than
    # continuing this one as a call or an index. This keeps a line like `[a, b]`
    # from being read as an index on the previous line. Keep the call or index
    # on the same line as its target to chain them.
    #
    # Note this tests only '(' and '[': a '.' on a new line still continues the
    # expression, which is what makes a fluent chain readable across lines and
    # is the Go parser's behaviour.
    if (check(p, "(") or check(p, "[")) and p.pos > 0 and peek(p, 0).line > p.toks[p.pos - 1].line {
      break
    }
    if check(p, ".") {
      let line: I64 = next_tok(p).line
      let name: Str = expect_ident(p)?
      x = ast.field(p.ids, x, name, line)
      continue
    }
    if check(p, "(") {
      let line: I64 = peek(p, 0).line
      p.group_depth = p.group_depth + 1
      let args: Arr[ast.Expr] = parse_args(p)?
      p.group_depth = p.group_depth - 1
      x = ast.call(p.ids, x, args, line)
      continue
    }
    if check(p, "[") {
      let line: I64 = next_tok(p).line
      p.group_depth = p.group_depth + 1
      let ix: ast.Expr = parse_index_or_slice(p, x, line)?
      p.group_depth = p.group_depth - 1
      x = ix
      continue
    }
    if check(p, "?") {
      # Postfix `?`: unwrap a Res/Opt success or return its failure.
      let line: I64 = next_tok(p).line
      x = ast.try_expr(p.ids, x, line)
      continue
    }
    break
  }
  # A type name immediately followed by `{ field: ... }` is a typed record
  # literal, `Point { x: 1.0 }`. Records are structural, so the value is the same
  # `{ ... }` builds; the name is carried only for printing. looks_like_record
  # requires `{ ident :`, which a block never begins with, so this does not
  # swallow the block of an `if`/`while` whose condition is a name.
  match expr_to_name(x) {
    Some(name) => if looks_like_record(p) {
      x = parse_record_lit(p, name)?
    },
    None => unit,
  }
  Ok(x)
}

# expr_to_name renders a name or a dotted name (`Point`, `geom.Point`) as text,
# for the type in front of a typed record literal. None for anything else.
fn expr_to_name(x: ast.Expr) -> Opt[Str] {
  match x {
    EIdent(e) => Some(e.name),
    EField(e) => match expr_to_name(e.target) {
      Some(base) => Some(bytes.concat(base, bytes.concat(".", e.name))),
      None => None,
    },
    _ => None,
  }
}

# parse_index_or_slice parses the body of a `[...]` after the '[' is consumed.
# It produces an Index (`t[e]`) or a Slice (`t[a:b]`, with either side
# optional). The two are told apart by whether a ':' follows the first
# expression, which is why the start is parsed before the decision is made.
fn parse_index_or_slice(p: Parser, target: ast.Expr, line: I64) -> Res[ast.Expr, lex.SyntaxError] {
  let start: Opt[ast.Expr] = None
  if not check(p, ":") {
    start = Some(parse_expr(p)?)
  }
  if accept(p, ":") {
    let end: Opt[ast.Expr] = None
    if not check(p, "]") {
      end = Some(parse_expr(p)?)
    }
    expect(p, "]")?
    return Ok(ast.slice(p.ids, target, start, end, line))
  }
  expect(p, "]")?
  match start {
    Some(e) => Ok(ast.index(p.ids, target, e, line)),
    # `t[]` reaches here: no start, and no ':' to make it a slice. The Go parser
    # builds an Index with a nil index and the evaluator fails on it later; this
    # refuses it where the mistake is, which is a divergence and a deliberate
    # one. See NEEDS-31.
    None => Err(err_at(peek(p, 0), "expected an index expression")),
  }
}

fn parse_primary(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)

  if t.kind == lex.KIND_NUMBER {
    next_tok(p)
    match flt.f64_of_str(t.value) {
      Some(v) => return Ok(ast.number_lit(p.ids, v, t.value, t.line)),
      None => return Err(err_at(t, bytes.concat("invalid number ", quoted(t.value)))),
    }
  }
  if t.kind == lex.KIND_STRING {
    next_tok(p)
    return Ok(ast.string_lit(p.ids, t.value, t.line))
  }
  if t.kind == lex.KIND_KEYWORD {
    if bytes.equal(t.value, "true") {
      next_tok(p)
      return Ok(ast.bool_lit(p.ids, true, t.line))
    }
    if bytes.equal(t.value, "false") {
      next_tok(p)
      return Ok(ast.bool_lit(p.ids, false, t.line))
    }
    if bytes.equal(t.value, "if") {
      return Ok(EIf(parse_if(p)?))
    }
    if bytes.equal(t.value, "match") {
      return parse_match(p)
    }
    if bytes.equal(t.value, "fn") {
      return parse_lambda(p)
    }
    # `and` and `or` are the boolean infix operators, but spelled as a call,
    # `and(x, y)`, they are the bitwise builtins. Only a following `(` selects
    # the call; as infix they always have a left operand and so never reach
    # parse_primary as a leading token. Emitting an ident lets parse_postfix
    # turn it into the call.
    if is_bitwise_word(t.value) and bytes.equal(peek(p, 1).value, "(") {
      next_tok(p)
      return Ok(ast.ident(p.ids, t.value, t.line))
    }
    # Any other keyword falls through to the unexpected-token error below,
    # which is what the Go parser's switch does by not matching.
  }
  if t.kind == lex.KIND_IDENT {
    next_tok(p)
    return Ok(ast.ident(p.ids, t.value, t.line))
  }

  # A parenthesised expression produces no node of its own: grouping is
  # expressed by the tree's shape, so `(a + b)` and a `+` node are the same
  # thing and the formatter re-inserts parentheses from precedence.
  if check(p, "(") {
    let open: lex.Token = next_tok(p)
    p.group_depth = p.group_depth + 1
    let inner: ast.Expr = parse_expr(p)?
    # The comma is what decides. Without one this is grouping and has been since
    # the first parser; with one it is a tuple, and the elements after it are
    # ordinary expressions.
    if not check(p, ",") {
      p.group_depth = p.group_depth - 1
      expect(p, ")")?
      return Ok(inner)
    }
    let elements: Arr[ast.Expr] = arr_new()
    push(elements, inner)
    while accept(p, ",") {
      if check(p, ")") {
        p.group_depth = p.group_depth - 1
        return Err(err_at(peek(p, 0), one_element_tuple_msg()))
      }
      push(elements, parse_expr(p)?)
    }
    p.group_depth = p.group_depth - 1
    expect(p, ")")?
    if len(elements) > max_tuple_arity() {
      return Err(err_at(open, tuple_arity_msg(len(elements))))
    }
    return Ok(ast.tuple_lit(p.ids, elements, open.line))
  }
  if check(p, "[") {
    p.group_depth = p.group_depth + 1
    let lst: ast.Expr = parse_tensor_or_list(p)?
    p.group_depth = p.group_depth - 1
    return Ok(lst)
  }
  if check(p, "{") {
    if looks_like_record(p) {
      return parse_record_lit(p, "")
    }
    return Ok(EBlock(parse_block(p)?))
  }
  Err(err_at(t, bytes.concat("unexpected token ", quoted(token_text(t)))))
}

fn parse_if(p: Parser) -> Res[ast.IfExpr, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let cond: ast.Expr = parse_expr(p)?
  let then_block: ast.Block = parse_block(p)?
  let else_branch: ast.Else = NoElse
  if accept(p, "else") {
    if check(p, "if") {
      else_branch = ElseIf(parse_if(p)?)
    } else {
      else_branch = ElseBlock(parse_block(p)?)
    }
  }
  Ok(ast.if_expr(p.ids, cond, then_block, else_branch, line))
}

# parse_match parses `match subject { pattern => body, ... }`. Arms are separated
# by commas (a trailing comma is allowed); each body is a statement, so it is
# parsed with parse_stmt and `Some(v) => v`, `_ => return x`, `Ok(b) => acc = b`
# and `None => { ... }` are all arms. The subject is a plain expression, and the
# `{` that follows it is the match's brace, never a record literal, because
# parse_postfix stops before a `{`.
fn parse_match(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let subject: ast.Expr = parse_expr(p)?
  expect(p, "{")?
  let arms: Arr[ast.MatchArm] = arr_new()
  while not check(p, "}") and not at_end(p) {
    let pat: ast.MatchPattern = parse_pattern(p)?
    # A guard is `if cond` between the pattern and the arrow.
    let guard: Arr[ast.Expr] = arr_new()
    if check(p, "if") {
      next_tok(p)
      push(guard, parse_expr(p)?)
    }
    expect(p, "=>")?
    let body: ast.Stmt = parse_stmt(p)?
    push(arms, ast.MatchArm { pattern: pat, body: body, guard: guard })
    if not accept(p, ",") {
      break
    }
  }
  expect(p, "}")?
  Ok(ast.match_expr(p.ids, subject, arms, line))
}

# parse_pattern parses a match arm's pattern. A pattern is one of:
#
#   _              matches anything, binds nothing
#   name           matches anything, binds it
#   3, "s", true   matches by equality
#   Variant        matches the case, whatever it carries
#   Variant(pat)   matches the case and matches its payload against pat
#
# and the last nests, so `Ok(Some(v))` and `Err(-1)` are patterns. The rule that
# tells a variant from a binder is the initial letter: `Some` names a case,
# `some` binds. Every variant in the language and its libraries is upper-case
# initial, and a lower-case one would previously have been read as a case that
# no enum declares, which the checker refused to judge.
fn parse_pattern(p: Parser) -> Res[ast.MatchPattern, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  if pattern_starts_literal(p, t) {
    let lit: ast.Expr = parse_pattern_literal(p)?
    let one: Arr[ast.Expr] = arr_new()
    push(one, lit)
    return Ok(ast.MatchPattern { kind: ast.PAT_LITERAL, variant: "", binding: "", sub: [], lit: one, line: t.line })
  }
  let name: Str = expect_ident(p)?
  # A variant may be written with something in front, `Opt.None` or
  # `ast.EBool(b)`, the same way it is written where a value is constructed. The
  # qualifier only says where the variant comes from, and variants are resolved
  # by name, so it is read and dropped. This runs before the case rule below,
  # because the qualifier is a type name or a module alias and either may be
  # lower-case: what decides is the name after the dot.
  if check(p, ".") {
    next_tok(p)
    name = expect_ident(p)?
  } else if not starts_upper(name) {
    if check(p, "(") {
      return Err(err_at(peek(p, 0), bytes.concat(name, " is a binding, not a variant: a case name starts with a capital letter")))
    }
    if bytes.equal(name, "_") {
      return Ok(ast.pat_bind("", t.line))
    }
    return Ok(ast.pat_bind(name, t.line))
  }
  let sub: Arr[ast.MatchPattern] = arr_new()
  if accept(p, "(") {
    push(sub, parse_pattern(p)?)
    expect(p, ")")?
  }
  Ok(ast.MatchPattern { kind: ast.PAT_VARIANT, variant: name, binding: "", sub: sub, lit: [], line: t.line })
}

# pattern_starts_literal reports whether the token begins one of the literal
# forms a pattern may match by equality. A leading `-` belongs to the number:
# `Err(-1)` is one pattern, not a negation applied to one.
fn pattern_starts_literal(p: Parser, t: lex.Token) -> Bool {
  if t.kind == lex.KIND_NUMBER { return true }
  if t.kind == lex.KIND_STRING { return true }
  if t.kind == lex.KIND_KEYWORD and (bytes.equal(t.value, "true") or bytes.equal(t.value, "false")) { return true }
  bytes.equal(t.value, "-") and peek(p, 1).kind == lex.KIND_NUMBER
}

# parse_pattern_literal reads that literal, keeping the digits as written so an
# I64 above 2^53 compares exactly rather than through an f64.
fn parse_pattern_literal(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  if bytes.equal(t.value, "-") and peek(p, 1).kind == lex.KIND_NUMBER {
    next_tok(p)
    let n: lex.Token = peek(p, 0)
    let num: ast.Expr = parse_pattern_number(p)?
    return Ok(ast.unary(p.ids, "-", num, n.line))
  }
  if t.kind == lex.KIND_NUMBER {
    return parse_pattern_number(p)
  }
  if t.kind == lex.KIND_STRING {
    next_tok(p)
    return Ok(ast.string_lit(p.ids, t.value, t.line))
  }
  next_tok(p)
  Ok(ast.bool_lit(p.ids, bytes.equal(t.value, "true"), t.line))
}

fn parse_pattern_number(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  next_tok(p)
  match flt.f64_of_str(t.value) {
    Some(v) => Ok(ast.number_lit(p.ids, v, t.value, t.line)),
    None => Err(err_at(t, bytes.concat("invalid number ", quoted(t.value)))),
  }
}

# starts_upper is the variant-versus-binder rule, applied to the first
# character. Names in twill are ASCII identifiers.
fn starts_upper(name: Str) -> Bool {
  if len(name) == 0 { return false }
  lex.is_upper(name[0])
}

fn parse_lambda(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let sig: Signature = parse_signature(p)?
  let body: ast.Expr = parse_fn_body(p)?
  Ok(ast.lambda(p.ids, sig.params, sig.ret, sig.ret_unit, sig.ret_type, body, line))
}

# A `[...]` is a tensor literal when every element is one a tensor can be built
# from, and a list literal otherwise. The decision is made here and not in the
# checker because it changes what the operators mean: `[1, 2] @ [3, 4]` is a
# matmul, and a list has no `@`.
#
# An empty `[]` is a list, not a rank-1 tensor of length zero. That is the Go
# parser's rule (isTensor starts false when there are no elements) and changing
# it would change what `len([])` means.
fn parse_tensor_or_list(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  let line: I64 = next_tok(p).line
  let elements: Arr[ast.Expr] = arr_new()
  if not check(p, "]") {
    push(elements, parse_expr(p)?)
    while accept(p, ",") {
      # A trailing comma before the bracket is allowed and produces no element.
      if check(p, "]") {
        break
      }
      push(elements, parse_expr(p)?)
    }
  }
  expect(p, "]")?
  let is_tensor: Bool = len(elements) > 0
  let i: I64 = 0
  while i < len(elements) {
    if not is_numeric_elem(elements[i]) {
      is_tensor = false
      break
    }
    i = i + 1
  }
  if is_tensor {
    return Ok(ast.tensor_lit(p.ids, elements, line))
  }
  Ok(ast.list_lit(p.ids, elements, line))
}

# is_numeric_elem reports whether e can appear inside a tensor literal: a number,
# a nested tensor literal, or a negated number. Deliberately not an arbitrary
# expression: `[a, b]` where a and b are variables is a list, and the runtime
# builds a tensor from it if the values turn out to be numbers.
fn is_numeric_elem(e: ast.Expr) -> Bool {
  match e {
    ENumber(_) => true,
    ETensor(_) => true,
    EUnary(u) => {
      if not bytes.equal(u.op, "-") { return false }
      match u.operand {
        ENumber(_) => true,
        _ => false,
      }
    },
    _ => false,
  }
}

fn parse_block(p: Parser) -> Res[ast.Block, lex.SyntaxError] {
  let open: lex.Token = expect(p, "{")?
  let body: Arr[ast.Stmt] = arr_new()
  skip_separators(p)
  while not check(p, "}") and not at_end(p) {
    push(body, parse_stmt(p)?)
    skip_separators(p)
  }
  let close_tok: lex.Token = expect(p, "}")?
  Ok(ast.new_block(p.ids, body, open.line, close_tok.line))
}

# A function body is either `= expr` or a block. The `=` form is the one most of
# std/ uses and it is not sugar for a block: a block's value is its last
# expression statement, and `= expr` has no statement at all.
fn parse_fn_body(p: Parser) -> Res[ast.Expr, lex.SyntaxError] {
  if accept(p, "=") {
    return parse_expr(p)
  }
  Ok(EBlock(parse_block(p)?))
}

# looks_like_record decides whether a `{` starts a record literal (`{ name: ...`)
# rather than a block. A block never begins with `ident :`, so three tokens of
# lookahead settle it with no backtracking.
#
# docs/self-hosting.md section 1.2 warns that pattern matching must not re-enter
# this ambiguity, which is why `match` arms use `=>` and commas rather than
# braces.
fn looks_like_record(p: Parser) -> Bool {
  if not bytes.equal(peek(p, 0).value, "{") {
    return false
  }
  # `{}` in expression position is the empty record. Read as a block it would be
  # a block with no statements, whose value is unit -- nothing a program can use
  # -- so there is no second meaning being taken away. It matters because
  # `let seen: Dict[Str, I64] = {}` is how the empty dictionary is written, and
  # binding unit there left every later dict_set on it failing.
  if bytes.equal(peek(p, 1).value, "}") {
    return true
  }
  peek(p, 1).kind == lex.KIND_IDENT and
    peek(p, 2).kind == lex.KIND_PUNCT and bytes.equal(peek(p, 2).value, ":")
}

fn parse_record_lit(p: Parser, type_name: Str) -> Res[ast.Expr, lex.SyntaxError] {
  let line: I64 = expect(p, "{")?.line
  let fields: Arr[ast.RecordField] = arr_new()
  while not check(p, "}") and not at_end(p) {
    let name: Str = expect_ident(p)?
    expect(p, ":")?
    let val: ast.Expr = parse_expr(p)?
    push(fields, ast.RecordField { name: name, value: val })
    if not accept(p, ",") {
      break
    }
  }
  expect(p, "}")?
  Ok(ast.record_lit(p.ids, type_name, fields, line))
}

# ---- signatures and annotations --------------------------------------------

fn parse_signature(p: Parser) -> Res[Signature, lex.SyntaxError] {
  let params: Arr[ast.Param] = parse_params(p)?
  let ret: Opt[ast.ShapeAnno] = None
  let ret_unit: Opt[ast.UnitAnno] = None
  let ret_type: Str = ""
  if accept(p, "->") {
    # A `[` after the arrow is a shape; otherwise a unit expression, unless a
    # `.` follows a single bare name, which makes it a qualified type: units are
    # never qualified. The qualified name is lifted into the advisory ret_type.
    if check(p, "[") {
      ret = Some(parse_shape_anno(p)?)
    } else if at_fn_type(p) {
      ret_type = parse_fn_type(p)?
    } else if check(p, "(") {
      ret_type = parse_tuple_type(p)?
    } else {
      let u: ast.UnitAnno = parse_unit_expr(p)?
      if (check(p, ".") or check(p, "[")) and len(u.factors) == 1 and u.factors[0].exp == 1 {
        ret_type = type_suffix(p, u.factors[0].name)?
      } else {
        ret_unit = Some(u)
      }
    }
  }
  Ok(Signature { params: params, ret: ret, ret_unit: ret_unit, ret_type: ret_type })
}

# qualify consumes `.Ident` segments after a base name and returns the dotted
# qualified name, e.g. base "cp" then ".Caps" gives "cp.Caps". It reads a
# module-qualified type name wherever a type annotation may appear.
fn qualify(p: Parser, base: Str) -> Res[Str, lex.SyntaxError] {
  let name: Str = base
  while check(p, ".") {
    next_tok(p)
    let seg: Str = expect_ident(p)?
    name = bytes.concat(name, bytes.concat(".", seg))
  }
  Ok(name)
}

# type_suffix continues a bare type name already read as `base`, consuming any
# `.name` qualification and `[...]` generic arguments, and returns the whole
# dotted/bracketed name, e.g. base "Arr" then "[I64]" gives "Arr[I64]".
fn type_suffix(p: Parser, base: Str) -> Res[Str, lex.SyntaxError] {
  let name: Str = qualify(p, base)?
  if check(p, "[") {
    let args: Str = parse_type_args(p)?
    name = bytes.concat(name, args)
  }
  Ok(name)
}

# parse_type_ref reads a full type reference: a name, an optional `.name`
# qualification, and optional `[...]` generic arguments, which nest.
fn parse_type_ref(p: Parser) -> Res[Str, lex.SyntaxError] {
  let name: Str = expect_ident(p)?
  type_suffix(p, name)
}

# at_fn_type reports whether a function type starts here, in either spelling:
# the `fn` keyword or the capitalised `Fn` that matches every other type name in
# the systems dialect.
fn at_fn_type(p: Parser) -> Bool {
  if check(p, "fn") { return true }
  let t: lex.Token = peek(p, 0)
  t.kind == lex.KIND_IDENT and bytes.equal(t.value, "Fn")
    and bytes.equal(peek(p, 1).value, "(")
}

# parse_type_expr parses one type in a type position: a function type, or a
# plain type reference (a name, a qualified name, or a generic). It is what a
# type argument or a struct field type is, wherever a `fn(...)` may appear
# alongside an ordinary name.
fn parse_type_expr(p: Parser) -> Res[Str, lex.SyntaxError] {
  if at_fn_type(p) { return parse_fn_type(p) }
  if check(p, "(") { return parse_tuple_type(p) }
  parse_type_ref(p)
}

# parse_tuple_type reads `(T, U, ...)` in type position and returns it as text,
# the way every other systems-mode type annotation is carried. The checker
# parses the text back into a type; the formatter prints it as written. It
# assumes the current token is `(`.
fn parse_tuple_type(p: Parser) -> Res[Str, lex.SyntaxError] {
  let open: lex.Token = next_tok(p)
  let parts: Arr[Str] = arr_new()
  while true {
    if check(p, ")") {
      return Err(err_at(peek(p, 0), one_element_tuple_msg()))
    }
    push(parts, parse_type_expr(p)?)
    if not accept(p, ",") { break }
  }
  expect(p, ")")?
  if len(parts) < 2 {
    return Err(err_at(open, one_element_tuple_msg()))
  }
  if len(parts) > max_tuple_arity() {
    return Err(err_at(open, tuple_arity_msg(len(parts))))
  }
  Ok(bytes.concat("(", bytes.concat(bytes.join(parts, ", "), ")")))
}

# parse_fn_type parses a function-type annotation `fn(T, ...) -> R`. Each
# argument and the result is itself a type, so function types nest: a
# higher-order callback is `fn(fn(F64) -> F64) -> F64`. Systems-mode type
# annotations are advisory, so this returns the type as its text form and the
# checker resolves that text. It assumes the current token is `fn` or `Fn`.
fn parse_fn_type(p: Parser) -> Res[Str, lex.SyntaxError] {
  next_tok(p)
  expect(p, "(")?
  let out: Str = "fn("
  if not check(p, ")") {
    let first: Bool = true
    while true {
      let t: Str = parse_type_expr(p)?
      if not first { out = bytes.concat(out, ", ") }
      out = bytes.concat(out, t)
      first = false
      if not accept(p, ",") { break }
    }
  }
  expect(p, ")")?
  out = bytes.concat(out, ")")
  if accept(p, "->") {
    let r: Str = parse_type_expr(p)?
    out = bytes.concat(out, bytes.concat(" -> ", r))
  }
  Ok(out)
}

# parse_type_args reads `[T, U, ...]` after a type name, each T a full type
# reference, and returns the bracketed text, e.g. "[Str, Arr[I64]]". It assumes
# the current token is "[".
fn parse_type_args(p: Parser) -> Res[Str, lex.SyntaxError] {
  next_tok(p)
  let out: Str = "["
  let first: Bool = true
  while true {
    let a: Str = parse_type_expr(p)?
    if not first {
      out = bytes.concat(out, ", ")
    }
    out = bytes.concat(out, a)
    first = false
    if not accept(p, ",") {
      break
    }
  }
  expect(p, "]")?
  Ok(bytes.concat(out, "]"))
}

fn parse_params(p: Parser) -> Res[Arr[ast.Param], lex.SyntaxError] {
  expect(p, "(")?
  let params: Arr[ast.Param] = arr_new()
  if not check(p, ")") {
    push(params, parse_param(p)?)
    while accept(p, ",") {
      if check(p, ")") {
        break
      }
      push(params, parse_param(p)?)
    }
  }
  expect(p, ")")?
  Ok(params)
}

fn parse_param(p: Parser) -> Res[ast.Param, lex.SyntaxError] {
  let name: Str = expect_ident(p)?
  let param: ast.Param = ast.plain_param(name)
  if accept(p, ":") {
    # `[` starts a shape; otherwise a unit expression, or a bare name that the
    # checker resolves as a record type or a unit. The parser cannot tell a type
    # from a unit here and does not try: it records the name and moves on.
    if check(p, "[") {
      param.shape = Some(parse_shape_anno(p)?)
    } else if at_fn_type(p) {
      # A function-typed parameter, e.g. `step: fn(Tree, Tensor) -> Tree`.
      param.type_name = parse_fn_type(p)?
    } else if check(p, "(") {
      param.type_name = parse_tuple_type(p)?
    } else {
      let u: ast.UnitAnno = parse_unit_expr(p)?
      if len(u.factors) == 1 and u.factors[0].exp == 1 {
        param.type_name = u.factors[0].name
        # A `.` or `[` makes it a qualified or generic type name (`cp.Caps`,
        # `Arr[I64]`): units are never qualified or bracketed, so the suffix is
        # unambiguously part of the type.
        if check(p, ".") or check(p, "[") {
          param.type_name = type_suffix(p, param.type_name)?
        }
      } else {
        param.unit = Some(u)
      }
    }
  }
  Ok(param)
}

# parse_unit_expr parses a scalar unit expression: `USD`, `USD/year`, `1/year`,
# `USD*share^-1`, `year^2`.
#
# There is no precedence here and there does not need to be: `*` and `/` both
# multiply a factor into the product, with `/` flipping the sign of its
# exponent, so `a/b*c` is a*c/b and the left-to-right reading is the only one.
fn parse_unit_expr(p: Parser) -> Res[ast.UnitAnno, lex.SyntaxError] {
  let anno: ast.UnitAnno = ast.UnitAnno { factors: arr_new() }
  parse_unit_factor(p, anno, 1)?
  while true {
    if accept(p, "*") {
      parse_unit_factor(p, anno, 1)?
      continue
    }
    if accept(p, "/") {
      parse_unit_factor(p, anno, -1)?
      continue
    }
    break
  }
  Ok(anno)
}

fn parse_unit_factor(p: Parser, anno: ast.UnitAnno, sign: I64) -> Res[Unit, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  # `1` is the dimensionless factor, so `1/year` has a name to divide into. Any
  # other number is a mistake rather than a scale factor: units carry no
  # magnitude in twill.
  if t.kind == lex.KIND_NUMBER {
    next_tok(p)
    if not bytes.equal(t.value, "1") {
      return Err(err_at(t, "a numeric unit factor must be 1 (dimensionless)"))
    }
    return Ok(unit)
  }
  if t.kind != lex.KIND_IDENT {
    return Err(err_at(t, "expected a unit name"))
  }
  next_tok(p)
  let exp: I64 = sign
  if accept(p, "^") {
    let neg: Bool = accept(p, "-")
    let nt: lex.Token = peek(p, 0)
    if nt.kind != lex.KIND_NUMBER {
      return Err(err_at(nt, "expected a unit exponent"))
    }
    next_tok(p)
    match i64_of_str(nt.value) {
      Some(k) => exp = sign * k,
      None => return Err(err_at(nt, "unit exponent must be an integer")),
    }
    if neg {
      exp = -exp
    }
  }
  push(anno.factors, ast.UnitFactor { name: t.value, exp: exp })
  Ok(unit)
}

# parse_shape_anno parses "[d0, d1, ...]" where each dim is an integer or a name.
# "[]" is a scalar, and that is not the same as no annotation at all: the caller
# wraps this in an Opt for exactly that reason.
fn parse_shape_anno(p: Parser) -> Res[ast.ShapeAnno, lex.SyntaxError] {
  expect(p, "[")?
  let dims: Arr[ast.Dim] = arr_new()
  if not check(p, "]") {
    push(dims, parse_dim(p)?)
    while accept(p, ",") {
      if check(p, "]") {
        break
      }
      push(dims, parse_dim(p)?)
    }
  }
  expect(p, "]")?
  Ok(ast.ShapeAnno { dims: dims })
}

fn parse_dim(p: Parser) -> Res[ast.Dim, lex.SyntaxError] {
  let t: lex.Token = peek(p, 0)
  if t.kind == lex.KIND_NUMBER {
    next_tok(p)
    match i64_of_str(t.value) {
      Some(n) => {
        if n < 0 {
          return Err(err_at(t, "shape dimension must be a non-negative integer"))
        }
        return Ok(ast.concrete_dim(n))
      },
      None => return Err(err_at(t, "shape dimension must be a non-negative integer")),
    }
  }
  if t.kind == lex.KIND_IDENT {
    next_tok(p)
    # "_" is an anonymous unknown dim; any other name is a shape variable, and
    # the checker makes two occurrences of the same name agree.
    if bytes.equal(t.value, "_") {
      return Ok(ast.anon_dim())
    }
    return Ok(ast.var_dim(t.value))
  }
  Err(err_at(t, "expected a dimension size or name"))
}

fn parse_args(p: Parser) -> Res[Arr[ast.Expr], lex.SyntaxError] {
  expect(p, "(")?
  let args: Arr[ast.Expr] = arr_new()
  if not check(p, ")") {
    push(args, parse_expr(p)?)
    while accept(p, ",") {
      if check(p, ")") {
        break
      }
      push(args, parse_expr(p)?)
    }
  }
  expect(p, ")")?
  Ok(args)
}
