# ---- automatic differentiation ---------------------------------------------
#
# grad(f) does not differentiate anything. It returns a builtin that remembers f
# and differentiates it when *that* is called, which is what makes
# `let g = grad(loss)` and then `g(w)` in a loop the natural spelling.

fn bi_derivative(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let f: Value = args[0]
  if in_words("grad grads", name) {
    refuse_nested_grad(name, f, line)?
  }
  if in_words("jvp vjp hvp", name) {
    refuse_derivative_of_grad(name, f, line)?
  }
  Ok(VBuiltin(BuiltinVal { name: bytes.concat(name, "(fn)"), captured: Some(f) }))
}

# refuse_nested_grad rejects grad(grad(f)) instead of answering it wrongly.
#
# The gradient grad returns is a value, not a traced expression: reverse mode
# reads the numbers out of the graph and hands them back with no history
# attached. Differentiating that again differentiates a constant, so the answer
# is zero, and it is zero silently, which is the worst way for a derivative to
# be wrong. Somebody building on a second derivative would have no reason to
# look.
#
# Second derivatives are hessian's job, which runs forward mode over the reverse
# pass and gets it right. This points there rather than quietly failing.
#
# The condition is narrow on purpose: only a builtin, and only one of the two
# named grad(fn) and grads(fn). value_and_grad(fn) is not refused, because it is
# not refused on the Go side either, and a closure that happens to call grad
# inside cannot be recognised from here at all.
fn refuse_nested_grad(caller: Str, f: Value, line: I64) -> Res[Unit, RuntimeError] {
  match f {
    VBuiltin(b) => {
      if not bytes.equal(b.name, "grad(fn)") and not bytes.equal(b.name, "grads(fn)") {
        return Ok(unit)
      }
      Err(runtime_error(line, bytes.concat(caller, bytes.concat("(", bytes.concat(b.name,
        bytes.concat(") is not a second derivative: the gradient ", bytes.concat(b.name,
        bytes.concat(" returns is a plain value with no history, so differentiating it again ",
        bytes.concat("gives zero. Use hessian(f) for a second derivative, or jacobian(f) for ",
        "the matrix of first ones")))))))))
    },
    _ => Ok(unit),
  }
}

fn bi_derived(b: BuiltinVal, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let f: Value = VUnit
  match b.captured {
    Some(v) => f = v,
    # Unreachable: the only place a "...(fn)" builtin is made is bi_derivative,
    # which always captures. Named rather than assumed, because a silent VUnit
    # here would be differentiated as a constant and report zeros.
    None => return Err(runtime_error(line, bytes.concat(b.name, " lost the function it wrapped"))),
  }
  if bytes.equal(b.name, "grad(fn)") {
    let g: Grads = gradients(f, args, line)?
    return Ok(g.first)
  }
  if bytes.equal(b.name, "grads(fn)") {
    let g: Grads = gradients(f, args, line)?
    return Ok(VList(ListVal { items: g.all }))
  }
  if bytes.equal(b.name, "value_and_grad(fn)") {
    let g: Grads = gradients(f, args, line)?
    let pair: Arr[Value] = arr_new()
    push(pair, VTensor(g.value))
    push(pair, g.first)
    return Ok(VList(ListVal { items: pair }))
  }
  # The count is already enforced by the arity check in `apply`, which knows
  # these two take one argument. The check is kept because the Go original keeps
  # it and its message differs from the arity one, so a change to the arity
  # table shows up here rather than silently.
  if bytes.equal(b.name, "jvp(fn)") {
    if len(args) != 2 {
      return Err(runtime_error(line, "jvp(f) takes exactly two arguments, the input and the tangent"))
    }
    return do_jvp(f, args[0], args[1], line)
  }
  if bytes.equal(b.name, "vjp(fn)") {
    if len(args) != 2 {
      return Err(runtime_error(line, "vjp(f) takes exactly two arguments, the input and the cotangent"))
    }
    return do_vjp(f, args[0], args[1], line)
  }
  if bytes.equal(b.name, "hvp(fn)") {
    if len(args) != 2 {
      return Err(runtime_error(line, "hvp(f) takes exactly two arguments, the input and the direction"))
    }
    return do_hvp(f, args[0], args[1], line)
  }
  if bytes.equal(b.name, "jacobian(fn)") {
    if len(args) != 1 {
      return Err(runtime_error(line, "jacobian(f) takes exactly one argument"))
    }
    return do_jacobian(f, args[0], line)
  }
  if len(args) != 1 {
    return Err(runtime_error(line, "hessian(f) takes exactly one argument"))
  }
  do_hessian(f, args[0], line)
}

# The tape seam, from grad's side. The seam itself is the section above:
# tape_push, tape_pop and tape_node_of are written, and the arithmetic in the
# builtins is routed through the tr_ shims, so an op that runs while f is being
# differentiated records and the same op outside a grad does not.
#
# What is decided here rather than there is the leaf order, the tree shape of
# the result, the seeding, and the arity and error handling, because those are
# what the corpus checks.

# A traced argument: the value handed to f, and the tree of leaf node indices to
# read the gradients back out of afterwards. The tree has the same shape as the
# argument, and that is the point, so `grads(loss)({w: ..., b: ...})` gives a
# record of gradients with the same fields rather than a flat list the caller
# has to re-associate.
enum GradNode {
  GLeaf(I64),
  GList(Arr[GradNode]),
  GRecord(Dict[Str, GradNode]),
  GNone,
}

struct Traced {
  passed: Value,
  node: GradNode,
}

fn trace_arg(tp: tensor.Tape, v: Value) -> Traced {
  match v {
    # grad(f)(3.0) passes a plain number, and without this it would fall to the
    # default below and report a gradient of zero for it.
    VNum(x) => {
      let n: I64 = tensor.leaf(tp, tensor.scalar(x))
      Traced { passed: VTensor(tensor.value_of(tp, n)), node: GLeaf(n) }
    },
    VTensor(t) => {
      let n: I64 = tensor.leaf(tp, t)
      Traced { passed: VTensor(tensor.value_of(tp, n)), node: GLeaf(n) }
    },
    VList(l) => {
      let passed: Arr[Value] = arr_new()
      let nodes: Arr[GradNode] = arr_new()
      let i: I64 = 0
      while i < len(l.items) {
        let tr: Traced = trace_arg(tp, l.items[i])
        push(passed, tr.passed)
        push(nodes, tr.node)
        i = i + 1
      }
      Traced { passed: VList(ListVal { items: passed }), node: GList(nodes) }
    },
    VRecord(r) => {
      let fields: Dict[Str, Value] = dict_new()
      let nodes: Dict[Str, GradNode] = dict_new()
      for k in dict_keys(r.fields) {
        let tr: Traced = trace_arg(tp, dict_must(r.fields, k))
        dict_set(fields, k, tr.passed)
        dict_set(nodes, k, tr.node)
      }
      Traced { passed: VRecord(plain_record(fields)), node: GRecord(nodes) }
    },
    # A string, a function, a unit: it has no derivative, and the gradient
    # reported for it is a scalar zero rather than an error, so that passing a
    # configuration record alongside the parameters still works.
    _ => Traced { passed: v, node: GNone },
  }
}

# grads is the backward pass's output indexed by leaf node, in the order the
# leaves were created, which is the order trace_arg walked the arguments.
fn grad_from_node(n: GradNode, grads: Arr[tensor.Tensor], shapes: Arr[tensor.Tensor]) -> Value {
  match n {
    GLeaf(idx) => {
      # A leaf the output never depended on gets zeros of its own shape, not an
      # error and not a scalar. An optimiser folding over a parameter tree would
      # otherwise trip on the one parameter a branch of the model did not use.
      if idx >= len(grads) {
        return VTensor(tensor.zeros_like(shapes[idx]))
      }
      VTensor(grads[idx])
    },
    GList(nodes) => {
      let items: Arr[Value] = arr_new()
      let i: I64 = 0
      while i < len(nodes) {
        push(items, grad_from_node(nodes[i], grads, shapes))
        i = i + 1
      }
      VList(ListVal { items: items })
    },
    GRecord(nodes) => {
      let fields: Dict[Str, Value] = dict_new()
      for k in dict_keys(nodes) {
        dict_set(fields, k, grad_from_node(dict_must(nodes, k), grads, shapes))
      }
      VRecord(plain_record(fields))
    },
    GNone => VTensor(tensor.scalar(0.0)),
  }
}

struct Grads {
  value: tensor.Tensor,
  first: Value,
  all: Arr[Value],
}

# gradients runs f with gradient-tracking arguments and returns the scalar
# value, the gradient of the first argument, and the gradients of all of them.
fn gradients(f: Value, call_args: Arr[Value], line: I64) -> Res[Grads, RuntimeError] {
  if len(call_args) == 0 {
    return Err(runtime_error(line, "gradient function requires at least one argument"))
  }
  let tp: tensor.Tape = tensor.new_tape()
  let pass_args: Arr[Value] = arr_new()
  let nodes: Arr[GradNode] = arr_new()
  let leaves: Arr[tensor.Tensor] = arr_new()
  let i: I64 = 0
  while i < len(call_args) {
    let tr: Traced = trace_arg(tp, call_args[i])
    push(pass_args, tr.passed)
    push(nodes, tr.node)
    i = i + 1
  }

  let ran: TracedRun = run_traced(f, pass_args, tp, line)?
  let ot: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(ran.value) {
    Some(t) => {
      if not tensor.is_scalar(t) {
        return Err(runtime_error(line, "grad target must return a scalar"))
      }
      ot = t
    },
    None => return Err(runtime_error(line, "grad target must return a scalar")),
  }
  # The seed is 1 for a scalar output: d(out)/d(out). Every other cotangent on
  # the tape is derived from it, so a seed of the wrong shape is the one mistake
  # that makes every gradient wrong by the same factor and looks like a learning
  # rate problem.
  let all_grads: Arr[tensor.Tensor] = arr_new()
  match tensor.backward(tp, ran.node, tensor.scalar(1.0)) {
    Ok(g) => all_grads = g,
    Err(m) => return Err(runtime_error(line, m)),
  }

  let all: Arr[Value] = arr_new()
  i = 0
  while i < len(nodes) {
    push(all, grad_from_node(nodes[i], all_grads, tape_leaf_values(tp)))
    i = i + 1
  }
  Ok(Grads {
    value: tensor.scalar(tensor.at(ot, 0)),
    first: grad_from_node(nodes[0], all_grads, tape_leaf_values(tp)),
    all: all,
  })
}

struct TracedRun {
  value: Value,
  node: I64,
}

# Run f with tp recording, and recover the node its result came from.
#
# The pop happens before the result is inspected rather than after, because
# there is no `defer` here and an early return through `?` would otherwise leave
# a finished tape installed for the rest of the program. That is also why the
# node lookup below names tp explicitly instead of going through tape_node_of:
# by then the tape is no longer installed, and an outer grad's tape would be,
# so the convenient form would answer about the wrong tape.
fn run_traced(f: Value, args: Arr[Value], tp: tensor.Tape, line: I64) -> Res[TracedRun, RuntimeError] {
  if GRAD_DEPTH[0] > 0 {
    return Err(runtime_error(line, bytes.concat("a gradient taken inside a gradient is not a ",
      bytes.concat("second derivative: the value the inner grad returns has no history, so ",
      bytes.concat("differentiating it again gives zero. Use hessian(f) for a second derivative, ",
      "or jacobian(f) for the matrix of first ones")))))
  }
  GRAD_DEPTH[0] = GRAD_DEPTH[0] + 1
  tape_push(tp)
  # Line 0, and it is deliberate: the call comes from inside grad, not from a
  # source position, and reporting the grad site would point at the wrong line
  # when the failure is inside f. The Go side passes 0 here for the same reason.
  let out: Res[Value, RuntimeError] = apply(f, args, 0)
  tape_pop()
  GRAD_DEPTH[0] = GRAD_DEPTH[0] - 1
  let v: Value = out?
  match tape_node_in(tp, v) {
    Some(n) => Ok(TracedRun { value: v, node: n }),
    # f ignored its arguments and returned a constant. The derivative of a
    # constant is zero, and that is an answer rather than an error, so an empty
    # tape root is legal and backward from it yields zeros.
    None => Ok(TracedRun { value: v, node: -1 }),
  }
}

# The leaf tensors in creation order, used only for their shapes when a leaf
# received no gradient at all.
fn tape_leaf_values(tp: tensor.Tape) -> Arr[tensor.Tensor] = tp.leaves

# jacobian(f)(x): the full matrix of partials of a vector output f(x) with
# respect to the vector input x, by one reverse-mode pass per output element.
# Row j is the gradient of the j-th output. The result is [m, n] for an
# m-vector output and an n-element input.
fn do_jacobian(f: Value, x: Value, line: I64) -> Res[Value, RuntimeError] {
  let xt: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(x) {
    Some(t) => xt = t,
    None => return Err(runtime_error(line, "jacobian: the input must be a tensor")),
  }
  let n: I64 = tensor.numel(xt)
  # A gradient-free pass to learn the output size. It costs one extra evaluation
  # and buys not having to guess m from the input.
  let y0: tensor.Tensor = apply_to_tensor(f, tensor.clone(xt), line)?
  let m: I64 = tensor.numel(y0)
  let jac: Arr[F64] = arr_new()
  let z: I64 = 0
  while z < m * n {
    push(jac, 0.0)
    z = z + 1
  }
  let j: I64 = 0
  # The output dtype is the same every pass; capture it so the result's dtype is
  # available after the loop, where `y` (bound per iteration) is out of scope.
  let out_dtype: I64 = xt.dtype
  while j < m {
    # A fresh tape and a fresh leaf each pass: gradients accumulate, so reusing
    # one would sum every row into every other.
    let tp: tensor.Tape = tensor.new_tape()
    let leaf: I64 = tensor.leaf(tp, xt)
    let args: Arr[Value] = arr_new()
    push(args, VTensor(tensor.value_of(tp, leaf)))
    let ran: TracedRun = run_traced(f, args, tp, line)?
    let y: tensor.Tensor = tensor.scalar(0.0)
    match as_tensor(ran.value) {
      Some(t) => y = t,
      None => return Err(runtime_error(line, bytes.concat("jacobian: f must return a tensor, got ",
        format_value(ran.value)))),
    }
    if tensor.numel(y) != m {
      return Err(runtime_error(line, "jacobian: f returned a different output size on re-evaluation"))
    }
    out_dtype = y.dtype
    # Isolate the j-th output by seeding the backward pass with a one-hot rather
    # than by indexing the output: indexing would need a gradient rule of its
    # own, and the seed is where the choice of output belongs anyway.
    let sel: Arr[F64] = arr_new()
    let k: I64 = 0
    while k < m {
      if k == j { push(sel, 1.0) } else { push(sel, 0.0) }
      k = k + 1
    }
    let seed: tensor.Tensor = tensor.mk_raw(tensor.copy_shape(y.shape), sel, y.dtype)
    match tensor.backward(tp, ran.node, seed) {
      Ok(g) => {
        if leaf < len(g) {
          k = 0
          while k < n {
            jac[j * n + k] = tensor.at(g[leaf], k)
            k = k + 1
          }
        }
      },
      Err(msg) => return Err(runtime_error(line, msg)),
    }
    j = j + 1
  }
  let shape: Arr[I64] = arr_new()
  push(shape, m)
  push(shape, n)
  # A jacobian is a derivative and takes the gradient dtype.
  Ok(VTensor(tensor.mk(shape, jac, tensor.grad_dtype(out_dtype))))
}

# hessian(f)(x): the matrix of second partial derivatives of a scalar f at x, by
# forward-mode 2-jets over the graph built from a single input leaf. Exact
# second-order autodiff, not a finite difference of gradients, which is the
# whole reason grad(grad(f)) is refused rather than approximated.
fn do_hessian(f: Value, x: Value, line: I64) -> Res[Value, RuntimeError] {
  let xt: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(x) {
    Some(t) => xt = t,
    None => return Err(runtime_error(line, "hessian: the input must be a tensor")),
  }
  let tp: tensor.Tape = tensor.new_tape()
  let leaf: I64 = tensor.leaf(tp, xt)
  # Record forward-mode (jet) closures only while building this graph, so
  # ordinary training and grad pay nothing for second-order support. Off before
  # the result is unwrapped, for the same reason run_traced pops before it does.
  tensor.set_record_jets(true)
  let args: Arr[Value] = arr_new()
  push(args, VTensor(tensor.value_of(tp, leaf)))
  let built: Res[TracedRun, RuntimeError] = run_traced(f, args, tp, line)
  tensor.set_record_jets(false)
  let ran: TracedRun = built?
  lift_v(tensor.hessian(tp, ran.node, leaf), line)
}

# apply_to_tensor calls a one-argument function with nothing recording and
# requires a tensor result. The message says "jacobian" even when hessian is the
# caller, which is how the Go side reads; changing it here would diverge on a
# message the harness compares byte for byte.
fn apply_to_tensor(f: Value, arg: tensor.Tensor, line: I64) -> Res[tensor.Tensor, RuntimeError] {
  let args: Arr[Value] = arr_new()
  push(args, VTensor(arg))
  let out: Value = apply(f, args, 0)?
  match as_tensor(out) {
    Some(t) => Ok(t),
    None => Err(runtime_error(line, bytes.concat("jacobian: f must return a tensor, got ",
      format_value(out)))),
  }
}


# ---- jvp, vjp and hvp -------------------------------------------------------
#
# The two primitives grad, jacobian and hessian are made of: one forward-mode
# pass and one reverse-mode pass, each named and each callable. The bootstrap's
# internal/interp/builtins.go carries the same three, with the same contracts and
# the same messages, and says at length there why vjp takes the cotangent as an
# argument instead of returning a pullback closure the way JAX does. The short
# version is decision 2: the tape is the tensor graph, so there is no recorded
# program for a retained pullback to replay.

# The leaf node indices of a traced argument, in creation order, which is the
# order trace_arg walked the argument and therefore the order the tangents below
# are flattened into.
fn collect_leaves(n: GradNode, out: Arr[I64]) {
  match n {
    GLeaf(idx) => push(out, idx),
    GList(nodes) => {
      let i: I64 = 0
      while i < len(nodes) {
        collect_leaves(nodes[i], out)
        i = i + 1
      }
    },
    GRecord(nodes) => {
      for k in dict_keys(nodes) {
        collect_leaves(dict_must(nodes, k), out)
      }
    },
    GNone => unit,
  }
}

# A shape as an error message renders it: "[2, 3]", or "scalar" for rank zero.
fn shape_text(shape: Arr[I64]) -> Str {
  if len(shape) == 0 { return "scalar" }
  let out: Str = "["
  let i: I64 = 0
  while i < len(shape) {
    if i > 0 { out = bytes.concat(out, ", ") }
    out = bytes.concat(out, num_to_text(shape[i]))
    i = i + 1
  }
  bytes.concat(out, "]")
}

fn same_shape(a: Arr[I64], b: Arr[I64]) -> Bool {
  if len(a) != len(b) { return false }
  let i: I64 = 0
  while i < len(a) {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}

# A position inside a parameter tree, rendered for an error message, and
# rendered as nothing at all for the root so a plain tensor input is not told its
# tangent is wrong "at the input".
fn at_path(path: Str) -> Str {
  if bytes.equal(path, "") { return "" }
  bytes.concat(" at ", path)
}

fn tensor_elems(t: tensor.Tensor) -> Arr[F64] {
  let out: Arr[F64] = arr_new()
  let i: I64 = 0
  let n: I64 = tensor.numel(t)
  while i < n {
    push(out, tensor.at(t, i))
    i = i + 1
  }
  out
}

# tangents_for flattens a tangent value onto the gradient leaves of a traced
# argument, in the same order collect_leaves produces them. The tangent has to
# have the input's structure -- same list lengths, same record fields, same
# shapes -- because a tangent is a point in the input's tangent space and there
# is nowhere else for a mismatched one to belong.
fn tangents_for(op: Str, n: GradNode, v: Value, path: Str, tp: tensor.Tape,
                out: Arr[Arr[F64]], line: I64) -> Res[Unit, RuntimeError] {
  match n {
    GLeaf(idx) => {
      match as_tensor(v) {
        Some(t) => {
          let leaf: tensor.Tensor = tensor.value_of(tp, idx)
          if not same_shape(t.shape, leaf.shape) {
            return Err(runtime_error(line, bytes.concat(op,
              bytes.concat(": the tangent", bytes.concat(at_path(path),
              bytes.concat(" has shape ", bytes.concat(shape_text(t.shape),
              bytes.concat(" but the input has shape ", shape_text(leaf.shape)))))))))
          }
          push(out, tensor_elems(t))
          Ok(unit)
        },
        None => Err(runtime_error(line, bytes.concat(op,
          bytes.concat(": the tangent", bytes.concat(at_path(path),
          bytes.concat(" must be a tensor or a number, got ", format_value(v))))))),
      }
    },
    GList(nodes) => {
      match v {
        VList(l) => {
          if len(l.items) != len(nodes) {
            return Err(runtime_error(line, bytes.concat(op,
              bytes.concat(": the input", bytes.concat(at_path(path),
              bytes.concat(" is a list of ", bytes.concat(num_to_text(len(nodes)),
              bytes.concat(" but the tangent is a list of ", num_to_text(len(l.items))))))))))
          }
          let i: I64 = 0
          while i < len(nodes) {
            let sub: Str = bytes.concat(path,
              bytes.concat("[", bytes.concat(num_to_text(i), "]")))
            tangents_for(op, nodes[i], l.items[i], sub, tp, out, line)?
            i = i + 1
          }
          Ok(unit)
        },
        _ => Err(runtime_error(line, bytes.concat(op,
          bytes.concat(": the input", bytes.concat(at_path(path),
          bytes.concat(" is a list of ", bytes.concat(num_to_text(len(nodes)),
          bytes.concat(", so the tangent must be a list too, got ", format_value(v))))))))),
      }
    },
    GRecord(nodes) => {
      match v {
        VRecord(r) => {
          if len(dict_keys(r.fields)) != len(dict_keys(nodes)) {
            return Err(runtime_error(line, bytes.concat(op,
              bytes.concat(": the tangent", bytes.concat(at_path(path),
              bytes.concat(" has ", bytes.concat(num_to_text(len(dict_keys(r.fields))),
              bytes.concat(" fields but the input has ", num_to_text(len(dict_keys(nodes)))))))))))
          }
          for k in dict_keys(nodes) {
            if not dict_has(r.fields, k) {
              return Err(runtime_error(line, bytes.concat(op,
                bytes.concat(": the tangent", bytes.concat(at_path(path),
                bytes.concat(" has no field ", bytes.concat(k, ", which the input has")))))))
            }
            tangents_for(op, dict_must(nodes, k), dict_must(r.fields, k),
              bytes.concat(path, bytes.concat(".", k)), tp, out, line)?
          }
          Ok(unit)
        },
        _ => Err(runtime_error(line, bytes.concat(op,
          bytes.concat(": the input", bytes.concat(at_path(path),
          bytes.concat(" is a record, so the tangent must be a record too, got ",
          format_value(v))))))),
      }
    },
    # A non-differentiable argument -- a string, a function -- carries no tangent.
    GNone => Ok(unit),
  }
}

# refuse_derivative_of_grad rejects jvp/vjp/hvp applied to grad(f), which is the
# same silent zero refuse_nested_grad refuses: the value grad returns has no
# history, so a forward pass over it carries no tangent and a reverse pass over
# it finds no graph. value_and_grad(fn) is refused here as well, and is not
# refused by refuse_nested_grad, because it is the first element of its pair that
# has history and the second that does not, so differentiating the pair is wrong
# either way round.
fn refuse_derivative_of_grad(caller: Str, f: Value, line: I64) -> Res[Unit, RuntimeError] {
  match f {
    VBuiltin(b) => {
      if not in_words("grad(fn) grads(fn) value_and_grad(fn)", b.name) {
        return Ok(unit)
      }
      let hint: Str = "use hessian(f) or hvp(f) for a second derivative"
      if bytes.equal(caller, "hvp") {
        hint = "hvp(f) is already the second derivative in a direction, so pass f itself"
      }
      Err(runtime_error(line, bytes.concat(caller, bytes.concat("(", bytes.concat(b.name,
        bytes.concat(") is not a second derivative: the value ", bytes.concat(b.name,
        bytes.concat(" returns is a plain value with no history, so differentiating it again ",
        bytes.concat("gives zero; ", hint)))))))))
    },
    _ => Ok(unit),
  }
}

# jvp(f)(x, v): the value of f at x and the directional derivative of f along the
# tangent v, in ONE forward-mode pass. The tangent has the structure of x, the
# result has the shape of f(x), and the cost is one evaluation of f.
fn do_jvp(f: Value, x: Value, v: Value, line: I64) -> Res[Value, RuntimeError] {
  let tp: tensor.Tape = tensor.new_tape()
  let tr: Traced = trace_arg(tp, x)
  let leaves: Arr[I64] = arr_new()
  collect_leaves(tr.node, leaves)
  let tangents: Arr[Arr[F64]] = arr_new()
  # Before f runs, so a mismatched tangent is reported without the side effects
  # of an evaluation that was never going to be used.
  tangents_for("jvp", tr.node, v, "", tp, tangents, line)?

  let args: Arr[Value] = arr_new()
  push(args, tr.passed)
  # Record forward-mode (jet) closures only while building this graph, so
  # ordinary evaluation and grad pay nothing for forward-mode support.
  tensor.set_record_jets(true)
  let built: Res[TracedRun, RuntimeError] = run_traced(f, args, tp, line)
  tensor.set_record_jets(false)
  let ran: TracedRun = built?
  let ot: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(ran.value) {
    Some(t) => ot = t,
    None => return Err(runtime_error(line, bytes.concat("jvp: f must return a tensor, got ",
      format_value(ran.value)))),
  }
  # A root of -1 is f ignoring its argument. Its directional derivative is zero,
  # which is the answer grad already gives for the same expression.
  let tangent: tensor.Tensor = tensor.zeros_like(ot)
  if ran.node >= 0 {
    match tensor.jet_forward_multi(tp, ran.node, leaves, tangents) {
      Ok(js) => {
        let d: Arr[F64] = arr_new()
        let i: I64 = 0
        while i < tensor.numel(ot) {
          push(d, js.d[ran.node][i])
          i = i + 1
        }
        tangent = tensor.mk_raw(tensor.copy_shape(ot.shape), d, tensor.grad_dtype(ot.dtype))
      },
      Err(m) => return Err(runtime_error(line,
        "jvp: the function uses an operation without forward-mode support")),
    }
  }
  let pair: Arr[Value] = arr_new()
  push(pair, VTensor(ot))
  push(pair, VTensor(tangent))
  Ok(VList(ListVal { items: pair }))
}

# vjp(f)(x, v): the value of f at x and the vector-Jacobian product with the
# cotangent v, in ONE reverse-mode pass. The cotangent has the shape of f(x), the
# result has the structure of x, and the cost is one evaluation of f plus one
# backward sweep -- exactly grad's cost, because grad is this with v = 1 on a
# scalar output.
fn do_vjp(f: Value, x: Value, v: Value, line: I64) -> Res[Value, RuntimeError] {
  let tp: tensor.Tape = tensor.new_tape()
  let tr: Traced = trace_arg(tp, x)
  let args: Arr[Value] = arr_new()
  push(args, tr.passed)
  let ran: TracedRun = run_traced(f, args, tp, line)?
  let ot: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(ran.value) {
    Some(t) => ot = t,
    None => return Err(runtime_error(line, bytes.concat("vjp: f must return a tensor, got ",
      format_value(ran.value)))),
  }
  let vt: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(v) {
    Some(t) => vt = t,
    None => return Err(runtime_error(line, bytes.concat("vjp: the cotangent must be a tensor or a number, got ",
      format_value(v)))),
  }
  if not same_shape(vt.shape, ot.shape) {
    return Err(runtime_error(line, bytes.concat("vjp: the cotangent has shape ",
      bytes.concat(shape_text(vt.shape), bytes.concat(" but f returned shape ",
        shape_text(ot.shape))))))
  }
  # The cotangent IS the seed of the backward pass. grad seeds a scalar 1 here;
  # every other cotangent on the tape is derived from whatever this is, which is
  # the whole of what "vector-Jacobian product" means.
  let seed: tensor.Tensor = tensor.mk_raw(tensor.copy_shape(ot.shape), tensor_elems(vt), ot.dtype)
  let all_grads: Arr[tensor.Tensor] = arr_new()
  match tensor.backward(tp, ran.node, seed) {
    Ok(g) => all_grads = g,
    Err(m) => return Err(runtime_error(line, m)),
  }
  let pair: Arr[Value] = arr_new()
  push(pair, VTensor(ot))
  push(pair, grad_from_node(tr.node, all_grads, tape_leaf_values(tp)))
  Ok(VList(ListVal { items: pair }))
}

# hvp(f)(x, v): the Hessian of a scalar f at x times the direction v, without
# ever forming the n by n matrix. tensor.hessian_vector states the cost, which is
# 2n+1 forward passes rather than the single forward-over-reverse pass JAX
# charges, and why decision 2 leaves no cheaper exact route.
fn do_hvp(f: Value, x: Value, v: Value, line: I64) -> Res[Value, RuntimeError] {
  let xt: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(x) {
    Some(t) => xt = t,
    None => return Err(runtime_error(line, "hvp: the input must be a tensor")),
  }
  let vt: tensor.Tensor = tensor.scalar(0.0)
  match as_tensor(v) {
    Some(t) => vt = t,
    None => return Err(runtime_error(line, bytes.concat("hvp: the direction must be a tensor or a number, got ",
      format_value(v)))),
  }
  if not same_shape(vt.shape, xt.shape) {
    return Err(runtime_error(line, bytes.concat("hvp: the direction has shape ",
      bytes.concat(shape_text(vt.shape), bytes.concat(" but the input has shape ",
        shape_text(xt.shape))))))
  }
  let tp: tensor.Tape = tensor.new_tape()
  let leaf: I64 = tensor.leaf(tp, xt)
  let args: Arr[Value] = arr_new()
  push(args, VTensor(tensor.value_of(tp, leaf)))
  tensor.set_record_jets(true)
  let built: Res[TracedRun, RuntimeError] = run_traced(f, args, tp, line)
  tensor.set_record_jets(false)
  let ran: TracedRun = built?
  match tensor.hessian_vector(tp, ran.node, leaf, tensor_elems(vt)) {
    Ok(t) => Ok(VTensor(t)),
    # The forward-mode refusal comes back worded for hessian, whose caller it was
    # written for. hvp names itself instead, because an error that names the
    # wrong operation sends the reader to the wrong page.
    Err(m) => Err(runtime_error(line, rename_for_hvp(m))),
  }
}

# The forward-mode refusal comes back worded for hessian, whose caller it was
# written for. hvp names itself instead, because an error naming the wrong
# operation sends the reader to the wrong page. hessian_vector's own messages
# already say hvp and pass straight through.
fn rename_for_hvp(m: Str) -> Str {
  let prefix: Str = "second-order autodiff: "
  if bytes.index_of(m, prefix) == 0 {
    return bytes.concat("hvp: ", slice(m, len(prefix), len(m)))
  }
  m
}

# ---- higher-order list and tree helpers ------------------------------------

fn bi_tree(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "map") {
    let items: Arr[Value] = to_items(args[1], "map", line)?
    let out: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < len(items) {
      let one: Arr[Value] = arr_new()
      push(one, items[i])
      push(out, apply(args[0], one, 0)?)
      i = i + 1
    }
    return Ok(VList(ListVal { items: out }))
  }
  if bytes.equal(name, "zip") {
    return bi_zip(args, line)
  }
  # fold(f, init, xs): left fold, acc = f(acc, x) over xs.
  if bytes.equal(name, "fold") {
    let acc: Value = args[1]
    let items: Arr[Value] = to_items(args[2], "fold", line)?
    let i: I64 = 0
    while i < len(items) {
      let pair: Arr[Value] = arr_new()
      push(pair, acc)
      push(pair, items[i])
      acc = apply(args[0], pair, 0)?
      i = i + 1
    }
    return Ok(acc)
  }
  # append is a copy plus one, not a mutation. A list value that changed under
  # an alias would make every fold over lists depend on how many names the
  # accumulator had.
  if bytes.equal(name, "append") {
    let items: Arr[Value] = to_items(args[0], "append", line)?
    let out: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < len(items) {
      push(out, items[i])
      i = i + 1
    }
    push(out, args[1])
    return Ok(VList(ListVal { items: out }))
  }
  if bytes.equal(name, "enumerate") {
    let items: Arr[Value] = to_items(args[0], "enumerate", line)?
    let out: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < len(items) {
      let pair: Arr[Value] = arr_new()
      push(pair, VTensor(tensor.scalar(f64_of_i64(i))))
      push(pair, items[i])
      push(out, VList(ListVal { items: pair }))
      i = i + 1
    }
    return Ok(VList(ListVal { items: out }))
  }
  # map_leaves(f, tree): apply f to every tensor leaf of a tree (a tensor, or a
  # list/record nesting tensors), preserving the structure.
  if bytes.equal(name, "map_leaves") {
    return map_leaves(args[0], args[1])
  }
  # zip_leaves(f, trees): given a list of same-shaped trees, call f with the
  # list of leaves at each position, preserving the structure.
  match args[1] {
    VList(l) => zip_leaves(args[0], l.items),
    _ => Err(runtime_error(line, "zip_leaves expects a list of trees as its second argument")),
  }
}

# zip stops at the shortest input rather than padding, so `zip(xs, ys)` over a
# batch and its labels cannot silently pair a value with nothing.
fn bi_zip(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) == 0 {
    return Ok(VList(ListVal { items: arr_new() }))
  }
  let cols: Arr[Arr[Value]] = arr_new()
  let min_len: I64 = -1
  let i: I64 = 0
  while i < len(args) {
    let items: Arr[Value] = to_items(args[i], "zip", line)?
    push(cols, items)
    if min_len < 0 or len(items) < min_len { min_len = len(items) }
    i = i + 1
  }
  let out: Arr[Value] = arr_new()
  let r: I64 = 0
  while r < min_len {
    let row: Arr[Value] = arr_new()
    let c: I64 = 0
    while c < len(args) {
      push(row, cols[c][r])
      c = c + 1
    }
    push(out, VList(ListVal { items: row }))
    r = r + 1
  }
  Ok(VList(ListVal { items: out }))
}

fn map_leaves(f: Value, tree: Value) -> Res[Value, RuntimeError] {
  match tree {
    # A number is a numeric leaf like any other. Letting it fall to the
    # pass-through default would silently skip a scalar bias in an optimiser's
    # parameter tree.
    VNum(_) => apply_one(f, tree),
    VTensor(_) => apply_one(f, tree),
    VList(l) => {
      let out: Arr[Value] = arr_new()
      let i: I64 = 0
      while i < len(l.items) {
        push(out, map_leaves(f, l.items[i])?)
        i = i + 1
      }
      Ok(VList(ListVal { items: out }))
    },
    VRecord(r) => {
      let fields: Dict[Str, Value] = dict_new()
      for k in dict_keys(r.fields) {
        dict_set(fields, k, map_leaves(f, dict_must(r.fields, k))?)
      }
      Ok(VRecord(plain_record(fields)))
    },
    # Non-tensor leaves pass through unchanged.
    _ => Ok(tree),
  }
}

fn apply_one(f: Value, v: Value) -> Res[Value, RuntimeError] {
  let one: Arr[Value] = arr_new()
  push(one, v)
  apply(f, one, 0)
}

# zip_leaves walks a list of same-shaped trees in parallel, calling f with the
# list of leaves at each position.
#
# Its structure mismatches report at line 0, because the Go side raises them
# through panicf(0, ...) from inside the recursion, where no source position is
# in hand. Carried across rather than improved: the harness compares the text.
fn zip_leaves(f: Value, trees: Arr[Value]) -> Res[Value, RuntimeError] {
  if len(trees) == 0 {
    return Err(runtime_error(0, "zip_leaves needs at least one tree"))
  }
  match trees[0] {
    VNum(_) => zip_leaf_call(f, trees),
    VTensor(_) => zip_leaf_call(f, trees),
    VList(first) => {
      let out: Arr[Value] = arr_new()
      let i: I64 = 0
      while i < len(first.items) {
        let sub: Arr[Value] = arr_new()
        let k: I64 = 0
        while k < len(trees) {
          match trees[k] {
            VList(lst) => {
              if i >= len(lst.items) {
                return Err(runtime_error(0, "zip_leaves: trees have different structures"))
              }
              push(sub, lst.items[i])
            },
            _ => return Err(runtime_error(0, "zip_leaves: trees have different structures")),
          }
          k = k + 1
        }
        push(out, zip_leaves(f, sub)?)
        i = i + 1
      }
      Ok(VList(ListVal { items: out }))
    },
    VRecord(first) => {
      let fields: Dict[Str, Value] = dict_new()
      for key in dict_keys(first.fields) {
        let sub: Arr[Value] = arr_new()
        let k: I64 = 0
        while k < len(trees) {
          match trees[k] {
            VRecord(r) => {
              match dict_get(r.fields, key) {
                Some(v) => push(sub, v),
                None => return Err(runtime_error(0, "zip_leaves: record trees have different fields")),
              }
            },
            _ => return Err(runtime_error(0, "zip_leaves: trees have different structures")),
          }
          k = k + 1
        }
        dict_set(fields, key, zip_leaves(f, sub)?)
      }
      Ok(VRecord(plain_record(fields)))
    },
    _ => Ok(trees[0]),
  }
}

fn zip_leaf_call(f: Value, trees: Arr[Value]) -> Res[Value, RuntimeError] {
  let leaves: Arr[Value] = arr_new()
  let i: I64 = 0
  while i < len(trees) {
    match as_tensor(trees[i]) {
      Some(_) => push(leaves, trees[i]),
      None => return Err(runtime_error(0, "zip_leaves: trees have different structures")),
    }
    i = i + 1
  }
  let one: Arr[Value] = arr_new()
  push(one, VList(ListVal { items: leaves }))
  apply(f, one, 0)
}

# ---- tensor construction ---------------------------------------------------

# dt is the dtype code of a trailing dtype-name argument, already resolved and
# stripped from args by eval_call, or -1 when the call named none. The default
# stays f64, docs/dtypes.md "The default for a literal is f64": narrow dtypes
# are asked for, never inferred.
fn bi_make(name: Str, args: Arr[Value], dt: I64, line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "tensor") {
    match args[0] {
      # Already a tensor: returned as it is, graph and all. Rebuilding it from
      # its numbers would silently detach it from the tape, so `tensor(x)` in
      # the middle of a loss would zero the gradient. With a dtype it is a
      # cast, and a cast is forward-only, so there the detachment is asked for.
      VTensor(t) => {
        if dt >= 0 { return Ok(VTensor(tensor.cast(t, dt))) }
        return Ok(VTensor(t))
      },
      _ => unit,
    }
    let made: tensor.Tensor = lift(tensor.from_nested(value_to_nested(args[0], line)?), line)?
    if dt >= 0 { made = tensor.cast(made, dt) }
    return Ok(VTensor(made))
  }
  if bytes.equal(name, "scalar") {
    return Ok(VTensor(tensor.scalar_of(scalar_of(args[0], "scalar", line)?, maker_dtype(dt))))
  }
  if bytes.equal(name, "zeros") {
    return Ok(VTensor(tensor.filled_of(shape_from_args(args, "zeros", line)?, 0.0, maker_dtype(dt))))
  }
  if bytes.equal(name, "ones") {
    return Ok(VTensor(tensor.filled_of(shape_from_args(args, "ones", line)?, 1.0, maker_dtype(dt))))
  }
  if bytes.equal(name, "fill") {
    if len(args) < 1 {
      return Err(runtime_error(line, "fill expects (value, ...shape)"))
    }
    let v: F64 = scalar_of(args[0], "fill", line)?
    return Ok(VTensor(tensor.filled_of(shape_from_args(rest(args, 1), "fill", line)?, v, maker_dtype(dt))))
  }
  # A random draw with a dtype is the f64 draw rounded once into it, which is
  # the cast rule applied to a sample.
  if bytes.equal(name, "randn") {
    let t: tensor.Tensor = random_tensor(shape_from_args(args, "randn", line)?, true)
    if dt >= 0 { t = tensor.cast(t, dt) }
    return Ok(VTensor(t))
  }
  if bytes.equal(name, "rand") {
    let t: tensor.Tensor = random_tensor(shape_from_args(args, "rand", line)?, false)
    if dt >= 0 { t = tensor.cast(t, dt) }
    return Ok(VTensor(t))
  }
  # seed makes subsequent randn/rand reproducible from a chosen starting point.
  if bytes.equal(name, "seed") {
    rng_seed(int_of(args[0], "seed", line)?)
    return Ok(VUnit)
  }
  # permutation(n): a shuffled ordering of 0..n-1, as a list, from the seeded
  # RNG (so it is reproducible). Use it with gather to shuffle a dataset.
  if bytes.equal(name, "permutation") {
    let n: I64 = int_of(args[0], "permutation", line)?
    if n < 0 {
      return Err(runtime_error(line, "permutation: n must be >= 0"))
    }
    let perm: Arr[I64] = rng_perm(n)
    let items: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < n {
      push(items, VTensor(tensor.scalar(f64_of_i64(perm[i]))))
      i = i + 1
    }
    return Ok(VList(ListVal { items: items }))
  }
  # linspace(start, stop, n): n points from start to stop, both included, with
  # the last set to stop exactly. Mirrors the bootstrap.
  if bytes.equal(name, "linspace") {
    let start: F64 = scalar_of(args[0], "linspace", line)?
    let stop: F64 = scalar_of(args[1], "linspace", line)?
    let ln: I64 = int_of(args[2], "linspace", line)?
    if ln < 0 {
      return Err(runtime_error(line, "linspace: count must be non-negative"))
    }
    let ld: Arr[F64] = arr_new()
    if ln == 1 {
      push(ld, start)
    } else if ln > 1 {
      let step: F64 = (stop - start) / f64_of_i64(ln - 1)
      let k: I64 = 0
      while k < ln {
        push(ld, start + f64_of_i64(k) * step)
        k = k + 1
      }
      ld[ln - 1] = stop
    }
    let lshape: Arr[I64] = arr_new()
    push(lshape, ln)
    return Ok(VTensor(tensor.mk_raw(lshape, ld, tensor.DT_F64)))
  }
  # arange(start, stop, step): start, start+step, ... up to but not including
  # stop. Mirrors the bootstrap.
  if bytes.equal(name, "arange") {
    let astart: F64 = scalar_of(args[0], "arange", line)?
    let astop: F64 = scalar_of(args[1], "arange", line)?
    let astep: F64 = scalar_of(args[2], "arange", line)?
    if astep == 0.0 {
      return Err(runtime_error(line, "arange: step must be non-zero"))
    }
    let an: I64 = i64_of_f64(f64_ceil((astop - astart) / astep))
    if an < 0 { an = 0 }
    let ad: Arr[F64] = arr_new()
    let j: I64 = 0
    while j < an {
      push(ad, astart + f64_of_i64(j) * astep)
      j = j + 1
    }
    let ashape: Arr[I64] = arr_new()
    push(ashape, an)
    return Ok(VTensor(tensor.mk_raw(ashape, ad, tensor.DT_F64)))
  }
  let n: I64 = int_of(args[0], "eye", line)?
  let d: Arr[F64] = arr_new()
  let i: I64 = 0
  while i < n * n {
    push(d, 0.0)
    i = i + 1
  }
  i = 0
  while i < n {
    d[i * n + i] = 1.0
    i = i + 1
  }
  let shape: Arr[I64] = arr_new()
  push(shape, n)
  push(shape, n)
  # Zero and one are representable in every dtype, so an eye with a dtype is
  # the f64 eye cast, with nothing to round.
  let out: tensor.Tensor = tensor.mk_raw(shape, d, tensor.DT_F64)
  if dt >= 0 { out = tensor.cast(out, dt) }
  Ok(VTensor(out))
}

# The dtype a maker builds in: the trailing dtype argument when the call named
# one, f64 otherwise.
fn maker_dtype(dt: I64) -> I64 {
  if dt >= 0 { return dt }
  tensor.DT_F64
}

# Nested arrays for `tensor([[1, 2], [3, 4]])`. Only numbers, tensors and lists
# convert; a record has no shape and says so.
fn value_to_nested(v: Value, line: I64) -> Res[tensor.Nested, RuntimeError] {
  match v {
    VNum(x) => Ok(tensor.NLeaf(x)),
    VTensor(t) => Ok(tensor.to_nested(t)),
    VList(l) => {
      let out: Arr[tensor.Nested] = arr_new()
      let i: I64 = 0
      while i < len(l.items) {
        push(out, value_to_nested(l.items[i], line)?)
        i = i + 1
      }
      Ok(tensor.NList(out))
    },
    _ => Err(runtime_error(line, "cannot convert value to a tensor")),
  }
}

fn random_tensor(shape: Arr[I64], normal: Bool) -> tensor.Tensor {
  let n: I64 = tensor.element_count(shape)
  let data: Arr[F64] = arr_new()
  let i: I64 = 0
  while i < n {
    if normal { push(data, rng_normal()) } else { push(data, rng_uniform()) }
    i = i + 1
  }
  tensor.mk_raw(shape, data, tensor.DT_F64)
}

# ---- inspection and utilities ----------------------------------------------

fn bi_inspect(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "shape") {
    let t: tensor.Tensor = arg_tensor(args[0], "shape", line)?
    let items: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < len(t.shape) {
      push(items, VTensor(tensor.scalar(f64_of_i64(t.shape[i]))))
      i = i + 1
    }
    return Ok(VList(ListVal { items: items }))
  }
  # len does not go through as_tensor, so a plain number is not a length-1
  # tensor here: `len(3)` is an error. That is the Go behaviour and it is worth
  # keeping, because a number silently having a length is how a loop over the
  # wrong variable runs once instead of failing.
  #
  # The Str, Dict and Bytes arms are docs/BUGS.md open divergence 2. This
  # refused a Str where the bootstrap answers its byte length, which is what
  # docs/language-guide.md documents and what src/lex.tw itself relies on when
  # the bootstrap runs it -- so the self-hosted evaluator could not have run the
  # self-hosted lexer. A Str is a byte string, so its length is its byte count,
  # matching how the lexer and the systems string code index it.
  if bytes.equal(name, "len") {
    match args[0] {
      VTensor(t) => {
        if len(t.shape) == 0 { return Ok(VTensor(tensor.scalar(1.0))) }
        return Ok(VTensor(tensor.scalar(f64_of_i64(t.shape[0]))))
      },
      VList(l) => return Ok(VTensor(tensor.scalar(f64_of_i64(len(l.items))))),
      VStr(s) => return Ok(VTensor(tensor.scalar(f64_of_i64(len(s))))),
      VDict(d) => return Ok(VTensor(tensor.scalar(f64_of_i64(len(dict_keys(d.entries)))))),
      VBytes(b) => return Ok(VTensor(tensor.scalar(f64_of_i64(buf_len(b.buf))))),
      _ => return Err(runtime_error(line, "len expects a tensor, list, string, dict or bytes")),
    }
  }
  if bytes.equal(name, "item") {
    let t: tensor.Tensor = arg_tensor(args[0], "item", line)?
    if tensor.numel(t) != 1 {
      return Err(runtime_error(line, "item expects a single-element tensor"))
    }
    return Ok(VTensor(tensor.scalar(tensor.at(t, 0))))
  }
  # dtype(t): the name of a tensor's dtype, as a string. The read-back the
  # constructors and `.to` have no inverse for otherwise: a program can ask for
  # bf16 but not ask what it got. It returns the name rather than a dtype value
  # because a dtype is a contextual name and not a first-class value (NEEDS-110),
  # and a string is what a caller branches on ("f64") or prints. loom, shuttle
  # and warp all wanted this; it is the surface for tensor.dtype_name.
  if bytes.equal(name, "dtype") {
    let t: tensor.Tensor = arg_tensor(args[0], "dtype", line)?
    return Ok(VStr(tensor.dtype_name(t.dtype)))
  }
  if bytes.equal(name, "range") { return bi_range(args, line) }
  if bytes.equal(name, "list") {
    let items: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < len(args) {
      push(items, args[i])
      i = i + 1
    }
    return Ok(VList(ListVal { items: items }))
  }
  if bytes.equal(name, "str") { return Ok(VStr(format_value(args[0]))) }
  # int(x): truncate a scalar toward zero (handy for computing sizes/indices).
  # It stays a tensor rather than becoming an I64, because twill has no integer
  # type at the value level; the truncation is the whole of the operation.
  Ok(VTensor(tensor.scalar(f64_trunc(scalar_of(args[0], "int", line)?))))
}

fn bi_range(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let start: I64 = 0
  let end: I64 = 0
  let step: I64 = 1
  if len(args) == 1 {
    end = int_of(args[0], "range", line)?
  } else {
    if len(args) == 2 {
      start = int_of(args[0], "range", line)?
      end = int_of(args[1], "range", line)?
    } else {
      if len(args) == 3 {
        start = int_of(args[0], "range", line)?
        end = int_of(args[1], "range", line)?
        step = int_of(args[2], "range", line)?
      } else {
        return Err(runtime_error(line, "range expects 1-3 arguments"))
      }
    }
  }
  # A zero step is the one case that would not terminate, so it is the one case
  # refused. A step that runs the wrong way just gives an empty list, which is
  # what makes `range(0, n)` safe when n is 0.
  if step == 0 {
    return Err(runtime_error(line, "range step cannot be 0"))
  }
  let items: Arr[Value] = arr_new()
  let x: I64 = start
  while (step > 0 and x < end) or (step < 0 and x > end) {
    push(items, VTensor(tensor.scalar(f64_of_i64(x))))
    x = x + step
  }
  Ok(VList(ListVal { items: items }))
}

# ---- the systems runtime: Arr, Dict, buffers and strings --------------------
#
# The port of the systems-dialect half of internal/interp/builtins.go: the
# growable list, the insertion-ordered dictionary, the byte buffer, and the
# handful of string primitives that cross to the host. These are the names the
# self-hosted compiler is itself written in, so until they were here the second
# implementation could check a program that used them and not run it.
#
# Where the host has the same primitive -- pop, arr_clear, dict_del, buf_get8,
# str_quote -- the body is a delegation rather than a re-implementation. That
# is not laziness: this evaluator runs on the bootstrap, so delegating is what
# makes the answer identical by construction instead of identical by
# inspection, and the cases that cannot delegate (a Str's length, an Opt's
# shape) are exactly the ones that had drifted.

# Opt as a Value. dict_get, i64_of_str and str_to_f64 all answer with one, and
# the Go side builds a *value.Variant for each.
fn some_value(payload: Value) -> Value =
  VVariant(VariantVal { name: "Some", payload: Some(payload), has_payload: true })

fn none_value() -> Value =
  VVariant(VariantVal { name: "None", payload: None, has_payload: false })

fn arg_list(v: Value, who: Str, line: I64) -> Res[ListVal, RuntimeError] {
  match v {
    VList(l) => Ok(l),
    _ => Err(runtime_error(line, bytes.concat(who, " expects a list"))),
  }
}

fn arg_dict(v: Value, who: Str, line: I64) -> Res[DictVal, RuntimeError] {
  match v {
    VDict(d) => Ok(d),
    _ => Err(runtime_error(line, bytes.concat(who, " expects a dict"))),
  }
}

# The two buffer families word their refusal differently -- bytes_* says "byte
# buffer" and buf_* says "buffer" -- so the noun is a parameter rather than a
# decision made here. The Go file says both, and the harness compares the text.
fn arg_buffer(v: Value, who: Str, noun: Str, line: I64) -> Res[BytesVal, RuntimeError] {
  match v {
    VBytes(b) => Ok(b),
    _ => Err(runtime_error(line, bytes.concat(who, bytes.concat(" expects a ", noun)))),
  }
}

# Go's asStr: a Str, or the bytes of a buffer. A Bytes is a string under
# construction, so the builtins that read text read either.
fn arg_text(v: Value) -> Opt[Str] {
  match v {
    VStr(s) => Some(s),
    VBytes(b) => Some(bytes_val_to_str(b)),
    _ => None,
  }
}

# A dictionary key as the string it is stored under. Keys are strings
# internally, and the systems dialect also has Dict[I64, V] -- the checker keys
# its recursion guard by function id -- so an integer key maps to its decimal
# string. A program keeps one key type per dict, so a numeric and a textual key
# never alias in practice.
fn dict_key_of(v: Value, who: Str, line: I64) -> Res[Str, RuntimeError] {
  match v {
    VStr(s) => return Ok(s),
    _ => unit,
  }
  # as_int first, so a value that is exactly an integer keeps every bit of it:
  # rounding a key through an f64 is how a Dict[I64, V] above 2^53 would start
  # aliasing two different keys onto one entry.
  match as_int(v) {
    Some(n) => return Ok(str(n)),
    None => unit,
  }
  match single_number(v) {
    Some(x) => {
      let n: I64 = i64_of_f64(f64_trunc(x))
      return Ok(str(n))
    },
    None => unit,
  }
  Err(runtime_error(line, bytes.concat(who, " expects a string or integer key")))
}

fn bi_arr(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "arr_new") { return Ok(VList(ListVal { items: arr_new() })) }
  # arr is a list literal as a call: arr(a, b, c) is [a, b, c]. A fresh list
  # every call, so two callers never share backing storage.
  if bytes.equal(name, "arr") {
    let items: Arr[Value] = arr_new()
    let i: I64 = 0
    while i < len(args) {
      push(items, args[i])
      i = i + 1
    }
    return Ok(VList(ListVal { items: items }))
  }
  if bytes.equal(name, "push") {
    let l: ListVal = arg_list(args[0], "push", line)?
    push(l.items, args[1])
    return Ok(VUnit)
  }
  # arr_push returns the list it appended to, so it reads as an expression,
  # `out = arr_push(out, x)`, as well as a statement. push is the same append
  # and returns unit; the two names differ only in that.
  if bytes.equal(name, "arr_push") {
    let l: ListVal = arg_list(args[0], "arr_push", line)?
    push(l.items, args[1])
    return Ok(args[0])
  }
  if bytes.equal(name, "pop") {
    let l: ListVal = arg_list(args[0], "pop", line)?
    if len(l.items) == 0 {
      return Err(runtime_error(line, "pop from an empty list"))
    }
    return Ok(pop(l.items))
  }
  # arr_clear empties a list in place, so a buffer can be reused across passes
  # without reallocating. In place is the whole of it: a fresh list here would
  # leave every other binding pointing at the old contents.
  if bytes.equal(name, "arr_clear") {
    let l: ListVal = arg_list(args[0], "arr_clear", line)?
    arr_clear(l.items)
    return Ok(VUnit)
  }
  # arr_of_tensor is the inverse of tensor(arr), at any rank: the elements come
  # out in row-major order, which is the order they are stored in and the order
  # tensor(arr) reads them back. A Num is refused, matching the Go type switch:
  # this takes a tensor, and a scalar has no elements to copy.
  if bytes.equal(name, "arr_of_tensor") {
    match args[0] {
      VTensor(t) => {
        let items: Arr[Value] = arr_new()
        let i: I64 = 0
        while i < tensor.numel(t) {
          push(items, VNum(tensor.at(t, i)))
          i = i + 1
        }
        return Ok(VList(ListVal { items: items }))
      },
      _ => return Err(runtime_error(line, "arr_of_tensor expects a tensor")),
    }
  }
  # numel is the total element count, the product of the shape, where `shape`
  # gives the dimensions and `len` gives only the first of them.
  match args[0] {
    VNum(_) => return Ok(VTensor(tensor.scalar(1.0))),
    VTensor(t) => return Ok(VTensor(tensor.scalar(f64_of_i64(tensor.numel(t))))),
    _ => unit,
  }
  Err(runtime_error(line, "numel expects a tensor"))
}

fn bi_dict(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "dict_new") { return Ok(VDict(DictVal { entries: dict_new() })) }
  let d: DictVal = arg_dict(args[0], name, line)?
  if bytes.equal(name, "dict_keys") {
    let items: Arr[Value] = arr_new()
    for k in dict_keys(d.entries) {
      push(items, VStr(k))
    }
    return Ok(VList(ListVal { items: items }))
  }
  let key: Str = dict_key_of(args[1], name, line)?
  if bytes.equal(name, "dict_set") {
    dict_set(d.entries, key, args[2])
    return Ok(VUnit)
  }
  # dict_get returns an Opt: Some(value) when the key is present, None when not.
  if bytes.equal(name, "dict_get") {
    match dict_get(d.entries, key) {
      Some(v) => return Ok(some_value(v)),
      None => return Ok(none_value()),
    }
  }
  if bytes.equal(name, "dict_has") { return Ok(VBool(dict_has(d.entries, key))) }
  # dict_must is dict_get without the Opt, for the call sites that have already
  # checked the key is present.
  if bytes.equal(name, "dict_must") {
    match dict_get(d.entries, key) {
      Some(v) => return Ok(v),
      None => return Err(runtime_error(line, bytes.concat("dict_must: no key ", quoted(key)))),
    }
  }
  # dict_or returns the value at a key, or a default when it is absent.
  if bytes.equal(name, "dict_or") {
    match dict_get(d.entries, key) {
      Some(v) => return Ok(v),
      None => return Ok(args[2]),
    }
  }
  # Deleting a key that is not there is not an error, and the host delete drops
  # it from the key order as well as the map, which is what keeps dict_keys
  # from handing back a key that is gone.
  dict_del(d.entries, key)
  Ok(VUnit)
}

fn bi_buf(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "bytes_new") { return Ok(VBytes(BytesVal { buf: bytes_new() })) }
  # A buf is a fixed-size byte buffer, the packed storage a narrow-dtype tensor
  # keeps. It reuses the same value, allocated to length up front.
  if bytes.equal(name, "buf_new") {
    let n: I64 = int_of(args[0], "buf_new", line)?
    return Ok(VBytes(BytesVal { buf: buf_new(n) }))
  }
  if bytes.equal(name, "bytes_push") {
    let b: BytesVal = arg_buffer(args[0], "bytes_push", "byte buffer", line)?
    let c: I64 = int_of(args[1], "bytes_push", line)?
    bytes_push(b.buf, c)
    return Ok(VUnit)
  }
  if bytes.equal(name, "bytes_to_str") {
    let b: BytesVal = arg_buffer(args[0], "bytes_to_str", "byte buffer", line)?
    return Ok(VStr(bytes_val_to_str(b)))
  }
  let b: BytesVal = arg_buffer(args[0], name, "buffer", line)?
  if bytes.equal(name, "buf_len") { return Ok(VTensor(tensor.scalar(f64_of_i64(buf_len(b.buf))))) }
  let i: I64 = int_of(args[1], name, line)?
  if i < 0 or i >= buf_len(b.buf) {
    return Err(runtime_error(line, bytes.concat(name,
      bytes.concat(" index ", bytes.concat(str(i), " out of range")))))
  }
  if bytes.equal(name, "buf_get8") {
    return Ok(VTensor(tensor.scalar(f64_of_i64(buf_get8(b.buf, i)))))
  }
  # The store narrows to a byte, so 258 lands as 2. That is the Go conversion
  # and it is what the packed dtype layouts rely on.
  let v: I64 = int_of(args[2], "buf_set8", line)?
  buf_set8(b.buf, i, v)
  Ok(VUnit)
}

fn bi_str(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  # chr is a one-byte string with the given byte value. UTF-8 text is built by
  # concatenating the bytes of a rune, which is why this is a byte and not a
  # rune.
  if bytes.equal(name, "chr") {
    let c: I64 = int_of(args[0], "chr", line)?
    return Ok(VStr(chr(c)))
  }
  # slice is a byte substring s[i:j], clamped to the string so an out-of-range
  # index yields the empty overlap rather than a failure. Indices are byte
  # offsets, matching how the lexer and the width code index a Str. Unlike the
  # text readers below it takes a Str and not a buffer, which is the Go type
  # assertion rather than asStr.
  if bytes.equal(name, "slice") {
    let s: Str = ""
    match args[0] {
      VStr(x) => s = x,
      _ => return Err(runtime_error(line, "slice expects a string")),
    }
    let lo: I64 = int_of(args[1], "slice", line)?
    let hi: I64 = int_of(args[2], "slice", line)?
    let n: I64 = len(s)
    if lo < 0 { lo = 0 }
    if hi > n { hi = n }
    if lo > hi { lo = hi }
    return Ok(VStr(slice(s, lo, hi)))
  }
  # The rest read text. f64_to_str, num_to_text and f64_hex read a number
  # instead, and are grouped here because what they produce is text.
  if bytes.equal(name, "f64_to_str") {
    return Ok(VStr(f64_to_str(scalar_of(args[0], "f64_to_str", line)?)))
  }
  # num_to_text is the runtime number rendering print and str use: an integer
  # without a point, otherwise %.6f with trailing zeros trimmed.
  if bytes.equal(name, "num_to_text") {
    return Ok(VStr(num_to_text(scalar_of(args[0], "num_to_text", line)?)))
  }
  # f64_hex is the exact hexadecimal-float form, for the canonical dump the
  # differential harness compares bit for bit.
  if bytes.equal(name, "f64_hex") {
    return Ok(VStr(f64_hex(scalar_of(args[0], "f64_hex", line)?)))
  }
  # SHA-256, lower-case hex. std/hash.tw is the specification and holds the
  # published vectors; this is the same digest reached through the host.
  #
  # These two are the exception to arg_text below. Everything else here takes a
  # Str or a buffer indifferently, because a Bytes is a string under
  # construction. A digest is a format constant -- spool's lockfiles, selvedge's
  # archives and warp's cache keys store one and read it back later -- so
  # sha256 takes a Str and sha256_bytes a Bytes and neither takes the other,
  # which is the Go builtin's rule and the Go builtin's wording.
  if bytes.equal(name, "sha256") {
    match args[0] {
      VStr(x) => return Ok(VStr(sha256(x))),
      _ => return Err(runtime_error(line, "sha256 expects a string")),
    }
  }
  if bytes.equal(name, "sha256_bytes") {
    let sb: BytesVal = arg_buffer(args[0], "sha256_bytes", "byte buffer", line)?
    return Ok(VStr(sha256_bytes(sb.buf)))
  }
  let text: Str = ""
  match arg_text(args[0]) {
    Some(t) => text = t,
    None => return Err(runtime_error(line, bytes.concat(name, " expects a string"))),
  }
  if bytes.equal(name, "str_quote") { return Ok(VStr(str_quote(text))) }
  # i64_of_str parses a decimal integer, returning an Opt. The payload is an
  # Int and not a scalar: the whole point of parsing an I64 from text is the
  # values an f64 cannot hold, and rounding the answer here would put the
  # precision back exactly where the caller was trying to keep it.
  if bytes.equal(name, "i64_of_str") {
    match i64_of_str(text) {
      Some(n) => return Ok(some_value(VInt(n))),
      None => return Ok(none_value()),
    }
  }
  # str_to_f64 parses a float from its decimal (or hex-float) text, also as an
  # Opt. Underscores are digit separators and dropped, matching the parser.
  match str_to_f64(text) {
    Some(x) => Ok(some_value(VTensor(tensor.scalar(x)))),
    None => Ok(none_value()),
  }
}

# ---- the filesystem, the clock and the process -----------------------------
#
# The second half of the systems runtime. Entry 12 of docs/BUGS.md ported the
# values -- lists, dictionaries, buffers and strings -- and left the effects:
# reading a file, asking what a path is, reading a clock, starting a program.
# Every one of those names checked clean on both sides and then died here with
# "named in the builtin table but has no implementation", so a systems-mode
# program that did any I/O at all ran on the bootstrap and refused self-hosted.
#
# The bodies delegate to the host builtin of the same name, for the reason the
# Arr and Dict port gives: this evaluator runs on the bootstrap, so delegating
# makes the answer identical to the bootstrap by construction rather than by
# inspection. The work that is not delegation is the two things around the
# syscall -- which argument is coerced first and what its refusal says, and
# what a relative path is measured from.
#
# WHERE A RELATIVE PATH POINTS
#
# The bootstrap resolves a relative path against the directory of the file
# doing the reading. Run a program directly and that is the program's own
# directory. Run it through this evaluator and the file doing the reading is
# src/eval.tw, so the same source names a different file: `read_file("in.txt")`
# would mean <program dir>/in.txt on one side and src/in.txt on the other. That
# is a wrong answer and not a refusal, which is the kind this port must not
# add, so PROGRAM_BASE carries the answer instead. src/main.tw records the file
# it is about to run and every path below is resolved against that file's
# directory, which is the directory the bootstrap would have used.
#
# Three of these builtins deliberately do not resolve anything, because the Go
# bodies do not: list_dir, save_value and load_value take the path they were
# given straight to the operating system, so it means what it means to the
# process rather than to the source file. Passing those through base_resolve
# would be a tidier rule and a divergence.

# The file being run, as src/main.tw was given it, or empty when nobody set it.
# An Arr of at most one element rather than a bare Str because a module-level
# binding is not assignable and a list is, which is the shape CALL_DEPTH and
# TAPES already use for evaluator state.
let PROGRAM_BASE: Arr[Str] = arr_new()

# What the program should see through args(). The self-hosted CLI's own argv is
# not the program's -- the process was invoked as `twill run main.tw run
# prog.tw`, and a program asking for its arguments must not be handed the two
# words that got the interpreter started -- so src/main.tw computes the vector
# the bootstrap would have passed and leaves it here.
let PROGRAM_ARGS: Arr[Str] = arr_new()

fn set_program_base(path: Str) {
  arr_clear(PROGRAM_BASE)
  push(PROGRAM_BASE, path)
}

fn set_program_args(argv: Arr[Str]) {
  arr_clear(PROGRAM_ARGS)
  let i: I64 = 0
  while i < len(argv) {
    push(PROGRAM_ARGS, argv[i])
    i = i + 1
  }
}

# base_resolve is the port of the Go interpreter's resolvePath for the program
# under evaluation: an absolute path is itself, and a relative one is measured
# from the directory of the file being run. The fallback when nothing has been
# recorded is resolve_path's own one-argument form, which measures from this
# file's directory -- the behaviour every path in this evaluator had before
# PROGRAM_BASE existed, kept so that a driver which does not set the base
# behaves as it did rather than resolving against the process's directory.
fn base_resolve(p: Str) -> Str {
  if path_is_abs(p) { return p }
  if len(PROGRAM_BASE) == 0 { return resolve_path(p) }
  resolve_path(resolve_path(PROGRAM_BASE[0]), p)
}

# args() is shadowed inside the builtin bodies by their own `args` parameter,
# so the host's is reached through a function that has no such parameter.
fn host_args() -> Arr[Str] = args()

# Res as a Value, the counterpart of some_value and none_value above. The
# filesystem, the process and the two persistence builtins all answer with one.
fn ok_value(payload: Value) -> Value =
  VVariant(VariantVal { name: "Ok", payload: Some(payload), has_payload: true })

fn err_value(payload: Value) -> Value =
  VVariant(VariantVal { name: "Err", payload: Some(payload), has_payload: true })

# The one coercion these builtins share. The noun is a parameter because the Go
# bodies say six different things -- "a path", "string content", "a string
# fallback", "a base path", "a program name", "a working directory" -- and the
# differential harness compares the text.
fn arg_path(v: Value, who: Str, noun: Str, line: I64) -> Res[Str, RuntimeError] {
  match arg_text(v) {
    Some(s) => Ok(s),
    None => Err(runtime_error(line, bytes.concat(who, bytes.concat(" expects ", noun)))),
  }
}

# An Arr[Str] as a list of VStr, which is what list_dir and args both answer.
fn str_list_value(items: Arr[Str]) -> Value {
  let out: Arr[Value] = arr_new()
  let i: I64 = 0
  while i < len(items) {
    push(out, VStr(items[i]))
    i = i + 1
  }
  VList(ListVal { items: out })
}

fn bi_io(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  # The three sinks. write_out and write_err print without a trailing newline,
  # because the source supplies its own; emit_line adds one and goes through
  # the interpreter's out, which is why a captured print and a captured
  # emit_line arrive interleaved in the order they were written.
  if in_words("write_out write_err emit_line", name) {
    let text: Str = arg_path(args[0], name, "a string", line)?
    if bytes.equal(name, "write_out") { write_out(text) }
    if bytes.equal(name, "write_err") { write_err(text) }
    if bytes.equal(name, "emit_line") { emit_line(text) }
    return Ok(VUnit)
  }
  # save_value is the only builtin here whose path is not the first argument:
  # it takes the value first, so the value reads as the subject.
  #
  # The text is produced by this evaluator's own format_value rather than by
  # handing the host the Value, because the host would format the enum wrapper
  # -- VNum, VTensor, VStr -- and not the twill value inside it. Once the text
  # exists, save_value writes it: the host formats a Str as itself, so the
  # bytes on disk and the message on a failure are the Go body's exactly,
  # including the unresolved path, which is the path this builtin uses.
  if bytes.equal(name, "save_value") {
    let p: Str = arg_path(args[1], "save_value", "a path", line)?
    match save_value(format_value(args[0]), p) {
      Ok(_) => return Ok(ok_value(VUnit)),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  if bytes.equal(name, "load_value") {
    let p: Str = arg_path(args[0], "load_value", "a path", line)?
    match load_value(p) {
      Ok(s) => return Ok(ok_value(VStr(s))),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  # list_dir takes the path unresolved, matching the Go body, so a relative one
  # is read against the process's directory on both sides.
  if bytes.equal(name, "list_dir") {
    let p: Str = arg_path(args[0], "list_dir", "a path", line)?
    match list_dir(p) {
      Ok(names) => return Ok(ok_value(str_list_value(names))),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  # module_source resolves an import path to its text: a "std/" path to the
  # embedded standard library, anything else to a file beside the program. The
  # std prefix is kept whole -- resolving it against the program's directory
  # would turn an embedded module into a missing file.
  if bytes.equal(name, "module_source") {
    let p: Str = arg_path(args[0], "module_source", "a string", line)?
    let target: Str = p
    if not bytes.has_prefix(p, "std/") { target = base_resolve(p) }
    match module_source(target) {
      Some(s) => return Ok(some_value(VStr(s))),
      None => return Ok(none_value()),
    }
  }
  # resolve_path is the one-argument form the file builtins use with the base
  # implicit, and the two-argument form that resolves against a named file's
  # directory. The second is pure string work and is delegated whole.
  if bytes.equal(name, "resolve_path") {
    if len(args) == 1 {
      let rel: Str = arg_path(args[0], "resolve_path", "a path", line)?
      return Ok(VStr(base_resolve(rel)))
    }
    if len(args) == 2 {
      let base: Str = arg_path(args[0], "resolve_path", "a base path", line)?
      let rel: Str = arg_path(args[1], "resolve_path", "a relative path", line)?
      return Ok(VStr(resolve_path(base, rel)))
    }
    return Err(runtime_error(line, bytes.concat("resolve_path expects 1 or 2 arguments, got ",
      str(len(args)))))
  }
  # The rest read or write a file at a path resolved against the program.
  let p: Str = arg_path(args[0], name, "a path", line)?
  let path: Str = base_resolve(p)
  if bytes.equal(name, "read_file") {
    match read_file(path) {
      Ok(s) => return Ok(ok_value(VStr(s))),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  if bytes.equal(name, "write_file") {
    let content: Str = arg_path(args[1], "write_file", "string content", line)?
    match write_file(path, content) {
      Ok(_) => return Ok(ok_value(VUnit)),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  # read_text_or and write_text_or are the two above for a caller who has
  # already decided what a failure means: the fallback text, and a Bool.
  if bytes.equal(name, "read_text_or") {
    let fallback: Str = arg_path(args[1], "read_text_or", "a string fallback", line)?
    return Ok(VStr(read_text_or(path, fallback)))
  }
  if bytes.equal(name, "write_text_or") {
    let content: Str = arg_path(args[1], "write_text_or", "string content", line)?
    return Ok(VBool(write_text_or(path, content)))
  }
  # file_size answers in bytes, or -1 when the path cannot be stat'd, which is
  # the same convention mtime keeps.
  if bytes.equal(name, "file_size") {
    return Ok(VTensor(tensor.scalar(f64(file_size(path)))))
  }
  # read_file_at reads at most count bytes from offset. The two counts are read
  # with as_int and not with int_of: the Go body takes value.AsInt, which
  # refuses a fractional number rather than truncating it, and truncating here
  # would accept a call the bootstrap rejects.
  let offset: I64 = 0
  match as_int(args[1]) {
    Some(n) => offset = n,
    None => return Err(runtime_error(line, "read_file_at expects an integer offset")),
  }
  let count: I64 = 0
  match as_int(args[2]) {
    Some(n) => count = n,
    None => return Err(runtime_error(line, "read_file_at expects an integer count")),
  }
  match read_file_at(path, offset, count) {
    Ok(s) => Ok(ok_value(VStr(s))),
    Err(m) => Ok(err_value(VStr(m))),
  }
}

# ---- paths -----------------------------------------------------------------
#
# The seven pure ones are string operations and touch no filesystem, so they
# are delegated with the path exactly as written. The rest stat or change
# something, and their paths go through base_resolve first -- which also puts
# the resolved path into the messages that quote one, the way the Go bodies do.

fn bi_path(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  # path_join is variadic: empty components contribute nothing, the rest are
  # joined with a single separator, and the result is normalised. It is built
  # here rather than delegated because a twill call cannot spread a list into a
  # variadic builtin; the normalisation at the end is the same call.
  if bytes.equal(name, "path_join") {
    let joined: Str = ""
    let n: I64 = 0
    let i: I64 = 0
    while i < len(args) {
      let part: Str = ""
      match arg_text(args[i]) {
        Some(s) => part = s,
        None => return Err(runtime_error(line, "path_join expects strings")),
      }
      if len(part) > 0 {
        if n > 0 { joined = bytes.concat(joined, "/") }
        joined = bytes.concat(joined, part)
        n = n + 1
      }
      i = i + 1
    }
    return Ok(VStr(path_normalize(joined)))
  }
  if bytes.equal(name, "cwd") {
    match cwd() {
      Ok(d) => return Ok(ok_value(VStr(d))),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  if bytes.equal(name, "temp_dir") {
    let prefix: Str = arg_path(args[0], "temp_dir", "a name prefix", line)?
    match temp_dir(prefix) {
      Ok(d) => return Ok(ok_value(VStr(d))),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  let raw: Str = arg_path(args[0], name, "a path", line)?
  if bytes.equal(name, "path_base") { return Ok(VStr(path_base(raw))) }
  if bytes.equal(name, "path_dir") { return Ok(VStr(path_dir(raw))) }
  if bytes.equal(name, "path_ext") { return Ok(VStr(path_ext(raw))) }
  if bytes.equal(name, "path_stem") { return Ok(VStr(path_stem(raw))) }
  if bytes.equal(name, "path_normalize") { return Ok(VStr(path_normalize(raw))) }
  if bytes.equal(name, "path_is_abs") { return Ok(VBool(path_is_abs(raw))) }
  let path: Str = base_resolve(raw)
  # The two predicates answer Bool and not Res: "it is not there" is the
  # answer rather than a failure.
  if bytes.equal(name, "path_exists") { return Ok(VBool(path_exists(path))) }
  if bytes.equal(name, "path_is_dir") { return Ok(VBool(path_is_dir(path))) }
  # mtime is whole seconds since the epoch, or -1 when the path cannot be
  # stat'd. Seconds because this answers "is the artefact older than its
  # sources", which a filesystem's timestamp resolution does not honestly
  # support finer.
  if bytes.equal(name, "mtime") { return Ok(VInt(mtime(path))) }
  if bytes.equal(name, "mkdir_all") {
    match mkdir_all(path) {
      Ok(_) => return Ok(ok_value(VUnit)),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  if bytes.equal(name, "remove_file") {
    match remove_file(path) {
      Ok(_) => return Ok(ok_value(VUnit)),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  if bytes.equal(name, "remove_dir") {
    match remove_dir(path) {
      Ok(_) => return Ok(ok_value(VUnit)),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  if bytes.equal(name, "remove_all") {
    match remove_all(path) {
      Ok(_) => return Ok(ok_value(VUnit)),
      Err(m) => return Ok(err_value(VStr(m))),
    }
  }
  let to: Str = arg_path(args[1], "rename", "a path", line)?
  match rename(path, base_resolve(to)) {
    Ok(_) => Ok(ok_value(VUnit)),
    Err(m) => Ok(err_value(VStr(m))),
  }
}

# ---- the clock and the process ---------------------------------------------

fn bi_proc(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  # clock_now_ms is the wall clock and can step backwards when the system's
  # time is corrected; mono_ns only ever goes forward and is what a duration
  # should be measured with. The zero point of the second is arbitrary, so only
  # a difference between two readings means anything.
  if bytes.equal(name, "clock_now_ms") {
    return Ok(VTensor(tensor.scalar(f64(clock_now_ms()))))
  }
  if bytes.equal(name, "mono_ns") { return Ok(VInt(mono_ns())) }
  if bytes.equal(name, "is_tty_stdout") { return Ok(VBool(is_tty_stdout())) }
  # window_size is the terminal's size as a { cols, rows } record. The Go body
  # has no size syscall and answers zeros, so the caller falls back to 80x24;
  # this is that constant rather than a delegation because reading the two
  # fields back out of a host record would cost more than the constant is
  # worth. testdata/conformance/cases/proc.tw compares both sides, so a
  # bootstrap that grows a real syscall fails there rather than diverging
  # quietly.
  if bytes.equal(name, "window_size") {
    let fields: Dict[Str, Value] = dict_new()
    dict_set(fields, "cols", VTensor(tensor.scalar(0.0)))
    dict_set(fields, "rows", VTensor(tensor.scalar(0.0)))
    return Ok(VRecord(plain_record(fields)))
  }
  # args is what src/main.tw recorded, not the interpreter's own argv. Nothing
  # recorded means a driver that did not set it, and the process's own vector
  # is a better answer than an empty one.
  if bytes.equal(name, "args") {
    if len(PROGRAM_ARGS) == 0 { return Ok(str_list_value(host_args())) }
    return Ok(str_list_value(PROGRAM_ARGS))
  }
  if bytes.equal(name, "env") {
    let key: Str = arg_path(args[0], "env", "a string", line)?
    match env(key) {
      Some(v) => return Ok(some_value(VStr(v))),
      None => return Ok(none_value()),
    }
  }
  # abort stops the program with the value as the message. It is a runtime
  # error and not an exit status: a caller has asserted something that did not
  # hold, and the line it happened on is the useful part.
  if bytes.equal(name, "abort") {
    return Err(runtime_error(line, bytes.concat("abort: ", format_value(args[0]))))
  }
  # exit(n) stops the program with status n, and it is delegated because there
  # is nothing else it could be: the host's exit unwinds the whole Go
  # interpreter, this evaluator included, and hands the status to the process.
  # Building a status that had to be carried back through every Res in this
  # file would be a second mechanism for one that already works.
  if bytes.equal(name, "exit") {
    let code: F64 = scalar_of(args[0], "exit", line)?
    exit(i64_of_f64(f64_trunc(code)))
    return Ok(VUnit)
  }
  # run starts a program, waits for it and answers with what it printed. The
  # program and its arguments stay separate values all the way to the host
  # call: nothing here parses a command line, splits on whitespace or reaches a
  # shell, and the argument for that is on internal/interp/proc.go.
  let program: Str = arg_path(args[0], "run", "a program name", line)?
  let items: Arr[Value] = arr_new()
  match args[1] {
    VList(l) => items = l.items,
    _ => return Err(runtime_error(line, "run expects an Arr[Str] of arguments")),
  }
  let argv: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(items) {
    match arg_text(items[i]) {
      Some(s) => push(argv, s),
      None => return Err(runtime_error(line, "run expects every argument to be a string")),
    }
    i = i + 1
  }
  let dir: Str = arg_path(args[2], "run", "a working directory", line)?
  # An empty directory means "where the running program's relative paths
  # point", which is the base every path builtin above resolves against, so a
  # caller does not have to know two rules. base_resolve("") is that directory.
  match run(program, argv, base_resolve(dir)) {
    Ok(s) => Ok(ok_value(VStr(s))),
    Err(m) => Ok(err_value(VStr(m))),
  }
}

# ---- files, frames and records ---------------------------------------------

fn bi_files(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "read_csv") {
    match args[0] {
      VStr(p) => return read_csv(p, line),
      _ => return Err(runtime_error(line, "read_csv expects a string path")),
    }
  }
  if bytes.equal(name, "read_frame") {
    match args[0] {
      VStr(p) => return read_frame(p, line),
      _ => return Err(runtime_error(line, "read_frame expects a string path")),
    }
  }
  if bytes.equal(name, "write_frame") {
    let rec: RecordVal = plain_record(dict_new())
    match args[0] {
      VRecord(r) => rec = r,
      _ => return Err(runtime_error(line, "write_frame expects a frame (record of columns)")),
    }
    match args[1] {
      VStr(p) => {
        write_frame(rec, p, line)?
        return Ok(VUnit)
      },
      _ => return Err(runtime_error(line, "write_frame expects a string path")),
    }
  }
  # save(value, path): write any value (tensors, records, lists, or a fitted gbm
  # model) to a file, so a trained model can be persisted and shipped.
  if bytes.equal(name, "save") {
    match args[1] {
      VStr(p) => {
        match save_value(args[0], resolve_path(p)) {
          Ok(_) => return Ok(VUnit),
          Err(m) => return Err(runtime_error(line, bytes.concat("save: ", m))),
        }
      },
      _ => return Err(runtime_error(line, "save expects a string path as its second argument")),
    }
  }
  # load(path): read back a value written by save.
  if bytes.equal(name, "load") {
    match args[0] {
      VStr(p) => {
        match load_value(resolve_path(p)) {
          Ok(v) => return Ok(v),
          Err(m) => return Err(runtime_error(line, bytes.concat("load: ", m))),
        }
      },
      _ => return Err(runtime_error(line, "load expects a string path")),
    }
  }
  # columns(record): the field names, in order, as a list of strings. In order,
  # because a frame's column order is the order it was read in and a caller
  # writing a header back out depends on it.
  if bytes.equal(name, "columns") {
    match args[0] {
      VRecord(r) => {
        let items: Arr[Value] = arr_new()
        for k in dict_keys(r.fields) {
          push(items, VStr(k))
        }
        return Ok(VList(ListVal { items: items }))
      },
      _ => return Err(runtime_error(line, "columns expects a record")),
    }
  }
  # field(record, name): look up a field by string name (dynamic access).
  if bytes.equal(name, "field") {
    match args[0] {
      VRecord(r) => {
        match args[1] {
          VStr(n) => {
            match dict_get(r.fields, n) {
              Some(v) => return Ok(v),
              None => return Err(runtime_error(line,
                bytes.concat("record has no field ", quoted(n)))),
            }
          },
          _ => return Err(runtime_error(line, "field expects a string name")),
        }
      },
      _ => return Err(runtime_error(line, "field expects a record")),
    }
  }
  # with_field(record, name, value): a copy of the record with the field set. A
  # copy, because a record is a value; an in-place set would make a frame passed
  # to a function change under the caller.
  match args[0] {
    VRecord(r) => {
      match args[1] {
        VStr(n) => {
          let fields: Dict[Str, Value] = dict_new()
          for k in dict_keys(r.fields) {
            dict_set(fields, k, dict_must(r.fields, k))
          }
          dict_set(fields, n, args[2])
          Ok(VRecord(plain_record(fields)))
        },
        _ => Err(runtime_error(line, "with_field expects a string name")),
      }
    },
    _ => Err(runtime_error(line, "with_field expects a record")),
  }
}

# read_csv(path): load a file of numeric rows (comma- or whitespace-separated)
# into a [rows, cols] tensor. Blank and '#' lines are skipped.
fn read_csv(path_in: Str, line: I64) -> Res[Value, RuntimeError] {
  let path: Str = resolve_path(path_in)
  let raw: Str = ""
  match read_file(path) {
    Some(s) => raw = s,
    # The message quotes the resolved path, not the one the caller wrote, which
    # is what makes a wrong working directory diagnosable.
    None => return Err(runtime_error(line, bytes.concat("read_csv: cannot read ", quoted(path)))),
  }
  let rows: Arr[Arr[F64]] = arr_new()
  for raw_line in tensor.split_on(raw, 10) {
    let text: Str = trim_space(raw_line)
    if len(text) == 0 or text[0] == 35 {
      continue
    }
    let row: Arr[F64] = arr_new()
    for f in split_fields(text) {
      match flt.f64_of_str(f) {
        Some(v) => push(row, v),
        None => return Err(runtime_error(line,
          bytes.concat("read_csv: ", bytes.concat(quoted(f), " is not a number")))),
      }
    }
    if len(row) > 0 {
      push(rows, row)
    }
  }
  if len(rows) == 0 {
    return Err(runtime_error(line, bytes.concat("read_csv: no numeric rows in ", quoted(path))))
  }
  let cols: I64 = len(rows[0])
  let flat: Arr[F64] = arr_new()
  let i: I64 = 0
  while i < len(rows) {
    if len(rows[i]) != cols {
      return Err(runtime_error(line, bytes.concat("read_csv: row ", bytes.concat(str(i + 1),
        bytes.concat(" has ", bytes.concat(str(len(rows[i])), bytes.concat(" columns, expected ",
        str(cols))))))))
    }
    let j: I64 = 0
    while j < cols {
      push(flat, rows[i][j])
      j = j + 1
    }
    i = i + 1
  }
  let shape: Arr[I64] = arr_new()
  push(shape, len(rows))
  push(shape, cols)
  Ok(VTensor(tensor.mk_raw(shape, flat, tensor.DT_F64)))
}

# read_frame(path): a CSV whose first row is a header, returned as a record
# mapping each column name to its column tensor (a "frame").
fn read_frame(path_in: Str, line: I64) -> Res[Value, RuntimeError] {
  let path: Str = resolve_path(path_in)
  let raw: Str = ""
  match read_file(path) {
    Some(s) => raw = s,
    None => return Err(runtime_error(line, bytes.concat("read_frame: cannot read ", quoted(path)))),
  }
  let header: Arr[Str] = arr_new()
  let have_header: Bool = false
  let rows: Arr[Arr[F64]] = arr_new()
  for raw_line in tensor.split_on(raw, 10) {
    let text: Str = trim_space(raw_line)
    if len(text) == 0 or text[0] == 35 {
      continue
    }
    let fields: Arr[Str] = split_fields(text)
    if not have_header {
      header = fields
      have_header = true
      continue
    }
    if len(fields) != len(header) {
      return Err(runtime_error(line, bytes.concat("read_frame: row has ",
        bytes.concat(str(len(fields)), bytes.concat(" values but ",
        bytes.concat(str(len(header)), " columns"))))))
    }
    let row: Arr[F64] = arr_new()
    let i: I64 = 0
    while i < len(fields) {
      match flt.f64_of_str(fields[i]) {
        Some(v) => push(row, v),
        None => return Err(runtime_error(line, bytes.concat("read_frame: column ",
          bytes.concat(quoted(header[i]), bytes.concat(" value ",
          bytes.concat(quoted(fields[i]), " is not a number")))))),
      }
      i = i + 1
    }
    push(rows, row)
  }
  if not have_header {
    return Err(runtime_error(line, bytes.concat("read_frame: ", bytes.concat(quoted(path),
      " has no header row"))))
  }
  let fields: Dict[Str, Value] = dict_new()
  let c: I64 = 0
  while c < len(header) {
    let col: Arr[F64] = arr_new()
    let r: I64 = 0
    while r < len(rows) {
      push(col, rows[r][c])
      r = r + 1
    }
    let shape: Arr[I64] = arr_new()
    push(shape, len(rows))
    dict_set(fields, header[c], VTensor(tensor.mk_raw(shape, col, tensor.DT_F64)))
    c = c + 1
  }
  Ok(VRecord(plain_record(fields)))
}

# write_frame writes a record of equal-length 1-D column tensors to a CSV.
fn write_frame(frame: RecordVal, path_in: Str, line: I64) -> Res[Unit, RuntimeError] {
  let keys: Arr[Str] = dict_keys(frame.fields)
  if len(keys) == 0 {
    return Err(runtime_error(line, "write_frame: frame has no columns"))
  }
  let nrows: I64 = -1
  let cols: Arr[Arr[F64]] = arr_new()
  let i: I64 = 0
  while i < len(keys) {
    let k: Str = keys[i]
    let col: Arr[F64] = arr_new()
    match as_tensor(dict_must(frame.fields, k)) {
      Some(t) => {
        if len(t.shape) != 1 {
          return Err(runtime_error(line, bytes.concat("write_frame: column ",
            bytes.concat(quoted(k), " must be a 1-D tensor"))))
        }
        col = tensor.data_arr(t)
      },
      None => return Err(runtime_error(line, bytes.concat("write_frame: column ",
        bytes.concat(quoted(k), " must be a 1-D tensor")))),
    }
    if nrows < 0 {
      nrows = len(col)
    } else {
      if len(col) != nrows {
        return Err(runtime_error(line, bytes.concat("write_frame: column ",
          bytes.concat(quoted(k), bytes.concat(" has ", bytes.concat(str(len(col)),
          bytes.concat(" rows, expected ", str(nrows))))))))
      }
    }
    push(cols, col)
    i = i + 1
  }
  let b: Bytes = bytes.new()
  bytes.push_text(b, bytes.join(keys, ","))
  bytes.push(b, 10)
  let r: I64 = 0
  while r < nrows {
    i = 0
    while i < len(cols) {
      if i > 0 { bytes.push(b, 44) }
      bytes.push_text(b, flt.format_number(cols[i][r]))
      i = i + 1
    }
    bytes.push(b, 10)
    r = r + 1
  }
  let path: Str = resolve_path(path_in)
  match write_file(path, bytes.to_str(b)) {
    Ok(_) => Ok(unit),
    Err(_) => Err(runtime_error(line, bytes.concat("write_frame: cannot write ", quoted(path)))),
  }
}

# Fields split on any of comma, space, tab, carriage return and semicolon, with
# empty fields dropped. Dropping them is what lets a line of space-separated
# numbers with runs of spaces read the same as a comma-separated one, and it is
# also why a trailing comma does not produce a phantom column.
fn split_fields(s: Str) -> Arr[Str] {
  let out: Arr[Str] = arr_new()
  let start: I64 = 0
  let i: I64 = 0
  while i <= len(s) {
    let at_sep: Bool = false
    if i == len(s) {
      at_sep = true
    } else {
      let c: I64 = s[i]
      at_sep = c == 44 or c == 32 or c == 9 or c == 13 or c == 59
    }
    if at_sep {
      if i > start { push(out, s[start:i]) }
      start = i + 1
    }
    i = i + 1
  }
  out
}

# ASCII whitespace only. Go's strings.TrimSpace also strips the Unicode space
# characters; a CSV containing one of those would be trimmed there and not here.
# NEEDS-61.
fn trim_space(s: Str) -> Str {
  let a: I64 = 0
  let b: I64 = len(s)
  while a < b and is_space_byte(s[a]) {
    a = a + 1
  }
  while b > a and is_space_byte(s[b - 1]) {
    b = b - 1
  }
  s[a:b]
}

fn is_space_byte(c: I64) -> Bool =
  c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12

# ---- gradient-boosted trees ------------------------------------------------

# gbm_fit(X, y) or gbm_fit(X, y, opts): train gradient-boosted trees on a [n, d]
# feature matrix and an [n] target/label vector. opts is an optional record of
# hyperparameters (rounds, learning_rate, max_depth, min_leaf, lambda, gamma,
# objective). Returns an opaque model.
fn bi_gbm(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(name, "gbm_fit") {
    if len(args) != 2 and len(args) != 3 {
      return Err(runtime_error(line, "gbm_fit expects (X, y) or (X, y, opts)"))
    }
    let x: tensor.Tensor = arg_tensor(args[0], "gbm_fit", line)?
    if len(x.shape) != 2 {
      return Err(runtime_error(line, bytes.concat("gbm_fit: X must be a 2-D [n, d] tensor, got shape ",
        shape_go(x.shape))))
    }
    let y: tensor.Tensor = arg_tensor(args[1], "gbm_fit", line)?
    if len(y.shape) != 1 {
      return Err(runtime_error(line, bytes.concat("gbm_fit: y must be a 1-D [n] tensor, got shape ",
        shape_go(y.shape))))
    }
    let n: I64 = x.shape[0]
    let d: I64 = x.shape[1]
    if y.shape[0] != n {
      return Err(runtime_error(line, bytes.concat("gbm_fit: X has ", bytes.concat(str(n),
        bytes.concat(" rows but y has ", str(y.shape[0]))))))
    }
    let p: GbmParams = gbm_default_params()
    if len(args) == 3 {
      match args[2] {
        VRecord(opts) => gbm_opts_from_record(opts, p, line)?,
        _ => return Err(runtime_error(line, "gbm_fit: opts must be a record")),
      }
    }
    match gbm_fit(tensor.data_arr(x), tensor.data_arr(y), n, d, p) {
      Ok(h) => return Ok(VForeign(ForeignVal { kind: "gbm model", handle: h })),
      Err(m) => return Err(runtime_error(line, m)),
    }
  }
  # gbm_predict(model, X): score a [n, d] feature matrix with a fitted model,
  # returning an [n] tensor (raw scores for regression, probabilities for a
  # logistic model).
  let handle: I64 = 0
  match args[0] {
    VForeign(fv) => {
      if not bytes.equal(fv.kind, "gbm model") {
        return Err(runtime_error(line, "gbm_predict: first argument must be a model from gbm_fit"))
      }
      handle = fv.handle
    },
    _ => return Err(runtime_error(line, "gbm_predict: first argument must be a model from gbm_fit")),
  }
  let x: tensor.Tensor = arg_tensor(args[1], "gbm_predict", line)?
  if len(x.shape) != 2 {
    return Err(runtime_error(line, bytes.concat("gbm_predict: X must be a 2-D [n, d] tensor, got shape ",
      shape_go(x.shape))))
  }
  match gbm_predict(handle, tensor.data_arr(x), x.shape[0], x.shape[1]) {
    Ok(out) => {
      let shape: Arr[I64] = arr_new()
      push(shape, x.shape[0])
      Ok(VTensor(tensor.mk_raw(shape, out, tensor.DT_F64)))
    },
    Err(m) => Err(runtime_error(line, m)),
  }
}

struct GbmParams {
  rounds: I64,
  max_depth: I64,
  min_leaf: I64,
  learning_rate: F64,
  lambda: F64,
  gamma: F64,
  # "squared" or "logistic". A string rather than an enum because it crosses
  # into the native core, and the core is where the switch on it lives.
  objective: Str,
}

# internal/gbm's DefaultParams. Repeated here rather than asked of the core,
# because the defaults are part of what `gbm_fit(X, y)` means to a reader of a
# twill program and burying them behind a call would hide them.
fn gbm_default_params() -> GbmParams =
  GbmParams {
    rounds: 100,
    max_depth: 3,
    min_leaf: 1,
    learning_rate: 0.1,
    lambda: 1.0,
    gamma: 0.0,
    objective: "squared",
  }

# gbm_opts_from_record overrides GBM parameters from an opts record. Unknown
# keys are ignored so the option set can grow without breaking callers.
fn gbm_opts_from_record(opts: RecordVal, p: GbmParams, line: I64) -> Res[Unit, RuntimeError] {
  match dict_get(opts.fields, "rounds") {
    Some(v) => p.rounds = i64_of_f64(scalar_of(v, "gbm_fit option rounds", line)?),
    None => unit,
  }
  match dict_get(opts.fields, "max_depth") {
    Some(v) => p.max_depth = i64_of_f64(scalar_of(v, "gbm_fit option max_depth", line)?),
    None => unit,
  }
  match dict_get(opts.fields, "min_leaf") {
    Some(v) => p.min_leaf = i64_of_f64(scalar_of(v, "gbm_fit option min_leaf", line)?),
    None => unit,
  }
  match dict_get(opts.fields, "learning_rate") {
    Some(v) => p.learning_rate = scalar_of(v, "gbm_fit option learning_rate", line)?,
    None => unit,
  }
  match dict_get(opts.fields, "lambda") {
    Some(v) => p.lambda = scalar_of(v, "gbm_fit option lambda", line)?,
    None => unit,
  }
  match dict_get(opts.fields, "gamma") {
    Some(v) => p.gamma = scalar_of(v, "gbm_fit option gamma", line)?,
    None => unit,
  }
  match dict_get(opts.fields, "objective") {
    Some(v) => {
      match v {
        VStr(s) => {
          if not bytes.equal(s, "squared") and not bytes.equal(s, "logistic") {
            return Err(runtime_error(line, bytes.concat("gbm_fit: unknown objective ",
              bytes.concat(quoted(s), " (use \"squared\" or \"logistic\")"))))
          }
          p.objective = s
        },
        _ => return Err(runtime_error(line, "gbm_fit: objective must be a string")),
      }
    },
    None => unit,
  }
  Ok(unit)
}
