mode systems

# eval.tw: the twill evaluator, in twill.
#
# PARTIAL, and the boundary is stated up front so nothing below reads as an
# oversight.
#
# What is here: the value model, lexical environments, statement execution,
# expression evaluation, closures and calls, control flow including the return
# signal, indexing and slicing, iteration, equality, and truthiness. That is the
# whole of internal/interp/interp.go's structure, and it is the part that is
# genuinely twill's business.
#
# Also here, since the port of internal/interp/builtins.go landed: the builtin
# table, all ninety-five of them, with the arity handling, the argument
# coercions and the error text of the Go originals.
#
# What those builtins do not carry is the arithmetic. src/tensor.tw has the
# kernels now, so this file calls them by the interface that file declares at
# its head rather than by a native calling convention. The kernels that file
# does not have yet, and that the builtins below name anyway, are NEEDS-54.
#
# The one thing grad needs that neither file has is a way for the arithmetic
# inside an interpreted f to record on a tape. That is NEEDS-75, and it is the
# only hole in this file that is a hole in the middle of something rather than
# at its edge.
#
# What is still not here: the arithmetic underneath the *operators*. eval_binary
# below refuses a tensor operand and points at NEEDS-25. That is now a smaller
# job than it was, since tensor.binary exists, but it is a separate one.
#
# The evaluator is a tree walker, exactly as the bootstrap is. docs/rewrite-plan
# Stage 1 replaces it with a bytecode VM, and when that lands this file becomes
# the emitter's reference for what each node has to mean, which is why it is
# worth writing even though it will not be the thing that runs.

import "ast.tw" as ast
import "parse.tw" as parse
import "bytes.tw" as bytes
import "tensor.tw" as tensor
import "builtins.tw" as builtins
import "std/float" as flt

# ---- values ----------------------------------------------------------------

# A closure captures its defining environment by handle, not by copy. That is
# load-bearing and it is NEEDS-26: `for i in range(3) { push(fs, fn() = i) }`
# has to give three closures that see the loop's binding, and the answer depends
# on whether the capture aliases. The bootstrap aliases, so this does.
struct Closure {
  params: Arr[ast.Param],
  body: ast.Expr,
  env: Env,
  # The name is carried only for diagnostics. An anonymous function has none and
  # the message says "function" instead, which is what the Go side does.
  name: Str,
  # The return annotation, kept so that `-> I64` truncates the returned value the
  # way `let n: I64 = ...` truncates a bound one. A bare `I64` arrives as a
  # one-factor unit and a qualified or generic name as text, which is how the
  # parser records each.
  ret_unit: Opt[ast.UnitAnno],
  ret_type: Str,
}

struct ListVal {
  items: Arr[Value],
}

# A fixed-arity positional group, `(lo, hi)`. It is immutable: there is no set,
# nothing indexes it, and no part of it has a name, so the only things a program
# can do with one are destructure it and pass it on. That is deliberate -- a
# value meant to be stored and read by name is a record, and a tuple that grew
# accessors would be a second, worse one.
struct TupleVal {
  items: Arr[Value],
}

# A record keeps its keys in insertion order, so printing or iterating a
# namespace gives the same result on every run. internal/value/value.go carries
# a Keys slice for exactly this reason; a Dict with insertion order gives it for
# free.
struct RecordVal {
  fields: Dict[Str, Value],
  # The struct a typed literal was built from (`Lexer { ... }`), or "" for a
  # plain record. Struct types are otherwise erased; the name is kept so a field
  # assignment can find the field's declared type (see STRUCT_FIELDS).
  type_name: Str,
}

fn plain_record(fields: Dict[Str, Value]) -> RecordVal =
  RecordVal { fields: fields, type_name: "" }

struct BuiltinVal {
  name: Str,
  # The function a derivative builtin closed over. `grad(f)` does not compute
  # anything: it returns a second builtin that remembers f and differentiates it
  # when that one is called. The Go side gets this from a Go closure over `f`;
  # here the captured value is a field, because a builtin is a name plus what it
  # captured and nothing else.
  #
  # It is also what refuse_nested_grad reads: the returned builtin is named
  # "grad(fn)", and seeing that name in argument position is how grad(grad(f))
  # is recognised.
  captured: Opt[Value],
}

fn plain_builtin(name: Str) -> Value = VBuiltin(BuiltinVal { name: name, captured: None })

# A variant is one case of an enum value: a tag naming the case and an optional
# single payload. A payload-less case (like None) has has_payload false and no
# payload. It is internal/value.Variant, and renders as `Some(5)` or `None`.
struct VariantVal {
  name: Str,
  payload: Opt[Value],
  has_payload: Bool,
}

# A payload case is a one-argument constructor: `Some` is a value in scope that,
# applied to one argument, builds the variant carrying it. The Go bootstrap uses
# a Builtin closure over the case name for this; the self-hosted dispatch is by
# name and cannot hold an arbitrary case name in its builtin table, so a
# constructor is its own small Value carrying the tag. apply builds the variant.
struct VariantCtor {
  name: Str,
  # The case's declared payload type, or "": an `I64` or `F64` payload converts
  # its argument at construction, the same rule a `let` annotation follows.
  payload_type: Str,
}

# A value the native core owns and twill only passes around: a fitted gbm model
# is the only one today. It has no operations of its own, which is the point;
# gbm_predict is the only thing that can read it, and it checks the kind.
struct ForeignVal {
  kind: Str,
  handle: I64,
}

# A dictionary: internal/value.Dict, an insertion-ordered map with string keys.
# Insertion order is why this is a struct around a Dict rather than something
# built out of two lists: a Dict in this language already keeps it, so
# dict_keys and the `{b: 3, a: 1}` rendering come back in the order the program
# built them, which is what makes a printed dictionary reproducible and what
# the Go side's parallel Keys slice exists to give.
#
# The keys are Str because the Go side's are: dict_key_of maps an integer key
# to its decimal text, which is how Dict[I64, V] works there and here.
struct DictVal {
  entries: Dict[Str, Value],
}

# A byte buffer: internal/value.Bytes. bytes_new grows one and buf_new
# allocates one at a fixed length, and they are the same value on the Go side,
# so they are the same value here -- a buffer built by bytes_push can be read
# back with buf_get8.
struct BytesVal {
  buf: Bytes,
}

enum Value {
  # A plain number: one that carries no shape and no gradient history. The
  # bootstrap has this as a distinct case from a rank-0 tensor purely for
  # allocation cost, and measured it at over half the runtime of a scalar loop.
  # The distinction is invisible to a program: `as_tensor` widens on demand and
  # a Num is produced only where nothing can be differentiating it.
  VNum(F64),
  # A systems-mode I64: a two's-complement 64-bit integer held exactly. It is
  # internal/value.Int, and it arises only where the program said I64 -- an
  # `I64` annotation, `i64()`, an integer literal an f64 cannot hold, or an
  # operation on two of them -- so a numeric-mode program never sees one. This
  # evaluator runs on the bootstrap, so arithmetic on the payload is exact.
  VInt(I64),
  VTensor(tensor.Tensor),
  VBool(Bool),
  VStr(Str),
  VList(ListVal),
  VTuple(TupleVal),
  VRecord(RecordVal),
  # A dictionary and a byte buffer are reference values, the way a list and a
  # record are: the payload holds the same underlying Dict or Bytes, so a store
  # through one binding is seen through every other. That is the Go bootstrap's
  # pointer semantics, and a dictionary that copied on every pass would break
  # every caller that builds one in a loop.
  VDict(DictVal),
  VBytes(BytesVal),
  VClosure(Closure),
  VBuiltin(BuiltinVal),
  VForeign(ForeignVal),
  VVariant(VariantVal),
  VVariantCtor(VariantCtor),
  VUnit,
}

fn type_name(v: Value) -> Str {
  match v {
    VNum(_) => "number",
    VInt(_) => "number",
    VTensor(_) => "tensor",
    VBool(_) => "bool",
    VStr(_) => "string",
    VList(_) => "list",
    VTuple(_) => "tuple",
    VRecord(_) => "record",
    VDict(_) => "dict",
    VBytes(_) => "bytes",
    VClosure(_) => "function",
    VBuiltin(_) => "builtin",
    VForeign(f) => f.kind,
    # A constructed variant names itself "variant"; a payload constructor is a
    # callable, and the Go bootstrap makes it a Builtin, so it reads "builtin"
    # here to keep the two sides' diagnostics identical.
    VVariant(_) => "variant",
    VVariantCtor(_) => "builtin",
    VUnit => "unit",
  }
}

# as_tensor widens a number to the rank-0 tensor the engine works in, and passes
# a tensor through untouched. Every place that would otherwise test for a tensor
# goes through here, so widening never loses a graph: anything that could be
# differentiating turns a Num back into a rank-0 tensor first.
fn as_tensor(v: Value) -> Opt[tensor.Tensor] {
  match v {
    VTensor(t) => Some(t),
    VNum(x) => {
      let data: Arr[F64] = arr_new()
      push(data, x)
      Some(tensor.mk_raw(arr_new(), data, tensor.DT_F64))
    },
    VInt(i) => {
      let data: Arr[F64] = arr_new()
      push(data, f64(i))
      Some(tensor.mk_raw(arr_new(), data, tensor.DT_F64))
    },
    _ => None,
  }
}

# A rank-0 tensor or a Num read back as a plain number. Used by the places that
# need a scalar and would rather say so than broadcast.
fn rank0_number(v: Value) -> Opt[F64] {
  match v {
    VNum(x) => Some(x),
    VInt(i) => Some(f64(i)),
    VTensor(t) => {
      if len(t.shape) == 0 { return Some(tensor.at(t, 0)) }
      None
    },
    _ => None,
  }
}

# Truthiness, and it is narrow on purpose. A bool is itself; a number is true
# when non-zero; everything else is an error rather than a convention, because
# `if xs { ... }` meaning "xs is non-empty" is the kind of rule that reads
# differently to every reader.
fn truthy(v: Value, line: I64) -> Res[Bool, RuntimeError] {
  match v {
    VBool(b) => Ok(b),
    VNum(x) => Ok(x != 0.0),
    VInt(i) => Ok(i != 0),
    VTensor(t) => {
      if len(t.shape) == 0 { return Ok(tensor.at(t, 0) != 0.0) }
      Err(runtime_error(line, "condition must be a bool or a scalar number"))
    },
    _ => Err(runtime_error(line, bytes.concat("condition must be a bool or a scalar number, got a ",
      type_name(v)))),
  }
}

# ---- errors and control flow -----------------------------------------------

struct RuntimeError {
  msg: Str,
  line: I64,
}

fn runtime_error(line: I64, msg: Str) -> RuntimeError =
  RuntimeError { msg: msg, line: line }

fn error_text(e: RuntimeError) -> Str =
  bytes.concat("line ", bytes.concat(str(e.line), bytes.concat(": ", e.msg)))

# A `return` unwinds to the enclosing call. The bootstrap does this with a panic
# carrying a returnSignal, recovered in callClosure, because Go has no other way
# to leave a recursive tree walk early.
#
# Here it is a value, because a panic that is part of the normal control flow is
# the thing docs/self-hosting.md section 1.2 narrowed `abort` to exclude. Every
# execution step reports whether it completed or returned, and the cost is that
# every caller has to look, which is what Flow makes unavoidable rather than
# forgettable.
enum Flow {
  Normal(Value),
  Returned(Value),
  BreakF,
  ContinueF,
}

fn flow_value(f: Flow) -> Value {
  match f {
    Normal(v) => v,
    Returned(v) => v,
    BreakF => VUnit,
    ContinueF => VUnit,
  }
}

# ---- environments ----------------------------------------------------------

struct Env {
  vars: Dict[Str, Value],
  parent: Opt[Env],
}

fn new_env(parent: Opt[Env]) -> Env = Env { vars: dict_new(), parent: parent }

fn env_get(e: Env, name: Str) -> Opt[Value] {
  let cur: Opt[Env] = Some(e)
  while true {
    match cur {
      Some(env) => {
        match dict_get(env.vars, name) {
          Some(v) => return Some(v),
          None => cur = env.parent,
        }
      },
      None => return None,
    }
  }
  None
}

fn env_define(e: Env, name: Str, v: Value) {
  dict_set(e.vars, name, v)
}

# Assignment rebinds where the name was defined, walking outward. Defining
# locally instead would make `total = total + x` inside a loop body create a new
# variable each iteration and quietly discard the accumulation.
fn env_assign(e: Env, name: Str, v: Value) -> Bool {
  let cur: Opt[Env] = Some(e)
  while true {
    match cur {
      Some(env) => {
        if dict_has(env.vars, name) {
          dict_set(env.vars, name, v)
          return true
        }
        cur = env.parent
      },
      None => return false,
    }
  }
  false
}

# assign_to stores v into the location named by target: a variable, a record
# field, or an element of a list or flat tensor. Records and lists are reference
# values, so a field or element write is visible through every binding that
# shares them, which is what makes `a.d[i] = v` mutate the object.
fn assign_to(target: ast.Expr, v: Value, env: Env, line: I64) -> Res[Unit, RuntimeError] {
  match target {
    EIdent(t) => {
      if not env_assign(env, t.name, v) {
        # Assigning to a name that was never declared is a typo, not a
        # declaration. `let` is how a binding is introduced and there is exactly
        # one way to do it.
        return Err(runtime_error(line, bytes.concat("cannot assign to undefined variable ",
          bytes.concat(quoted(t.name), " (use 'let' first)"))))
      }
      Ok(unit)
    },
    EField(t) => {
      let obj: Value = eval_expr(t.target, env)?
      match obj {
        VRecord(r) => {
          # A struct's field keeps its declared type across an assignment, so
          # `lx.i = lx.i + 1` on an I64 field stays an I64.
          let stored: Value = v
          if len(r.type_name) > 0 {
            match struct_field_type(r.type_name, t.name) {
              Some(ft) => stored = coerce_field(ft, v, t.line)?,
              None => unit,
            }
          }
          dict_set(r.fields, t.name, stored)
          Ok(unit)
        },
        _ => Err(runtime_error(t.line, bytes.concat("cannot set field ",
          bytes.concat(quoted(t.name), " of a non-record")))),
      }
    },
    EIndex(t) => {
      let obj: Value = eval_expr(t.target, env)?
      let idx_val: Value = eval_expr(t.index, env)?
      # A dictionary is subscripted by its key, `counts[tok] = n`, which is how
      # every caller writes it. dict_set is the same store under a name. The
      # test comes before the numeric index below because a key is a string and
      # would fail that one.
      match obj {
        VDict(d) => {
          match idx_val {
            VStr(k) => {
              dict_set(d.entries, k, v)
              return Ok(unit)
            },
            _ => return Err(runtime_error(t.line, "a dictionary key must be a string")),
          }
        },
        _ => unit,
      }
      let idx: I64 = 0
      match rank0_number(idx_val) {
        Some(n) => idx = i64_of_f64(n),
        None => return Err(runtime_error(t.line, "index must be a scalar number")),
      }
      match obj {
        VList(l) => {
          if idx < 0 or idx >= len(l.items) {
            return Err(runtime_error(t.line, bytes.concat("list index ",
              bytes.concat(str(idx), " out of range"))))
          }
          l.items[idx] = v
          Ok(unit)
        },
        VTensor(tn) => {
          let s: F64 = 0.0
          match rank0_number(v) {
            Some(n) => s = n,
            None => return Err(runtime_error(t.line, "can only assign a scalar to a tensor element")),
          }
          if idx < 0 or idx >= tensor.numel(tn) {
            return Err(runtime_error(t.line, bytes.concat("tensor index ",
              bytes.concat(str(idx), " out of range"))))
          }
          tensor.set_at(tn, idx, s)
          Ok(unit)
        },
        _ => Err(runtime_error(t.line, "value is not indexable")),
      }
    },
    _ => Err(runtime_error(line, "cannot assign to this expression")),
  }
}

# exec_let_tuple runs `let (lo, hi) = span(xs)`: the value has to be a tuple of
# exactly as many parts as there are names, and each name takes its own part.
# `_` stands for a position the program does not want and binds nothing, the way
# it does in a pattern.
fn exec_let_tuple(st: ast.LetTuple, env: Env) -> Res[Flow, RuntimeError] {
  let v: Value = eval_expr(st.value, env)?
  let tup: TupleVal = match v {
    VTuple(t) => t,
    _ => return Err(runtime_error(st.line,
      bytes.concat("a destructuring let needs a tuple of ",
      bytes.concat(str(len(st.names)),
      bytes.concat(" values on the right, but the value is ", format_value(v)))))),
  }
  if len(tup.items) != len(st.names) {
    return Err(runtime_error(st.line,
      bytes.concat("a destructuring let of ",
      bytes.concat(str(len(st.names)),
      bytes.concat(" names needs a tuple of ",
      bytes.concat(str(len(st.names)),
      bytes.concat(" values, but the value has ", str(len(tup.items)))))))))
  }
  let i: I64 = 0
  while i < len(st.names) {
    if not bytes.equal(st.names[i], "_") {
      env_define(env, st.names[i], tup.items[i])
    }
    i = i + 1
  }
  Ok(Normal(VUnit))
}

# ---- statements ------------------------------------------------------------

fn exec_stmt(s: ast.Stmt, env: Env) -> Res[Flow, RuntimeError] {
  match s {
    SLet(st) => {
      let v: Value = eval_expr(st.value, env)?
      v = container_for_annotation(st.type_name, v)
      v = tensor_for_annotation(anno_name(st.type_name, st.unit), v)
      # A number bound at an `I64` annotation becomes an Int, and one bound at
      # `F64` a Num: the annotation is where the program says which half of the
      # language the value lives in.
      env_define(env, st.name, coerce_scalar_anno(st.type_name, st.unit, v, st.line)?)
      Ok(Normal(VUnit))
    },
    SLetTuple(st) => exec_let_tuple(st, env),
    SFn(st) => {
      # A declaration binds before its body can run, so a function can call
      # itself. It captures the environment it is declared in, which is the same
      # environment the binding lands in, so the recursion resolves.
      env_define(env, st.name, VClosure(Closure {
        params: st.params, body: st.body, env: env, name: st.name,
        ret_unit: st.ret_unit, ret_type: st.ret_type,
      }))
      Ok(Normal(VUnit))
    },
    SAssign(st) => {
      let v: Value = eval_expr(st.value, env)?
      assign_to(st.target, v, env, st.line)?
      Ok(Normal(VUnit))
    },
    SWhile(st) => exec_while(st, env),
    SFor(st) => exec_for(st, env),
    SReturn(st) => {
      match st.value {
        Some(e) => Ok(Returned(eval_expr(e, env)?)),
        None => Ok(Returned(VUnit)),
      }
    },
    SImport(st) => exec_import(st, env),
    SEnum(st) => {
      # Each case becomes a value in scope: a payload case is a one-argument
      # constructor (VVariantCtor, which apply turns into the variant carrying
      # its argument), a payload-less case is the variant value itself. That is
      # what makes `Some(x)` a call and `None` a bare name.
      let i: I64 = 0
      while i < len(st.variants) {
        let vt: ast.EnumVariant = st.variants[i]
        if vt.has_payload {
          env_define(env, vt.name, VVariantCtor(VariantCtor { name: vt.name, payload_type: vt.payload }))
        } else {
          env_define(env, vt.name, VVariant(VariantVal { name: vt.name, payload: None, has_payload: false }))
        }
        i = i + 1
      }
      Ok(Normal(VUnit))
    },
    STypeDecl(_) => Ok(Normal(VUnit)),
    # A struct is a record type: checked statically, erased at runtime, since a
    # record carries its own fields and needs no declaration to be built.
    SStruct(sd) => {
      # The field types are kept anyway, so that a typed literal can convert a
      # number at an I64 or F64 field, and read an empty `[]` at a container
      # field as that container.
      let fields: Dict[Str, Str] = dict_new()
      let i: I64 = 0
      while i < len(sd.fields) {
        let f: ast.StructField = sd.fields[i]
        dict_set(fields, f.name, f.type_name)
        i = i + 1
      }
      dict_set(STRUCT_FIELDS, sd.name, fields)
      Ok(Normal(VUnit))
    },
    # A unit declaration is erased at run time: units are a static check and
    # carry no representation in a value.
    SUnitDecl(_) => Ok(Normal(VUnit)),
    # An `if` or a `match` in statement position is executed rather than
    # evaluated, so a `return`, `break` or `continue` inside one reaches the
    # loop or the function it belongs to. Going through eval_expr collapses the
    # Flow to a value (see eval_if), which meant `if c { return 9 }` computed 9
    # and threw it away, and `if c { break }` never left the loop.
    SExpr(st) => match st.x {
      EIf(x) => exec_if(x, env),
      EMatch(x) => exec_match_stmt(x, env),
      EBlock(b) => exec_block(b, new_env(Some(env))),
      _ => Ok(Normal(eval_expr(st.x, env)?)),
    },
    SBlock(b) => exec_block(b, new_env(Some(env))),
    SBreak(_) => Ok(BreakF),
    SContinue(_) => Ok(ContinueF),
  }
}

# A block's value is its last expression statement, and a declaration or a loop
# resets it to unit. A `return` anywhere inside stops the block and propagates.
fn exec_block(b: ast.Block, scope: Env) -> Res[Flow, RuntimeError] {
  let last: Value = VUnit
  for s in b.body {
    let f: Flow = exec_stmt(s, scope)?
    # A `?` that failed anywhere inside that statement returns from the
    # enclosing function, and this is the nearest boundary that can say so.
    match take_pending_try() {
      Some(failure) => return Ok(Returned(failure)),
      None => unit,
    }
    match f {
      Returned(v) => return Ok(Returned(v)),
      BreakF => return Ok(BreakF),
      ContinueF => return Ok(ContinueF),
      Normal(v) => {
        match s {
          SExpr(_) => last = v,
          _ => last = VUnit,
        }
      },
    }
  }
  Ok(Normal(last))
}

fn exec_while(st: ast.While, env: Env) -> Res[Flow, RuntimeError] {
  while true {
    let c: Value = eval_expr(st.cond, env)?
    if not truthy(c, st.line)? {
      break
    }
    # A fresh scope per iteration, so a `let` in the body does not leak into the
    # next one and a closure made in the body captures that iteration.
    let f: Flow = exec_block(st.body, new_env(Some(env)))?
    match f {
      Returned(v) => return Ok(Returned(v)),
      BreakF => return Ok(Normal(VUnit)),
      ContinueF => unit,
      Normal(_) => unit,
    }
  }
  Ok(Normal(VUnit))
}

fn exec_for(st: ast.For, env: Env) -> Res[Flow, RuntimeError] {
  # `for i in range(n)` is the overwhelmingly common form, and materialising a
  # list of n values to iterate it is a per-loop allocation of the loop's whole
  # extent. The bootstrap special-cases it (interp.rangeLoop) and so does this,
  # for the same reason and with the same observable behaviour.
  match range_loop(st.iter, env) {
    Some(r) => {
      let i: I64 = r.start
      while (r.step > 0 and i < r.end) or (r.step < 0 and i > r.end) {
        let scope: Env = new_env(Some(env))
        env_define(scope, st.name, VNum(f64_of_i64(i)))
        let f: Flow = exec_block(st.body, scope)?
        match f {
          Returned(v) => return Ok(Returned(v)),
          BreakF => return Ok(Normal(VUnit)),
          ContinueF => unit,
          Normal(_) => unit,
        }
        i = i + r.step
      }
      return Ok(Normal(VUnit))
    },
    None => unit,
  }

  let it: Value = eval_expr(st.iter, env)?
  let items: Arr[Value] = iterate(it, st.line)?
  let k: I64 = 0
  while k < len(items) {
    let scope: Env = new_env(Some(env))
    env_define(scope, st.name, items[k])
    let f: Flow = exec_block(st.body, scope)?
    match f {
      Returned(v) => return Ok(Returned(v)),
      BreakF => return Ok(Normal(VUnit)),
      ContinueF => unit,
      Normal(_) => unit,
    }
    k = k + 1
  }
  Ok(Normal(VUnit))
}

struct RangeSpec {
  start: I64,
  end: I64,
  step: I64,
}

# Recognise `range(...)` written literally at the loop's iterator position, with
# constant-foldable arguments. Anything else falls through to the general path,
# including a variable that happens to hold a range's result, because that is a
# list by then and iterating it is correct.
fn range_loop(iter: ast.Expr, env: Env) -> Opt[RangeSpec] {
  match iter {
    ECall(c) => {
      match c.callee {
        EIdent(id) => {
          if not bytes.equal(id.name, "range") { return None }
          # A local binding named `range` shadows the builtin, and honouring
          # that is what keeps this an optimisation rather than a language rule.
          match env_get(env, "range") {
            Some(_) => return None,
            None => unit,
          }
          if len(c.args) < 1 or len(c.args) > 3 { return None }
          let nums: Arr[I64] = arr_new()
          let i: I64 = 0
          while i < len(c.args) {
            match const_i64(c.args[i], env) {
              Some(n) => push(nums, n),
              None => return None,
            }
            i = i + 1
          }
          if len(nums) == 1 { return Some(RangeSpec { start: 0, end: nums[0], step: 1 }) }
          if len(nums) == 2 { return Some(RangeSpec { start: nums[0], end: nums[1], step: 1 }) }
          if nums[2] == 0 { return None }
          Some(RangeSpec { start: nums[0], end: nums[1], step: nums[2] })
        },
        _ => None,
      }
    },
    _ => None,
  }
}

# Only a literal, or a name already bound to a whole number. Not a general
# constant folder: the loop bounds have to mean the same thing they would if the
# list had been built, and evaluating an arbitrary expression twice would not.
fn const_i64(e: ast.Expr, env: Env) -> Opt[I64] {
  match e {
    ENumber(n) => whole(n.value),
    EIdent(id) => {
      match env_get(env, id.name) {
        Some(v) => {
          match rank0_number(v) {
            Some(x) => whole(x),
            None => None,
          }
        },
        None => None,
      }
    },
    _ => None,
  }
}

fn whole(x: F64) -> Opt[I64] {
  let n: I64 = i64_of_f64(x)
  if f64_of_i64(n) == x { return Some(n) }
  None
}

# iterate turns a value into the sequence a `for` walks. Iterating a matrix
# yields its rows, which is what makes `for row in X` read the way it looks.
fn iterate(v: Value, line: I64) -> Res[Arr[Value], RuntimeError] {
  match v {
    VList(l) => Ok(l.items),
    VTensor(t) => {
      if len(t.shape) == 0 {
        return Err(runtime_error(line, "cannot iterate a scalar"))
      }
      Ok(tensor_rows(t))
    },
    _ => Err(runtime_error(line, bytes.concat("cannot iterate a ", type_name(v)))),
  }
}

fn tensor_rows(t: tensor.Tensor) -> Arr[Value] {
  let out: Arr[Value] = arr_new()
  let n: I64 = t.shape[0]
  let row_shape: Arr[I64] = arr_new()
  let i: I64 = 1
  while i < len(t.shape) {
    push(row_shape, t.shape[i])
    i = i + 1
  }
  let stride: I64 = tensor.element_count(row_shape)
  let k: I64 = 0
  while k < n {
    let data: Arr[F64] = arr_new()
    let j: I64 = 0
    while j < stride {
      push(data, tensor.at(t, k * stride + j))
      j = j + 1
    }
    if len(row_shape) == 0 {
      push(out, VNum(data[0]))
    } else {
      push(out, VTensor(tensor.mk_raw(row_shape, data, t.dtype)))
    }
    k = k + 1
  }
  out
}

# ---- imports ---------------------------------------------------------------
#
# PARTIAL. The resolver's policy is here; the file reading and the std lookup
# are NEEDS-28 and NEEDS-51.
#
# The rules that matter and are not obvious:
#   - A path is resolved relative to the importing file, not the process's
#     working directory, so a module that imports a sibling works from anywhere.
#   - `std/...` resolves to the embedded library rather than the filesystem,
#     unless TWILL_STD overrides it.
#   - A `.ra` path is refused outright rather than resolved. See section 4 of
#     docs/self-hosting.md: the extension change is a hard break, and refusing
#     loudly once with the fix in the message is the whole of the migration.
#   - A module is evaluated once and cached, so two importers share its state.
#   - With no alias the module's bindings land in the importer's environment
#     unqualified. With one they land in a record under the alias.
# canonical renders a value in the differential harness's dump form, matching
# cmd/twill/dump.go byte for byte: floats as exact hex bit patterns (f64_hex),
# a scalar tensor and a Num rendered the same, record keys sorted. It is what
# `run --dump=canonical` prints so two binaries can be compared with no tolerance.
fn canonical(v: Value, depth: I64) -> Str {
  if depth > 32 { return "elided" }
  match v {
    VNum(x) => bytes.concat("num ", f64_hex(x)),
    VInt(_) => "opaque value.Int",
    VTensor(t) => {
      if len(t.shape) == 0 { return bytes.concat("num ", f64_hex(tensor.at(t, 0))) }
      let out: Bytes = bytes.new()
      bytes.push_text(out, "tensor shape=[")
      bytes.push_text(out, canon_join_ints(t.shape))
      bytes.push_text(out, "] data=[")
      let n: I64 = tensor.numel(t)
      let i: I64 = 0
      while i < n {
        if i > 0 { bytes.push(out, 32) }
        bytes.push_text(out, f64_hex(tensor.at(t, i)))
        i = i + 1
      }
      bytes.push_text(out, "]")
      bytes.to_str(out)
    },
    VBool(b) => { if b { "bool true" } else { "bool false" } },
    VStr(s) => bytes.concat("str ", str_quote(s)),
    VUnit => "unit",
    VList(l) => {
      let out: Bytes = bytes.new()
      bytes.push_text(out, "list [")
      let i: I64 = 0
      while i < len(l.items) {
        if i > 0 { bytes.push_text(out, ", ") }
        bytes.push_text(out, canonical(l.items[i], depth + 1))
        i = i + 1
      }
      bytes.push_text(out, "]")
      bytes.to_str(out)
    },
    VTuple(t) => {
      let out: Bytes = bytes.new()
      bytes.push_text(out, "tuple (")
      let i: I64 = 0
      while i < len(t.items) {
        if i > 0 { bytes.push_text(out, ", ") }
        bytes.push_text(out, canonical(t.items[i], depth + 1))
        i = i + 1
      }
      bytes.push_text(out, ")")
      bytes.to_str(out)
    },
    VRecord(r) => {
      let keys: Arr[Str] = canon_sort(dict_keys(r.fields))
      let out: Bytes = bytes.new()
      bytes.push_text(out, "record {")
      let i: I64 = 0
      while i < len(keys) {
        if i > 0 { bytes.push_text(out, ", ") }
        bytes.push_text(out, keys[i])
        bytes.push_text(out, ": ")
        bytes.push_text(out, canonical(dict_must(r.fields, keys[i]), depth + 1))
        i = i + 1
      }
      bytes.push_text(out, "}")
      bytes.to_str(out)
    },
    VClosure(c) => {
      let nm: Str = c.name
      if len(nm) == 0 { nm = "anonymous" }
      bytes.concat("fn ", bytes.concat(nm, bytes.concat("/", str(len(c.params)))))
    },
    VBuiltin(b) => bytes.concat("builtin ", b.name),
    # A variant or a foreign handle has no portable canonical form in the Go
    # dumper either; it prints the Go type name. Nothing in the corpus binds one
    # at the top level, so the exact spelling here is not compared.
    VVariant(_) => "opaque *value.Variant",
    VVariantCtor(_) => "opaque *value.Builtin",
    # A dictionary and a byte buffer have no case in cmd/twill/dump.go either,
    # so they fall to its `opaque %T` default and print the Go type name.
    VDict(_) => "opaque *value.Dict",
    VBytes(_) => "opaque *value.Bytes",
    VForeign(f) => bytes.concat("opaque ", f.kind),
  }
}

# Shape dimensions joined with ", ", matching Go's joinInts in the dumper (which
# differs from shape_go's space-joined error-message form).
fn canon_join_ints(shape: Arr[I64]) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(shape) {
    push(parts, str(shape[i]))
    i = i + 1
  }
  bytes.join(parts, ", ")
}

# A byte-wise ascending sort of strings, Go's sort.Strings, for a record's keys.
# Insertion sort: a record has a handful of fields, not thousands.
fn canon_sort(xs: Arr[Str]) -> Arr[Str] {
  let out: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(xs) {
    push(out, xs[i])
    i = i + 1
  }
  let j: I64 = 1
  while j < len(out) {
    let key: Str = out[j]
    let k: I64 = j - 1
    while k >= 0 and canon_str_less(key, out[k]) {
      out[k + 1] = out[k]
      k = k - 1
    }
    out[k + 1] = key
    j = j + 1
  }
  out
}

fn canon_str_less(a: Str, b: Str) -> Bool {
  let n: I64 = len(a)
  if len(b) < n { n = len(b) }
  let i: I64 = 0
  while i < n {
    if a[i] < b[i] { return true }
    if a[i] > b[i] { return false }
    i = i + 1
  }
  len(a) < len(b)
}

# Truncate a scalar bound at an `I64` annotation toward zero. On a real I64
# runtime `/` between integers is already integer division; the bootstrap runs
# every number as a float64, so `rem / stride` comes back fractional and, used as
# a buffer index in the ported tensor kernels (transpose_origins and friends),
# reads out of bounds. Applying the annotation's integer truncation at the bind
# is what makes the interpreted arithmetic match the compiled I64 semantics. Only
# a bare `I64` annotation on a scalar Num is coerced; `Arr[I64]`, `F64`, an
# unannotated let and non-numeric values pass through untouched.
fn coerce_scalar_anno(type_name: Str, u: Opt[ast.UnitAnno], v: Value, line: I64) -> Res[Value, RuntimeError] {
  if is_i64_anno(type_name, u) {
    return to_int(v, line)
  }
  if is_f64_anno(type_name, u) {
    match v {
      VInt(i) => return Ok(VNum(f64(i))),
      _ => unit,
    }
  }
  Ok(v)
}

# STRUCT_FIELDS is each declared struct's field types by name, kept so a typed
# literal or a field assignment can apply the field's declared type. It is
# interp.structFields.
let STRUCT_FIELDS: Dict[Str, Dict[Str, Str]] = dict_new()

# bare_type_name drops a module qualifier, so "resolve.Catalog" gives "Catalog".
fn bare_type_name(name: Str) -> Str {
  let i: I64 = len(name) - 1
  while i >= 0 {
    if name[i] == 46 { return slice(name, i + 1, len(name)) }
    i = i - 1
  }
  name
}

fn struct_field_type(type_name: Str, field: Str) -> Opt[Str] {
  match dict_get(STRUCT_FIELDS, type_name) {
    Some(fields) => dict_get(fields, field),
    None => None,
  }
}

# coerce_field applies a struct field's declared type to a value stored in it:
# a literal at a container type builds the container, and a number at an I64 or
# F64 field converts, the same two rules a `let` annotation follows.
fn coerce_field(field_type: Str, v: Value, line: I64) -> Res[Value, RuntimeError] {
  let out: Value = container_for_annotation(field_type, v)
  coerce_scalar_anno(field_type, None, out, line)
}

# to_int converts a numeric value to an Int, truncating a fractional one toward
# zero. A non-numeric value passes through unchanged. A number an I64 cannot
# hold -- NaN, an infinity, or a magnitude at or beyond 2^63 -- is an error
# rather than a saturated or wrapped value.
fn to_int(v: Value, line: I64) -> Res[Value, RuntimeError] {
  match v {
    VInt(_) => Ok(v),
    VNum(x) => int_of_float(x, line),
    VTensor(t) => {
      if len(t.shape) == 0 { return int_of_float(tensor.at(t, 0), line) }
      Ok(v)
    },
    _ => Ok(v),
  }
}

fn int_of_float(x: F64, line: I64) -> Res[Value, RuntimeError] {
  if x != x or x < -9223372036854775808.0 or x >= 9223372036854775808.0 {
    return Err(runtime_error(line, bytes.concat("cannot convert ",
      bytes.concat(num_to_text(x), " to I64: out of range"))))
  }
  Ok(VInt(i64_of_f64(f64_trunc(x))))
}

# int_literal reads an integer literal that an f64 would round: one whose
# magnitude is above 2^53. Small integer literals stay Num, so a numeric-mode
# program is untouched. `negate` is set when the literal sits under a unary
# minus, which is how MIN_I64 is spelled: 9223372036854775808 alone does not
# fit and is rejected, but its negation does.
fn int_literal(text: Str, negate: Bool) -> Opt[Value] {
  if len(text) == 0 { return None }
  let i: I64 = 0
  while i < len(text) {
    if text[i] < 48 or text[i] > 57 { return None }
    i = i + 1
  }
  # The digits are accumulated negatively so MIN_I64, whose magnitude does not
  # fit positive, still parses; i64_of_str cannot be used here because its
  # payload travels as an f64 and rounds the very digits this exists to keep.
  let limit: I64 = -922337203685477580
  let n: I64 = 0
  i = 0
  while i < len(text) {
    let d: I64 = text[i] - 48
    if n < limit { return None }
    if n == limit {
      if negate and d > 8 { return None }
      if not negate and d > 7 { return None }
    }
    n = n * 10 - d
    i = i + 1
  }
  if not negate { n = 0 - n }
  if n >= -9007199254740992 and n <= 9007199254740992 { return None }
  Some(VInt(n))
}

# int_operands reports whether a binary operation is an I64 operation: both
# sides Int, or one side Int and the other an integral number standing for one.
# Two Nums are never an I64 operation, which is what keeps numeric mode's `/` a
# float division.
struct IntPair { x: I64, y: I64 }

fn int_operands(l: Value, r: Value) -> Opt[IntPair] {
  match l {
    VInt(a) => {
      match r {
        VInt(b) => Some(IntPair { x: a, y: b }),
        _ => {
          match as_int(r) {
            Some(b) => Some(IntPair { x: a, y: b }),
            None => None,
          }
        },
      }
    },
    _ => {
      match r {
        VInt(b) => {
          match as_int(l) {
            Some(a) => Some(IntPair { x: a, y: b }),
            None => None,
          }
        },
        _ => None,
      }
    },
  }
}

# as_int reads a value as an I64: an Int directly, or an integral Num (or
# rank-0 tensor) that stands for one. None for a fractional number and for
# anything non-numeric.
fn as_int(v: Value) -> Opt[I64] {
  match v {
    VInt(i) => Some(i),
    _ => {
      match rank0_number(v) {
        Some(x) => int_of_num(x),
        None => None,
      }
    },
  }
}

fn int_of_num(x: F64) -> Opt[I64] {
  if x != f64_trunc(x) or x < -9223372036854775808.0 or x >= 9223372036854775808.0 { return None }
  Some(i64_of_f64(x))
}

# int_arith is `+ - * / % //` on two I64s. Everything wraps; the two divisions
# truncate toward zero and refuse a zero divisor. `^` is left to the float path
# on purpose. This evaluator runs on the bootstrap, whose I64 arithmetic is the
# semantics being defined, so each line below is the operation itself.
fn int_arith(op: Str, x: I64, y: I64, line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(op, "+") { return Ok(VInt(x + y)) }
  if bytes.equal(op, "-") { return Ok(VInt(x - y)) }
  if bytes.equal(op, "*") { return Ok(VInt(x * y)) }
  if bytes.equal(op, "/") or bytes.equal(op, "//") {
    if y == 0 { return Err(runtime_error(line, "integer division by zero")) }
    return Ok(VInt(x / y))
  }
  if y == 0 { return Err(runtime_error(line, "integer modulo by zero")) }
  Ok(VInt(x % y))
}

fn is_int_arith_op(op: Str) -> Bool =
  bytes.equal(op, "+") or bytes.equal(op, "-") or bytes.equal(op, "*")
    or bytes.equal(op, "/") or bytes.equal(op, "%") or bytes.equal(op, "//")

fn is_compare_op(op: Str) -> Bool =
  bytes.equal(op, "==") or bytes.equal(op, "!=") or bytes.equal(op, "<")
    or bytes.equal(op, "<=") or bytes.equal(op, ">") or bytes.equal(op, ">=")

# int_compare orders two I64s exactly, so a value above 2^53 is not compared
# through an f64 that cannot tell it from its neighbour.
fn int_compare(op: Str, x: I64, y: I64) -> Bool {
  if bytes.equal(op, "==") { return x == y }
  if bytes.equal(op, "!=") { return x != y }
  if bytes.equal(op, "<") { return x < y }
  if bytes.equal(op, "<=") { return x <= y }
  if bytes.equal(op, ">") { return x > y }
  x >= y
}

# is_f64_anno reports whether an annotation is a bare `F64`, the systems-mode
# float. Like is_i64_anno it reads whichever slot the parser used.
fn is_f64_anno(type_name: Str, u: Opt[ast.UnitAnno]) -> Bool {
  if bytes.equal(type_name, "F64") { return true }
  match u {
    Some(anno) => {
      if len(anno.factors) == 1 {
        let f: ast.UnitFactor = anno.factors[0]
        return bytes.equal(f.name, "F64") and f.exp == 1
      }
      false
    },
    None => false,
  }
}

# CALL_DEPTH counts the closures currently executing. It is what tells a `?`
# at the top of a file that there is no function to return the failure from,
# and it is what the recursion limit counts.
let CALL_DEPTH: Arr[I64] = [0]

# MAX_CALL_DEPTH is how many twill calls may be nested before the evaluator
# refuses to go further, and it is interp.DefaultMaxCallDepth: the two engines
# refuse the same programs at the same depth with the same words.
#
# The bootstrap's reason for having a limit at all is that a Go stack overflow
# is fatal and cannot be recovered from, so a missing base case took the whole
# process down with several hundred lines of runtime internals. This evaluator
# runs on the bootstrap and so inherits that, and would in any case want the
# same refusal for its own sake. The number is measured, not guessed, and what
# it does and does not buy is written out at DefaultMaxCallDepth in
# internal/interp/interp.go: 10,000 is far above anything a real program needs,
# and it is below the host's crash only for calls that do not sit too deep
# inside the expression around them. There is no number that is below it for
# every shape.
#
# One consequence is worth writing down, because it decides how the two engines
# are made to agree. When this evaluator runs on the bootstrap there are two
# counters over one stack, and each twill frame here costs exactly eight
# bootstrap frames: measured on `twill run src/main.tw run prog.tw`, the outer
# depth is 8*inner + 9. So the outer limit is met first at 1,248 of the inner
# program's calls, and the refusal, while still a twill diagnostic, names a
# function in this file rather than one in prog.tw.
#
# Sharing one constant cannot fix that: reaching L here needs more than 8L
# frames out there, which is more than L for every L. The host has to be given
# the larger number, and TWILL_MAX_CALL_DEPTH is how. 80,013 is the bisected
# number this evaluator needs, and with it
# `TWILL_MAX_CALL_DEPTH=100000 twill run src/main.tw run prog.tw` prints the
# same bytes the bootstrap prints for prog.tw. That command is what
# interp.TestSelfHostedRefusalsMatchTheBootstrap runs.
let MAX_CALL_DEPTH: I64 = 10000

# call_depth_message is the refusal. interp.callDepthMessage is the same text
# and the two must agree character for character;
# interp.TestSelfHostedRefusalsMatchTheBootstrap is what holds them together.
fn call_depth_message(name: Str, depth: I64) -> Str {
  let who: Str = "an anonymous function"
  if len(name) > 0 {
    who = quoted(name)
  }
  bytes.concat("call depth limit reached: ", bytes.concat(who,
    bytes.concat(" is ", bytes.concat(str(depth),
      bytes.concat(" calls deep, which is as deep as twill goes. A recursion this deep is ",
        "almost always a missing base case; if it is not, rewrite it as a loop")))))
}

# How many gradient passes are running, so that a gradient taken inside one is
# refused rather than answered with a zero.
#
# refuse_nested_grad catches `grad(grad(f))` written directly, and misses it
# the long way round: `let g = grad(f)` and then `grad(fn(x) = g(x) * 2)` puts a
# user function between the two, so the argument is not a grad builtin and the
# direct check sees nothing. The inner call still returns a value with no
# history, the outer pass still differentiates a constant, and the answer is
# still zero -- silently, which is the one thing docs/DECISIONS.md says this
# refusal exists to prevent. The bootstrap has carried this counter since the
# refusal was written; this side did not, and answered [0, 0].
let GRAD_DEPTH: Arr[I64] = [0]

# The failure a `?` is carrying out of the function, when one is in flight.
#
# `?` returns the failure from the enclosing function, and an expression here
# has nowhere to put a Flow: eval_expr yields a Value, so eval_try could only
# hand the failure back as the expression's value and the function carried on.
# That was the documented gap this file's `?` comment named.
#
# So the failure is parked here and collected at the next statement boundary,
# which is the nearest place that can turn it into a `Returned`. That is what
# the Go bootstrap's panic does, minus the panic: the same unwinding, expressed
# as a value, because a panic in normal control flow is what
# docs/self-hosting.md narrowed `abort` to exclude. Empty means nothing is in
# flight, and it is emptied by whoever collects it.
let TRY_PENDING: Arr[Value] = arr_new()

# The failure in flight, if there is one, taking it. Called at every statement
# boundary; nothing else should read the slot.
fn take_pending_try() -> Opt[Value] {
  if len(TRY_PENDING) == 0 {
    return None
  }
  let v: Value = TRY_PENDING[0]
  arr_clear(TRY_PENDING)
  Some(v)
}

# anno_head returns the constructor at the head of a type annotation, so that
# "Arr[Str]" gives "Arr" and "Dict[Str, I64]" gives "Dict".
fn anno_head(type_name: Str) -> Str {
  let i: I64 = 0
  while i < len(type_name) {
    if type_name[i] == 91 { return slice(type_name, 0, i) }
    i = i + 1
  }
  type_name
}

# container_for_annotation reads a literal at a container annotation as that
# container. A bracket literal is a tensor when its elements are numbers and a
# list otherwise, and a brace literal with no fields is a record: those are the
# right defaults with nothing else to go on, but an annotation is something
# else to go on.
#
#   let seen: Dict[Str, I64] = {}   // a dictionary, not an empty record
#   let want: Arr[I64] = [1]        // a list of one, not a 1-element tensor
#
# This used to convert only the *empty* bracket literal, and that is docs/BUGS.md
# open divergence 1: `let a: Arr[I64] = [3, 1, 2]` kept its tensor, so every
# later list operation on it took the tensor path and `str(a)` printed
# `tensor([3, 1, 2], shape=[3])` where the bootstrap printed `[3, 1, 2]`. A
# wrong answer rather than a refusal, which is the worse kind: a program that
# sorts a list of numbers got a tensor sort and no error.
#
# Only tensors of rank 0 or 1 convert, since a list is flat; a higher-rank
# tensor at an Arr annotation is left alone rather than silently flattened.
fn container_for_annotation(type_name: Str, v: Value) -> Value {
  let head: Str = anno_head(type_name)
  if bytes.equal(head, "Arr") or bytes.equal(head, "List") {
    match v {
      VTensor(t) => {
        if len(t.shape) <= 1 {
          let items: Arr[Value] = arr_new()
          let i: I64 = 0
          while i < tensor.numel(t) {
            push(items, VNum(tensor.at(t, i)))
            i = i + 1
          }
          return VList(ListVal { items: items })
        }
      },
      _ => unit,
    }
  }
  if bytes.equal(head, "Dict") {
    match v {
      VRecord(r) => {
        if len(dict_keys(r.fields)) == 0 { return VDict(DictVal { entries: dict_new() }) }
      },
      _ => unit,
    }
  }
  v
}

# anno_name is the annotation's name whichever slot the parser put it in: a bare
# name arrives as a one-factor unit, a qualified or generic one as text.
fn anno_name(type_name: Str, u: Opt[ast.UnitAnno]) -> Str {
  if len(type_name) > 0 { return type_name }
  match u {
    Some(anno) => {
      if len(anno.factors) == 1 and anno.factors[0].exp == 1 { return anno.factors[0].name }
      ""
    },
    None => "",
  }
}

# tensor_for_annotation reads a list of numbers at a `Tensor` annotation as a
# tensor. A bracket literal is a tensor when its elements are numeric literals
# and a list otherwise, so `[1.0, 2.0]` is a tensor but `arr(1.0, 2.0)` is not,
# and a caller who annotated `Tensor` and meant it gets one.
#
# This has no counterpart in the container rule above and is not a special case
# of it: that one turns a tensor into a list, this one turns a list into a
# tensor, and a program can want either. It matters here because `arr` had no
# implementation in this evaluator until now, so the annotation could not
# previously be reached with a list to convert -- the program failed earlier,
# loudly. Porting `arr` without this would have turned that refusal into a
# wrong answer, which is the trade docs/BUGS.md keeps arguing against.
#
# A list holding anything but numbers is left alone rather than refused: there
# is no tensor to make of it, and the bootstrap leaves it alone too.
fn tensor_for_annotation(name: Str, v: Value) -> Value {
  if not bytes.equal(name, "Tensor") { return v }
  match v {
    VList(l) => {
      let data: Arr[F64] = arr_new()
      let i: I64 = 0
      while i < len(l.items) {
        match rank0_number(l.items[i]) {
          Some(x) => push(data, x),
          None => return v,
        }
        i = i + 1
      }
      let shape: Arr[I64] = arr_new()
      push(shape, len(data))
      return VTensor(tensor.mk_raw(shape, data, tensor.DT_F64))
    },
    _ => unit,
  }
  v
}

# A bare `I64` annotation reaches here as a one-factor unit (name "I64", exp 1),
# because the parser routes a `.`-or-`[`-free annotation to the unit slot rather
# than type_name. Either spelling counts; `Arr[I64]`, `F64`, a compound unit and
# no annotation do not.
fn is_i64_anno(type_name: Str, u: Opt[ast.UnitAnno]) -> Bool {
  if bytes.equal(type_name, "I64") { return true }
  match u {
    Some(anno) => {
      if len(anno.factors) == 1 {
        let f: ast.UnitFactor = anno.factors[0]
        return bytes.equal(f.name, "I64") and f.exp == 1
      }
      false
    },
    None => false,
  }
}

fn exec_import(st: ast.Import, env: Env) -> Res[Flow, RuntimeError] {
  # The source comes from the native `module_source`, which owns the resolution
  # policy (std embedded, else relative to the running program, `.ra` refused).
  # Everything after is twill: parse the module, run its top level in a fresh
  # scope, then either bind that scope under the alias as a record or, for a
  # plain import, copy its names into the importer's scope.
  let src: Str = ""
  match module_source(st.path) {
    Some(s) => src = s,
    None => return Err(runtime_error(st.line, bytes.concat("cannot read import ", quoted(st.path)))),
  }
  match parse.parse(src) {
    Err(e) => return Err(runtime_error(st.line,
      bytes.concat("import ", bytes.concat(quoted(st.path), " failed to parse")))),
    Ok(prog) => {
      # A fresh module scope with no parent: it reaches builtins through the
      # is_builtin fallback, not through a scope, and must not see the importer's
      # locals. Functions are pre-bound so a top-level `let` may call one declared
      # below it, matching the bootstrap's hoist.
      let mod_env: Env = new_env(None)
      hoist_module_fns(prog.body, mod_env)
      let i: I64 = 0
      while i < len(prog.body) {
        exec_stmt(prog.body[i], mod_env)?
        i = i + 1
      }
      if len(st.alias) == 0 {
        let keys: Arr[Str] = dict_keys(mod_env.vars)
        let j: I64 = 0
        while j < len(keys) {
          match dict_get(mod_env.vars, keys[j]) {
            Some(v) => env_define(env, keys[j], v),
            None => unit,
          }
          j = j + 1
        }
      } else {
        env_define(env, st.alias, VRecord(plain_record(mod_env.vars)))
      }
      Ok(Normal(VUnit))
    },
  }
}

# Pre-bind every top-level function of a module before its body runs, so a
# definition or a module-level `let` may reference a function written lower in
# the file. This is what the bootstrap interpreter's hoist does; the evaluator's
# ordinary exec is single-pass, so imports do it explicitly here.
fn hoist_module_fns(body: Arr[ast.Stmt], env: Env) {
  let i: I64 = 0
  while i < len(body) {
    match body[i] {
      SFn(fd) => env_define(env, fd.name, VClosure(Closure {
        params: fd.params,
        body: fd.body,
        env: env,
        name: fd.name,
        ret_unit: fd.ret_unit,
        ret_type: fd.ret_type,
      })),
      _ => unit,
    }
    i = i + 1
  }
}

# ---- expressions -----------------------------------------------------------

fn eval_expr(e: ast.Expr, env: Env) -> Res[Value, RuntimeError] {
  match e {
    ENumber(x) => {
      match int_literal(x.text, false) {
        Some(v) => Ok(v),
        None => Ok(VNum(x.value)),
      }
    },
    EString(x) => Ok(VStr(x.value)),
    EBool(x) => Ok(VBool(x.value)),
    EIdent(x) => {
      match env_get(env, x.name) {
        Some(v) => Ok(v),
        None => {
          # `unit` is the bare spelling of the Unit value, so an arm like
          # `None => unit` and any nothing-valued expression resolves here. It is
          # a builtin name, not a keyword, so it stays usable as a field name;
          # only the bare identifier resolves to the value.
          if bytes.equal(x.name, "unit") {
            return Ok(VUnit)
          }
          # Res and Opt are built in: their cases are constructors and values
          # in every scope, matching the Go bootstrap's variantCtor set.
          if bytes.equal(x.name, "None") {
            return Ok(VVariant(VariantVal { name: "None", payload: None, has_payload: false }))
          }
          if in_words("Ok Err Some", x.name) {
            return Ok(VVariantCtor(VariantCtor { name: x.name, payload_type: "" }))
          }
          if is_builtin(x.name) {
            return Ok(plain_builtin(x.name))
          }
          Err(runtime_error(x.line, bytes.concat("undefined variable ", quoted(x.name))))
        },
      }
    },
    ETensor(x) => eval_tensor_lit(x, env),
    EList(x) => {
      let items: Arr[Value] = arr_new()
      let i: I64 = 0
      while i < len(x.elements) {
        push(items, eval_expr(x.elements[i], env)?)
        i = i + 1
      }
      Ok(VList(ListVal { items: items }))
    },
    ETuple(x) => {
      let items: Arr[Value] = arr_new()
      let i: I64 = 0
      while i < len(x.elements) {
        push(items, eval_expr(x.elements[i], env)?)
        i = i + 1
      }
      Ok(VTuple(TupleVal { items: items }))
    },
    ELambda(x) => Ok(VClosure(Closure { params: x.params, body: x.body, env: env, name: "",
      ret_unit: x.ret_unit, ret_type: x.ret_type })),
    EUnary(x) => eval_unary(x, env),
    EBinary(x) => eval_binary(x, env),
    ECall(x) => eval_call(x, env),
    EIndex(x) => eval_index(x, env),
    ESlice(x) => eval_slice(x, env),
    ERecord(x) => {
      let fields: Dict[Str, Value] = dict_new()
      let tn: Str = ""
      # `{ ..base, x: 1 }` starts from a copy of the base and then lets the
      # fields written out replace what they name. The copy is shallow: a field
      # holding a list hands over the same list, which is what `{ x: base.x }`
      # written out by hand already does, and making this one case deep would be
      # a second rule for the same syntax.
      #
      # The copy carries the base's struct name, so an update of a `Point` is
      # still a `Point` for the purpose of a later field assignment's coercion.
      # A type name on the literal itself wins, and is set below.
      match x.base {
        Some(b) => {
          match eval_expr(b, env)? {
            VRecord(r) => {
              tn = r.type_name
              for name in dict_keys(r.fields) {
                dict_set(fields, name, dict_must(r.fields, name))
              }
            },
            _ => return Err(runtime_error(x.line,
              "the base of a record update must be a record")),
          }
        },
        None => unit,
      }
      # A typed literal reads its declared field types, so a number at an I64
      # field is an Int, the same rule a `let` annotation follows. The name is
      # looked up unqualified: `resolve.Catalog` and `Catalog` name the same
      # declaration.
      let declared: Opt[Dict[Str, Str]] = dict_get(STRUCT_FIELDS, bare_type_name(x.type_name))
      match declared {
        Some(_) => tn = bare_type_name(x.type_name),
        None => unit,
      }
      let i: I64 = 0
      while i < len(x.fields) {
        let f: ast.RecordField = x.fields[i]
        let v: Value = eval_expr(f.value, env)?
        match declared {
          Some(d) => {
            match dict_get(d, f.name) {
              Some(ft) => v = coerce_field(ft, v, ast.expr_line(f.value))?,
              None => unit,
            }
          },
          None => unit,
        }
        dict_set(fields, f.name, v)
        i = i + 1
      }
      Ok(VRecord(RecordVal { fields: fields, type_name: tn }))
    },
    EField(x) => field_value(eval_expr(x.target, env)?, x.name, x.line),
    EIf(x) => eval_if(x, env),
    EMatch(x) => eval_match(x, env),
    ETry(x) => eval_try(x, env),
    EBlock(b) => Ok(flow_value(exec_block(b, new_env(Some(env)))?)),
  }
}

# Postfix `?`: unwrap a Res/Opt success (the payload of Ok/Some) or, on a failure
# case, hand it back. The Go interp returns the failure from the enclosing
# function via its return signal; the self-hosted evaluator collapses returns at
# every expression boundary (eval_if and eval_match do the same), so here the
# failure variant becomes the expression's value rather than an early return.
# Propagating it needs the evaluator change if-expressions and match arms wait
# on; the parse, check and format of `?` are exact.
fn eval_try(x: ast.Try, env: Env) -> Res[Value, RuntimeError] {
  let v: Value = eval_expr(x.expr, env)?
  match v {
    VVariant(vt) => {
      if bytes.equal(vt.name, "Ok") or bytes.equal(vt.name, "Some") {
        match vt.payload {
          Some(pv) => Ok(pv),
          None => Ok(VUnit),
        }
      } else {
        # At the top of a file there is no function to return the failure
        # from, so `?` there is an error naming the value.
        if CALL_DEPTH[0] == 0 {
          return Err(runtime_error(x.line, bytes.concat("`?` outside a function: the value was ",
            format_value(v))))
        }
        # Park the failure for the next statement boundary to turn into a
        # return, and hand it back as this expression's value so the rest of
        # the statement can finish evaluating harmlessly before it is
        # collected.
        push(TRY_PENDING, v)
        Ok(v)
      }
    },
    _ => Err(runtime_error(x.line, "`?` expects a Res or Opt value")),
  }
}

# `match subject { pattern => body, ... }`. The subject is evaluated once, then
# arms are tried in order, and an arm is taken when its pattern fits the value
# and its guard, if it has one, is true. A pattern is a tree -- `_`, a binder, a
# literal, a case, or a case carrying another pattern -- so `Ok(Some(v))` and
# `Err(-1)` select an arm and bind through the payload. The arm body runs as a
# statement in a child scope holding the pattern's bindings.
#
# The body's Flow is collapsed with flow_value, the same way eval_if collapses a
# block's, so a `return` in an arm yields its value here rather than unwinding
# the enclosing call. That is the tree walker's existing treatment of return in
# expression position (see the EBlock and eval_if arms), and match follows it.
fn eval_match(x: ast.Match, env: Env) -> Res[Value, RuntimeError] {
  let subj: Value = eval_expr(x.subject, env)?
  let i: I64 = 0
  while i < len(x.arms) {
    let arm: ast.MatchArm = x.arms[i]
    # Each arm gets its own scope, and the pattern binds into it as it matches:
    # `Ok(Some(v))` puts the innermost payload in `v`. A failed match leaves the
    # scope to be discarded, so a partially bound arm cannot leak a name into
    # the next one.
    let scope: Env = new_env(Some(env))
    if arm_matches(arm, subj, scope)? {
      return Ok(flow_value(exec_stmt(arm.body, scope)?))
    }
    i = i + 1
  }
  Err(runtime_error(x.line, bytes.concat("no match arm for ", format_value(subj))))
}

# arm_matches decides whether one arm takes the subject, defining the pattern's
# bindings in scope as it goes. The guard sees those bindings and is the last
# word: a false guard falls through to the arms below.
fn arm_matches(arm: ast.MatchArm, subj: Value, scope: Env) -> Res[Bool, RuntimeError] {
  if not match_pattern(arm.pattern, subj, scope)? {
    return Ok(false)
  }
  if len(arm.guard) == 0 {
    return Ok(true)
  }
  let g: Value = eval_expr(arm.guard[0], scope)?
  truthy(g, arm.pattern.line)
}

# match_pattern matches one pattern against one value, defining the pattern's
# bindings in scope, and reports whether the value fits. Bindings are written
# even on the way to a failure, which is safe because the caller gives every arm
# a fresh scope and throws it away when this returns false.
fn match_pattern(pat: ast.MatchPattern, v: Value, scope: Env) -> Res[Bool, RuntimeError] {
  if pat.kind == ast.PAT_BINDING {
    if len(pat.binding) > 0 {
      env_define(scope, pat.binding, v)
    }
    return Ok(true)
  }
  if pat.kind == ast.PAT_LITERAL {
    # The literal is a closed expression -- a number, a string, a boolean, or a
    # negated number -- so it needs no scope of its own, and it is compared with
    # the same equality `==` gives.
    let lit: Value = eval_expr(pat.lit[0], scope)?
    return Ok(deep_equal(lit, v))
  }
  match v {
    VVariant(var) => {
      if not bytes.equal(var.name, pat.variant) { return Ok(false) }
      # A pattern naming the case alone matches it whatever it carries, which is
      # how a payload-less case is written too.
      if len(pat.sub) == 0 { return Ok(true) }
      match var.payload {
        # A pattern asking about a payload that is not there matches nothing,
        # rather than matching a unit that was never written.
        None => Ok(false),
        Some(pv) => match_pattern(pat.sub[0], pv, scope),
      }
    },
    _ => Ok(false),
  }
}

# The flow-preserving twin of eval_match, for a `match` in statement position,
# so a `return` or a `break` in an arm reaches the function or the loop it
# belongs to rather than becoming the arm's value. It repeats eval_match's arm
# selection because the two differ only in the last line, and threading a flag
# through would make the common path read worse than the duplication does.
fn exec_match_stmt(x: ast.Match, env: Env) -> Res[Flow, RuntimeError] {
  let subj: Value = eval_expr(x.subject, env)?
  let i: I64 = 0
  while i < len(x.arms) {
    let arm: ast.MatchArm = x.arms[i]
    let scope: Env = new_env(Some(env))
    if arm_matches(arm, subj, scope)? {
      return exec_stmt(arm.body, scope)
    }
    i = i + 1
  }
  Err(runtime_error(x.line, bytes.concat("no match arm for ", format_value(subj))))
}

# Field access on an already-evaluated target, shared by eval_expr and
# eval_call. eval_call evaluates the target itself so that `t.to(f32)` can be
# recognised before field access refuses a tensor, and without evaluating the
# target twice; the error text lives here once for both.
fn field_value(target: Value, name: Str, line: I64) -> Res[Value, RuntimeError] {
  match target {
    VRecord(r) => {
      match dict_get(r.fields, name) {
        Some(v) => Ok(v),
        None => Err(runtime_error(line, bytes.concat("record has no field ", quoted(name)))),
      }
    },
    _ => Err(runtime_error(line, bytes.concat("cannot read a field of a ", type_name(target)))),
  }
}

# An `if` used as an expression takes the value of whichever block ran. With no
# else and a false condition it is unit, which is why `let x = if c { 1 }` is
# legal and rarely what anyone means.
# The flow-preserving twin of eval_if, for an `if` in statement position. The
# two differ only in what they do with the branch's Flow: this one hands it on,
# eval_if collapses it to a value because an expression has nowhere to put it.
fn exec_if(x: ast.IfExpr, env: Env) -> Res[Flow, RuntimeError] {
  let c: Value = eval_expr(x.cond, env)?
  if truthy(c, x.line)? {
    return exec_block(x.then_block, new_env(Some(env)))
  }
  match x.else_branch {
    ElseBlock(b) => exec_block(b, new_env(Some(env))),
    ElseIf(alt) => exec_if(alt, env),
    NoElse => Ok(Normal(VUnit)),
  }
}

fn eval_if(x: ast.IfExpr, env: Env) -> Res[Value, RuntimeError] {
  let c: Value = eval_expr(x.cond, env)?
  if truthy(c, x.line)? {
    return Ok(flow_value(exec_block(x.then_block, new_env(Some(env)))?))
  }
  match x.else_branch {
    ElseBlock(b) => Ok(flow_value(exec_block(b, new_env(Some(env)))?)),
    ElseIf(alt) => eval_if(alt, env),
    NoElse => Ok(VUnit),
  }
}

# A tensor literal is built by flattening the nesting and reading the shape off
# the first row at each depth, then requiring every other row to match. The
# ragged case is an error here rather than a truncation, which is the same
# decision src/check.tw makes statically.
fn eval_tensor_lit(x: ast.TensorLit, env: Env) -> Res[Value, RuntimeError] {
  let shape: Arr[I64] = arr_new()
  let data: Arr[F64] = arr_new()
  flatten_tensor_lit(x.elements, 0, shape, data, env, x.line)?
  Ok(VTensor(tensor.mk_raw(shape, data, tensor.DT_F64)))
}

fn flatten_tensor_lit(elems: Arr[ast.Expr], depth: I64, shape: Arr[I64],
                      data: Arr[F64], env: Env, line: I64) -> Res[Unit, RuntimeError] {
  if depth == len(shape) {
    push(shape, len(elems))
  } else {
    if shape[depth] != len(elems) {
      return Err(runtime_error(line, "ragged tensor literal: rows have inconsistent lengths"))
    }
  }
  let i: I64 = 0
  while i < len(elems) {
    match elems[i] {
      ETensor(inner) => flatten_tensor_lit(inner.elements, depth + 1, shape, data, env, line)?,
      _ => {
        let v: Value = eval_expr(elems[i], env)?
        match rank0_number(v) {
          Some(n) => push(data, n),
          None => return Err(runtime_error(line, "a tensor literal needs numbers")),
        }
      },
    }
    i = i + 1
  }
  Ok(unit)
}

fn eval_unary(x: ast.Unary, env: Env) -> Res[Value, RuntimeError] {
  if bytes.equal(x.op, "-") {
    # `-9223372036854775808` is MIN_I64 spelled the only way it can be: the
    # magnitude does not fit, its negation does, so the literal is read under
    # the minus rather than after it.
    match x.operand {
      ENumber(lit) => {
        match int_literal(lit.text, true) {
          Some(iv) => return Ok(iv),
          None => unit,
        }
      },
      _ => unit,
    }
  }
  let v: Value = eval_expr(x.operand, env)?
  if bytes.equal(x.op, "-") {
    match v {
      VNum(n) => return Ok(VNum(-n)),
      VInt(i) => return Ok(VInt(0 - i)),
      # Negating a tensor is the elementwise neg kernel, the same traced op the
      # unary-math builtins use, so it records on the tape.
      VTensor(t) => return Ok(VTensor(tr_unary(tensor.OpNeg, t))),
      _ => return Err(runtime_error(x.line, bytes.concat("cannot negate a ", type_name(v)))),
    }
  }
  Ok(VBool(not truthy(v, x.line)?))
}

# str_compare orders two strings by byte, returning -1, 0 or 1. A shorter string
# that is a prefix of a longer one sorts first, which is what comparing the
# lengths after the shared bytes gives.
fn str_compare(a: Str, b: Str) -> I64 {
  let n: I64 = len(a)
  if len(b) < n { n = len(b) }
  let i: I64 = 0
  while i < n {
    if a[i] < b[i] { return -1 }
    if a[i] > b[i] { return 1 }
    i = i + 1
  }
  if len(a) < len(b) { return -1 }
  if len(a) > len(b) { return 1 }
  0
}

# str_order applies one of the four ordering operators to two strings, by byte.
fn str_order(op: Str, a: Str, b: Str) -> Bool {
  let c: I64 = str_compare(a, b)
  if bytes.equal(op, "<") { return c < 0 }
  if bytes.equal(op, "<=") { return c <= 0 }
  if bytes.equal(op, ">") { return c > 0 }
  c >= 0
}

fn eval_binary(x: ast.Binary, env: Env) -> Res[Value, RuntimeError] {
  # `and` and `or` short-circuit, so the right operand is not evaluated unless
  # it is needed. They also return the operand rather than a bool, which is what
  # makes `a or default` an idiom.
  if bytes.equal(x.op, "and") or bytes.equal(x.op, "&&") {
    let l: Value = eval_expr(x.left, env)?
    if not truthy(l, x.line)? { return Ok(l) }
    return eval_expr(x.right, env)
  }
  if bytes.equal(x.op, "or") or bytes.equal(x.op, "||") {
    let l: Value = eval_expr(x.left, env)?
    if truthy(l, x.line)? { return Ok(l) }
    return eval_expr(x.right, env)
  }

  let l: Value = eval_expr(x.left, env)?
  let r: Value = eval_expr(x.right, env)?

  # An I64 operation: both sides Int, or an Int and an integral number. Exact
  # comparison; wrapping arithmetic, truncating division, dividend-signed
  # modulo. It comes before every float path, so an Int never rounds through
  # an f64 on its way to an answer.
  if is_compare_op(x.op) or is_int_arith_op(x.op) {
    match int_operands(l, r) {
      Some(pr) => {
        if is_compare_op(x.op) { return Ok(VBool(int_compare(x.op, pr.x, pr.y))) }
        return int_arith(x.op, pr.x, pr.y, x.line)
      },
      None => unit,
    }
  }

  # The bitwise words are the same operation infix as they are called, so both
  # routes land in bi_bitwise and the two spellings cannot come to mean
  # different things. `and`/`or` are not here: they short-circuited above, as
  # the boolean operators, and reach the bitwise meaning only when called.
  # `//` divides and truncates toward zero: the integer division every
  # `(n + k - 1) // k` and midpoint wants. `/` stays exact float division, so the
  # two intents are written down rather than inferred from the operands.
  if bytes.equal(x.op, "//") {
    let ln: F64 = scalar_of(l, "//", x.line)?
    let rn: F64 = scalar_of(r, "//", x.line)?
    if rn == 0.0 {
      return Err(runtime_error(x.line, "integer division by zero"))
    }
    return Ok(VNum(i64_of_f64(ln / rn)))
  }
  if is_bitwise_op(x.op) {
    let bargs: Arr[Value] = arr_new()
    push(bargs, l)
    push(bargs, r)
    return bi_bitwise(x.op, bargs, x.line)
  }
  if bytes.equal(x.op, "==") { return Ok(VBool(deep_equal(l, r))) }
  if bytes.equal(x.op, "!=") { return Ok(VBool(not deep_equal(l, r))) }

  # An ordering comparison is scalar: a Num or a rank-0 tensor on each side. It
  # has zero gradient, so -- unlike arithmetic, whose fast path is Num-only to
  # keep a traced rank-0 tensor on the tape -- it may read a rank-0 tensor out
  # without breaking a derivative. A non-scalar operand falls through and errors,
  # matching the bootstrap, where the elementwise form is greater/less, not >/<.
  if bytes.equal(x.op, "<") or bytes.equal(x.op, "<=") or bytes.equal(x.op, ">") or bytes.equal(x.op, ">=") {
    match rank0_number(l) {
      Some(a) => {
        match rank0_number(r) {
          Some(b) => return num_arith(x.op, a, b, x.line),
          None => unit,
        }
      },
      None => unit,
    }
    # Two strings order by their bytes. The ordering already existed -- `sort`
    # has always accepted an Arr[Str] -- it just had no operator, so every caller
    # that wanted a sorted list of names wrote its own compare_str returning
    # -1/0/1 and compared that against zero. Byte order rather than anything
    # locale-aware is the same choice `sort` makes, and the one that gives the
    # same answer on every machine.
    match l {
      VStr(ls) => {
        match r {
          VStr(rs) => return Ok(VBool(str_order(x.op, ls, rs))),
          _ => unit,
        }
      },
      _ => unit,
    }
  }

  # `+` concatenates two strings, before the numeric paths, since a string is
  # neither a scalar nor a tensor and would otherwise fall through to the error.
  if bytes.equal(x.op, "+") {
    match l {
      VStr(ls) => {
        match r {
          VStr(rs) => return Ok(VStr(bytes.concat(ls, rs))),
          _ => unit,
        }
      },
      _ => unit,
    }
  }

  # The scalar fast path, which is most of what a twill program actually does
  # and the reason Num exists as a distinct case. It is VNum-only, NOT any rank-0
  # value: a rank-0 *tensor* carries a tape node, and intercepting it here would
  # compute through it untraced and break the derivative. Only a Num, which by
  # construction can carry no gradient, takes this path; a tensor of any rank
  # goes to the traced kernel below.
  match l {
    VNum(a) => {
      match r {
        VNum(b) => return num_arith(x.op, a, b, x.line),
        _ => unit,
      }
    },
    _ => unit,
  }

  # A wider operand is a tensor kernel. `^` takes a scalar exponent; the rest
  # broadcast. Both operands widen through as_tensor, so a tensor-scalar mix (a
  # bias add, a scale) works without a special case.
  if bytes.equal(x.op, "^") {
    match as_tensor(l) {
      Some(a) => {
        match rank0_number(r) {
          Some(p) => return Ok(VTensor(tr_pow_scalar(a, p))),
          None => return Err(runtime_error(x.line, "exponent must be a scalar")),
        }
      },
      None => unit,
    }
  }
  match as_tensor(l) {
    Some(a) => {
      match as_tensor(r) {
        Some(b) => return eval_tensor_binop(x.op, a, b, x.line),
        None => unit,
      }
    },
    None => unit,
  }
  Err(runtime_error(x.line, bytes.concat("operator ", bytes.concat(quoted(x.op),
    " expects numbers/tensors"))))
}

# The elementwise and matmul kernels behind the arithmetic operators, delegating
# to the same traced tensor ops the named builtins use, so `a + b` and the like
# record on the tape exactly as `add(a, b)` would. A comparison operator does not
# reach here: it is scalar-only (the fast path) or an error, matching the
# bootstrap, where the elementwise mask is spelled `greater`/`less`, not `>`/`<`.
fn eval_tensor_binop(op: Str, a: tensor.Tensor, b: tensor.Tensor, line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(op, "+") { return lift_v(tr_binary(tensor.OpAdd, a, b), line) }
  if bytes.equal(op, "-") { return lift_v(tr_binary(tensor.OpSub, a, b), line) }
  if bytes.equal(op, "*") { return lift_v(tr_binary(tensor.OpMul, a, b), line) }
  if bytes.equal(op, "/") { return lift_v(tr_binary(tensor.OpDiv, a, b), line) }
  if bytes.equal(op, "%") { return lift_v(tr_binary(tensor.OpMod, a, b), line) }
  if bytes.equal(op, "@") { return lift_v(tr_matmul(a, b), line) }
  Err(runtime_error(line, bytes.concat("operator ", bytes.concat(quoted(op),
    " does not apply to tensors"))))
}

fn num_arith(op: Str, a: F64, b: F64, line: I64) -> Res[Value, RuntimeError] {
  if bytes.equal(op, "+") { return Ok(VNum(a + b)) }
  if bytes.equal(op, "-") { return Ok(VNum(a - b)) }
  if bytes.equal(op, "*") { return Ok(VNum(a * b)) }
  # Division by zero produces an infinity rather than an error, matching float64
  # semantics. A compiler would want the error; a numeric language wants the
  # IEEE answer, and this is the numeric language.
  if bytes.equal(op, "/") { return Ok(VNum(a / b)) }
  if bytes.equal(op, "%") { return Ok(VNum(f64_mod(a, b))) }
  if bytes.equal(op, "^") { return Ok(VNum(f64_pow(a, b))) }
  if bytes.equal(op, "<") { return Ok(VBool(a < b)) }
  if bytes.equal(op, "<=") { return Ok(VBool(a <= b)) }
  if bytes.equal(op, ">") { return Ok(VBool(a > b)) }
  if bytes.equal(op, ">=") { return Ok(VBool(a >= b)) }
  # `@` on two scalars is their product, since a rank-0 matmul is a
  # multiplication and refusing it would make a generic function fail on the
  # one-element case.
  if bytes.equal(op, "@") { return Ok(VNum(a * b)) }
  Err(runtime_error(line, bytes.concat("unknown operator ", quoted(op))))
}

# Values of different types are never equal, and that is not an error. Comparing
# a string to a number is a question with an answer, and the answer is no.
# internal/interp/equality_test.go pins this rule; see NEEDS-27.
fn deep_equal(l: Value, r: Value) -> Bool {
  # An Int against an integral number compares exactly; against a fractional
  # number, or a non-number, through the float it stands for.
  match int_operands(l, r) {
    Some(pr) => return pr.x == pr.y,
    None => unit,
  }
  match l {
    VNum(a) => {
      match rank0_number(r) {
        Some(b) => a == b,
        None => false,
      }
    },
    VInt(a) => {
      match rank0_number(r) {
        Some(b) => f64(a) == b,
        None => false,
      }
    },
    VBool(a) => {
      match r {
        VBool(b) => a == b,
        _ => false,
      }
    },
    VStr(a) => {
      match r {
        VStr(b) => bytes.equal(a, b),
        _ => false,
      }
    },
    VUnit => {
      match r {
        VUnit => true,
        _ => false,
      }
    },
    VTensor(a) => {
      match r {
        VTensor(b) => tensor_equal(a, b),
        # A rank-0 tensor equals a number of the same value: the two are the
        # same thing with different representations and a program cannot tell
        # them apart anywhere else either.
        VNum(b) => len(a.shape) == 0 and tensor.at(a, 0) == b,
        VInt(b) => len(a.shape) == 0 and tensor.at(a, 0) == f64(b),
        _ => false,
      }
    },
    VList(a) => {
      match r {
        VList(b) => list_equal(a, b),
        _ => false,
      }
    },
    # Structural, and by arity first: a 2-tuple and a 3-tuple are never equal,
    # and a tuple is never equal to a list that happens to hold the same values,
    # because they are not the same kind of thing.
    VTuple(a) => {
      match r {
        VTuple(b) => tuple_equal(a, b),
        _ => false,
      }
    },
    VRecord(a) => {
      match r {
        VRecord(b) => record_equal(a, b),
        _ => false,
      }
    },
    # A dictionary and a byte buffer compare by contents, not by identity: two
    # separately built dictionaries with the same entries are equal, the way
    # two separately built records are. deepEqual on the Go side has a case for
    # each, and TestVariantsCompareStructurally asserts the dictionary one.
    VDict(a) => {
      match r {
        VDict(b) => dict_equal(a, b),
        _ => false,
      }
    },
    VBytes(a) => {
      match r {
        VBytes(b) => bytes.equal(bytes_val_to_str(a), bytes_val_to_str(b)),
        _ => false,
      }
    },
    # An enum value is its case and its payload: `Some(1) == Some(1)`, the way
    # `[1] == [1]`.
    VVariant(a) => {
      match r {
        VVariant(b) => variant_equal(a, b),
        _ => false,
      }
    },
    # Two functions are equal only if they are the same function, and this has
    # no way to ask that, so it says no. Comparing functions is not something a
    # twill program has a reason to do.
    _ => false,
  }
}

fn variant_equal(a: VariantVal, b: VariantVal) -> Bool {
  if not bytes.equal(a.name, b.name) or a.has_payload != b.has_payload { return false }
  if not a.has_payload { return true }
  match a.payload {
    Some(pa) => {
      match b.payload {
        Some(pb) => deep_equal(pa, pb),
        None => false,
      }
    },
    None => {
      match b.payload {
        Some(_) => false,
        None => true,
      }
    },
  }
}

fn tensor_equal(a: tensor.Tensor, b: tensor.Tensor) -> Bool {
  if not tensor.shape_equal(a.shape, b.shape) { return false }
  let i: I64 = 0
  while i < tensor.numel(a) {
    if tensor.at(a, i) != tensor.at(b, i) { return false }
    i = i + 1
  }
  true
}

fn list_equal(a: ListVal, b: ListVal) -> Bool {
  if len(a.items) != len(b.items) { return false }
  let i: I64 = 0
  while i < len(a.items) {
    if not deep_equal(a.items[i], b.items[i]) { return false }
    i = i + 1
  }
  true
}

fn tuple_equal(a: TupleVal, b: TupleVal) -> Bool {
  if len(a.items) != len(b.items) { return false }
  let i: I64 = 0
  while i < len(a.items) {
    if not deep_equal(a.items[i], b.items[i]) { return false }
    i = i + 1
  }
  true
}

# Field order does not affect equality: two records with the same fields and
# the same values are equal whichever order they were written in. Order is kept
# for printing, not for identity.
fn record_equal(a: RecordVal, b: RecordVal) -> Bool {
  if len(a.fields) != len(b.fields) { return false }
  for k in dict_keys(a.fields) {
    match dict_get(b.fields, k) {
      Some(v) => {
        if not deep_equal(dict_must(a.fields, k), v) { return false }
      },
      None => return false,
    }
  }
  true
}

# Key order does not affect equality either, for the same reason it does not
# for a record: it is kept for printing, not for identity.
fn dict_equal(a: DictVal, b: DictVal) -> Bool {
  if len(dict_keys(a.entries)) != len(dict_keys(b.entries)) { return false }
  for k in dict_keys(a.entries) {
    match dict_get(b.entries, k) {
      Some(v) => {
        if not deep_equal(dict_must(a.entries, k), v) { return false }
      },
      None => return false,
    }
  }
  true
}

# ---- calls -----------------------------------------------------------------

fn eval_call(x: ast.Call, env: Env) -> Res[Value, RuntimeError] {
  # A call whose callee is a field access is looked at before the callee is
  # evaluated the ordinary way, because `t.to(f32)` is the cast method on a
  # tensor (NEEDS-110) and plain field access refuses a tensor target. The
  # target is evaluated exactly once whichever way the dispatch goes, so a
  # record with a field named `to` keeps meaning what it meant.
  let callee: Value = VUnit
  match x.callee {
    EField(f) => {
      let target: Value = eval_expr(f.target, env)?
      if bytes.equal(f.name, "to") {
        match as_tensor(target) {
          Some(t) => return eval_cast(t, x),
          None => unit,
        }
      }
      callee = field_value(target, f.name, f.line)?
    },
    _ => callee = eval_expr(x.callee, env)?,
  }
  # A trailing dtype name on a tensor constructor: `zeros([784, 128], bf16)`.
  # The seven dtype names are contextual rather than reserved, and the reading
  # is decided here while the argument is still syntax: the last argument
  # counts as a dtype only on a maker, only when it names one of the seven,
  # and only when nothing in scope binds it, so a program that uses f32 as an
  # ordinary variable keeps meaning what it meant.
  let dt: I64 = -1
  let maker: Str = ""
  match callee {
    VBuiltin(b) => {
      if in_words(DTYPE_MAKERS, b.name) and len(x.args) > 0 {
        match contextual_dtype(x.args[len(x.args) - 1], env) {
          Some(code) => {
            dt = code
            maker = b.name
          },
          None => unit,
        }
      }
    },
    _ => unit,
  }
  let n: I64 = len(x.args)
  if dt >= 0 {
    n = n - 1
  }
  let args: Arr[Value] = arr_new()
  let i: I64 = 0
  while i < n {
    push(args, eval_expr(x.args[i], env)?)
    i = i + 1
  }
  if dt >= 0 {
    # The same arity check apply makes, against the list with the dtype
    # stripped, so `scalar(1.5, f32)` passes and a wrong count is reported
    # against the arguments the maker actually received.
    let want: I64 = builtin_arity(maker)
    if want >= 0 and want != len(args) {
      return Err(runtime_error(x.line, bytes.concat(maker, bytes.concat(" expects ",
        bytes.concat(str(want), bytes.concat(" argument(s), got ", str(len(args))))))))
    }
    return bi_make(maker, args, dt, x.line)
  }
  apply(callee, args, x.line)
}

# `t.to(f32)`: the explicit cast, docs/dtypes.md "The cast is spelled .to(dt)".
# It lowers through tr_cast, which re-rounds once from the source value. The
# argument is the one position that exists for nothing but a dtype, so the
# name is read as one without consulting the environment: `x.to(f32)` casts
# even in a scope that binds f32. Constructors read the other way around, see
# contextual_dtype below.
#
# It carries a gradient: tr_cast records an OpCast on the tape, whose vjp is the
# straight-through estimator, so a cast inside a differentiated function no
# longer detaches its input. That is what a bf16 weight with an f32 master
# depends on.
fn eval_cast(t: tensor.Tensor, x: ast.Call) -> Res[Value, RuntimeError] {
  if len(x.args) != 1 {
    return Err(runtime_error(x.line, bytes.concat("to expects 1 argument(s), got ",
      str(len(x.args)))))
  }
  match x.args[0] {
    EIdent(id) => {
      match tensor.dtype_of_name(id.name) {
        Some(dt) => return Ok(VTensor(tr_cast(t, dt))),
        None => unit,
      }
    },
    _ => unit,
  }
  Err(runtime_error(x.line, "to expects a dtype name (bool, i8, i32, f16, bf16, f32, f64)"))
}

# The contextual reading of a dtype name in a constructor's trailing argument.
# The name resolves to a dtype only when the argument is a bare identifier,
# only when tensor.dtype_of_name knows it, and only when the environment does
# not bind it. A binding wins because the trailing position is shared with
# shape dimensions: `let f32 = 5` followed by `zeros(f32)` meant a 5-vector
# before dtypes existed and has to keep meaning one.
fn contextual_dtype(e: ast.Expr, env: Env) -> Opt[I64] {
  match e {
    EIdent(x) => {
      match env_get(env, x.name) {
        Some(_) => None,
        None => tensor.dtype_of_name(x.name),
      }
    },
    _ => None,
  }
}

fn apply(callee: Value, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  match callee {
    VClosure(c) => call_closure(c, args, line),
    VBuiltin(b) => {
      # The arity check happens here rather than inside each builtin, because
      # the Go side does it in Apply and the message names the builtin, not the
      # argument. A variadic builtin checks its own count and says what it
      # wanted, which is why those messages read differently.
      let want: I64 = builtin_arity(b.name)
      if want >= 0 and want != len(args) {
        return Err(runtime_error(line, bytes.concat(b.name, bytes.concat(" expects ",
          bytes.concat(str(want), bytes.concat(" argument(s), got ", str(len(args))))))))
      }
      call_builtin(b, args, line)
    },
    # A payload case constructor: one argument, wrapped as the variant's payload.
    # The Go bootstrap installs this as an arity-1 Builtin; the arity mismatch
    # message names the case, matching how apply names a builtin above.
    VVariantCtor(c) => {
      if len(args) != 1 {
        return Err(runtime_error(line, bytes.concat(c.name, bytes.concat(" expects 1 argument(s), got ",
          str(len(args))))))
      }
      let p: Value = args[0]
      if is_i64_anno(c.payload_type, None) or is_f64_anno(c.payload_type, None) {
        p = coerce_scalar_anno(c.payload_type, None, p, line)?
      }
      Ok(VVariant(VariantVal { name: c.name, payload: Some(p), has_payload: true }))
    },
    _ => Err(runtime_error(line, bytes.concat("cannot call a ", type_name(callee)))),
  }
}

# coerce_return applies a closure's return annotation to the value it produced.
fn coerce_return(c: Closure, v: Value) -> Res[Value, RuntimeError] {
  if is_i64_anno(c.ret_type, c.ret_unit) or is_f64_anno(c.ret_type, c.ret_unit) {
    return coerce_scalar_anno(c.ret_type, c.ret_unit, v, ast.expr_line(c.body))
  }
  Ok(tensor_for_annotation(anno_name(c.ret_type, c.ret_unit), v))
}

# param_type_name is a parameter's annotation as a bare name, or "" for a shape
# annotation or none: what call_closure reads to convert an `I64`/`F64`
# argument at the call. It is interp.paramTypes, one parameter at a time.
fn param_type_name(p: ast.Param) -> Str {
  if len(p.type_name) > 0 { return p.type_name }
  match p.unit {
    Some(u) => {
      if len(u.factors) == 1 and u.factors[0].exp == 1 { return u.factors[0].name }
      ""
    },
    None => "",
  }
}

fn call_closure(c: Closure, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(c.params) != len(args) {
    let who: Str = "function"
    if len(c.name) > 0 {
      who = bytes.concat("function ", quoted(c.name))
    }
    return Err(runtime_error(line, bytes.concat(who, bytes.concat(" expects ",
      bytes.concat(str(len(c.params)), bytes.concat(" argument(s), got ", str(len(args))))))))
  }
  # The depth check comes before the frame is built, so the refusal has a stack
  # left to unwind through and so that it wins over anything the frame's own
  # setup might report. The bootstrap this runs on cannot recover from a stack
  # overflow at all, so there is no after-the-fact version to fall back on.
  # interp.callClosure checks in the same place for the same reasons.
  if CALL_DEPTH[0] >= MAX_CALL_DEPTH {
    return Err(runtime_error(line, call_depth_message(c.name, MAX_CALL_DEPTH)))
  }
  # The call's scope hangs off the closure's captured environment, not off the
  # caller's. That is the whole of lexical scoping and getting it wrong gives
  # dynamic scoping, which passes most tests.
  let scope: Env = new_env(Some(c.env))
  let i: I64 = 0
  while i < len(c.params) {
    let arg: Value = args[i]
    # An `I64` or `F64` parameter converts its argument at the call, the way
    # a `let` annotation converts a bound value.
    let pt: Str = param_type_name(c.params[i])
    if len(pt) > 0 {
      arg = coerce_scalar_anno(pt, None, arg, ast.expr_line(c.body))?
    }
    env_define(scope, c.params[i].name, arg)
    i = i + 1
  }
  # `-> I64` converts the result to an Int, the same rule `let n: I64 = ...`
  # applies to a bound value; `-> F64` converts an Int back to a number.
  CALL_DEPTH[0] = CALL_DEPTH[0] + 1
  let out: Res[Value, RuntimeError] = match c.body {
    EBlock(blk) => {
      match exec_block(blk, scope) {
        Ok(f) => Ok(flow_value(f)),
        Err(e) => Err(e),
      }
    },
    _ => eval_expr(c.body, scope),
  }
  CALL_DEPTH[0] = CALL_DEPTH[0] - 1
  coerce_return(c, out?)
}

# ---- indexing and slicing --------------------------------------------------

fn eval_index(x: ast.Index, env: Env) -> Res[Value, RuntimeError] {
  let target: Value = eval_expr(x.target, env)?
  let idx_val: Value = eval_expr(x.index, env)?
  # The read half of the dictionary store in assign_to. A missing key is an
  # error rather than a zero: dict_get returns an Opt for the caller who wants
  # to ask, and `d[k]` is the form that says the key is expected to be there.
  match target {
    VDict(d) => {
      match idx_val {
        VStr(k) => {
          match dict_get(d.entries, k) {
            Some(got) => return Ok(got),
            None => return Err(runtime_error(x.line, bytes.concat("no key ",
              bytes.concat(quoted(k), " in the dictionary")))),
          }
        },
        _ => return Err(runtime_error(x.line, "a dictionary key must be a string")),
      }
    },
    _ => unit,
  }
  let idx: I64 = 0
  match rank0_number(idx_val) {
    Some(n) => idx = i64_of_f64(n),
    None => return Err(runtime_error(x.line, "an index must be a number")),
  }
  match target {
    VList(l) => {
      if idx < 0 or idx >= len(l.items) {
        return Err(runtime_error(x.line, bytes.concat("index ", bytes.concat(str(idx),
          bytes.concat(" out of range for a list of length ", str(len(l.items)))))))
      }
      Ok(l.items[idx])
    },
    VTensor(t) => {
      if len(t.shape) == 0 {
        return Err(runtime_error(x.line, "cannot index a scalar"))
      }
      if idx < 0 or idx >= t.shape[0] {
        return Err(runtime_error(x.line, bytes.concat("index ", bytes.concat(str(idx),
          bytes.concat(" out of range for axis 0 of length ", str(t.shape[0]))))))
      }
      Ok(tensor_rows(t)[idx])
    },
    VStr(s) => {
      if idx < 0 or idx >= len(s) {
        return Err(runtime_error(x.line, bytes.concat("index ", bytes.concat(str(idx),
          bytes.concat(" out of range for a string of length ", str(len(s)))))))
      }
      Ok(VNum(f64_of_i64(s[idx])))
    },
    _ => Err(runtime_error(x.line, bytes.concat("cannot index a ", type_name(target)))),
  }
}

fn eval_slice(x: ast.Slice, env: Env) -> Res[Value, RuntimeError] {
  let target: Value = eval_expr(x.target, env)?
  let n: I64 = 0
  match target {
    VList(l) => n = len(l.items),
    VStr(s) => n = len(s),
    VTensor(t) => {
      if len(t.shape) == 0 {
        return Err(runtime_error(x.line, "cannot slice a scalar"))
      }
      n = t.shape[0]
    },
    _ => return Err(runtime_error(x.line, bytes.concat("cannot slice a ", type_name(target)))),
  }
  let start: I64 = slice_bound(x.start, env, 0)?
  let end: I64 = slice_bound(x.end, env, n)?
  # Bounds are clamped rather than refused. A slice that runs past the end is
  # how a caller asks for "the rest", and erroring on it would make every
  # windowing loop carry a min().
  if start < 0 { start = 0 }
  if end > n { end = n }
  if end < start { end = start }
  match target {
    VList(l) => {
      let items: Arr[Value] = arr_new()
      let i: I64 = start
      while i < end {
        push(items, l.items[i])
        i = i + 1
      }
      Ok(VList(ListVal { items: items }))
    },
    VStr(s) => Ok(VStr(s[start:end])),
    # A tensor slice is axis-0 and records on the tape when one is installed, so
    # a gradient flows back through `x[i:j]`. Building the result from raw data
    # here instead (as this once did) detached it from the tape, and jacobian(f)
    # of a function that slices its input then recombined the pieces came back
    # all zeros because the backward pass could not reach the leaf.
    VTensor(t) => lift_v(tr_slice(t, start, end), x.line),
    _ => Err(runtime_error(x.line, "unreachable: slice target was validated above")),
  }
}

# The tape shim for an axis-0 slice, mirroring tr_matmul and tr_unary: the traced
# node when a tape is installed, the plain kernel otherwise.
fn tr_slice(a: tensor.Tensor, start: I64, end: I64) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.slice_axis0(a, start, end)
  }
  let tp: tensor.Tape = tape_current()
  Ok(tensor.value_of(tp, tensor.t_slice_axis0(tp, tr_node(tp, a), start, end)?))
}

fn slice_bound(e: Opt[ast.Expr], env: Env, dflt: I64) -> Res[I64, RuntimeError] {
  match e {
    None => Ok(dflt),
    Some(x) => {
      let v: Value = eval_expr(x, env)?
      match rank0_number(v) {
        Some(n) => Ok(i64_of_f64(n)),
        None => Err(runtime_error(ast.expr_line(x), "a slice bound must be a number")),
      }
    },
  }
}

fn quoted(s: Str) -> Str = str_quote(s)

# is_builtin is the check.tw table, now genuinely shared rather than a second
# copy: src/builtins.tw owns the one list and the checker builds its set from
# the same NAMES. That is the end state NEEDS-52 asked for, and it replaces a
# call to a builtin_exists that was never defined, so a bare builtin name in
# expression position resolves to a VBuiltin instead of reaching an undefined
# function.
fn is_builtin(name: Str) -> Bool = builtins.is_builtin_name(name)

# ---- builtins --------------------------------------------------------------
#
# The port of internal/interp/builtins.go. Ninety-five names, and the contract
# is stricter than "same behaviour": the differential harness compares stderr
# byte for byte, so every message below is the Go message and not an improved
# one. Where a message reads awkwardly, it reads awkwardly on both sides.
#
# The kernels are not here. A builtin's job is the part that is twill's: decide
# how many arguments it takes, coerce them, default an axis, and name the
# kernel. That split is exactly where the Go file's `def` closures stop too,
# which is why the port is a transcription rather than a redesign.
#
# The one structural difference: Go installs builtins by defining closures into
# the global environment, so a builtin is a first-class function value carrying
# its own body. Here a builtin is a name, and dispatch is by name. The reason is
# that a closure over the interpreter is the thing that would need the native
# calling convention to exist before any of this could be written down at all;
# a name plus a switch needs nothing. `grad(f)` is the one case that has to
# carry a value with it, and BuiltinVal.captured is that.

# A membership test over a space-separated list, the same shape as check.tw's
# `in_set`. Padding both sides is what stops "max" from matching inside
# "cummax": the space-delimited needle can only land on a whole word.
fn in_words(list: Str, name: Str) -> Bool {
  let hay: Str = bytes.concat(" ", bytes.concat(list, " "))
  let needle: Str = bytes.concat(" ", bytes.concat(name, " "))
  bytes.index_of(hay, needle) >= 0
}

let ARITY1: Str = "black_box relu exp log log1p expm1 sin cos tanh sigmoid sqrt square abs grad grads value_and_grad jacobian hessian jvp vjp hvp tensor scalar seed permutation eye shape len item dtype str int floor ceil round read_csv read_frame load columns nbytes"

let ARITY2: Str = "pow matmul dot linear conv2d maxpool2d gather maximum minimum greater less greater_equal less_equal equal concat map append gbm_predict write_frame save field map_leaves zip_leaves"

# The declared arity, or -1 for variadic. Go carries this on the Builtin value
# and checks it in Apply before the body runs, so a wrong count never reaches
# the coercions and never produces the coercion's message instead.
fn builtin_arity(name: Str) -> I64 {
  if in_words(ARITY1, name) { return 1 }
  if in_words(ARITY2, name) { return 2 }
  if in_words("where clip fold with_field linspace arange", name) { return 3 }
  # The systems runtime's arities, from the same `def` calls the bodies below
  # are ported from. `arr` is the one variadic among them, so it is absent here
  # and takes whatever it is given.
  if in_words("arr_new dict_new bytes_new", name) { return 0 }
  if in_words("pop arr_clear arr_of_tensor numel dict_keys bytes_to_str buf_new buf_len chr str_quote i64_of_str str_to_f64 f64_to_str num_to_text f64_hex sha256 sha256_bytes", name) { return 1 }
  if in_words("push arr_push dict_get dict_has dict_must dict_del bytes_push buf_get8", name) { return 2 }
  if in_words("dict_set dict_or slice buf_set8", name) { return 3 }
  # The filesystem, the clock and the process, from the same `def` calls.
  # resolve_path and path_join are the two variadic ones and are absent, as
  # `arr` is.
  if in_words("args cwd clock_now_ms mono_ns is_tty_stdout window_size", name) { return 0 }
  if in_words("write_out write_err emit_line read_file file_size list_dir load_value module_source env exit abort temp_dir path_exists path_is_dir mtime mkdir_all remove_file remove_dir remove_all path_base path_dir path_ext path_stem path_normalize path_is_abs", name) { return 1 }
  if in_words("write_file read_text_or write_text_or rename save_value", name) { return 2 }
  if in_words("read_file_at run", name) { return 3 }
  # The builtins returned by grad/grads/value_and_grad take whatever the
  # function they wrap takes; jacobian's and hessian's take exactly one.
  if in_words("jacobian(fn) hessian(fn)", name) { return 1 }
  if in_words("jvp(fn) vjp(fn) hvp(fn)", name) { return 2 }
  -1
}

# ---- argument coercion -----------------------------------------------------
#
# These are the Go file's asTensor/scalarOf/intOf/indicesOf/shapeFromArgs/
# toItems, and they matter more than their size: every builtin's first failure
# mode goes through one of them, so their wording is most of the error surface.

fn arg_tensor(v: Value, who: Str, line: I64) -> Res[tensor.Tensor, RuntimeError] {
  match as_tensor(v) {
    Some(t) => Ok(t),
    None => Err(runtime_error(line, bytes.concat(who, " expects a tensor/number"))),
  }
}

# A single number, whether it arrived as a Num or as a one-element tensor of any
# rank. Deliberately looser than rank0_number above: `sum(x, shape(y)[0])` hands
# an axis over as a rank-0 tensor and a caller writing `t[0:1]` hands one over as
# a [1], and both are one number.
fn single_number(v: Value) -> Opt[F64] {
  match v {
    VNum(x) => Some(x),
    VInt(i) => Some(f64(i)),
    VTensor(t) => {
      if tensor.numel(t) == 1 { return Some(tensor.at(t, 0)) }
      None
    },
    _ => None,
  }
}

# scalarOf reads a single number. It reads a Num straight out rather than
# widening it first, because a builtin that wants a scalar wants an axis or a
# bound and would throw the tensor away again.
#
# The two failure messages are different on purpose: a many-element tensor is a
# caller who passed the right kind of thing at the wrong size and is told
# "expects a scalar", and anything else is told what the builtin takes at all.
fn scalar_of(v: Value, who: Str, line: I64) -> Res[F64, RuntimeError] {
  match single_number(v) {
    Some(x) => return Ok(x),
    None => unit,
  }
  match as_tensor(v) {
    Some(_) => Err(runtime_error(line, bytes.concat(who, " expects a scalar"))),
    None => Err(runtime_error(line, bytes.concat(who, " expects a tensor/number"))),
  }
}

fn int_of(v: Value, who: Str, line: I64) -> Res[I64, RuntimeError] =
  Ok(i64_of_f64(f64_trunc(scalar_of(v, who, line)?)))

# A boolean flag argument, written either way.
#
# The flags that came before this one -- sort's descending, topk's smallest --
# are numbers, because a comparison in twill already yields 1 and 0, and
# `sort(t, 0, true)` is a runtime error today for want of a Bool case here. A new
# flag does not have to inherit that. Both spellings are accepted, so `keepdims`
# can be written the way anybody would write it, and nothing that worked before
# means anything different.
fn flag_of(v: Value, who: Str, line: I64) -> Res[Bool, RuntimeError] {
  match v {
    VBool(b) => return Ok(b),
    _ => unit,
  }
  Ok(scalar_of(v, who, line)? != 0.0)
}

# Whether v is a single number as opposed to a sequence of them. Used where a
# scalar and a one-element sequence have to mean different things, which is
# `split` and only `split`.
fn is_scalar_value(v: Value) -> Bool {
  match v {
    VNum(_) => true,
    VTensor(t) => tensor.numel(t) == 1,
    _ => false,
  }
}

# Go's %v on a []int: space-separated, no commas, and that is what the gbm and
# indices messages print. tensor.shape_string writes "[2, 3]" for the
# diagnostics the checker emits, so the two cannot share a formatter without
# changing one side's output.
fn shape_go(shape: Arr[I64]) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(shape) {
    push(parts, str(shape[i]))
    i = i + 1
  }
  bytes.concat("[", bytes.concat(bytes.join(parts, " "), "]"))
}

# A sequence of integer indices from either a list of scalars or a 1-D tensor.
# A bare number is one index, which is what makes `gather(x, 3)` legal.
fn indices_of(v: Value, who: Str, line: I64) -> Res[Arr[I64], RuntimeError] {
  match v {
    VNum(x) => {
      let one: Arr[I64] = arr_new()
      push(one, i64_of_f64(f64_trunc(x)))
      Ok(one)
    },
    VList(l) => {
      let out: Arr[I64] = arr_new()
      let i: I64 = 0
      while i < len(l.items) {
        push(out, int_of(l.items[i], who, line)?)
        i = i + 1
      }
      Ok(out)
    },
    VTensor(t) => {
      if len(t.shape) > 1 {
        return Err(runtime_error(line, bytes.concat(who,
          bytes.concat(" expects a 1-D tensor or list of indices, got shape ", shape_go(t.shape)))))
      }
      let out: Arr[I64] = arr_new()
      let i: I64 = 0
      while i < tensor.numel(t) {
        push(out, i64_of_f64(f64_trunc(tensor.at(t, i))))
        i = i + 1
      }
      Ok(out)
    },
    _ => Err(runtime_error(line, bytes.concat(who, " expects a list or 1-D tensor of indices"))),
  }
}

# A shape from either a spread of dimensions or a single list of them, so
# `zeros(2, 3)` and `zeros(shape(x))` both work. A single non-list argument
# falls through to the spread case and gives a 1-D shape, which is why
# `zeros(5)` is a vector and not a scalar.
fn shape_from_args(args: Arr[Value], who: Str, line: I64) -> Res[Arr[I64], RuntimeError] {
  if len(args) == 1 {
    match args[0] {
      VList(l) => {
        let dims: Arr[I64] = arr_new()
        let i: I64 = 0
        while i < len(l.items) {
          push(dims, int_of(l.items[i], who, line)?)
          i = i + 1
        }
        return Ok(dims)
      },
      # A bracketed shape like `[784, 128]` is a tensor literal by the
      # parse-time rule (is_numeric_elem in parse.tw), so it arrives here as a
      # 1-D tensor rather than a list. Reading its elements as dimensions is
      # what makes `zeros([784, 128], bf16)` mean what it writes. For a
      # one-element tensor this coincides with the spread reading below, so
      # nothing that worked changes meaning. The bootstrap refuses this form;
      # the divergence is deliberate and came in with NEEDS-110.
      VTensor(t) => {
        if len(t.shape) == 1 {
          let dims: Arr[I64] = arr_new()
          let i: I64 = 0
          while i < tensor.numel(t) {
            push(dims, i64_of_f64(f64_trunc(tensor.at(t, i))))
            i = i + 1
          }
          return Ok(dims)
        }
      },
      _ => unit,
    }
  }
  let dims: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(args) {
    push(dims, int_of(args[i], who, line)?)
    i = i + 1
  }
  Ok(dims)
}

# The elements of a sequence. A 1-D tensor iterates as its numbers; a tensor of
# any higher rank does not, and the message says "1-D" rather than pretending
# rows would do, because `map` over the rows of a matrix and `map` over its
# elements are different enough that guessing is worse than refusing.
fn to_items(v: Value, who: Str, line: I64) -> Res[Arr[Value], RuntimeError] {
  match v {
    VList(l) => return Ok(l.items),
    VTensor(t) => {
      if len(t.shape) == 1 {
        let out: Arr[Value] = arr_new()
        let i: I64 = 0
        while i < tensor.numel(t) {
          push(out, VTensor(tensor.scalar(tensor.at(t, i))))
          i = i + 1
        }
        return Ok(out)
      }
    },
    _ => unit,
  }
  Err(runtime_error(line, bytes.concat(who, " expects a list or 1-D tensor")))
}

# A kernel's Err is a bare message; a runtime error carries the call's line. One
# place converts, so no builtin below has to remember to.
fn lift(r: Res[tensor.Tensor, Str], line: I64) -> Res[tensor.Tensor, RuntimeError] {
  match r {
    Ok(t) => Ok(t),
    Err(m) => Err(runtime_error(line, m)),
  }
}

fn lift_v(r: Res[tensor.Tensor, Str], line: I64) -> Res[Value, RuntimeError] =
  Ok(VTensor(lift(r, line)?))

# ---- the dispatch ----------------------------------------------------------

let UNARY_MATH: Str = "relu exp log log1p expm1 sin cos tanh sigmoid sqrt square"
let BIN_TENSOR: Str = "matmul dot conv2d maximum minimum greater less greater_equal less_equal equal"
let REDUCTIONS: Str = "sum mean max min prod median"
let SCANS: Str = "cumsum cumprod cummax cummin"
let LAST_AXIS: Str = "argmax argmin flip diff"
let ELEM_ROUND: Str = "floor ceil round"
let DERIVATIVES: Str = "grad grads value_and_grad jacobian hessian jvp vjp hvp"
let DERIVED: Str = "grad(fn) grads(fn) value_and_grad(fn) jacobian(fn) hessian(fn) jvp(fn) vjp(fn) hvp(fn)"
let TREE_OPS: Str = "map zip fold append enumerate map_leaves zip_leaves"
let MAKERS: Str = "tensor scalar zeros ones fill randn rand seed permutation eye linspace arange"
# The makers whose trailing argument may be a dtype name (NEEDS-110). seed and
# permutation are the two MAKERS left out: neither makes a tensor.
let DTYPE_MAKERS: Str = "tensor scalar zeros ones fill randn rand eye"
let INSPECT: Str = "shape len item range list str int dtype"
# The systems-dialect runtime, ported in three families. Each of these names
# was in src/builtins.tw and nowhere in this dispatch, so a program that used
# one type-checked and then failed with "named in the builtin table but has no
# implementation" -- which is to say the second implementation could not run
# the dialect the second implementation is written in.
let ARR_OPS: Str = "arr_new arr push arr_push pop arr_clear arr_of_tensor numel"
let DICT_OPS: Str = "dict_new dict_set dict_get dict_has dict_must dict_or dict_keys dict_del"
# bytes_* grows a buffer and buf_* indexes a fixed-size one; they are the same
# value on the Go side and the same value here.
let BUF_OPS: Str = "bytes_new bytes_push bytes_to_str buf_new buf_get8 buf_set8 buf_len"
let STR_OPS: Str = "chr slice str_quote i64_of_str str_to_f64 f64_to_str num_to_text f64_hex sha256 sha256_bytes"
let FILE_OPS: Str = "read_csv read_frame write_frame save load columns field with_field"
# The second half of that runtime: the filesystem, the clock and the process.
# Same story as the three lists above -- every name here was in
# src/builtins.tw and in no dispatch, so a systems-mode program that read a
# file, asked the time or started a process type-checked and then refused.
let IO_OPS: Str = "write_out write_err emit_line read_file write_file read_text_or write_text_or file_size list_dir read_file_at save_value load_value module_source resolve_path"
let PATH_OPS: Str = "path_exists path_is_dir mtime mkdir_all remove_file remove_dir remove_all rename temp_dir cwd path_join path_base path_dir path_ext path_stem path_normalize path_is_abs"
let PROC_OPS: Str = "args env exit abort is_tty_stdout window_size run clock_now_ms mono_ns"

fn call_builtin(b: BuiltinVal, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let name: Str = b.name
  if bytes.equal(name, "print") { return bi_print(args) }
  if in_words(UNARY_MATH, name) { return bi_unary_math(name, args, line) }
  if bytes.equal(name, "abs") { return bi_abs(args, line) }
  if bytes.equal(name, "stop_grad") { return bi_stop_grad(args, line) }
  # The barrier. This evaluator has no tracer and no optimiser, so here it is
  # the identity and nothing more; the guarantee it carries is written down in
  # docs/CODEGEN.md and it is the Go interpreter that has something to enforce
  # today. What matters on this side is that it returns its argument unchanged,
  # because the differential harness compares the two implementations' output
  # byte for byte.
  if bytes.equal(name, "black_box") { return Ok(args[0]) }
  if bytes.equal(name, "pow") { return bi_pow(args, line) }
  if in_words(BIN_TENSOR, name) { return bi_binary(name, args, line) }
  if bytes.equal(name, "maxpool2d") { return bi_maxpool2d(args, line) }
  if bytes.equal(name, "gather") { return bi_gather(args, line) }
  if bytes.equal(name, "where") { return bi_where(args, line) }
  if bytes.equal(name, "clip") { return bi_clip(args, line) }
  if in_words(REDUCTIONS, name) { return bi_reduce(name, args, line) }
  if in_words("sort argsort", name) { return bi_sorting(name, args, line) }
  if in_words("topk argtopk", name) { return bi_topping(name, args, line) }
  if in_words(LAST_AXIS, name) { return bi_last_axis(name, args, line) }
  if bytes.equal(name, "roll") { return bi_roll(args, line) }
  if bytes.equal(name, "softmax") { return bi_softmax(args, line) }
  if bytes.equal(name, "logsumexp") { return bi_logsumexp(args, line) }
  if in_words("reshape broadcast_to", name) { return bi_reshaping(name, args, line) }
  if bytes.equal(name, "transpose") { return bi_transpose(args, line) }
  if bytes.equal(name, "linear") { return bi_linear(args, line) }
  if bytes.equal(name, "einsum") { return bi_einsum(args, line) }
  if bytes.equal(name, "concat") { return bi_concat(args, line) }
  if bytes.equal(name, "split") { return bi_split(args, line) }
  if in_words(SCANS, name) { return bi_scan(name, args, line) }
  if in_words(ELEM_ROUND, name) { return bi_elem_round(name, args, line) }
  if in_words(DERIVATIVES, name) { return bi_derivative(name, args, line) }
  if in_words(DERIVED, name) { return bi_derived(b, args, line) }
  if in_words(TREE_OPS, name) { return bi_tree(name, args, line) }
  if in_words(MAKERS, name) { return bi_make(name, args, -1, line) }
  if in_words(INSPECT, name) { return bi_inspect(name, args, line) }
  if in_words(FILE_OPS, name) { return bi_files(name, args, line) }
  if in_words("gbm_fit gbm_predict", name) { return bi_gbm(name, args, line) }
  if bytes.equal(name, "nbytes") { return bi_nbytes(args, line) }
  if in_words("and or band bor xor shl shr ushr", name) { return bi_bitwise(name, args, line) }
  if bytes.equal(name, "bnot") { return bi_bnot(args, line) }
  if in_words(ARR_OPS, name) { return bi_arr(name, args, line) }
  if in_words(DICT_OPS, name) { return bi_dict(name, args, line) }
  if in_words(BUF_OPS, name) { return bi_buf(name, args, line) }
  if in_words(STR_OPS, name) { return bi_str(name, args, line) }
  if in_words(IO_OPS, name) { return bi_io(name, args, line) }
  if in_words(PATH_OPS, name) { return bi_path(name, args, line) }
  if in_words(PROC_OPS, name) { return bi_proc(name, args, line) }
  # i64 and f64 are the two conversions across the systems-mode seam. i64 makes
  # an exact I64 of a number, truncating a fraction toward zero; f64 makes an
  # F64 of an I64, which loses precision above 2^53.
  if bytes.equal(name, "i64") {
    match single_number(args[0]) {
      Some(_) => return to_int(args[0], line),
      None => return Err(runtime_error(line, "i64 expects a number")),
    }
  }
  if bytes.equal(name, "f64") { return Ok(VNum(scalar_of(args[0], "f64", line)?)) }
  # `quantize` is a Go-bootstrap builtin: it packs a weight into int8/int4, which
  # is a memory layout the reference interpreter has no way to produce (it holds
  # every element as an F64). It is named in the table so a program using it type-
  # checks the same on both sides, and falls through to the message below if run
  # here -- the same contract the gpu_* builtins keep.
  # Unreachable through eval_expr, which only makes a VBuiltin for a name
  # is_builtin accepts. Reachable if the two tables drift, which is NEEDS-52,
  # and saying so is better than returning unit.
  Err(runtime_error(line, bytes.concat("builtin ", bytes.concat(quoted(name),
    " is named in the builtin table but has no implementation"))))
}

# ---- I/O -------------------------------------------------------------------

# print writes one line with the arguments separated by single spaces. The line
# ending is the sink's, not print's: the Go interpreter is constructed with an
# `out func(string)` so a test or the REPL can capture output without going
# near a file descriptor. NEEDS-56.
# ---- value formatting ------------------------------------------------------
#
# format_value is the port of internal/value.Format, and print, str, and the
# grad and jacobian error paths all go through it. It has to match the Go text
# byte for byte, because the differential harness compares stdout, so every
# branch here is the Go branch: "true"/"false" for a Bool, the raw bytes for a
# Str, "()" for Unit, "<builtin NAME>" and "<fn NAME(params)>" for the two
# callables, and "tensor(NESTED, shape=[...])" for a tensor of rank above zero.
#
# The one thing Go has no equivalent for is the dtype tag on a narrow tensor. An
# f64 tensor prints exactly as Go prints it, so the goldens do not move; a bf16
# or i8 tensor, which the Go bootstrap cannot produce at all, prints its dtype
# after the shape and renders each element through dt_shortest at that dtype, so
# it shows the digits the value actually has rather than seventeen (NEEDS-114).
fn format_value(v: Value) -> Str {
  match v {
    VNum(x) => tensor.dt_shortest(tensor.DT_F64, x),
    VInt(i) => str(i),
    VTensor(t) => format_tensor(t),
    VBool(b) => { if b { "true" } else { "false" } },
    VStr(s) => s,
    VList(l) => format_list(l),
    VTuple(t) => format_tuple(t),
    VRecord(r) => format_record(r),
    # A dictionary renders like a record, `{key: value, ...}`, in insertion
    # order rather than sorted -- internal/value.Format walks the Keys slice.
    VDict(d) => format_dict(d),
    # A byte buffer renders as the text of its bytes, which is what Go's
    # `string(t.Data)` gives. It is not quoted and not escaped: a Bytes is a
    # string under construction, and printing one should read as the string.
    VBytes(b) => bytes_val_to_str(b),
    VClosure(c) => format_closure(c),
    VBuiltin(b) => bytes.concat("<builtin ", bytes.concat(b.name, ">")),
    # A foreign value renders through the Go value's String() there. A fitted gbm
    # model is described by handle through the native gbm_describe, so it prints
    # "<gbm logistic, N trees, M features>" exactly as the reference does; any
    # other foreign kind falls back to "<kind>".
    VForeign(f) => {
      if bytes.equal(f.kind, "gbm model") { gbm_describe(f.handle) }
      else { bytes.concat("<", bytes.concat(f.kind, ">")) }
    },
    # A variant renders as `Some(5)` or `None`, exactly as internal/value.Format
    # does: the payload goes through this same formatter. A payload constructor
    # is a Builtin on the Go side and prints as one, so it matches here.
    VVariant(v) => format_variant(v),
    VVariantCtor(c) => bytes.concat("<builtin ", bytes.concat(c.name, ">")),
    VUnit => "()",
  }
}

# `Some(5)` for a payload variant, `None` for a payload-less one. The payload is
# rendered through format_value, the same recursion the Go formatter uses.
fn format_variant(v: VariantVal) -> Str {
  if v.has_payload {
    match v.payload {
      Some(p) => return bytes.concat(v.name, bytes.concat("(", bytes.concat(format_value(p), ")"))),
      None => unit,
    }
  }
  v.name
}

# A scalar tensor is its number, exactly as Go's Format prints Data[0]. A tensor
# of rank one or more is "tensor(" plus the nested rows plus the shape, with the
# dtype appended only when it is not the default f64.
fn format_tensor(t: tensor.Tensor) -> Str {
  if len(t.shape) == 0 {
    return tensor.dt_shortest(t.dtype, tensor.at(t, 0))
  }
  bytes.concat("tensor(",
    bytes.concat(format_dim(t, 0, 0),
    bytes.concat(", shape=",
    bytes.concat(shape_comma(t.shape),
    bytes.concat(dtype_suffix(t), ")")))))
}

# The nested rows, the port of tensor.ToNested plus formatNested in one pass.
# The innermost dimension lists its elements; an outer dimension lists its
# sub-blocks, each `dim_stride` elements wide. Row major, so the block at index i
# of `dim` starts at base + i * stride.
fn format_dim(t: tensor.Tensor, base: I64, dim: I64) -> Str {
  let n: I64 = t.shape[dim]
  let parts: Arr[Str] = arr_new()
  if dim == len(t.shape) - 1 {
    let i: I64 = 0
    while i < n {
      push(parts, tensor.dt_shortest(t.dtype, tensor.at(t, base + i)))
      i = i + 1
    }
  } else {
    let stride: I64 = dim_stride(t.shape, dim)
    let i: I64 = 0
    while i < n {
      push(parts, format_dim(t, base + i * stride, dim + 1))
      i = i + 1
    }
  }
  bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]"))
}

# Elements spanned by one step along `dim`: the product of the dimensions below.
fn dim_stride(shape: Arr[I64], dim: I64) -> I64 {
  let s: I64 = 1
  let i: I64 = dim + 1
  while i < len(shape) {
    s = s * shape[i]
    i = i + 1
  }
  s
}

# "[2, 3]", comma-separated, which is Go's joinInts. This is not shape_go, which
# joins with a space for the error messages that mirror Go's %v on a slice.
fn shape_comma(shape: Arr[I64]) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(shape) {
    push(parts, str(shape[i]))
    i = i + 1
  }
  bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]"))
}

# Nothing for f64, so the goldens are untouched; ", dtype=NAME" for a narrow one.
fn dtype_suffix(t: tensor.Tensor) -> Str {
  if t.dtype == tensor.DT_F64 { return "" }
  bytes.concat(", dtype=", tensor.dtype_name(t.dtype))
}

fn format_list(l: ListVal) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(l.items) {
    push(parts, format_value(l.items[i]))
    i = i + 1
  }
  bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]"))
}

fn format_tuple(t: TupleVal) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(t.items) {
    push(parts, format_value(t.items[i]))
    i = i + 1
  }
  bytes.concat("(", bytes.concat(bytes.join(parts, ", "), ")"))
}

# Keys in insertion order, the same order deep_equal walks them, which is the
# order the fields were written in the source and the order Go's Record.Keys
# holds.
fn format_record(r: RecordVal) -> Str {
  let parts: Arr[Str] = arr_new()
  for k in dict_keys(r.fields) {
    push(parts, bytes.concat(k, bytes.concat(": ", format_value(dict_must(r.fields, k)))))
  }
  bytes.concat("{", bytes.concat(bytes.join(parts, ", "), "}"))
}

# A dictionary's keys, also in insertion order: internal/value.Format walks the
# Dict's Keys slice, which is the same order this Dict hands back. Nothing
# sorts, so `{b: 3, a: 1}` prints in the order it was built.
fn format_dict(d: DictVal) -> Str {
  let parts: Arr[Str] = arr_new()
  for k in dict_keys(d.entries) {
    push(parts, bytes.concat(k, bytes.concat(": ", format_value(dict_must(d.entries, k)))))
  }
  bytes.concat("{", bytes.concat(bytes.join(parts, ", "), "}"))
}

# The bytes of a buffer as a Str, Go's `string(t.Data)`. The buffer itself is
# what bytes_to_str reads, so this is that builtin's body as well as the
# formatter's.
fn bytes_val_to_str(b: BytesVal) -> Str = bytes.to_str(b.buf)

fn format_closure(c: Closure) -> Str {
  let name: Str = c.name
  if len(name) == 0 { name = "anonymous" }
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(c.params) {
    push(parts, c.params[i].name)
    i = i + 1
  }
  bytes.concat("<fn ", bytes.concat(name,
    bytes.concat("(", bytes.concat(bytes.join(parts, ", "), ")>"))))
}

fn bi_print(args: Arr[Value]) -> Res[Value, RuntimeError] {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(args) {
    push(parts, format_value(args[i]))
    i = i + 1
  }
  emit_line(bytes.join(parts, " "))
  Ok(VUnit)
}

# ---- differentiable elementwise and binary ops -----------------------------

fn bi_unary_math(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  if bytes.equal(name, "relu") { return Ok(VTensor(tr_unary(tensor.OpRelu, t))) }
  if bytes.equal(name, "exp") { return Ok(VTensor(tr_unary(tensor.OpExp, t))) }
  if bytes.equal(name, "log") { return Ok(VTensor(tr_unary(tensor.OpLog, t))) }
  if bytes.equal(name, "log1p") { return Ok(VTensor(tr_unary(tensor.OpLog1p, t))) }
  if bytes.equal(name, "expm1") { return Ok(VTensor(tr_unary(tensor.OpExpm1, t))) }
  if bytes.equal(name, "sin") { return Ok(VTensor(tr_unary(tensor.OpSin, t))) }
  if bytes.equal(name, "cos") { return Ok(VTensor(tr_unary(tensor.OpCos, t))) }
  if bytes.equal(name, "tanh") { return Ok(VTensor(tr_unary(tensor.OpTanh, t))) }
  if bytes.equal(name, "sigmoid") { return Ok(VTensor(tr_unary(tensor.OpSigmoid, t))) }
  if bytes.equal(name, "sqrt") { return Ok(VTensor(tr_unary(tensor.OpSqrt, t))) }
  Ok(VTensor(tr_unary(tensor.OpSquare, t)))
}

# |x| = relu(x) + relu(-x), keeping it differentiable. Written as two relus
# rather than a sign test because a sign test has no gradient at all, and this
# has the subgradient 0 at the origin, which is the conventional choice.
# stop_grad(x): the same values, outside the graph.
#
# The tape records the operations that produced a value, so a tensor built
# straight from its numbers has no node on it and a backward pass reaching one
# stops there. That is the whole of it: mk_raw rather than a traced op.
#
# The numbers are copied rather than shared, so that a later in-place write
# through the original cannot change what the detached copy holds.
fn bi_stop_grad(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let t: tensor.Tensor = arg_tensor(args[0], "stop_grad", line)?
  Ok(VTensor(tensor.clone(t)))
}

fn bi_abs(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let t: tensor.Tensor = arg_tensor(args[0], "abs", line)?
  let pos: tensor.Tensor = tr_unary(tensor.OpRelu, t)
  let neg: tensor.Tensor = tr_unary(tensor.OpRelu, tr_unary(tensor.OpNeg, t))
  lift_v(tr_binary(tensor.OpAdd, pos, neg), line)
}

fn bi_pow(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let base: tensor.Tensor = arg_tensor(args[0], "pow", line)?
  let p: F64 = scalar_of(args[1], "pow", line)?
  # tr_pow_scalar returns a bare tensor, not a Res, so it is wrapped directly
  # rather than through lift_v, which unwraps an Ok/Err. Passing the tensor to
  # lift_v (as this once did) handed lift a value that was neither, and every
  # `pow` call -- adam's bias correction among them -- died on "no match arm".
  Ok(VTensor(tr_pow_scalar(base, p)))
}

fn bi_binary(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let x: tensor.Tensor = arg_tensor(args[0], name, line)?
  let y: tensor.Tensor = arg_tensor(args[1], name, line)?
  # dot is matmul under a second name, not an inner product: on two vectors the
  # matmul rule already gives the scalar, and on matrices `dot` meaning
  # something else would surprise every caller who wrote it for readability.
  if in_words("matmul dot", name) { return lift_v(tr_matmul(x, y), line) }
  if bytes.equal(name, "conv2d") { return lift_v(tr_conv2d(x, y), line) }
  if bytes.equal(name, "maximum") { return lift_v(tr_binary(tensor.OpMaximum, x, y), line) }
  if bytes.equal(name, "minimum") { return lift_v(tr_binary(tensor.OpMinimum, x, y), line) }
  if bytes.equal(name, "greater") { return lift_v(tr_binary(tensor.OpGreater, x, y), line) }
  if bytes.equal(name, "less") { return lift_v(tr_binary(tensor.OpLess, x, y), line) }
  if bytes.equal(name, "greater_equal") { return lift_v(tr_binary(tensor.OpGreaterEqual, x, y), line) }
  if bytes.equal(name, "less_equal") { return lift_v(tr_binary(tensor.OpLessEqual, x, y), line) }
  # equal_op, not equal: this is the elementwise 0/1 mask, a different question
  # from the `==` operator's single deep-equality answer.
  lift_v(tr_binary(tensor.OpEqual, x, y), line)
}

# maxpool2d(x, k): non-overlapping k by k max pooling over each channel.
fn bi_maxpool2d(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let x: tensor.Tensor = arg_tensor(args[0], "maxpool2d", line)?
  let k: I64 = int_of(args[1], "maxpool2d", line)?
  lift_v(tr_maxpool2d(x, k), line)
}

# gather(x, indices): select rows of x (first axis) by an index list or 1-D
# tensor. Differentiable, and the base of embedding lookups and batching.
fn bi_gather(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let x: tensor.Tensor = arg_tensor(args[0], "gather", line)?
  let idx: Arr[I64] = indices_of(args[1], "gather", line)?
  lift_v(tr_gather(x, idx), line)
}

fn bi_where(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let c: tensor.Tensor = arg_tensor(args[0], "where", line)?
  let x: tensor.Tensor = arg_tensor(args[1], "where", line)?
  let y: tensor.Tensor = arg_tensor(args[2], "where", line)?
  lift_v(tr_where(c, x, y), line)
}

fn bi_clip(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let t: tensor.Tensor = arg_tensor(args[0], "clip", line)?
  let lo: F64 = scalar_of(args[1], "clip", line)?
  let hi: F64 = scalar_of(args[2], "clip", line)?
  lift_v(tr_clip(t, lo, hi), line)
}

# ---- reductions ------------------------------------------------------------
#
# One argument reduces everything to a scalar; a second reduces a single axis.
#
# The axis may be negative and counts from the end, and the normalisation lives
# in the kernel (src/tensor.tw normalize_axis) rather than here, so that one
# place decides both the index and the wording.
#
# The message names the axis the CALLER WROTE: `sum(m, -7)` on a rank-2 tensor
# says "axis -7 out of range for rank 2". This comment used to claim the
# opposite, that the message reports the axis after the negative adjustment and
# that normalising here would make the two implementations disagree. The kernel
# beside it had always reported the original, so the comment was wrong about its
# own file, and the disagreement it warned about was real and already present:
# the Go bootstrap printed the adjusted value. Go now reports the original too.
# A constant axis is refused by the checker before any of this, so the message
# is only reachable when the axis is computed.

# A third argument is the rank-preserving flag, which leaves the reduced axis in
# at length 1 instead of dropping it. It is positional because twill has no named
# arguments (docs/roadmap.md entry 29) and it is a Bool or a number because
# flag_of takes either.
fn bi_reduce(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) == 0 or len(args) > 3 {
    return Err(runtime_error(line, bytes.concat(name, " expects (tensor) or (tensor, axis[, keepdims])")))
  }
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  let op: tensor.Op = reduce_op(name)
  if len(args) == 1 {
    return lift_v(tr_reduce_all(op, t), line)
  }
  let ax: I64 = int_of(args[1], name, line)?
  let keep: Bool = false
  if len(args) == 3 { keep = flag_of(args[2], name, line)? }
  if keep { return lift_v(tr_reduce_axis_keep(op, t, ax), line) }
  lift_v(tr_reduce_axis(op, t, ax), line)
}

# The Op a reduction's name stands for. One place, so the whole-tensor form, the
# axis form and the keepdims form cannot drift into three different six-way
# branches that agree only by inspection.
fn reduce_op(name: Str) -> tensor.Op {
  if bytes.equal(name, "sum") { return tensor.OpSum }
  if bytes.equal(name, "mean") { return tensor.OpMean }
  if bytes.equal(name, "max") { return tensor.OpMax }
  if bytes.equal(name, "min") { return tensor.OpMin }
  if bytes.equal(name, "prod") { return tensor.OpProd }
  tensor.OpMedian
}

# sort/argsort take an optional axis and an optional "desc" flag, so `sort(t)`,
# `sort(t, 0)` and `sort(t, 0, true)` all read the way they look.
fn bi_sorting(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) == 0 or len(args) > 3 {
    return Err(runtime_error(line, bytes.concat(name, " expects (tensor[, axis[, descending]])")))
  }
  # A list of strings sorts by the bytewise-unsigned lexicographic order
  # (docs/language-guide.md, Strings -> Ordering), so the ecosystem's hand-written
  # string sorts can delegate here. A list has no axis, so the optional second
  # argument is the descending flag directly. `argsort` on strings has no defined
  # result and is refused.
  match args[0] {
    VList(l) => return sort_string_list(name, l, args, line),
    _ => unit,
  }
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  # Default to the last axis, matching softmax and argmax rather than reducing
  # over everything: sorting a matrix almost always means sorting each row.
  let axis: I64 = len(t.shape) - 1
  if len(args) >= 2 { axis = int_of(args[1], name, line)? }
  let descending: Bool = false
  if len(args) == 3 { descending = scalar_of(args[2], name, line)? != 0.0 }
  if bytes.equal(name, "sort") { return lift_v(tr_sort_axis(t, axis, descending), line) }
  # argsort, argtopk, argmax and argmin stay on the pure kernel even under a
  # tape. They return positions, not values, and a position has no derivative,
  # so recording them would put a node on the tape that severs the chain at the
  # first arithmetic done with the result. The bootstrap does the same by
  # returning a tensor with RequiresGrad clear.
  lift_v(tensor.argsort_axis(t, axis, descending), line)
}

# The list branch of `sort`. Mirrors sortList in the Go bootstrap, and has to:
# two implementations of one builtin that disagree is a program that behaves
# differently depending on which binary ran it.
#
# Three forms, decided by the second argument:
#
#   sort(xs)              ascending, by the elements' own order
#   sort(xs, true)        descending
#   sort(xs, fn(a, b))    by the caller's comparison
#
# Strings order bytewise (docs/language-guide.md, Strings -> Ordering) and
# numbers order as numbers, I64 and F64 alike. Anything else needs the
# comparison. Every form is stable, which skein's vocabulary depends on: token
# ids are assigned from a sorted order, so an unstable sort would make them a
# function of the sort rather than of the corpus.
#
# The input list is left untouched; a fresh list is returned.
fn sort_string_list(name: Str, l: ListVal, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if not bytes.equal(name, "sort") {
    return Err(runtime_error(line, bytes.concat(name, " is defined on tensors, not a list")))
  }
  if len(args) > 2 {
    return Err(runtime_error(line, "sort on a list takes the list and one of a descending flag or a comparison"))
  }

  let descending: Bool = false
  let cmp: Opt[Value] = None
  if len(args) == 2 {
    match args[1] {
      VNum(x) => descending = x != 0.0,
      VInt(i) => descending = i != 0,
      VBool(b) => descending = b,
      VClosure(_) => cmp = Some(args[1]),
      VBuiltin(_) => cmp = Some(args[1]),
      _ => return Err(runtime_error(line, "sort: the second argument on a list is a descending flag (a bool) or a comparison (a function)")),
    }
  }

  let items: Arr[Value] = arr_new()
  let i: I64 = 0
  while i < len(l.items) {
    push(items, l.items[i])
    i = i + 1
  }

  # `kind` is what the elements are: 0 a comparison decides, 1 strings, 2
  # numbers. Read once here rather than per comparison, so a list that cannot be
  # ordered says so before any work rather than part way through it.
  let kind: I64 = 0
  match cmp {
    Some(_) => kind = 0,
    None => kind = list_order_kind(items, line)?,
  }

  let sorted: Arr[Value] = merge_sort_values(items, kind, cmp, descending, line)?
  Ok(VList(ListVal { items: sorted }))
}

# What order a list of one kind of element has, or the reason it has none.
# Mirrors listOrder in the Go bootstrap, error text included.
fn list_order_kind(items: Arr[Value], line: I64) -> Res[I64, RuntimeError] {
  if len(items) == 0 { return Ok(1) }
  let strs: I64 = 0
  let nums: I64 = 0
  let i: I64 = 0
  while i < len(items) {
    match items[i] {
      VStr(_) => strs = strs + 1,
      VNum(_) => nums = nums + 1,
      VInt(_) => nums = nums + 1,
      _ => unit,
    }
    i = i + 1
  }
  if strs == len(items) { return Ok(1) }
  if nums == len(items) { return Ok(2) }
  if strs + nums == len(items) {
    return Err(runtime_error(line, "sort on a list of mixed strings and numbers has no order; sort them apart, or pass a comparison"))
  }
  Err(runtime_error(line, "sort on a list orders strings and numbers; for anything else pass a comparison, as sort(xs, fn(a, b) = ...)"))
}

# Does a come before b, under whichever order this sort is running.
fn value_before(a: Value, b: Value, kind: I64, cmp: Opt[Value], line: I64) -> Res[Bool, RuntimeError] {
  match cmp {
    Some(f) => {
      let two: Arr[Value] = arr_new()
      push(two, a)
      push(two, b)
      return truthy(apply(f, two, line)?, line)
    },
    None => unit,
  }
  if kind == 1 {
    let sa: Str = match a { VStr(x) => x, _ => "" }
    let sb: Str = match b { VStr(x) => x, _ => "" }
    return Ok(canon_str_less(sa, sb))
  }
  let na: F64 = match rank0_number(a) { Some(x) => x, None => 0.0 }
  let nb: F64 = match rank0_number(b) { Some(x) => x, None => 0.0 }
  Ok(na < nb)
}

# A bottom-up merge sort over values, stable, and the only sort in this file that
# a comparison can drive.
#
# Merge rather than the insertion sort `canon_sort` uses, because this one runs
# on whatever a program hands it: a vocabulary is tens of thousands of entries
# and quadratic there is minutes. Stability is the property every caller of this
# builtin was promised.
fn merge_sort_values(items: Arr[Value], kind: I64, cmp: Opt[Value], descending: Bool, line: I64) -> Res[Arr[Value], RuntimeError] {
  let n: I64 = len(items)
  if n < 2 { return Ok(items) }

  let buf: Arr[Value] = arr_new()
  let z: I64 = 0
  while z < n {
    push(buf, items[0])
    z = z + 1
  }

  let width: I64 = 1
  while width < n {
    let lo: I64 = 0
    while lo < n {
      let mid: I64 = lo + width
      let hi: I64 = lo + width + width
      if mid > n { mid = n }
      if hi > n { hi = n }
      let a: I64 = lo
      let b: I64 = mid
      let o: I64 = lo
      while o < hi {
        let take_left: Bool = false
        if a < mid and b < hi {
          # `before(right, left)` rather than `not before(left, right)`, so a
          # tie takes the left element and the sort stays stable.
          let right_first: Bool = value_before(items[b], items[a], kind, cmp, line)?
          take_left = not right_first
        } else {
          take_left = a < mid
        }
        if take_left {
          buf[o] = items[a]
          a = a + 1
        } else {
          buf[o] = items[b]
          b = b + 1
        }
        o = o + 1
      }
      lo = hi
    }
    let k: I64 = 0
    while k < n {
      items[k] = buf[k]
      k = k + 1
    }
    width = width + width
  }

  if not descending { return Ok(items) }
  # Reversing a stable ascending sort is not the same as sorting descending: it
  # reverses ties too. The Go bootstrap sorts with the comparison flipped
  # instead, which keeps ties in input order, so this does the same.
  let out: Arr[Value] = arr_new()
  let r: I64 = 0
  while r < n {
    push(out, items[0])
    r = r + 1
  }
  let g: I64 = 0
  while g < n {
    out[g] = items[n - 1 - g]
    g = g + 1
  }
  Ok(out)
}

# topk/argtopk need k, so they take (tensor, k[, axis[, smallest]]). The flag is
# spelled "smallest" and the kernel takes "largest", so it inverts here: passing
# a non-zero fourth argument asks for the k smallest.
fn bi_topping(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) < 2 or len(args) > 4 {
    return Err(runtime_error(line, bytes.concat(name, " expects (tensor, k[, axis[, smallest]])")))
  }
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  let k: I64 = int_of(args[1], name, line)?
  let axis: I64 = len(t.shape) - 1
  if len(args) >= 3 { axis = int_of(args[2], name, line)? }
  let largest: Bool = true
  if len(args) == 4 { largest = scalar_of(args[3], name, line)? == 0.0 }
  if bytes.equal(name, "topk") { return lift_v(tr_topk_axis(t, k, axis, largest), line) }
  lift_v(tensor.argtopk_axis(t, k, axis, largest), line)
}

# argmax/argmin/flip/diff all take an optional axis and default to the last one.
# argmax and argmin remove that axis, so they take the rank-preserving flag as
# well; flip keeps the rank it was given and diff only shortens the axis, so for
# those a third argument is the arity error it always was.
fn bi_last_axis(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let indexing: Bool = in_words("argmax argmin", name)
  let usage: Str = bytes.concat(name, " expects (tensor[, axis])")
  let max_args: I64 = 2
  if indexing {
    usage = bytes.concat(name, " expects (tensor[, axis[, keepdims]])")
    max_args = 3
  }
  if len(args) == 0 or len(args) > max_args {
    return Err(runtime_error(line, usage))
  }
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  let axis: I64 = len(t.shape) - 1
  if len(args) >= 2 { axis = int_of(args[1], name, line)? }
  let keep: Bool = false
  if len(args) == 3 { keep = flag_of(args[2], name, line)? }
  if bytes.equal(name, "argmax") { return lift_v(keep_reduced(tensor.argmax_axis(t, axis), t, axis, keep), line) }
  if bytes.equal(name, "argmin") { return lift_v(keep_reduced(tensor.argmin_axis(t, axis), t, axis, keep), line) }
  if bytes.equal(name, "flip") { return lift_v(tr_flip_axis(t, axis), line) }
  lift_v(tr_diff_axis(t, axis), line)
}

# The rank-preserving form of an index reduction. argmax and argmin stay on the
# pure kernel even under a tape, for the reason bi_sorting gives -- a position
# has no derivative -- so putting the axis back is a plain reshape with nothing
# to record. The reduction has already run when this is called, so an
# out-of-range axis has been reported by the kernel, in the kernel's words,
# exactly as it is without the flag.
fn keep_reduced(r: Res[tensor.Tensor, Str], t: tensor.Tensor, axis: I64, keep: Bool) -> Res[tensor.Tensor, Str] {
  let out: tensor.Tensor = r?
  if not keep { return Ok(out) }
  let ax: I64 = tensor.normalize_axis(axis, len(t.shape))?
  tensor.reshape(out, tensor.keep_axis(t.shape, ax))
}

# roll takes the shift first, since that is the argument nobody omits.
fn bi_roll(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) < 2 or len(args) > 3 {
    return Err(runtime_error(line, "roll expects (tensor, shift[, axis])"))
  }
  let t: tensor.Tensor = arg_tensor(args[0], "roll", line)?
  let shift: I64 = int_of(args[1], "roll", line)?
  let axis: I64 = len(t.shape) - 1
  if len(args) == 3 { axis = int_of(args[2], "roll", line)? }
  lift_v(tr_roll_axis(t, shift, axis), line)
}

# softmax defaults to the last axis. It has no count check on the Go side and
# none here: a third argument is ignored rather than refused, and that is
# transcribed rather than tightened, because tightening it would turn a
# silently-accepted call into an error the corpus has never seen. It preserves
# the shape it was given, so there is no axis for a keepdims flag to keep.
fn bi_softmax(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) == 0 {
    return Err(runtime_error(line, "softmax expects (tensor[, axis])"))
  }
  let t: tensor.Tensor = arg_tensor(args[0], "softmax", line)?
  let axis: I64 = len(t.shape) - 1
  if len(args) == 2 { axis = int_of(args[1], "softmax", line)? }
  lift_v(tr_softmax(t, axis), line)
}

# logsumexp reduces the axis it works on rather than preserving it, so it takes
# the rank-preserving flag and no longer shares softmax's dispatch. It keeps
# softmax's laxity about the argument count -- neither ever refused a trailing
# argument -- so the third position gains a meaning it did not have and no call
# that ran before stops running.
fn bi_logsumexp(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) == 0 {
    return Err(runtime_error(line, "logsumexp expects (tensor[, axis[, keepdims]])"))
  }
  let t: tensor.Tensor = arg_tensor(args[0], "logsumexp", line)?
  let axis: I64 = len(t.shape) - 1
  if len(args) >= 2 { axis = int_of(args[1], "logsumexp", line)? }
  let keep: Bool = false
  if len(args) >= 3 { keep = flag_of(args[2], "logsumexp", line)? }
  if keep { return lift_v(tr_reduce_axis_keep(tensor.OpLogSumExp, t, axis), line) }
  lift_v(tr_logsumexp_axis(t, axis), line)
}

# ---- shape ----------------------------------------------------------------

fn bi_reshaping(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) < 2 {
    return Err(runtime_error(line, bytes.concat(name, " expects (tensor, ...shape)")))
  }
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  let shape: Arr[I64] = shape_from_args(rest(args, 1), name, line)?
  if bytes.equal(name, "reshape") { return lift_v(tr_reshape(t, shape), line) }
  lift_v(tr_broadcast_to(t, shape), line)
}

fn bi_transpose(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) < 1 {
    return Err(runtime_error(line, "transpose expects a tensor"))
  }
  let t: tensor.Tensor = arg_tensor(args[0], "transpose", line)?
  # No axes means the default reversal, and the empty permutation carries that
  # rather than being an error: transpose(m) is the common call.
  let axes: Arr[I64] = arr_new()
  let i: I64 = 1
  while i < len(args) {
    push(axes, int_of(args[i], "transpose", line)?)
    i = i + 1
  }
  lift_v(tr_transpose(t, axes), line)
}

# linear(x, W) is x @ transpose(W). The Go bootstrap fuses this into one kernel
# that reads W in place (a ~14% forward-pass win, docs/perf-baseline.md); the
# self-hosted reference has no need of the speed, so it composes the traced
# transpose and matmul it already owns. Both accumulate in the same order, so the
# reference result is bit-for-bit the fused one -- which is what parity means.
fn bi_linear(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) != 2 {
    return Err(runtime_error(line, "linear expects (input, weight)"))
  }
  let x: tensor.Tensor = arg_tensor(args[0], "linear", line)?
  let w: tensor.Tensor = arg_tensor(args[1], "linear", line)?
  let axes: Arr[I64] = arr_new()
  push(axes, 1)
  push(axes, 0)
  let wt: tensor.Tensor = match tr_transpose(w, axes) {
    Ok(t) => t,
    Err(e) => return Err(runtime_error(line, e)),
  }
  lift_v(tr_matmul(x, wt), line)
}

# nbytes(v) reports the in-memory footprint of a value in bytes, recursing into
# lists and records. It mirrors the Go bootstrap's nbytesOf: eight bytes per f64
# tensor element and per number, and the sum of the parts for a container. A
# quantised weight would report its packed size, but the reference never holds
# one, so that case only exists on the Go side.
# is_bitwise_op reports whether an operator is one of the bitwise words that
# carries the same meaning infix and called. `and` and `or` are excluded: infix
# they are the short-circuiting boolean operators, and only the call form
# `and(x, y)` is the bitwise one.
fn is_bitwise_op(op: Str) -> Bool =
  bytes.equal(op, "band") or bytes.equal(op, "bor") or bytes.equal(op, "xor")
    or bytes.equal(op, "shl") or bytes.equal(op, "shr")

# bi_bitwise applies a bitwise word to two values, truncating each to I64. The
# host's own bitwise builtins do the work: this evaluator runs on the bootstrap,
# so `and`/`shr` here are the bootstrap's, and reimplementing them in twill
# would need the very operators being defined.
fn bi_bitwise(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let a: I64 = int64_of(args[0], name, line)?
  let b: I64 = int64_of(args[1], name, line)?
  let out: I64 = 0
  if bytes.equal(name, "and") or bytes.equal(name, "band") { out = and(a, b) }
  if bytes.equal(name, "or") or bytes.equal(name, "bor") { out = or(a, b) }
  if bytes.equal(name, "xor") { out = xor(a, b) }
  if bytes.equal(name, "shl") { out = shl(a, b) }
  if bytes.equal(name, "shr") { out = shr(a, b) }
  if bytes.equal(name, "ushr") { out = ushr(a, b) }
  Ok(VInt(out))
}

# int64_of reads a scalar as an I64: exact for an Int, truncating for a number.
# The result of every bitwise word is an Int, so a full 64-bit pattern such as a
# sign bit survives the round trip.
fn int64_of(v: Value, who: Str, line: I64) -> Res[I64, RuntimeError] {
  match v {
    VInt(i) => Ok(i),
    _ => Ok(i64(scalar_of(v, who, line)?)),
  }
}

fn bi_bnot(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  Ok(VInt(bnot(int64_of(args[0], "bnot", line)?)))
}

fn bi_nbytes(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) != 1 {
    return Err(runtime_error(line, "nbytes expects one argument"))
  }
  Ok(VNum(f64_of_i64(nbytes_of(args[0]))))
}

fn nbytes_of(v: Value) -> I64 {
  match v {
    VTensor(t) => tensor.numel(t) * 8,
    VNum(_) => 8,
    VList(l) => {
      let total: I64 = 0
      let i: I64 = 0
      while i < len(l.items) {
        total = total + nbytes_of(l.items[i])
        i = i + 1
      }
      total
    },
    VRecord(r) => {
      let total: I64 = 0
      let keys: Arr[Str] = dict_keys(r.fields)
      let i: I64 = 0
      while i < len(keys) {
        total = total + nbytes_of(dict_must(r.fields, keys[i]))
        i = i + 1
      }
      total
    },
    _ => 0,
  }
}

fn bi_einsum(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) < 2 {
    return Err(runtime_error(line, "einsum expects a spec string and at least one tensor"))
  }
  let spec: Str = ""
  match args[0] {
    VStr(s) => spec = s,
    _ => return Err(runtime_error(line, "einsum's first argument must be a spec string")),
  }
  let ts: Arr[tensor.Tensor] = arr_new()
  let i: I64 = 1
  while i < len(args) {
    push(ts, arg_tensor(args[i], "einsum", line)?)
    i = i + 1
  }
  lift_v(tr_einsum(spec, ts), line)
}

fn bi_concat(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let items: Arr[Value] = to_items(args[0], "concat", line)?
  let ts: Arr[tensor.Tensor] = arr_new()
  let i: I64 = 0
  while i < len(items) {
    push(ts, arg_tensor(items[i], "concat", line)?)
    i = i + 1
  }
  let axis: I64 = int_of(args[1], "concat", line)?
  lift_v(tr_concat(ts, axis), line)
}

# split(t, n | sizes[, axis]): the inverse of concat, returning a list. A scalar
# second argument means that many equal pieces; a list or 1-D tensor means those
# exact lengths. The axis defaults to 0, matching the axis a bare `concat`
# result is usually built along.
fn bi_split(args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) < 2 or len(args) > 3 {
    return Err(runtime_error(line, "split expects (tensor, n | sizes[, axis])"))
  }
  let t: tensor.Tensor = arg_tensor(args[0], "split", line)?
  let axis: I64 = 0
  if len(args) == 3 { axis = int_of(args[2], "split", line)? }

  # A scalar and a one-element list mean different things, 2 pieces versus one
  # piece of length 2, so the scalar case is tested first and explicitly rather
  # than falling through to indices_of.
  let is_list: Bool = false
  match args[1] {
    VList(_) => is_list = true,
    _ => unit,
  }
  let pieces: Arr[tensor.Tensor] = arr_new()
  if not is_list and is_scalar_value(args[1]) {
    let n: I64 = int_of(args[1], "split", line)?
    pieces = lift_pieces(tr_split_equal(t, n, axis), line)?
  } else {
    let sizes: Arr[I64] = indices_of(args[1], "split", line)?
    pieces = lift_pieces(tr_split(t, sizes, axis), line)?
  }
  let items: Arr[Value] = arr_new()
  let i: I64 = 0
  while i < len(pieces) {
    push(items, VTensor(pieces[i]))
    i = i + 1
  }
  Ok(VList(ListVal { items: items }))
}

fn lift_pieces(r: Res[Arr[tensor.Tensor], Str], line: I64) -> Res[Arr[tensor.Tensor], RuntimeError] {
  match r {
    Ok(ps) => Ok(ps),
    Err(m) => Err(runtime_error(line, m)),
  }
}

# ---- scans -----------------------------------------------------------------
#
# Cumulative scans over a sequence (a 1-D tensor's elements in order): each
# output element folds in the next input. Used to build signals, equity curves,
# and running peaks for backtests. Differentiable: the scan is a chain of adds,
# multiplies, or selections, so reverse mode unrolls it. With an axis they scan
# along it instead, keeping the shape. The split follows the reductions: sum(t)
# covers everything and sum(t, 0) works per axis, so cumsum(t) and cumsum(t, 0)
# should mean the matching pair. On a 1-D tensor, which is what a sequence is,
# the two are the same thing.
fn bi_scan(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  if len(args) == 0 or len(args) > 2 {
    return Err(runtime_error(line, bytes.concat(name, " expects (tensor[, axis])")))
  }
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  if len(args) == 1 {
    if bytes.equal(name, "cumsum") { return lift_v(tr_scan_all(tensor.OpCumSum, t), line) }
    if bytes.equal(name, "cumprod") { return lift_v(tr_scan_all(tensor.OpCumProd, t), line) }
    if bytes.equal(name, "cummax") { return lift_v(tr_scan_all(tensor.OpCumMax, t), line) }
    return lift_v(tr_scan_all(tensor.OpCumMin, t), line)
  }
  let axis: I64 = int_of(args[1], name, line)?
  if bytes.equal(name, "cumsum") { return lift_v(tr_scan_axis(tensor.OpCumSum, t, axis), line) }
  if bytes.equal(name, "cumprod") { return lift_v(tr_scan_axis(tensor.OpCumProd, t, axis), line) }
  if bytes.equal(name, "cummax") { return lift_v(tr_scan_axis(tensor.OpCumMax, t, axis), line) }
  lift_v(tr_scan_axis(tensor.OpCumMin, t, axis), line)
}

# Elementwise rounding, forward-only, handy for turning random draws into
# integer indices or tokens. No kernel: it is a loop over a buffer with no
# gradient rule, so it stays on this side of the line.
#
# `round` is half away from zero, which is Go's math.Round and not the
# banker's rounding a reader coming from Python would assume.
fn bi_elem_round(name: Str, args: Arr[Value], line: I64) -> Res[Value, RuntimeError] {
  let t: tensor.Tensor = arg_tensor(args[0], name, line)?
  let out: Arr[F64] = arr_new()
  let i: I64 = 0
  while i < tensor.numel(t) {
    if bytes.equal(name, "floor") { push(out, f64_floor(tensor.at(t, i))) }
    if bytes.equal(name, "ceil") { push(out, f64_ceil(tensor.at(t, i))) }
    if bytes.equal(name, "round") { push(out, f64_round(tensor.at(t, i))) }
    i = i + 1
  }
  Ok(VTensor(tensor.mk(tensor.copy_shape(t.shape), out, t.dtype)))
}

fn rest(args: Arr[Value], from: I64) -> Arr[Value] {
  let out: Arr[Value] = arr_new()
  let i: I64 = from
  while i < len(args) {
    push(out, args[i])
    i = i + 1
  }
  out
}

# ---- the tape seam ---------------------------------------------------------
#
# NEEDS-75. src/tensor.tw splits every differentiable op in two: `binary(op, a,
# b)` computes, and `t_binary(tp, op, a, b)` computes and records, returning a
# node index. `grad(f)` differentiates an *interpreted* f, whose arithmetic
# happens in the builtins above as this file evaluates f's body. Something has
# to make those builtins take the taped twin while f is running and the pure
# kernel the rest of the time. This section is that something.
#
# The shape is the bootstrap's. internal/tensor/jet.go carries a package-level
# `recordJets` that internal/interp/builtins.go turns on immediately before it
# builds the graph a Hessian will differentiate and off again after, so ordinary
# evaluation never pays for the wiring. Here the flag is a stack of tapes rather
# than a bool, for the reason NEEDS-75 gives: a single slot would let an inner
# grad steal the outer one's recording, and `jacobian(f)` running f once per
# output element, or a `grad` inside a function passed to `map`, are both legal.
#
# Why the tape has dynamic extent rather than being threaded through eval as a
# parameter. Whether an op records is a property of *who called it*, not of
# where it was written. f's body is arbitrary interpreted twill: it calls other
# interpreted functions, and it calls closures that were built before grad
# existed and captured an environment that has no tape in it. A threaded
# parameter is lexical, so a closure created outside the grad and called inside
# it would carry the tape it was born with, which is none, and its arithmetic
# would silently vanish from the graph. That is the exact bug the split into
# `binary` and `t_binary` was made to avoid. Dynamic extent gets it right for
# free: the closure's environment stays lexical, which is what NEEDS-26 is
# about, and the tape stays dynamic, which is what recording is about. It would
# also mean every eval_* function, every Closure and all ninety-five builtin
# signatures grew a parameter that all but five of them ignore.
#
# The cost outside a grad is one length check on an empty array per arithmetic
# builtin, and no allocation. That is the "ordinary evaluation does not pay for
# it" requirement, and it is why the shims below test the stack first and return
# the pure kernel's result unchanged.

# The installed tapes, innermost last. File-level and mutated in place: the
# evaluator is single-threaded, exactly as the bootstrap's package-level flag
# assumes.
let TAPES: Arr[tensor.Tape] = arr_new()

# Make tp the tape ops record on. Pairs with tape_pop, always.
fn tape_push(tp: tensor.Tape) {
  push(TAPES, tp)
}

# Restore the previous tape, or none. Tolerates an empty stack rather than
# aborting: the one caller pops on the error path too, and an abort there would
# replace a runtime error from inside f with a less useful one from here.
fn tape_pop() {
  if len(TAPES) > 0 {
    pop(TAPES)
  }
}

fn tape_installed() -> Bool = len(TAPES) > 0

fn tape_current() -> tensor.Tape = TAPES[len(TAPES) - 1]

# The node a traced value came from, on the innermost installed tape.
#
# Identity, not equality. Two tensors holding equal data are different graph
# nodes, and `internal/tensor` gets this for free because a *Tensor pointer is
# the node. Here the association has to be looked up, and the thing that makes
# it sound is that a taped op hands back `value_of(tp, n)`, which is the very
# handle stored in the entry, so the value flowing through f is the node.
#
# Backwards, because the answer is the most recent node with that handle and
# the loop should stop at it rather than walk the whole tape every time.
#
# OPTIMISATION, not taken: this is a linear scan per operand, so a forward pass
# over a tape of n entries is O(n^2). The fix is a dict keyed by value identity
# rather than by string, which is NEEDS-81. A scan is written here because it is
# obviously correct and because the identity-keyed dict does not exist yet.
fn tape_node_in(tp: tensor.Tape, v: Value) -> Opt[I64] {
  match as_tensor(v) {
    Some(t) => tape_node_of_tensor(tp, t),
    None => None,
  }
}

fn tape_node_of(v: Value) -> Opt[I64] {
  if not tape_installed() {
    return None
  }
  tape_node_in(tape_current(), v)
}

fn tape_node_of_tensor(tp: tensor.Tape, t: tensor.Tensor) -> Opt[I64] {
  let i: I64 = len(tp.entries) - 1
  while i >= 0 {
    if is_same(tp.entries[i].out, t) {
      return Some(i)
    }
    i = i - 1
  }
  None
}

# The node to name an operand by. A tensor that is already on the tape is that
# node; anything else is a constant that arrived from outside f, and it goes on
# as a const so the entry that names it has a valid input index. `konst` is not
# a leaf, so it collects a cotangent nobody reads and reports no gradient, which
# is the right answer for a literal.
fn tr_node(tp: tensor.Tape, t: tensor.Tensor) -> I64 {
  match tape_node_of_tensor(tp, t) {
    Some(n) => n,
    None => tensor.konst(tp, t),
  }
}

# ---- the routed arithmetic -------------------------------------------------
#
# One shim per differentiable kernel. Each is the same three lines: if no tape
# is installed call the pure kernel and return, otherwise lift the operands to
# nodes, call the taped twin, and return that node's value.
#
# Returning `value_of(tp, n)` rather than the kernel's own result is the part
# that carries the association forward, and it is the one line in this section
# that is not mechanical. A clone here would break tape_node_of for every
# downstream op and the gradient would come back all zeros, which reads as a
# modelling mistake rather than a plumbing one.
#
# Comparisons are recorded like everything else rather than skipped, because
# src/tensor.tw's `is_comparison` comment states the rule: a comparison is a
# node with no gradient path, and leaving it off the tape would make a
# downstream entry's input index dangle.

fn tr_unary(op: tensor.Op, a: tensor.Tensor) -> tensor.Tensor {
  if not tape_installed() {
    return tensor.unary(op, a)
  }
  let tp: tensor.Tape = tape_current()
  tensor.value_of(tp, tensor.t_unary(tp, op, tr_node(tp, a)))
}

fn tr_pow_scalar(a: tensor.Tensor, p: F64) -> tensor.Tensor {
  if not tape_installed() {
    return tensor.pow_scalar(a, p)
  }
  let tp: tensor.Tape = tape_current()
  tensor.value_of(tp, tensor.t_pow_scalar(tp, tr_node(tp, a), p))
}

fn tr_clip(a: tensor.Tensor, lo: F64, hi: F64) -> tensor.Tensor {
  if not tape_installed() {
    return tensor.clip(a, lo, hi)
  }
  let tp: tensor.Tape = tape_current()
  tensor.value_of(tp, tensor.t_clip(tp, tr_node(tp, a), lo, hi))
}

# `x.to(dt)`. Records an OpCast when a tape is installed, so a cast inside a
# differentiated function passes its gradient straight through rather than
# detaching. Off the tape it is the plain cast.
fn tr_cast(a: tensor.Tensor, dt: I64) -> tensor.Tensor {
  if not tape_installed() {
    return tensor.cast(a, dt)
  }
  let tp: tensor.Tape = tape_current()
  tensor.value_of(tp, tensor.t_cast(tp, tr_node(tp, a), dt))
}

fn tr_binary(op: tensor.Op, a: tensor.Tensor, b: tensor.Tensor) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.binary(op, a, b)
  }
  let tp: tensor.Tape = tape_current()
  let n: I64 = tensor.t_binary(tp, op, tr_node(tp, a), tr_node(tp, b))?
  Ok(tensor.value_of(tp, n))
}

fn tr_where(c: tensor.Tensor, a: tensor.Tensor, b: tensor.Tensor) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.where3(c, a, b)
  }
  let tp: tensor.Tape = tape_current()
  let n: I64 = tensor.t_where(tp, tr_node(tp, c), tr_node(tp, a), tr_node(tp, b))?
  Ok(tensor.value_of(tp, n))
}

fn tr_matmul(a: tensor.Tensor, b: tensor.Tensor) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.matmul(a, b)
  }
  let tp: tensor.Tape = tape_current()
  let n: I64 = tensor.t_matmul(tp, tr_node(tp, a), tr_node(tp, b))?
  Ok(tensor.value_of(tp, n))
}

fn tr_einsum(spec: Str, inputs: Arr[tensor.Tensor]) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.einsum(spec, inputs)
  }
  let tp: tensor.Tape = tape_current()
  let nodes: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(inputs) {
    push(nodes, tr_node(tp, inputs[i]))
    i = i + 1
  }
  let n: I64 = tensor.t_einsum(tp, spec, nodes)?
  Ok(tensor.value_of(tp, n))
}

fn tr_reduce_all(op: tensor.Op, a: tensor.Tensor) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.reduce_all_by(a, op)
  }
  let tp: tensor.Tape = tape_current()
  let n: I64 = tensor.t_reduce_all(tp, op, tr_node(tp, a))?
  Ok(tensor.value_of(tp, n))
}

fn tr_reduce_axis(op: tensor.Op, a: tensor.Tensor, axis: I64) -> Res[tensor.Tensor, Str] {
  if not tape_installed() {
    return tensor.reduce_axis_by(a, axis, op)
  }
  let tp: tensor.Tape = tape_current()
  let n: I64 = tensor.t_reduce_axis(tp, op, tr_node(tp, a), axis)?
  Ok(tensor.value_of(tp, n))
}

