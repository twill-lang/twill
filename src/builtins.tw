# builtins.tw: the one list of builtin names, shared by the checker and the
# evaluator.
#
# NEEDS-52 was the drift risk of keeping this list twice. src/check.tw held it
# for the unknown-name diagnostic, and src/eval.tw wanted the same set to turn a
# bare name into a VBuiltin, and the comment there said "is_builtin is the
# check.tw table again" over a call to a function that did not exist. This file
# is the shared table both of them meant: check.tw builds its set from NAMES and
# eval.tw asks is_builtin_name, so a builtin added to the dispatch is a name
# added here once and seen by both, and the two can no longer disagree.
#
# The list is the evaluator's dispatch set and the checker's known-name set,
# which are the same set by intent. A name here that eval does not dispatch
# would check clean and fail at run time; a name eval dispatches that is missing
# here would be reported as unknown though it works. Keeping one list is what
# makes both of those impossible rather than merely unlikely.

import "bytes.tw" as bytes

let NAMES: Str = "print relu exp log sin cos tanh sigmoid sqrt sum prod median mean abs pow matmul dot linear quantize nbytes grad grads value_and_grad map zip tensor scalar zeros ones fill randn rand eye linspace arange transpose shape len item dtype range list str square maximum minimum greater less greater_equal less_equal equal where clip max min argmax argmin flip roll diff softmax logsumexp sort topk argtopk reshape broadcast_to concat split fold append enumerate read_csv einsum map_leaves zip_leaves seed read_frame write_frame columns field with_field gbm_fit gbm_predict cumsum cumprod cummax cummin conv2d maxpool2d save load gather permutation int floor ceil round jacobian hessian jvp vjp hvp and or band bor xor shl shr bnot Ok Err Some None unit f64_sqrt f64_exp f64_log f64_sin f64_cos f64_floor f64_trunc f64_pow f64_of_i64 i64_of_f64 f64_bits f64_from_bits f64_signbit f64_bits_hi f64_bits_lo f64_from_halves arr_of_tensor arr_new push arr_push pop dict_new dict_set dict_get dict_has dict_must dict_or dict_keys bytes_new bytes_push bytes_to_str abort dict_del buf_new buf_get8 buf_set8 buf_len argsort f64_ceil f64_round f64_tanh f64_mod i64 f64 write_out write_err read_file write_file list_dir resolve_path str_quote i64_of_str emit_line rng_seed rng_uniform rng_normal rng_perm is_same args save_value load_value arr arr_clear chr slice gpu_available gpu_device_count is_tty_stdout window_size gpu_device_open gpu_device_info gpu_device_close gpu_alloc gpu_free gpu_write gpu_read gpu_copy gpu_program_build gpu_kernel gpu_set_arg_buffer gpu_set_arg_local gpu_launch gpu_finish gpu_device_info_i64 gpu_set_arg_i64 gpu_set_arg_f64 env clock_now_ms str_to_f64 f64_to_str num_to_text module_source f64_hex gbm_describe stop_grad read_text_or write_text_or file_size all_finite numel rng_open rng_close rng_u53 rng_f64 rng_norm exit path_exists path_is_dir mkdir_all remove_file remove_dir remove_all rename temp_dir cwd mtime mono_ns path_join path_base path_dir path_ext path_stem path_normalize path_is_abs read_file_at mem_allocs mem_bytes mem_live_bytes mem_tensors mem_counters_available run"

# Membership over the space-separated list. Padding both sides is what stops
# "max" from matching inside "cummax": the same trick eval's in_words and
# check's in_set use, so the needle can only land on a whole word.
fn is_builtin_name(name: Str) -> Bool {
  let hay: Str = bytes.concat(" ", bytes.concat(NAMES, " "))
  let needle: Str = bytes.concat(" ", bytes.concat(name, " "))
  bytes.index_of(hay, needle) >= 0
}
