mode systems

# tensor.tw: the tensor value model, every kernel, and reverse-mode autodiff,
# in twill.
#
# The original version of this file stopped at the shape algebra and deferred
# the arithmetic to a native core reached through NEEDS-25. There is no native
# core: everything is twill. So the kernels are here, written plainly, and the
# gradient rule for each one is written next to it.
#
# Nothing here can execute yet. What is missing is listed in docs/needs.md, and
# every entry this file adds names the function that reaches for it. The code is
# written as though the language were finished, because the alternative is a
# specification that drifts from the implementation it is supposed to describe.
#
# internal/tensor/*.go is the specification this was ported from. Where the Go
# has a fast path that only changes cost, this has the slow path only, and a
# comment saying where the fast path would go. Where the Go has a fast path that
# changes an *answer* (the scalar-by-scalar shortcut in broadcastBinary is the
# one), the answer is reproduced.
#
# ---- the interface src/eval.tw calls --------------------------------------
#
# This is the whole surface. Everything else in this file is internal and may
# move. Every fallible entry point returns Res[_, Str] and the Str is the exact
# message the bootstrap produces for the same mistake.
#
# Values and shapes:
#   Tensor { shape: Arr[I64], data: Buf, dtype: I64 }
#   rank, is_scalar, element_count, strides_of, shape_string, shape_equal
#   scalar(x), filled(shape, v), zeros_like(t), clone(t)
#   broadcast_shape(a, b), matmul_shape(a, b)
#
# Dtypes. docs/dtypes.md is the design and this is its surface:
#   DT_BOOL DT_I8 DT_I32 DT_F16 DT_BF16 DT_F32 DT_F64
#   dtype_name(dt), dtype_of_name(s), dtype_bits(dt)
#   scalar_of(x, dt), filled_of(shape, v, dt), zeros_dt(shape, dt)
#   cast(t, dt)
#   promote(a, b), acc_dtype(dt), grad_dtype(dt), dt_round(dt, x)
#
# Elementwise, on the Op enum below:
#   binary(op, a, b)        -> Res[Tensor, Str]   add sub mul div mod
#                                                 max min gt lt ge le eq
#   unary(op, a)            -> Tensor            neg relu exp log log1p expm1
#                                                 sin cos sqrt tanh sigmoid
#                                                 square
#   pow_scalar(a, p)        -> Tensor
#   clip(a, lo, hi)         -> Tensor
#   where(cond, a, b)       -> Res[Tensor, Str]
#
# Linear algebra:
#   matmul(a, b)            -> Res[Tensor, Str]
#   einsum(spec, inputs)    -> Res[Tensor, Str]
#
# Reductions (axis may be negative; keepdims variants insert a 1):
#   sum_all, mean_all, max_all, min_all, prod_all, median_all  -> Tensor
#   sum_axis, mean_axis, max_axis, min_axis, prod_axis,
#   median_axis, argmax_axis, argmin_axis, logsumexp_axis      -> Res[Tensor, Str]
#   reduce_axis_keep(t, axis, op)                              -> Res[Tensor, Str]
#   softmax(t, axis)                                           -> Res[Tensor, Str]
#
# Shape:
#   reshape(t, shape), transpose(t, axes), broadcast_to(t, shape),
#   concat(ts, axis), split(t, sizes, axis), split_equal(t, n, axis),
#   index_axis0(t, i), slice_axis0(t, start, end), gather(t, idx),
#   flip_axis(t, axis), sort_axis(t, axis, desc), argsort_axis(t, axis, desc),
#   topk_axis(t, k, axis, largest), argtopk_axis(t, k, axis, largest)
#
# Sequences, convolution and pooling:
#   cumsum, cumprod, cummax, cummin (t)              -> Tensor
#   cumsum_axis, cumprod_axis, cummax_axis,
#   cummin_axis, diff_axis (t, axis)                 -> Res[Tensor, Str]
#   roll_axis(t, shift, axis)                        -> Res[Tensor, Str]
#   conv2d(input, weight), maxpool2d(t, k)           -> Res[Tensor, Str]
#
# Literals:
#   Nested { NLeaf(F64), NList(Arr[Nested]) }
#   from_nested(n) -> Res[Tensor, Str], to_nested(t) -> Nested
#
# Second order:
#   set_record_jets(on), hessian(tp, root, leaf) -> Res[Tensor, Str]
#
# Autodiff. The tape is built by the caller; every op above has a taped twin
# named `t_<op>` that takes node indices and returns a node index:
#   new_tape(), leaf(tp, t), value_of(tp, node),
#   t_binary, t_unary, t_pow_scalar, t_clip, t_where, t_matmul, t_einsum,
#   t_sum_all, t_mean_all, ... (one per differentiable op)
#   backward(tp, root, seed) -> Res[Arr[Tensor], Str]
#   backward_scaled(tp, root, seed, scale) -> Res[Arr[Tensor], Str]
#   grads_finite(gs) -> Bool
#
# The split between `binary` and `t_binary` is deliberate. eval.tw does most of
# its arithmetic with nothing differentiating, and a taped op that is never
# differentiated still costs a tape entry that pins its output alive. The
# bootstrap makes the same split with its RequiresGrad flag; this makes it with
# two entry points, because twill has no mutable flag on a value type.

import "bytes.tw" as bytes
import "std/float" as flt
import "buf.tw" as buf

# ---- the value ------------------------------------------------------------

# A tensor is a flat buffer, a shape, and a dtype. Row-major, always dense,
# never strided: internal/tensor/tensor.go made that choice and every kernel
# below depends on it, so a view type would be a lie about what the kernels
# accept.
#
# Rank 0 is a scalar and is a real tensor rather than a special case. That is
# what lets `x + 1` broadcast with no rule for scalars, and it is why `shape` of
# a number is `[]` rather than an error.
#
# THE BUFFER IS PACKED. NEEDS-111 landed here.
#
# The dtype is the *semantics* of the element: which values exist, what a store
# rounds to, and what an operation accumulates in. The buffer is the *physical
# layout*: `data` is the packed byte buffer from src/buf.tw, element i in
# elem_bytes(dtype) bytes at offset i times that, little-endian. A bf16 element
# occupies sixteen bits, so the memory drop docs/dtypes.md promises is real now
# and `twill-lang/shuttle` stops being right that quantisation shrinks nothing.
#
# The invariant that let the semantics land before the layout is unchanged, and
# the layout now enforces it rather than trusting it: every element read out of
# `data` is exactly the F64 widening of a value representable in `dtype`,
# because `buf.set` can only store such a bit pattern and `buf.get` can only
# widen one. Nothing writes into a buffer except through `mk`, whose packing
# rounds, or `mk_raw`, whose callers copy elements that already satisfy the
# invariant and for which the packing is therefore the identity.
#
# The kernels kept their text, which is the property the two-step landing was
# for: `t.data[i]` became `buf.get(t.data, t.dtype, i)`, `len(t.data)` became
# `element_count(t.shape)`, and nothing else about them moved. A kernel still
# computes into a plain Arr[F64] at full width and hands it to `mk`, so the
# accumulation story in docs/dtypes.md is untouched. No slicing, no views: a
# Buf is never shared between two tensors, every kernel allocates its own
# output, and the primitive deliberately offers nothing that would change that.
struct Tensor {
  shape: Arr[I64],
  data: Buf,
  dtype: I64,
}

# ---- dtypes ----------------------------------------------------------------
#
# docs/dtypes.md is the design; this is the part of it that executes. Read that
# first for why the set is these seven and not more, and for the accumulation
# rule, which is the one that decides whether a bf16 matmul is a number or a
# rumour.
#
# Codes are I64 rather than an enum. That was forced when a payload-free enum
# case could not be compared with `==` (NEEDS-70, closed in 1.6, which is why
# the dispatches below compare Op values directly instead of their names); it
# stays an I64 because the order is load-bearing -- see the paragraph below --
# and an enum has no order.
#
# The order is deliberate and two of the comparisons below depend on it: the
# integer kinds are below the float kinds, and within the floats the order is by
# how much of F64 the format retains. It is NOT a promotion lattice on its own,
# because f16 and bf16 are incomparable: f16 has three more mantissa bits, bf16
# has five more exponent bits, and neither contains the other.

let DT_BOOL: I64 = 0
let DT_I8: I64 = 1
let DT_I32: I64 = 2
let DT_F16: I64 = 3
let DT_BF16: I64 = 4
let DT_F32: I64 = 5
let DT_F64: I64 = 6

fn dtype_name(dt: I64) -> Str {
  if dt == DT_BOOL { return "bool" }
  if dt == DT_I8 { return "i8" }
  if dt == DT_I32 { return "i32" }
  if dt == DT_F16 { return "f16" }
  if dt == DT_BF16 { return "bf16" }
  if dt == DT_F32 { return "f32" }
  if dt == DT_F64 { return "f64" }
  "?"
}

fn dtype_of_name(s: Str) -> Opt[I64] {
  if bytes.equal(s, "bool") { return Some(DT_BOOL) }
  if bytes.equal(s, "i8") { return Some(DT_I8) }
  if bytes.equal(s, "i32") { return Some(DT_I32) }
  if bytes.equal(s, "f16") { return Some(DT_F16) }
  if bytes.equal(s, "bf16") { return Some(DT_BF16) }
  if bytes.equal(s, "f32") { return Some(DT_F32) }
  if bytes.equal(s, "f64") { return Some(DT_F64) }
  None
}

# Storage width per element. src/buf.tw `elem_bytes` is this table divided by
# eight. It is declared there rather than read from here because the import
# points the other way, the same trade src/gpu/buffer.tw makes with
# `element_count`; a dtype added to one table is added to both in the same
# change.
fn dtype_bits(dt: I64) -> I64 {
  if dt == DT_BOOL { return 8 }
  if dt == DT_I8 { return 8 }
  if dt == DT_I32 { return 32 }
  if dt == DT_F16 { return 16 }
  if dt == DT_BF16 { return 16 }
  if dt == DT_F32 { return 32 }
  64
}

fn is_float_dtype(dt: I64) -> Bool = dt >= DT_F16
fn is_int_dtype(dt: I64) -> Bool = dt <= DT_I32

# Toward zero, which is what a float-to-integer cast means in Go, in C, and in
# every array library. Not toward negative infinity: `i32(-0.5)` is 0.
fn trunc_toward_zero(x: F64) -> F64 {
  if x < 0.0 { return 0.0 - f64_floor(0.0 - x) }
  f64_floor(x)
}

# The value `x` takes when it is stored in `dt` and read back. This is the whole
# observable content of a dtype, and every write into a buffer goes through it.
#
# Integer overflow clamps rather than wraps. Wrapping is what C does and it is
# the wrong default here: a weight that saturates at 127 is visibly wrong in a
# plot, and one that wraps to -128 looks like a plausible negative weight.
fn dt_round(dt: I64, x: F64) -> F64 {
  if dt == DT_F64 { return x }
  if dt == DT_F32 { return flt.round_f32(x) }
  if dt == DT_BF16 { return flt.round_bf16(x) }
  if dt == DT_F16 { return flt.round_f16(x) }
  if dt == DT_BOOL {
    # NaN is not zero, so it is true. That matches Go's `x != 0` and it is the
    # only reading under which `bool(x)` and `x != 0` agree.
    if x == 0.0 { return 0.0 }
    return 1.0
  }
  # NaN has no integer image at all; zero is the answer every library gives and
  # the only one that does not propagate a NaN into an index.
  if x != x { return 0.0 }
  let lo: F64 = 0.0 - 128.0
  let hi: F64 = 127.0
  if dt == DT_I32 {
    lo = 0.0 - 2147483648.0
    hi = 2147483647.0
  }
  let v: F64 = trunc_toward_zero(x)
  if v < lo { return lo }
  if v > hi { return hi }
  v
}

# The shortest decimal that reads a stored element back to itself, at the
# element's own dtype. It mirrors dt_round: the import points tensor -> float,
# so the DT_* codes cannot reach float.tw and the dispatch on them has to live
# here, next to the rounding it is the printing half of.
#
# The point is precision, not width. A bf16 element is stored as the F64
# widening of a bf16 value, so format_number would print seventeen digits of a
# number that distinguishes about three; f_shortest cuts the decimal at the
# first digit no other bf16 could round back from, which is the honest reading.
# DT_F64 keeps format_number unchanged, because the differential harness
# compares that text byte for byte against the bootstrap and every golden in
# testdata/ depends on it.
fn dt_shortest(dt: I64, x: F64) -> Str {
  if dt == DT_F64 { return flt.format_number(x) }
  if dt == DT_F32 { return flt.f32_shortest(x) }
  if dt == DT_BF16 { return flt.bf16_shortest(x) }
  if dt == DT_F16 { return flt.f16_shortest(x) }
  # bool and the integers hold integer-valued F64s, which format_number renders
  # exactly and at their natural length. The dtype tag that tells a bool 1 from
  # an i8 1 apart prints beside the tensor and is eval.tw's, not this function's.
  flt.format_number(x)
}

# A decimal literal parsed straight to its dtype, ready to store. For the narrow
# floats this rounds once, at the format, rather than parsing at f64 and letting
# dt_round round a second time; docs/dtypes.md notes that decimal double
# rounding is almost always harmless and that "almost always" is not a
# specification. The integers and bool have no such hazard, because a literal
# small enough to be one is exact in f64, so they parse at f64 and take
# dt_round's single rounding. None on a malformed literal, as f64_of_str does.
fn dt_of_str(dt: I64, s: Str) -> Opt[F64] {
  if dt == DT_F64 { return flt.f64_of_str(s) }
  if dt == DT_F32 { return flt.f32_of_str(s) }
  if dt == DT_BF16 { return flt.bf16_of_str(s) }
  if dt == DT_F16 { return flt.f16_of_str(s) }
  match flt.f64_of_str(s) {
    Some(x) => Some(dt_round(dt, x)),
    None => None,
  }
}

# The dtype a mixed-dtype operation produces.
#
# Two rules do the work. An integer kind meeting a float kind yields the float
# kind unchanged, so `bf16_tensor * 2` stays bf16 rather than being widened by
# an integer that fits in it easily. And f16 meeting bf16 yields f32, because
# neither is a superset of the other and picking either would silently discard
# the range or the precision the other operand was chosen for.
fn promote(a: I64, b: I64) -> I64 {
  if a == b { return a }
  if is_int_dtype(a) and is_int_dtype(b) {
    if a > b { return a }
    return b
  }
  if is_int_dtype(a) { return b }
  if is_int_dtype(b) { return a }
  if (a == DT_F16 and b == DT_BF16) or (a == DT_BF16 and b == DT_F16) {
    return DT_F32
  }
  if a > b { return a }
  b
}

fn promote3(a: I64, b: I64, c: I64) -> I64 = promote(promote(a, b), c)

# The dtype an operation accumulates in, given the dtype it stores.
#
# THIS IS THE RULE THAT MATTERS. A bf16 matmul over an inner dimension of 1024
# adds a thousand products; bf16 carries eight significand bits, so once the
# running sum is a few hundred times the size of the next term, the term is
# rounded away entirely and the sum stops growing. The answer is not imprecise,
# it is wrong, and it is wrong in the direction that makes a model appear to
# train and then plateau. Accumulating in f32 and rounding once on store fixes
# it, and costs nothing that matters, because the accumulator is a register and
# not the thing that fills memory or crosses a bus.
#
# So: anything narrower than f32 accumulates in f32, f32 accumulates in f32,
# f64 accumulates in f64. Integers accumulate in i32, which is what saves an
# int8 dot product from overflowing on its fourth term.
#
# It is stated per operation *class*, not per tensor: a tensor has one dtype and
# never an accumulation dtype, and asking a tensor what it accumulates in is
# already the wrong question.
fn acc_dtype(dt: I64) -> I64 {
  if dt == DT_F64 { return DT_F64 }
  if is_float_dtype(dt) { return DT_F32 }
  DT_I32
}

# One step of an accumulation, at the accumulation dtype.
#
# Adding in F64 and rounding to the accumulation dtype gives exactly the result
# the accumulation dtype's own addition would give. That is not an
# approximation and not luck: a double rounding is harmless when the wide format
# carries at least 2p+2 bits of the narrow one's p, and 53 clears that bar for
# f32's 24, for bf16's 8 and for f16's 11. The same theorem is why every
# elementwise kernel below can compute in F64 and round once on store and still
# be bit-exact against real f32 hardware.
fn acc_add(dt: I64, acc: F64, x: F64) -> F64 = dt_round(dt, acc + x)

fn acc_mul(dt: I64, acc: F64, x: F64) -> F64 = dt_round(dt, acc * x)

# The dtype a gradient carries.
#
# Gradients want more precision than the forward pass, for a reason that is
# about dynamic range rather than about accuracy: a cotangent is a sum over
# every use of a value, so it accumulates across a batch and across broadcast
# axes, and it is routinely several orders of magnitude smaller than the
# activation it belongs to. f16's smallest normal is 2^-14, which real gradients
# reach and go under, and a gradient that underflows to zero is a parameter that
# stops learning with nothing reported.
#
# So a gradient is never narrower than f32. It is f64 for an f64 forward, f32
# for every other float, and f32 for an integer or boolean leaf, which cannot
# carry one at all and gets a zero of that dtype so the shapes still line up.
# This is the master-weights arrangement mixed-precision training already uses,
# and stating it here rather than at each rule is what stops one vjp_ from
# quietly narrowing.
fn grad_dtype(dt: I64) -> I64 {
  if dt == DT_F64 { return DT_F64 }
  DT_F32
}

fn rank(t: Tensor) -> I64 = len(t.shape)

fn is_scalar(t: Tensor) -> Bool = len(t.shape) == 0

fn element_count(shape: Arr[I64]) -> I64 {
  let n: I64 = 1
  let i: I64 = 0
  while i < len(shape) {
    n = n * shape[i]
    i = i + 1
  }
  n
}

# Strides for a row-major dense buffer, trailing axis first. Computed rather
# than stored, because a dense tensor's strides are a function of its shape and
# storing them invites the two to disagree.
fn strides_of(shape: Arr[I64]) -> Arr[I64] {
  let n: I64 = len(shape)
  let s: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < n {
    push(s, 1)
    i = i + 1
  }
  i = n - 2
  while i >= 0 {
    s[i] = s[i + 1] * shape[i + 1]
    i = i - 1
  }
  s
}

fn shape_string(shape: Arr[I64]) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(shape) {
    push(parts, str(shape[i]))
    i = i + 1
  }
  bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]"))
}

fn shape_equal(a: Arr[I64], b: Arr[I64]) -> Bool {
  if len(a) != len(b) { return false }
  let i: I64 = 0
  while i < len(a) {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}

fn copy_shape(s: Arr[I64]) -> Arr[I64] {
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(s) {
    push(out, s[i])
    i = i + 1
  }
  out
}

# Every kernel below computes into a fresh wide buffer like this one and hands
# it to `mk`, which packs it; no kernel writes into a buffer the caller
# supplied. Nothing in this file hands out an alias, which is the property that
# lets `split` copy instead of view and lets the tape hold a tensor without
# fearing a later write to it.
fn alloc(n: I64) -> Arr[F64] {
  let d: Arr[F64] = arr_new()
  let i: I64 = 0
  while i < n {
    push(d, 0.0)
    i = i + 1
  }
  d
}

# The two ways a tensor is built, and the reason there are still two.
#
# `mk` is for a buffer a kernel computed: the values came out of an accumulator
# that is wider than the dtype, so every one of them is rounded on the way in.
# The rounding now lives in `buf.set`, which cannot store anything but a
# representable bit pattern, so the invariant no longer depends on this
# function remembering anything; what `mk` still owns is the claim that
# rounding *here* is correct, which is the one-rounding-on-store argument in
# docs/dtypes.md.
#
# `mk_raw` is for a buffer whose every element was copied from a tensor of the
# same dtype. Transposing, gathering, concatenating and sorting move values
# without computing any, so the packing's narrowing is the identity on them.
# The body is `mk`'s body, because a packed store narrows whether or not the
# caller needed it to; what is left of the distinction is the caller's claim,
# and the claim is still worth reading at the call sites, which are exactly the
# rearrangements.
fn mk(shape: Arr[I64], data: Arr[F64], dt: I64) -> Tensor {
  let d: Buf = buf.alloc_elems(len(data), dt)
  let i: I64 = 0
  while i < len(data) {
    buf.set(d, dt, i, data[i])
    i = i + 1
  }
  Tensor { shape: shape, data: d, dtype: dt }
}

fn mk_raw(shape: Arr[I64], data: Arr[F64], dt: I64) -> Tensor = mk(shape, data, dt)

fn scalar_of(x: F64, dt: I64) -> Tensor {
  let d: Buf = buf.alloc_elems(1, dt)
  buf.set(d, dt, 0, x)
  Tensor { shape: arr_new(), data: d, dtype: dt }
}

# A bare F64 scalar. The default dtype for a literal is f64, and
# docs/dtypes.md says why at length: the differential harness compares printed
# numbers byte for byte against a bootstrap that computes in float64, so a
# default of f32 changes every golden in `testdata/` before it changes anything
# about a model. Narrow dtypes are asked for, never inferred.
fn scalar(x: F64) -> Tensor = scalar_of(x, DT_F64)

fn filled_of(shape: Arr[I64], v: F64, dt: I64) -> Tensor {
  let n: I64 = element_count(shape)
  let r: F64 = dt_round(dt, v)
  let d: Buf = buf.alloc_elems(n, dt)
  let i: I64 = 0
  while i < n {
    buf.set(d, dt, i, r)
    i = i + 1
  }
  Tensor { shape: copy_shape(shape), data: d, dtype: dt }
}

fn filled(shape: Arr[I64], v: F64) -> Tensor = filled_of(shape, v, DT_F64)

# Zero is representable in every dtype, so this needs no rounding and keeps the
# dtype it was given rather than promoting to f64. A zeros_like that changed the
# dtype would silently widen every gradient buffer seeded from one.
fn zeros_like(t: Tensor) -> Tensor = filled_of(t.shape, 0.0, t.dtype)

fn zeros_dt(shape: Arr[I64], dt: I64) -> Tensor = filled_of(shape, 0.0, dt)

fn clone(t: Tensor) -> Tensor = mk_raw(copy_shape(t.shape), data_arr(t), t.dtype)

# The elements of `t` as a fresh Arr[F64], row-major. The helpers that operate
# on plain wide buffers (`mm`, `transpose2d`, `sort_offsets`, `accumulate`)
# take one of these rather than a Buf, because they are also handed buffers no
# tensor owns: an accumulator, a transposed copy, a vjp contribution. The copy
# is the point; handing out the packed buffer itself would alias the tensor.
fn data_arr(t: Tensor) -> Arr[F64] {
  let d: Arr[F64] = arr_new()
  let n: I64 = element_count(t.shape)
  let i: I64 = 0
  while i < n {
    push(d, buf.get(t.data, t.dtype, i))
    i = i + 1
  }
  d
}

# Element i of the buffer, widened to F64. The single-element read for callers
# outside this file that used to index `t.data[i]` when it was an Arr[F64]; now
# that it is a packed Buf, this is the accessor they go through, so the widening
# rule lives in one place. src/eval.tw is the caller this exists for.
fn at(t: Tensor, i: I64) -> F64 = buf.get(t.data, t.dtype, i)

# Store x into element i of the buffer, rounded to the tensor's dtype the way
# `buf.set` requires. The write counterpart to `at`, for the same callers: it
# keeps the dtype rule in one place rather than letting src/eval.tw reach into
# the packed Buf itself. In-element assignment (`t[i] = x`) is the caller.
fn set_at(t: Tensor, i: I64, x: F64) {
  buf.set(t.data, t.dtype, i, x)
}

# The element count, for a caller that used to read `len(t.data)`. It is the
# product of the shape, not the byte length of the buffer, which is the number
# those callers meant.
fn numel(t: Tensor) -> I64 = element_count(t.shape)

# The explicit cast. `docs/dtypes.md` spells it `x.to(f32)` in surface syntax;
# this is what that lowers to.
#
# It converts from the source *value*, never from the source's own narrower
# encoding through an intermediate. Casting bf16 to f16 by way of f32 would
# round twice, and two roundings disagree with one on exactly the values that
# land halfway after the first, which is the class of bug that shows up as a
# handful of wrong elements in a tensor and nothing else.
fn cast(t: Tensor, dt: I64) -> Tensor {
  if t.dtype == dt { return clone(t) }
  let d: Arr[F64] = alloc(element_count(t.shape))
  let i: I64 = 0
  while i < element_count(t.shape) {
    d[i] = dt_round(dt, buf.get(t.data, t.dtype, i))
    i = i + 1
  }
  mk_raw(copy_shape(t.shape), d, dt)
}

# ---- float helpers --------------------------------------------------------
#
# NEEDS-68 supplies the transcendentals and NEEDS-65 supplies `f64_floor`.
# These wrappers exist so that there is
# exactly one place to change when they land, and so the NaN and signed-zero
# rules below are written once rather than at every use.

# Go's math.Max propagates NaN and prefers +0 over -0; a bare `if x >= y` does
# neither. Both matter: a NaN that silently becomes a number turns a diverged
# training run into a plausible-looking one, and the sign of a zero is
# observable through a later division.
fn f64_max(x: F64, y: F64) -> F64 {
  # x + y is NaN whenever either operand is, which is the cheapest way to
  # produce a NaN without a NaN literal in the language.
  if x != x or y != y { return x + y }
  if x == 0.0 and y == 0.0 {
    if f64_signbit(x) { return y }
    return x
  }
  if x >= y { return x }
  y
}

fn f64_min(x: F64, y: F64) -> F64 {
  if x != x or y != y { return x + y }
  if x == 0.0 and y == 0.0 {
    if f64_signbit(x) { return x }
    return y
  }
  if x <= y { return x }
  y
}

# Finite means neither an infinity nor a NaN. x - x is zero for every finite x
# and NaN for the other three values, so one subtraction asks the whole
# question without an infinity literal in the language.
fn f64_is_finite(x: F64) -> Bool = x - x == 0.0

# ---- op codes -------------------------------------------------------------
#
# One enum rather than one function per op. The Go side passes the forward and
# derivative closures into broadcastBinary; twill has function values, but a
# closure per op means the gradient rule for `mul` lives at the call site of a
# generic helper, and the point of this file is that the gradient rules are
# readable in one place.

enum Op {
  OpAdd,
  OpSub,
  OpMul,
  OpDiv,
  OpMod,
  OpMaximum,
  OpMinimum,
  OpGreater,
  OpLess,
  OpGreaterEqual,
  OpLessEqual,
  OpEqual,

  OpNeg,
  OpRelu,
  OpExp,
  OpLog,
  OpLog1p,
  OpExpm1,
  OpSin,
  OpCos,
  OpSqrt,
  OpTanh,
  OpSigmoid,
  OpSquare,
  OpPow,
  OpClip,
  OpCast,

  OpSum,
  OpMean,
  OpMax,
  OpMin,
  OpProd,
  OpMedian,
  OpArgmax,
  OpArgmin,
  OpLogSumExp,
  OpSoftmax,

  OpWhere,
  OpMatMul,
  OpEinsum,
  OpReshape,
  OpTranspose,
  OpBroadcastTo,
  OpConcat,
  OpSplit,
  OpIndex0,
  OpSlice0,
  OpGather,
  OpFlip,
  OpSort,
  OpTopK,

  OpConv2D,
  OpMaxPool2D,
  OpDiff,
  OpRoll,
  OpCumSum,
  OpCumProd,
  OpCumMax,
  OpCumMin,

  OpLeaf,
  OpConst,
}

fn op_name(op: Op) -> Str {
  match op {
    OpAdd => "add", OpSub => "sub", OpMul => "mul", OpDiv => "div",
    OpMod => "mod", OpMaximum => "maximum", OpMinimum => "minimum",
    OpGreater => "greater", OpLess => "less", OpGreaterEqual => "greater_equal",
    OpLessEqual => "less_equal", OpEqual => "equal",
    OpNeg => "neg", OpRelu => "relu", OpExp => "exp", OpLog => "log",
    OpLog1p => "log1p", OpExpm1 => "expm1",
    OpSin => "sin", OpCos => "cos", OpSqrt => "sqrt", OpTanh => "tanh",
    OpSigmoid => "sigmoid", OpSquare => "square", OpPow => "pow",
    OpClip => "clip", OpCast => "cast",
    OpSum => "sum", OpMean => "mean", OpMax => "max", OpMin => "min",
    OpProd => "prod", OpMedian => "median", OpArgmax => "argmax",
    OpArgmin => "argmin", OpLogSumExp => "logsumexp", OpSoftmax => "softmax",
    OpWhere => "where", OpMatMul => "matmul", OpEinsum => "einsum",
    OpReshape => "reshape", OpTranspose => "transpose",
    OpBroadcastTo => "broadcast_to", OpConcat => "concat", OpSplit => "split",
    OpIndex0 => "index0", OpSlice0 => "slice0", OpGather => "gather",
    OpFlip => "flip", OpSort => "sort", OpTopK => "topk",
    OpConv2D => "conv2d", OpMaxPool2D => "maxpool2d",
    OpDiff => "diff", OpRoll => "roll",
    OpCumSum => "cumsum", OpCumProd => "cumprod",
    OpCumMax => "cummax", OpCumMin => "cummin",
    OpLeaf => "leaf", OpConst => "const",
  }
}

# A comparison produces 1 or 0 and has a zero derivative everywhere it is
# defined, so it is recorded on the tape as a value with no gradient path rather
# than left off it: leaving it off would make a downstream op's input index
# dangle.
fn is_comparison(op: Op) -> Bool {
  match op {
    OpGreater => true, OpLess => true, OpGreaterEqual => true,
    OpLessEqual => true, OpEqual => true,
    _ => false,
  }
}

# ---- broadcasting ----------------------------------------------------------
#
# The runtime rule, which src/check.tw approximates statically. The difference
# between the two is only that the checker has to tolerate an unknown size and
# this does not: at run time every size is known, so a mismatch here is always
# an error and never a silence.

fn broadcast_shape(a: Arr[I64], b: Arr[I64]) -> Res[Arr[I64], Str] {
  let ra: I64 = len(a)
  let rb: I64 = len(b)
  let r: I64 = ra
  if rb > r { r = rb }
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < r {
    push(out, 0)
    i = i + 1
  }
  i = 0
  while i < r {
    # Aligned from the trailing axis. A missing axis is an implicit 1, which is
    # what makes a [3] add to a [2, 3] without the caller reshaping.
    let da: I64 = 1
    let db: I64 = 1
    if i < ra { da = a[ra - 1 - i] }
    if i < rb { db = b[rb - 1 - i] }
    if da == db {
      out[r - 1 - i] = da
    } else {
      if da == 1 {
        out[r - 1 - i] = db
      } else {
        if db == 1 {
          out[r - 1 - i] = da
        } else {
          return Err(bytes.concat("shape mismatch: ", bytes.concat(shape_string(a),
            bytes.concat(" vs ", bytes.concat(shape_string(b), " cannot broadcast")))))
        }
      }
    }
    i = i + 1
  }
  Ok(out)
}

# The flat offset in `src` (of shape `from`) that supplies the element at the
# multi-index `idx` in a broadcast result. An axis of size 1 contributes 0,
# which is exactly what "stretching" means: the same element is read repeatedly
# rather than copied.
fn broadcast_offset(from: Arr[I64], idx: Arr[I64]) -> I64 {
  let st: Arr[I64] = strides_of(from)
  let pad: I64 = len(idx) - len(from)
  let off: I64 = 0
  let i: I64 = 0
  while i < len(from) {
    let d: I64 = from[i]
    let k: I64 = idx[pad + i]
    if d == 1 { k = 0 }
    off = off + k * st[i]
    i = i + 1
  }
  off
}

# eff_strides gives, per axis of `out_shape`, how far to step in `in_shape`'s
# flat buffer when that axis advances by one. Zero where the input broadcasts,
# which is the same "read the same element again" rule as broadcast_offset,
# expressed incrementally so the odometer below never divides.
fn eff_strides(in_shape: Arr[I64], out_shape: Arr[I64]) -> Arr[I64] {
  let r_in: I64 = len(in_shape)
  let r_out: I64 = len(out_shape)
  let real: Arr[I64] = strides_of(in_shape)
  let eff: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < r_out {
    push(eff, 0)
    i = i + 1
  }
  i = 0
  while i < r_out {
    let j: I64 = r_out - 1 - i
    if i < r_in and in_shape[r_in - 1 - i] != 1 {
      eff[j] = real[r_in - 1 - i]
    } else {
      eff[j] = 0
    }
    i = i + 1
  }
  eff
}

# ---- the odometer ---------------------------------------------------------
#
# Several kernels walk one index space while tracking an offset into each of
# several differently shaped buffers: broadcast binary ops, `where`,
# `broadcast_to`, and einsum. They all want the same loop, so it is written once.
#
# `offs[k]` is the current flat offset into buffer k, advanced incrementally.
# Recomputing it by division per element is what the Go version avoids and what
# a naive port does; doing it once here means no kernel below gets it wrong
# separately.

struct Odometer {
  dims: Arr[I64],
  coord: Arr[I64],
  # contrib[k][d] is how far offs[k] moves when axis d advances.
  contrib: Arr[Arr[I64]],
  offs: Arr[I64],
}

fn odo_new(dims: Arr[I64], contrib: Arr[Arr[I64]]) -> Odometer {
  let coord: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(dims) {
    push(coord, 0)
    i = i + 1
  }
  let offs: Arr[I64] = arr_new()
  i = 0
  while i < len(contrib) {
    push(offs, 0)
    i = i + 1
  }
  Odometer { dims: dims, coord: coord, contrib: contrib, offs: offs }
}

fn odo_step(o: Odometer) {
  let d: I64 = len(o.dims) - 1
  while d >= 0 {
    o.coord[d] = o.coord[d] + 1
    let k: I64 = 0
    while k < len(o.offs) {
      o.offs[k] = o.offs[k] + o.contrib[k][d]
      k = k + 1
    }
    if o.coord[d] < o.dims[d] { return }
    # This axis wrapped: undo the whole axis and carry into the next one out.
    o.coord[d] = 0
    k = 0
    while k < len(o.offs) {
      o.offs[k] = o.offs[k] - o.contrib[k][d] * o.dims[d]
      k = k + 1
    }
    d = d - 1
  }
}

# ---- elementwise -----------------------------------------------------------

fn apply_binary(op: Op, x: F64, y: F64) -> F64 {
  match op {
    OpAdd => x + y,
    OpSub => x - y,
    OpMul => x * y,
    OpDiv => x / y,
    # Go's Mod here is the floored modulo, not math.Mod's truncated one. They
    # differ in sign for a negative operand, and the floored answer is the one
    # `%` means everywhere else in twill.
    OpMod => x - f64_floor(x / y) * y,
    OpMaximum => f64_max(x, y),
    OpMinimum => f64_min(x, y),
    OpGreater => bool_to_f64(x > y),
    OpLess => bool_to_f64(x < y),
    OpGreaterEqual => bool_to_f64(x >= y),
    OpLessEqual => bool_to_f64(x <= y),
    OpEqual => bool_to_f64(x == y),
    _ => abort(bytes.concat("apply_binary: not a binary op: ", op_name(op))),
  }
}

fn bool_to_f64(b: Bool) -> F64 {
  if b { return 1.0 }
  0.0
}

# d(out)/dx at (x, y), with the forward result `o` available because several
# rules are cheaper in terms of it.
#
# Every rule here is local: the value of the op at one pair of elements depends
# on that pair alone, so the chain rule contributes `d * upstream` at that
# element and nothing else. What makes broadcasting hard is not this function,
# it is *where the contribution lands*, and that is handled in the backward pass.
fn d_binary_a(op: Op, x: F64, y: F64, o: F64) -> F64 {
  match op {
    OpAdd => 1.0,
    OpSub => 1.0,
    # d(xy)/dx = y.
    OpMul => y,
    # d(x/y)/dx = 1/y.
    OpDiv => 1.0 / y,
    # floored mod is x - floor(x/y)*y; floor is locally constant, so this is 1
    # away from the wrap points and undefined on them. The bootstrap answers 1
    # there too rather than NaN, and matching it matters more than being right
    # on a measure-zero set nobody differentiates through on purpose.
    OpMod => 1.0,
    # A tie goes to the left operand, matching Go's `x >= y`. Some libraries
    # split the gradient in half on a tie; that is defensible and it is not what
    # the bootstrap does, and a gradient that differs between implementations is
    # worse than one that is arbitrary but fixed.
    OpMaximum => bool_to_f64(x >= y),
    OpMinimum => bool_to_f64(x <= y),
    _ => 0.0,
  }
}

fn d_binary_b(op: Op, x: F64, y: F64, o: F64) -> F64 {
  match op {
    OpAdd => 1.0,
    OpSub => 0.0 - 1.0,
    OpMul => x,
    # d(x/y)/dy = -x/y^2.
    OpDiv => (0.0 - x) / (y * y),
    # d(x - floor(x/y)*y)/dy = -floor(x/y), again treating floor as constant.
    OpMod => 0.0 - f64_floor(x / y),
    OpMaximum => bool_to_f64(x < y),
    OpMinimum => bool_to_f64(x > y),
    _ => 0.0,
  }
}

# binary is the forward kernel: broadcast `a` against `b` and apply `op`.
#
# The Go version has three fast paths (equal shapes, scalar on the right, scalar
# on the left) and a scalar-by-scalar shortcut before all of them. Only the
# shortcut is semantically visible, and only because it returns before the
# broadcast is computed; since two rank-0 shapes always broadcast to rank 0, the
# general path returns the same tensor. So none of the four is reproduced. If
# this ever needs to be fast, the equal-shape path is the one worth having,
# because it is the one training loops spend their time in.
#
# Dtype: the promotion of the two operands, except for a comparison, which
# yields bool whatever it was handed. The arithmetic itself runs in F64 and is
# rounded once on store, which for a single operation is exactly the answer the
# result dtype's own arithmetic gives; `acc_add` above carries the argument.
fn binary(op: Op, a: Tensor, b: Tensor) -> Res[Tensor, Str] {
  let shape: Arr[I64] = broadcast_shape(a.shape, b.shape)?
  # A comparison yields the promoted dtype, not bool: internal/tensor's compareOp
  # returns a plain float tensor of 0.0/1.0 (broadcastBinary), so `sum(greater(
  # x, 0))` counts them. Packing the result into DT_BOOL here diverged from the
  # reference and made a comparison-then-reduce (gbm.tw's default count) wrong.
  let dt: I64 = promote(a.dtype, b.dtype)
  let n: I64 = element_count(shape)
  let out: Arr[F64] = alloc(n)

  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(a.shape, shape))
  push(contrib, eff_strides(b.shape, shape))
  let odo: Odometer = odo_new(shape, contrib)

  let o: I64 = 0
  while o < n {
    out[o] = apply_binary(op, buf.get(a.data, a.dtype, odo.offs[0]),
      buf.get(b.data, b.dtype, odo.offs[1]))
    odo_step(odo)
    o = o + 1
  }
  Ok(mk(shape, out, dt))
}

fn apply_unary(op: Op, x: F64, p0: F64, p1: F64) -> F64 {
  match op {
    OpNeg => 0.0 - x,
    OpRelu => { if x > 0.0 { x } else { 0.0 } },
    OpExp => f64_exp(x),
    OpLog => f64_log(x),
    # log(1+x) and exp(x)-1 without forming the sum or the difference, so the
    # cancellation near zero does not throw the answer away.
    OpLog1p => f64_log1p(x),
    OpExpm1 => f64_expm1(x),
    OpSin => f64_sin(x),
    OpCos => f64_cos(x),
    OpSqrt => f64_sqrt(x),
    OpTanh => f64_tanh(x),
    OpSigmoid => 1.0 / (1.0 + f64_exp(0.0 - x)),
    OpSquare => x * x,
    OpPow => f64_pow(x, p0),
    OpClip => f64_min(f64_max(x, p0), p1),
    _ => abort(bytes.concat("apply_unary: not a unary op: ", op_name(op))),
  }
}

# The derivative of a unary op at x, given the forward result o. Written in
# terms of o where that is both cheaper and more accurate: exp' is exp, and
# sqrt' is 0.5/sqrt(x), which is 0.5/o and avoids a second square root.
fn d_unary(op: Op, x: F64, o: F64, p0: F64, p1: F64) -> F64 {
  match op {
    OpNeg => 0.0 - 1.0,
    # Zero at exactly 0. Not a subgradient choice made lightly: it is what makes
    # a dead relu stay dead, and every framework picks it.
    OpRelu => { if x > 0.0 { 1.0 } else { 0.0 } },
    OpExp => o,
    OpLog => 1.0 / x,
    # 1/(1+x) written on x and not on o: recovering x from log1p(x) would give
    # back the accuracy log1p exists to keep.
    OpLog1p => 1.0 / (1.0 + x),
    # expm1' is exp(x), which is the result plus one, so no second exponential.
    OpExpm1 => o + 1.0,
    OpSin => f64_cos(x),
    OpCos => 0.0 - f64_sin(x),
    OpSqrt => 0.5 / o,
    # 1 - tanh(x)^2, in terms of the result.
    OpTanh => 1.0 - o * o,
    # s(1 - s), in terms of the result.
    OpSigmoid => o * (1.0 - o),
    OpSquare => 2.0 * x,
    OpPow => p0 * f64_pow(x, p0 - 1.0),
    # The gradient passes through the interior only. On the clamp the output is
    # constant in x, so it is genuinely zero, not a convenience.
    OpClip => { if x > p0 and x < p1 { 1.0 } else { 0.0 } },
    _ => 0.0,
  }
}

# A unary op keeps its operand's dtype, with one exception: `exp` of an integer
# is not an integer, and truncating it back would turn `exp(i32_tensor)` into a
# staircase without saying so. The ops that do preserve integrality keep it, and
# the rest promote to f32, which is the same rule numpy applies and the same one
# a reader expects.
fn unary_result_dtype(op: Op, dt: I64) -> I64 {
  if is_float_dtype(dt) { return dt }
  if op == OpNeg or op == OpRelu { return dt }
  if op == OpSquare or op == OpClip { return dt }
  DT_F32
}

fn unary_p(op: Op, a: Tensor, p0: F64, p1: F64) -> Tensor {
  let dt: I64 = unary_result_dtype(op, a.dtype)
  let n: I64 = element_count(a.shape)
  let out: Arr[F64] = alloc(n)
  let i: I64 = 0
  while i < n {
    out[i] = apply_unary(op, buf.get(a.data, a.dtype, i), p0, p1)
    i = i + 1
  }
  mk(copy_shape(a.shape), out, dt)
}

fn unary(op: Op, a: Tensor) -> Tensor = unary_p(op, a, 0.0, 0.0)

fn pow_scalar(a: Tensor, p: F64) -> Tensor = unary_p(OpPow, a, p, 0.0)

fn clip(a: Tensor, lo: F64, hi: F64) -> Tensor = unary_p(OpClip, a, lo, hi)

# where selects from `a` where `cond` is non-zero and from `b` otherwise, with
# all three broadcast together. Not differentiable through `cond`: it is a
# selector, and an infinitesimal change to it changes nothing until it crosses
# zero, at which point the output jumps.
fn where_broadcast(x: Arr[I64], y: Arr[I64]) -> Res[Arr[I64], Str] {
  match broadcast_shape(x, y) {
    Ok(s) => Ok(s),
    Err(_) => Err(bytes.concat("where: cannot broadcast ",
      bytes.concat(shape_string(x), bytes.concat(" with ", shape_string(y))))),
  }
}

fn where3(cond: Tensor, a: Tensor, b: Tensor) -> Res[Tensor, Str] {
  # `where` reports its own message rather than letting broadcast_shape's
  # through, because the bootstrap does and the two texts differ.
  let s1: Arr[I64] = where_broadcast(cond.shape, a.shape)?
  let shape: Arr[I64] = where_broadcast(s1, b.shape)?
  # The condition's dtype does not enter the promotion. It is read for its
  # truthiness and never for its value, so a bool selector must not drag the
  # result down to bool.
  let dt: I64 = promote(a.dtype, b.dtype)
  let n: I64 = element_count(shape)
  let out: Arr[F64] = alloc(n)

  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(cond.shape, shape))
  push(contrib, eff_strides(a.shape, shape))
  push(contrib, eff_strides(b.shape, shape))
  let odo: Odometer = odo_new(shape, contrib)

  let o: I64 = 0
  while o < n {
    if buf.get(cond.data, cond.dtype, odo.offs[0]) != 0.0 {
      out[o] = buf.get(a.data, a.dtype, odo.offs[1])
    } else {
      out[o] = buf.get(b.data, b.dtype, odo.offs[2])
    }
    odo_step(odo)
    o = o + 1
  }
  # `mk` and not `mk_raw`: an operand of a wider dtype than the result is
  # possible only through promotion, which never narrows, so every element is
  # already representable. Rounding anyway costs one pass and removes the need
  # for the reader to have just checked that.
  Ok(mk(shape, out, dt))
}

# ---- matmul ----------------------------------------------------------------

# The matmul shape rule, matching src/check.tw's matmul_result. A rank-1 operand
# is promoted, on the left to a row and on the right to a column, and the
# promoted axis is dropped again from the result.
fn matmul_shape(a: Arr[I64], b: Arr[I64]) -> Res[Arr[I64], Str] {
  let a2: Arr[I64] = a
  if len(a) == 1 {
    a2 = arr_new()
    push(a2, 1)
    push(a2, a[0])
  }
  let b2: Arr[I64] = b
  if len(b) == 1 {
    b2 = arr_new()
    push(b2, b[0])
    push(b2, 1)
  }
  if len(a2) != 2 or len(b2) != 2 {
    return Err(bytes.concat("@ needs vectors or matrices, got ",
      bytes.concat(shape_string(a), bytes.concat(" and ", shape_string(b)))))
  }
  if a2[1] != b2[0] {
    return Err(bytes.concat("shape mismatch in @: ", bytes.concat(shape_string(a),
      bytes.concat(" @ ", bytes.concat(shape_string(b),
      bytes.concat(" (inner ", bytes.concat(str(a2[1]),
      bytes.concat(" != ", bytes.concat(str(b2[0]), ")")))))))))
  }
  let out: Arr[I64] = arr_new()
  if len(a) == 1 and len(b) == 1 { return Ok(out) }
  if len(a) == 1 {
    push(out, b2[1])
    return Ok(out)
  }
  if len(b) == 1 {
    push(out, a2[0])
    return Ok(out)
  }
  push(out, a2[0])
  push(out, b2[1])
  Ok(out)
}

# The promoted 2-D shape of a matmul operand: [1, k] for a left vector, [k, 1]
# for a right vector, unchanged for a matrix. The gradient rules need it, so it
# is a function rather than three lines repeated in four places.
fn matmul_promote(s: Arr[I64], is_left: Bool) -> Arr[I64] {
  if len(s) != 1 { return s }
  let out: Arr[I64] = arr_new()
  if is_left {
    push(out, 1)
    push(out, s[0])
  } else {
    push(out, s[0])
    push(out, 1)
  }
  out
}

# The textbook triple loop, over flat buffers, with the k loop outside the j
# loop so the innermost access is contiguous in both b and c. Nothing else about
# it is tuned: no blocking, no transposed copy, no parallel split. Those go here
# and only here, because every other use of matmul below goes through this.
#
# `acc` is the accumulation dtype and the whole reason this function takes a
# dtype at all. `c` is the accumulator, not the output: it is held at `acc`
# throughout and rounded to the output dtype exactly once, by `mk` at the call
# site. Rounding to the output dtype inside the k loop instead is the mistake
# `acc_dtype` exists to prevent, and for bf16 over a long inner dimension it
# does not merely lose accuracy, it stops the sum growing altogether.
fn mm(a: Arr[F64], m: I64, k: I64, b: Arr[F64], n: I64, acc: I64) -> Arr[F64] {
  let c: Arr[F64] = alloc(m * n)
  let i: I64 = 0
  while i < m {
    let p: I64 = 0
    while p < k {
      let aip: F64 = a[i * k + p]
      # Skipping zeros is in the Go version and is kept, not for speed but
      # because it is load-bearing for one case: a zero times an infinity is
      # NaN, and a sparse matrix multiplied by a buffer holding an infinity
      # would otherwise poison the whole row.
      if aip != 0.0 {
        let b_row: I64 = p * n
        let c_row: I64 = i * n
        let j: I64 = 0
        while j < n {
          # The product is formed in F64 and the sum is rounded to `acc`, which
          # is exactly an `acc`-precision fused step: the product of two values
          # of a format at most as wide as f32 is exact in F64, so the only
          # rounding is the one written here.
          c[c_row + j] = acc_add(acc, c[c_row + j], aip * b[b_row + j])
          j = j + 1
        }
      }
      p = p + 1
    }
    i = i + 1
  }
  c
}

fn transpose2d(a: Arr[F64], rows: I64, cols: I64) -> Arr[F64] {
  let t: Arr[F64] = alloc(rows * cols)
  let i: I64 = 0
  while i < rows {
    let j: I64 = 0
    while j < cols {
      t[j * rows + i] = a[i * cols + j]
      j = j + 1
    }
    i = i + 1
  }
  t
}

fn matmul(a: Tensor, b: Tensor) -> Res[Tensor, Str] {
  let out_shape: Arr[I64] = matmul_shape(a.shape, b.shape)?
  let a2: Arr[I64] = matmul_promote(a.shape, true)
  let b2: Arr[I64] = matmul_promote(b.shape, false)
  let dt: I64 = promote(a.dtype, b.dtype)
  let data: Arr[F64] = mm(data_arr(a), a2[0], a2[1], data_arr(b), b2[1], acc_dtype(dt))
  # The buffer is m*n either way; only the shape records that a promoted axis
  # was dropped. That is why the backward pass can treat the incoming cotangent
  # as flat regardless of the result's rank.
  Ok(mk(out_shape, data, dt))
}

# ---- axis helpers ----------------------------------------------------------
#
# Every axis-wise kernel below sees the tensor as `before * length * after`:
# `before` independent blocks, each holding `after` interleaved runs of
# `length`. The flat index of run element k is `i*length*after + k*after + j`.
#
# This is the single idea that makes reductions, scans, sorts, concat and split
# one loop shape instead of five. It works because the buffer is dense and
# row-major, so the axis being worked on is a fixed stride apart.

struct Spans {
  before: I64,
  length: I64,
  after: I64,
}

fn axis_spans(shape: Arr[I64], axis: I64) -> Spans {
  let before: I64 = 1
  let after: I64 = 1
  let i: I64 = 0
  while i < axis {
    before = before * shape[i]
    i = i + 1
  }
  i = axis + 1
  while i < len(shape) {
    after = after * shape[i]
    i = i + 1
  }
  Spans { before: before, length: shape[axis], after: after }
}

fn remove_axis(shape: Arr[I64], axis: I64) -> Arr[I64] {
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(shape) {
    if i != axis { push(out, shape[i]) }
    i = i + 1
  }
  out
}

# The reduced shape with a 1 left in the reduced axis. This is what other array
# libraries spell `keepdims=True`. The bootstrap has no such flag and asks the
# caller to `broadcast_to` the original shape instead; both are here because a
# 1-axis is what makes the result line up against the input again, and
# right-aligned broadcasting will not do that on its own: reducing axis 1 of a
# [2, 3] gives a [2], and [2] does not align with [2, 3].
fn keep_axis(shape: Arr[I64], axis: I64) -> Arr[I64] {
  let out: Arr[I64] = copy_shape(shape)
  out[axis] = 1
  out
}

# A negative axis counts from the end, so -1 is the last axis. Out of range is
# an error rather than a clamp: a clamped axis reduces the wrong thing and the
# result still has a plausible shape, which is the worst kind of bug.
fn normalize_axis(axis: I64, rank: I64) -> Res[I64, Str] {
  let a: I64 = axis
  if a < 0 { a = a + rank }
  if a < 0 or a >= rank {
    return Err(bytes.concat("axis ", bytes.concat(str(axis),
      bytes.concat(" out of range for rank ", str(rank)))))
  }
  Ok(a)
}

# ---- reductions ------------------------------------------------------------

# sum and mean over every element, to a rank-0 tensor.
#
# Gradient: every input contributed exactly once to the sum, so each gets the
# whole upstream scalar; for mean each gets it divided by n. There is no
# summing-back to do here because the output is a scalar, which is the one case
# where the broadcast trap cannot bite.
# The result dtype of a sum is the input's; of a mean it is the input's if that
# is a float and f32 otherwise, because the mean of a set of integers is not one.
fn reduce_result_dtype(dt: I64, mean: Bool) -> I64 {
  if mean and is_int_dtype(dt) { return DT_F32 }
  dt
}

# The bootstrap sums a whole tensor in two forms, and this reduction has to pick
# the same one at every size or it disagrees on the last bits. Below MIN_PARALLEL
# it is a plain running sum; at or above, it is summed in fixed SUM_CHUNK-element
# blocks whose partials are then combined in block order. The block size is fixed
# and not derived from a core count, exactly as internal/tensor/parallel.go fixes
# it, because that is what makes the answer the same on any machine and, the point
# here, the same as the bootstrap's to the last bit. A plain running sum at every
# size, which this was, failed the differential test above 8192 elements on the
# last digit of a canonical float (NEEDS-109).
let MIN_PARALLEL: I64 = 8192
let SUM_CHUNK: I64 = 4096

# The whole-buffer sum in that order. acc_add rather than a bare `+` so a narrow
# tensor accumulates at its accumulation dtype; for an f64 tensor acc_add is f64
# addition, so the order below is bit-identical to `parallelSum` over `[]float64`.
fn block_sum(a: Tensor, acc: I64, n: I64) -> F64 {
  if n < MIN_PARALLEL {
    let s: F64 = 0.0
    let i: I64 = 0
    while i < n {
      s = acc_add(acc, s, buf.get(a.data, a.dtype, i))
      i = i + 1
    }
    return s
  }
  let total: F64 = 0.0
  let start: I64 = 0
  while start < n {
    let end: I64 = start + SUM_CHUNK
    if end > n { end = n }
    let s: F64 = 0.0
    let i: I64 = start
    while i < end {
      s = acc_add(acc, s, buf.get(a.data, a.dtype, i))
      i = i + 1
    }
    total = acc_add(acc, total, s)
    start = start + SUM_CHUNK
  }
  total
}

fn reduce_all(a: Tensor, mean: Bool) -> Tensor {
  let dt: I64 = reduce_result_dtype(a.dtype, mean)
  # The running sum is held at the accumulation dtype for the length of the
  # reduction and rounded to the result dtype once, by `scalar_of`. Over a
  # million-element bf16 tensor the difference between this and a bf16 running
  # sum is not in the last bits: a bf16 accumulator stops moving once the sum
  # exceeds 256 times a typical term.
  let acc: I64 = acc_dtype(dt)
  let n: I64 = element_count(a.shape)
  let s: F64 = block_sum(a, acc, n)
  # The bootstrap forms the mean as `s * (1.0 / n)`, not `s / n`. The two round
  # differently, because `1.0 / n` rounds once before the multiply rounds again,
  # and matching the bootstrap to the last bit means matching that, not just the
  # sum order above.
  if mean { return scalar_of(s * (1.0 / f64_of_i64(n)), dt) }
  scalar_of(s, dt)
}

fn sum_all(a: Tensor) -> Tensor = reduce_all(a, false)
fn mean_all(a: Tensor) -> Tensor = reduce_all(a, true)

# sum or mean along one axis, dropping it.
#
# Gradient: the output at (i, j) is the sum of the L elements of that run, each
# with coefficient 1 (or 1/L for mean), so the upstream value at (i, j) is
# broadcast back along the run. That broadcast-back is the same operation as
# `broadcast_to` and it is the reason a reduction and an expansion are each
# other's gradient.
fn reduce_axis(t: Tensor, axis_in: I64, mean: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let dt: I64 = reduce_result_dtype(t.dtype, mean)
  let acc: I64 = acc_dtype(dt)
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(sp.before * sp.after)
  let scale: F64 = 1.0
  if mean { scale = 1.0 / f64_of_i64(sp.length) }
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let s: F64 = 0.0
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        # Accumulated wider than it is stored. See `acc_dtype`.
        s = acc_add(acc, s, buf.get(t.data, t.dtype, base + k * sp.after))
        k = k + 1
      }
      out[i * sp.after + j] = s * scale
      j = j + 1
    }
    i = i + 1
  }
  Ok(mk(remove_axis(t.shape, axis), out, dt))
}

fn sum_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = reduce_axis(t, axis, false)
fn mean_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = reduce_axis(t, axis, true)

# The keepdims form of any axis reduction. Reduce, then reshape the 1 back in.
# Written as a composition rather than a flag on every reduction because the
# gradient then composes too: reshape's gradient is the identity on the buffer,
# so nothing about the reduction's gradient has to know keepdims exists.
fn reduce_axis_keep(t: Tensor, axis_in: I64, op: Op) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let dropped: Tensor = reduce_axis_by(t, axis, op)?
  reshape(dropped, keep_axis(t.shape, axis))
}

# One name for "reduce this axis with this op", so that keepdims, and the
# gradient dispatch further down, do not each need their own seven-way branch.
fn reduce_axis_by(t: Tensor, axis: I64, op: Op) -> Res[Tensor, Str] {
  if op == OpSum { return sum_axis(t, axis) }
  if op == OpMean { return mean_axis(t, axis) }
  if op == OpMax { return max_axis(t, axis) }
  if op == OpMin { return min_axis(t, axis) }
  if op == OpProd { return prod_axis(t, axis) }
  if op == OpMedian { return median_axis(t, axis) }
  if op == OpLogSumExp { return logsumexp_axis(t, axis) }
  Err(bytes.concat("reduce_axis_by: not a reduction: ", op_name(op)))
}

# max or min along an axis, dropping it.
#
# Gradient: the output is one of the inputs, so the derivative with respect to
# that input is 1 and with respect to every other element of the run is 0. Move
# a non-selected element a little and the maximum does not move at all. The
# whole upstream value therefore routes to the selected offset.
#
# Ties go to the first occurrence, because the comparison is strict. That is a
# choice, and it has to be the same choice as argmax's and as the sort's, or two
# operations disagree about which element they are talking about.
fn extreme_axis(t: Tensor, axis_in: I64, want_max: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(sp.before * sp.after)
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let best: F64 = buf.get(t.data, t.dtype, base)
      let k: I64 = 1
      while k < sp.length {
        let v: F64 = buf.get(t.data, t.dtype, base + k * sp.after)
        if (want_max and v > best) or ((not want_max) and v < best) { best = v }
        k = k + 1
      }
      out[i * sp.after + j] = best
      j = j + 1
    }
    i = i + 1
  }
  # A selection, not a computation: every output element is an input element, so
  # it is already representable and `mk_raw` is honest rather than lazy.
  Ok(mk_raw(remove_axis(t.shape, axis), out, t.dtype))
}

fn max_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = extreme_axis(t, axis, true)
fn min_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = extreme_axis(t, axis, false)

# The flat offsets the extremes came from, recomputed in the backward pass
# rather than recorded in the forward one. Recomputing is exact: the forward
# kernel is deterministic and the input tensor is on the tape, so the same scan
# picks the same element. Recording it would be faster and is the optimisation
# that goes here.
fn extreme_axis_origins(t: Tensor, axis: I64, want_max: Bool) -> Arr[I64] {
  let sp: Spans = axis_spans(t.shape, axis)
  let origin: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < sp.before * sp.after {
    push(origin, 0)
    i = i + 1
  }
  i = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let best: F64 = buf.get(t.data, t.dtype, base)
      let best_idx: I64 = base
      let k: I64 = 1
      while k < sp.length {
        let v: F64 = buf.get(t.data, t.dtype, base + k * sp.after)
        if (want_max and v > best) or ((not want_max) and v < best) {
          best = v
          best_idx = base + k * sp.after
        }
        k = k + 1
      }
      origin[i * sp.after + j] = best_idx
      j = j + 1
    }
    i = i + 1
  }
  origin
}

# argmax and argmin, returning the position within the run. Not differentiable:
# the output is an index, and moving an input by an infinitesimal amount does not
# move an index at all until it crosses a neighbour, at which point it jumps.
# The derivative is zero almost everywhere and undefined on the boundaries, so
# there is nothing worth propagating.
fn arg_extreme_axis(t: Tensor, axis_in: I64, want_max: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(sp.before * sp.after)
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let best: F64 = buf.get(t.data, t.dtype, base)
      let best_k: I64 = 0
      let k: I64 = 1
      while k < sp.length {
        let v: F64 = buf.get(t.data, t.dtype, base + k * sp.after)
        if (want_max and v > best) or ((not want_max) and v < best) {
          best = v
          best_k = k
        }
        k = k + 1
      }
      out[i * sp.after + j] = f64_of_i64(best_k)
      j = j + 1
    }
    i = i + 1
  }
  # An index, so i32 whatever the input was. An argmax that came back as bf16
  # would round to the nearest 2^k above 256 and start naming the wrong element.
  Ok(mk(remove_axis(t.shape, axis), out, DT_I32))
}

fn argmax_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = arg_extreme_axis(t, axis, true)
fn argmin_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = arg_extreme_axis(t, axis, false)

# max or min over every element. Same gradient argument as the axis form: the
# whole upstream scalar goes to the one offset that was selected.
fn extreme_all(t: Tensor, want_max: Bool) -> Tensor {
  scalar_of(buf.get(t.data, t.dtype, extreme_all_origin(t, want_max)), t.dtype)
}

fn extreme_all_origin(t: Tensor, want_max: Bool) -> I64 {
  let best: F64 = buf.get(t.data, t.dtype, 0)
  let best_idx: I64 = 0
  let i: I64 = 1
  while i < element_count(t.shape) {
    let v: F64 = buf.get(t.data, t.dtype, i)
    if (want_max and v > best) or ((not want_max) and v < best) {
      best = v
      best_idx = i
    }
    i = i + 1
  }
  best_idx
}

fn max_all(t: Tensor) -> Tensor = extreme_all(t, true)
fn min_all(t: Tensor) -> Tensor = extreme_all(t, false)

# ---- softmax and logsumexp -------------------------------------------------

# Softmax along an axis, shifted by the run maximum before exponentiating. The
# shift is not an optimisation: exp of a large positive number overflows to
# infinity and the ratio becomes NaN, and subtracting the maximum leaves the
# answer unchanged because it cancels between numerator and denominator.
#
# Gradient: with s the softmax output and g the upstream cotangent, the
# derivative is s * (g - dot(g, s)) within each run, where dot is over the run.
# The subtraction is the whole content of the rule: softmax's outputs sum to 1
# along the run, so any change that raises one output must lower the others, and
# the dot term is exactly that constraint. Dropping it gives a gradient that is
# wrong by a rank-1 term and still looks plausible, which is why it is spelled
# out here rather than derived at the call site.
fn softmax(t: Tensor, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  # An integer softmax is not an integer, so it comes back as f32.
  let dt: I64 = t.dtype
  if is_int_dtype(dt) { dt = DT_F32 }
  # The exponentials and their total are held at the accumulation dtype and only
  # the quotient is stored. This is the op where a narrow accumulator does the
  # most damage: the terms span orders of magnitude by construction, so a bf16
  # total is the largest term and nothing else.
  let acc: I64 = acc_dtype(dt)
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(element_count(t.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let m: F64 = buf.get(t.data, t.dtype, base)
      let k: I64 = 1
      while k < sp.length {
        let v: F64 = buf.get(t.data, t.dtype, base + k * sp.after)
        if v > m { m = v }
        k = k + 1
      }
      let total: F64 = 0.0
      k = 0
      while k < sp.length {
        let e: F64 = dt_round(acc, f64_exp(buf.get(t.data, t.dtype, base + k * sp.after) - m))
        out[base + k * sp.after] = e
        total = acc_add(acc, total, e)
        k = k + 1
      }
      k = 0
      while k < sp.length {
        out[base + k * sp.after] = out[base + k * sp.after] / total
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(mk(copy_shape(t.shape), out, dt))
}

# logsumexp along an axis, dropping it. Same maximum shift, and the added
# maximum at the end is what makes it exact rather than merely non-overflowing.
#
# Gradient: d/dx log sum exp(x) = softmax(x). So the upstream value at each
# output is spread along the run weighted by the softmax of that run. That is
# the cleanest gradient in this file and it is worth knowing by name, because it
# is why a cross-entropy written as logsumexp minus the true logit backpropagates
# to `softmax - onehot`.
fn logsumexp_axis(t: Tensor, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let dt: I64 = t.dtype
  if is_int_dtype(dt) { dt = DT_F32 }
  let acc: I64 = acc_dtype(dt)
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(sp.before * sp.after)
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let m: F64 = buf.get(t.data, t.dtype, base)
      let k: I64 = 1
      while k < sp.length {
        let v: F64 = buf.get(t.data, t.dtype, base + k * sp.after)
        if v > m { m = v }
        k = k + 1
      }
      let total: F64 = 0.0
      k = 0
      while k < sp.length {
        # Accumulated wider than it is stored, as in `softmax`, and for the same
        # reason: the terms differ by orders of magnitude on purpose.
        total = acc_add(acc, total, f64_exp(buf.get(t.data, t.dtype, base + k * sp.after) - m))
        k = k + 1
      }
      out[i * sp.after + j] = m + f64_log(total)
      j = j + 1
    }
    i = i + 1
  }
  Ok(mk(remove_axis(t.shape, axis), out, dt))
}

# ---- product ---------------------------------------------------------------

# prod_over is the shared body for both product entry points: `before * after`
# independent runs of length L, strided by `after`. Passing before = after = 1
# and L = len(data) reduces the whole tensor, so the two are the same code.
#
# Gradient: the derivative of a product with respect to one factor is the
# product of the others, which is the whole product divided by that factor,
# except that the division is invalid exactly when the factor is zero, and a
# zero in a tensor is not a rare case. So the zeros are counted instead:
#
#   no zeros     every factor gets total / x
#   one zero     that factor gets the product of the rest; every other factor's
#                "product of the others" still contains the zero, so it is 0
#   two or more  every derivative is 0, for the same reason
#
# The zero-count and the product of the non-zero factors are both computed in
# the forward pass here and recomputed in the backward pass by calling this
# again, which is the recompute-instead-of-record choice made everywhere below.
struct ProdAux {
  out: Arr[F64],
  nz_prod: Arr[F64],
  zeros: Arr[I64],
}

# `acc` is the accumulation dtype, as for a sum. A product needs it more than a
# sum does, not less: the running product's exponent is the sum of the terms'
# exponents, so a bf16 product of a hundred terms leaves bf16's range long
# before it leaves f32's, and an accumulator that overflows returns an infinity
# rather than a number that is merely off.
fn prod_over(t: Tensor, l: I64, before: I64, after: I64, acc: I64) -> ProdAux {
  let out_n: I64 = before * after
  let out: Arr[F64] = alloc(out_n)
  let nz_prod: Arr[F64] = alloc(out_n)
  let zeros: Arr[I64] = arr_new()
  let z: I64 = 0
  while z < out_n {
    push(zeros, 0)
    z = z + 1
  }
  let i: I64 = 0
  while i < before {
    let j: I64 = 0
    while j < after {
      let base: I64 = i * l * after + j
      let p: F64 = 1.0
      let nz: F64 = 1.0
      let nzeros: I64 = 0
      let k: I64 = 0
      while k < l {
        let v: F64 = buf.get(t.data, t.dtype, base + k * after)
        p = acc_mul(acc, p, v)
        if v == 0.0 {
          nzeros = nzeros + 1
        } else {
          nz = acc_mul(acc, nz, v)
        }
        k = k + 1
      }
      let idx: I64 = i * after + j
      out[idx] = p
      nz_prod[idx] = nz
      zeros[idx] = nzeros
      j = j + 1
    }
    i = i + 1
  }
  ProdAux { out: out, nz_prod: nz_prod, zeros: zeros }
}

fn prod_all(t: Tensor) -> Tensor {
  let aux: ProdAux = prod_over(t, element_count(t.shape), 1, 1, acc_dtype(t.dtype))
  mk(arr_new(), aux.out, t.dtype)
}

fn prod_axis(t: Tensor, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let aux: ProdAux = prod_over(t, sp.length, sp.before, sp.after, acc_dtype(t.dtype))
  Ok(mk(remove_axis(t.shape, axis), aux.out, t.dtype))
}

# ---- median ----------------------------------------------------------------

# median_over mirrors prod_over's layout.
#
# Gradient: the median of a run is one of its values, so moving any other value
# a little does not move the answer at all and its derivative is zero. The
# selected element takes the whole upstream value. An even-length run averages
# the two middle values, so each of those takes half.
#
# Selection is by sorting *indices*, not values, because the gradient needs to
# know which element was chosen and not just what it held.
struct MedianAux {
  out: Arr[F64],
  lo: Arr[I64],
  hi: Arr[I64],
}

fn median_over(t: Tensor, l: I64, before: I64, after: I64) -> MedianAux {
  # One widened copy for the sort keys, taken up front: sort_offsets orders
  # plain wide buffers, and reading the packed buffer once per comparison would
  # widen the same element l log l times.
  let keys: Arr[F64] = data_arr(t)
  let out_n: I64 = before * after
  let out: Arr[F64] = alloc(out_n)
  let lo: Arr[I64] = arr_new()
  let hi: Arr[I64] = arr_new()
  let z: I64 = 0
  while z < out_n {
    push(lo, 0)
    push(hi, 0)
    z = z + 1
  }
  let i: I64 = 0
  while i < before {
    let j: I64 = 0
    while j < after {
      let base: I64 = i * l * after + j
      let idx_buf: Arr[I64] = arr_new()
      let k: I64 = 0
      while k < l {
        push(idx_buf, base + k * after)
        k = k + 1
      }
      sort_offsets(idx_buf, keys, false)
      let idx: I64 = i * after + j
      let mid: I64 = l / 2
      if l % 2 == 1 {
        lo[idx] = idx_buf[mid]
        hi[idx] = idx_buf[mid]
        out[idx] = buf.get(t.data, t.dtype, idx_buf[mid])
      } else {
        lo[idx] = idx_buf[mid - 1]
        hi[idx] = idx_buf[mid]
        out[idx] = (buf.get(t.data, t.dtype, idx_buf[mid - 1])
          + buf.get(t.data, t.dtype, idx_buf[mid])) / 2.0
      }
      j = j + 1
    }
    i = i + 1
  }
  MedianAux { out: out, lo: lo, hi: hi }
}

fn median_all(t: Tensor) -> Tensor {
  let aux: MedianAux = median_over(t, element_count(t.shape), 1, 1)
  # An even-length run averages its two middle values, so a median is a mean in
  # the one respect that decides the dtype: it need not be an integer.
  mk(arr_new(), aux.out, reduce_result_dtype(t.dtype, true))
}

fn median_axis(t: Tensor, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let aux: MedianAux = median_over(t, sp.length, sp.before, sp.after)
  Ok(mk(remove_axis(t.shape, axis), aux.out, reduce_result_dtype(t.dtype, true)))
}

# ---- sorting ---------------------------------------------------------------

# A stable insertion sort of an array of flat offsets by the values they point
# at. Insertion sort is quadratic and that is the wrong asymptotics for a long
# axis; a merge sort goes here when it matters. It is not a placeholder for
# correctness, though: it is stable, and stability is load-bearing.
#
# Stability is why ties keep their original relative order, which is what makes
# the result reproducible between runs and, because the gradient of a sort
# follows the permutation, makes the *gradient* reproducible too. An unstable
# sort returns the same values in a different arrangement and a different
# gradient.
fn sort_offsets(offs: Arr[I64], data: Arr[F64], descending: Bool) {
  let i: I64 = 1
  while i < len(offs) {
    let v: I64 = offs[i]
    let vv: F64 = data[v]
    let j: I64 = i - 1
    while j >= 0 and sorts_before(vv, data[offs[j]], descending) {
      offs[j + 1] = offs[j]
      j = j - 1
    }
    offs[j + 1] = v
    i = i + 1
  }
}

# Strict comparison in the direction asked for. Strict is what keeps the
# insertion loop stable: an equal pair does not shift, so the earlier element
# stays earlier.
fn sorts_before(x: F64, y: F64, descending: Bool) -> Bool {
  if descending { return x > y }
  x < y
}

# Sort each run along an axis.
#
# Gradient: sorting is a permutation, and the derivative of a permutation is its
# inverse. Whatever cotangent arrives at the element now in position 3 belongs
# to whichever element started there, so the backward pass sends each one home.
# No approximation is involved, which is why this is worth having rather than
# something a caller fakes with an argsort and a gather.
fn sort_axis(t: Tensor, axis_in: I64, descending: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let origin: Arr[I64] = sort_origins(t, axis, descending, sp_length(t, axis))
  let out: Arr[F64] = alloc(element_count(t.shape))
  let i: I64 = 0
  while i < len(origin) {
    out[i] = buf.get(t.data, t.dtype, origin[i])
    i = i + 1
  }
  Ok(mk_raw(copy_shape(t.shape), out, t.dtype))
}

fn sp_length(t: Tensor, axis: I64) -> I64 = t.shape[axis]

# origin[dst] is the flat input offset that supplies output offset dst. Shared
# by sort and topk, and by both of their gradients, so there is one definition
# of which element went where.
#
# `keep` is how many of each sorted run survive into the output: the whole run
# for a sort, k for a topk.
fn sort_origins(t: Tensor, axis: I64, descending: Bool, keep: I64) -> Arr[I64] {
  # The same up-front widening median_over does, for the same reason.
  let keys: Arr[F64] = data_arr(t)
  let sp: Spans = axis_spans(t.shape, axis)
  let origin: Arr[I64] = arr_new()
  let z: I64 = 0
  while z < sp.before * keep * sp.after {
    push(origin, 0)
    z = z + 1
  }
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let offs: Arr[I64] = arr_new()
      let k: I64 = 0
      while k < sp.length {
        push(offs, base + k * sp.after)
        k = k + 1
      }
      sort_offsets(offs, keys, descending)
      k = 0
      while k < keep {
        origin[i * keep * sp.after + k * sp.after + j] = offs[k]
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  origin
}

# The indices that would sort each run. Not differentiable, for the same reason
# as argmax.
fn argsort_axis(t: Tensor, axis_in: I64, descending: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let origin: Arr[I64] = sort_origins(t, axis, descending, sp.length)
  let out: Arr[F64] = alloc(element_count(t.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        # Back out the position within the run from the flat offset it came
        # from, which is what an index means here.
        let src: I64 = origin[base + k * sp.after]
        out[base + k * sp.after] = f64_of_i64((src - base) / sp.after)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  # Indices, so i32. Same argument as argmax.
  Ok(mk(copy_shape(t.shape), out, DT_I32))
}

# The k largest (or smallest) values along an axis, in order, with the axis
# shrinking to k. This is the shape a caller wants for "the five most likely
# classes": the values, in order, with everything else dropped.
#
# Gradient: differentiable through the values that survive, and exactly zero for
# the ones that do not. A value outside the top k contributes nothing to the
# output, so changing it a little does not move the output. That is correct
# rather than a simplification.
fn topk_axis(t: Tensor, k: I64, axis_in: I64, largest: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  if k <= 0 {
    return Err(bytes.concat("topk: k must be positive, got ", str(k)))
  }
  if k > sp.length {
    return Err(bytes.concat("topk: k is ", bytes.concat(str(k),
      bytes.concat(" but axis ", bytes.concat(str(axis),
      bytes.concat(" has length ", str(sp.length)))))))
  }
  let origin: Arr[I64] = sort_origins(t, axis, largest, k)
  let out: Arr[F64] = alloc(len(origin))
  let i: I64 = 0
  while i < len(origin) {
    out[i] = buf.get(t.data, t.dtype, origin[i])
    i = i + 1
  }
  let shape: Arr[I64] = copy_shape(t.shape)
  shape[axis] = k
  Ok(mk_raw(shape, out, t.dtype))
}

# The indices of the k largest. Indices, so not differentiable.
fn argtopk_axis(t: Tensor, k: I64, axis_in: I64, largest: Bool) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  if k <= 0 {
    return Err(bytes.concat("argtopk: k must be positive, got ", str(k)))
  }
  if k > sp.length {
    return Err(bytes.concat("argtopk: k is ", bytes.concat(str(k),
      bytes.concat(" but axis ", bytes.concat(str(axis),
      bytes.concat(" has length ", str(sp.length)))))))
  }
  let origin: Arr[I64] = sort_origins(t, axis, largest, k)
  let out: Arr[F64] = alloc(len(origin))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let n: I64 = 0
      while n < k {
        let dst: I64 = i * k * sp.after + n * sp.after + j
        out[dst] = f64_of_i64((origin[dst] - base) / sp.after)
        n = n + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  let shape: Arr[I64] = copy_shape(t.shape)
  shape[axis] = k
  Ok(mk(shape, out, DT_I32))
}

# Reverse the order along one axis, keeping the shape.
#
# Gradient: reversing is a permutation and it is its own inverse, so the
# backward pass is the same reversal. Worth stating because it makes the rule
# obvious rather than something to derive.
fn flip_axis(t: Tensor, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(element_count(t.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        out[base + k * sp.after] = buf.get(t.data, t.dtype, base + (sp.length - 1 - k) * sp.after)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(mk_raw(copy_shape(t.shape), out, t.dtype))
}

# ---- shape ops -------------------------------------------------------------

# Same buffer, new shape.
#
# Gradient: the identity on the buffer. Element i of the output is element i of
# the input, so the cotangent is copied straight back, only wearing the input's
# shape again. This is the one op where the gradient is genuinely nothing.
fn reshape(t: Tensor, shape: Arr[I64]) -> Res[Tensor, Str] {
  if element_count(shape) != element_count(t.shape) {
    return Err(bytes.concat("reshape: cannot fit ", bytes.concat(str(element_count(t.shape)),
      bytes.concat(" elements into shape ", shape_string(shape)))))
  }
  # The clone's buffer is adopted whole rather than repacked through mk_raw,
  # which takes the wide Arr[F64] form; the elements are already packed and
  # already the right dtype, and only the shape changes.
  let c: Tensor = clone(t)
  Ok(Tensor { shape: copy_shape(shape), data: c.data, dtype: t.dtype })
}

# Resolve a permutation argument. An empty `axes` reverses them, which is the
# plain transpose.
fn resolve_perm(rank_in: I64, axes: Arr[I64]) -> Res[Arr[I64], Str] {
  let perm: Arr[I64] = arr_new()
  if len(axes) == 0 {
    let i: I64 = 0
    while i < rank_in {
      push(perm, rank_in - 1 - i)
      i = i + 1
    }
    return Ok(perm)
  }
  if len(axes) != rank_in {
    return Err(bytes.concat("transpose: got ", bytes.concat(str(len(axes)),
      bytes.concat(" axes for a rank-", bytes.concat(str(rank_in), " tensor")))))
  }
  let seen: Arr[Bool] = arr_new()
  let i: I64 = 0
  while i < rank_in {
    push(seen, false)
    i = i + 1
  }
  i = 0
  while i < rank_in {
    let ax: I64 = axes[i]
    # Not normalized against negatives: the bootstrap does not accept a negative
    # transpose axis either, and src/check.tw's transpose_result agrees. See
    # NEEDS-50 for the mismatch in how an out-of-range one is reported.
    if ax < 0 or ax >= rank_in or seen[ax] {
      return Err(bytes.concat("transpose: invalid axis permutation ", shape_string(axes)))
    }
    seen[ax] = true
    push(perm, ax)
    i = i + 1
  }
  Ok(perm)
}

# transpose_origin[o] is the input offset supplying output offset o. Computed by
# division here rather than by an odometer, because the odometer walks the
# *output* while the mapping needed is from output coordinates to a permuted set
# of input strides, and spelling that as an odometer means building the permuted
# stride vector anyway. The division form is the one in the bootstrap.
fn transpose_origins(in_shape: Arr[I64], perm: Arr[I64], out_shape: Arr[I64]) -> Arr[I64] {
  let r: I64 = len(perm)
  let in_str: Arr[I64] = strides_of(in_shape)
  let out_str: Arr[I64] = strides_of(out_shape)
  let n: I64 = element_count(out_shape)
  let origin: Arr[I64] = arr_new()
  let o: I64 = 0
  while o < n {
    let rem: I64 = o
    let src: I64 = 0
    let i: I64 = 0
    while i < r {
      let coord: I64 = rem / out_str[i]
      rem = rem % out_str[i]
      src = src + coord * in_str[perm[i]]
      i = i + 1
    }
    push(origin, src)
    o = o + 1
  }
  origin
}

# Permute axes.
#
# Gradient: a permutation of the buffer, so the inverse permutation of the
# cotangent. Expressed as a scatter through the same origin table the forward
# pass used, which is the same thing and cannot get the inverse backwards.
fn transpose(t: Tensor, axes: Arr[I64]) -> Res[Tensor, Str] {
  let perm: Arr[I64] = resolve_perm(len(t.shape), axes)?
  let out_shape: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(perm) {
    push(out_shape, t.shape[perm[i]])
    i = i + 1
  }
  let origin: Arr[I64] = transpose_origins(t.shape, perm, out_shape)
  let out: Arr[F64] = alloc(len(origin))
  let o: I64 = 0
  while o < len(origin) {
    out[o] = buf.get(t.data, t.dtype, origin[o])
    o = o + 1
  }
  Ok(mk_raw(out_shape, out, t.dtype))
}

# Expand a tensor to `shape` under the usual right-aligned rules: every axis of
# the input must already match the target or be 1, and the input may have fewer
# axes, which are prepended.
#
# Broadcasting normally happens implicitly inside a binary op, and that is enough
# right up until the shape to broadcast against is not one of the operands. The
# case that forces it is a reduction result, which is why this and keep_axis are
# two spellings of the same need.
#
# Gradient: the exact reverse of the expansion. Every output that read a given
# input element sends its cotangent back to it, so a broadcast axis *sums*. This
# is the summing-back that is the classic autodiff bug, and it is worth being
# precise about why it is a sum rather than a copy: the input element appears in
# the output many times, the output is a function of that one element in each of
# those places, and the chain rule over a variable used n times adds the n
# contributions. Copying instead of adding gives a gradient that is too small by
# a factor of the broadcast width and is not obviously wrong at a glance.
fn broadcast_to(t: Tensor, shape: Arr[I64]) -> Res[Tensor, Str] {
  if len(shape) < len(t.shape) {
    return Err(bytes.concat("cannot broadcast ", bytes.concat(shape_string(t.shape),
      bytes.concat(" to ", bytes.concat(shape_string(shape), ": fewer axes in target")))))
  }
  # Checked against broadcast_shape rather than reimplementing the rule, so
  # there is one definition of what is compatible. The result must equal the
  # target exactly: a shape that broadcasts *with* the target but is not equal
  # to it (a 5 against a 1) would expand the target too, which is not what was
  # asked for.
  let got: Arr[I64] = match broadcast_shape(t.shape, shape) {
    Ok(s) => s,
    Err(_) => arr_new(),
  }
  if not shape_equal(got, shape) {
    return Err(bytes.concat("cannot broadcast ", bytes.concat(shape_string(t.shape),
      bytes.concat(" to ", shape_string(shape)))))
  }

  let n: I64 = element_count(shape)
  let out: Arr[F64] = alloc(n)
  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(t.shape, shape))
  let odo: Odometer = odo_new(shape, contrib)
  let o: I64 = 0
  while o < n {
    out[o] = buf.get(t.data, t.dtype, odo.offs[0])
    odo_step(odo)
    o = o + 1
  }
  Ok(mk_raw(copy_shape(shape), out, t.dtype))
}

# sum_to_shape reduces `g` down to `target` by summing every axis that `target`
# broadcast along. It is the gradient of broadcast_to expressed as a reduction
# rather than as a scatter.
#
# Nothing in this file calls it: every backward pass below scatters through the
# same effective strides its forward pass read through, which is equivalent and
# has one fewer place to be wrong. It is here because it is the shape of the
# rule people expect to see, and because a future fused kernel that cannot
# afford the scatter needs it. Equivalence: scattering `g[o]` to input offset
# `src(o)` for every o accumulates, at each input element, the sum of the g at
# every output that read it, which is what summing the broadcast axes computes.
fn sum_to_shape(g: Tensor, target: Arr[I64]) -> Res[Tensor, Str] {
  if shape_equal(g.shape, target) { return Ok(clone(g)) }
  let acc: I64 = acc_dtype(g.dtype)
  let out: Arr[F64] = alloc(element_count(target))
  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(target, g.shape))
  let odo: Odometer = odo_new(g.shape, contrib)
  let o: I64 = 0
  while o < element_count(g.shape) {
    # A reduction, so the running total is held at the accumulation dtype and
    # rounded once by `mk`, exactly as `reduce_axis` does it.
    out[odo.offs[0]] = acc_add(acc, out[odo.offs[0]], buf.get(g.data, g.dtype, o))
    odo_step(odo)
    o = o + 1
  }
  Ok(mk(copy_shape(target), out, g.dtype))
}

# Join tensors along an axis. Shapes must match on every other axis.
#
# Gradient: concat is a copy into disjoint regions, so each input takes back
# exactly the slab of the cotangent it filled. Disjoint is why nothing sums here
# and why concat is the easy one; split is the same op read the other way and
# has the same gradient with the roles swapped.
fn concat(ts: Arr[Tensor], axis_in: I64) -> Res[Tensor, Str] {
  if len(ts) == 0 { return Err("concat: need at least one tensor") }
  let rank_in: I64 = len(ts[0].shape)
  let axis: I64 = normalize_axis(axis_in, rank_in)?
  let total: I64 = 0
  let p: I64 = 0
  while p < len(ts) {
    if len(ts[p].shape) != rank_in { return Err("concat: mismatched ranks") }
    let d: I64 = 0
    while d < rank_in {
      if d != axis and ts[p].shape[d] != ts[0].shape[d] {
        return Err(bytes.concat("concat: shapes differ on axis ", str(d)))
      }
      d = d + 1
    }
    total = total + ts[p].shape[axis]
    p = p + 1
  }
  # The promotion of every piece. Promotion never narrows, so each piece's
  # elements are already representable in it and the copy below stays a copy.
  let dt: I64 = ts[0].dtype
  p = 1
  while p < len(ts) {
    dt = promote(dt, ts[p].dtype)
    p = p + 1
  }
  let out_shape: Arr[I64] = copy_shape(ts[0].shape)
  out_shape[axis] = total
  let sp: Spans = axis_spans(out_shape, axis)
  let out: Arr[F64] = alloc(element_count(out_shape))

  let offset: I64 = 0
  p = 0
  while p < len(ts) {
    let l: I64 = ts[p].shape[axis]
    let i: I64 = 0
    while i < sp.before {
      let k: I64 = 0
      while k < l {
        let j: I64 = 0
        while j < sp.after {
          out[i * total * sp.after + (offset + k) * sp.after + j] =
            buf.get(ts[p].data, ts[p].dtype, i * l * sp.after + k * sp.after + j)
          j = j + 1
        }
        k = k + 1
      }
      i = i + 1
    }
    offset = offset + l
    p = p + 1
  }
  Ok(mk_raw(out_shape, out, dt))
}

# The offset along `axis` at which piece `p` of a concat starts. The backward
# pass needs it and recomputing it there from the input shapes is cheaper than
# carrying it on the tape.
fn concat_offset(ts: Arr[Tensor], axis: I64, p: I64) -> I64 {
  let off: I64 = 0
  let i: I64 = 0
  while i < p {
    off = off + ts[i].shape[axis]
    i = i + 1
  }
  off
}

# Cut a tensor into consecutive pieces along one axis. The inverse of concat.
#
# `sizes` must add up to the axis exactly. A short or long list is an error
# rather than a silent drop, because a split that quietly loses a row shows up
# later as a wrong loss rather than as a crash.
#
# Gradient: each piece's cotangent lands in the slab of the parent it came from,
# and the pieces are disjoint, so the parent's gradient is assembled rather than
# summed. Where it *does* sum is when two pieces are used in the same expression
# and both send gradient back: those are two separate tape nodes with the same
# input, and the accumulate in the backward loop handles it.
fn split(t: Tensor, sizes: Arr[I64], axis_in: I64) -> Res[Arr[Tensor], Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  if len(sizes) == 0 { return Err("split: need at least one piece") }
  let total: I64 = 0
  let i: I64 = 0
  while i < len(sizes) {
    if sizes[i] < 0 {
      return Err(bytes.concat("split: negative size ", str(sizes[i])))
    }
    total = total + sizes[i]
    i = i + 1
  }
  if total != t.shape[axis] {
    return Err(bytes.concat("split: sizes sum to ", bytes.concat(str(total),
      bytes.concat(" but axis ", bytes.concat(str(axis),
      bytes.concat(" has length ", str(t.shape[axis])))))))
  }
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[Tensor] = arr_new()
  let offset: I64 = 0
  let p: I64 = 0
  while p < len(sizes) {
    push(out, split_piece(t, axis, offset, sizes[p])?)
    offset = offset + sizes[p]
    p = p + 1
  }
  Ok(out)
}

# One piece of a split. Copied rather than aliased: a view sharing the parent's
# buffer would let a later write to one piece silently change the others' idea
# of the parent, and nothing else in this file hands out an alias.
fn split_piece(t: Tensor, axis: I64, offset: I64, size: I64) -> Res[Tensor, Str] {
  let sp: Spans = axis_spans(t.shape, axis)
  let shape: Arr[I64] = copy_shape(t.shape)
  shape[axis] = size
  let data: Arr[F64] = alloc(sp.before * size * sp.after)
  let i: I64 = 0
  while i < sp.before {
    let k: I64 = 0
    while k < size {
      let j: I64 = 0
      while j < sp.after {
        data[i * size * sp.after + k * sp.after + j] =
          buf.get(t.data, t.dtype, i * sp.length * sp.after + (offset + k) * sp.after + j)
        j = j + 1
      }
      k = k + 1
    }
    i = i + 1
  }
  Ok(mk_raw(shape, data, t.dtype))
}

# Cut into `n` equal pieces. The axis must divide evenly; numpy's array_split
# tolerates a remainder, and that leniency turns a wrong `n` into ragged output
# rather than an error, so it is not copied.
fn split_equal(t: Tensor, n: I64, axis_in: I64) -> Res[Arr[Tensor], Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  if n <= 0 {
    return Err(bytes.concat("split: piece count must be positive, got ", str(n)))
  }
  let l: I64 = t.shape[axis]
  if l % n != 0 {
    return Err(bytes.concat("split: axis ", bytes.concat(str(axis),
      bytes.concat(" has length ", bytes.concat(str(l),
      bytes.concat(", which ", bytes.concat(str(n), " does not divide evenly")))))))
  }
  let sizes: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < n {
    push(sizes, l / n)
    i = i + 1
  }
  split(t, sizes, axis)
}

# The size of one row along axis 0, which is what index and slice move in.
fn row_size(shape: Arr[I64]) -> I64 {
  let n: I64 = 1
  let i: I64 = 1
  while i < len(shape) {
    n = n * shape[i]
    i = i + 1
  }
  n
}

# Select one element or row along the first axis, dropping that axis: a rank-1
# tensor yields a scalar and a rank-n tensor yields a row of shape shape[1:].
#
# Gradient: the cotangent lands in the selected row and every other row gets
# nothing. Indexing is a linear map with a 0/1 matrix, and its transpose is the
# scatter this describes.
fn index_axis0(t: Tensor, idx: I64) -> Res[Tensor, Str] {
  if len(t.shape) == 0 { return Err("cannot index a scalar") }
  let dim0: I64 = t.shape[0]
  if idx < 0 or idx >= dim0 {
    return Err(bytes.concat("index ", bytes.concat(str(idx),
      bytes.concat(" out of range [0, ", bytes.concat(str(dim0), ")")))))
  }
  let rs: I64 = row_size(t.shape)
  let off: I64 = idx * rs
  let data: Arr[F64] = alloc(rs)
  let i: I64 = 0
  while i < rs {
    data[i] = buf.get(t.data, t.dtype, off + i)
    i = i + 1
  }
  Ok(mk_raw(remove_axis(t.shape, 0), data, t.dtype))
}

# Rows [start, end) along the first axis, keeping the trailing dimensions. A
# negative bound counts from the end, matching the slice syntax in the language.
#
# Gradient: as for index_axis0, over a contiguous run of rows.
fn slice_axis0(t: Tensor, start_in: I64, end_in: I64) -> Res[Tensor, Str] {
  if len(t.shape) == 0 { return Err("cannot slice a scalar") }
  let dim0: I64 = t.shape[0]
  let start: I64 = start_in
  let end: I64 = end_in
  if start < 0 { start = start + dim0 }
  if end < 0 { end = end + dim0 }
  if start < 0 or end > dim0 or start > end {
    return Err(bytes.concat("slice [", bytes.concat(str(start_in),
      bytes.concat(":", bytes.concat(str(end_in),
      bytes.concat("] out of range for first dim ", str(dim0)))))))
  }
  let rs: I64 = row_size(t.shape)
  let n: I64 = (end - start) * rs
  let data: Arr[F64] = alloc(n)
  let i: I64 = 0
  while i < n {
    data[i] = buf.get(t.data, t.dtype, start * rs + i)
    i = i + 1
  }
  let shape: Arr[I64] = copy_shape(t.shape)
  shape[0] = end - start
  Ok(mk_raw(shape, data, t.dtype))
}

# Select rows from x along its first axis by a list of indices. The primitive
# behind embedding lookups and index-based minibatching.
#
# Gradient: scatter-add each output row's cotangent back to its source row. The
# *add* is what makes a repeated index correct: an embedding row used by three
# tokens in a batch receives all three contributions, and an assignment would
# keep only the last one. This is the same accumulate-not-assign rule as the
# tape's, in the one place where a single op can hit it on its own.
fn gather(x: Tensor, idx: Arr[I64]) -> Res[Tensor, Str] {
  if len(x.shape) == 0 { return Err("gather: cannot gather from a scalar") }
  let n: I64 = x.shape[0]
  let rs: I64 = row_size(x.shape)
  let out: Arr[F64] = alloc(len(idx) * rs)
  let i: I64 = 0
  while i < len(idx) {
    let ix: I64 = idx[i]
    if ix < 0 or ix >= n {
      return Err(bytes.concat("gather: index ", bytes.concat(str(ix),
        bytes.concat(" out of range [0, ", bytes.concat(str(n), ")")))))
    }
    let j: I64 = 0
    while j < rs {
      out[i * rs + j] = buf.get(x.data, x.dtype, ix * rs + j)
      j = j + 1
    }
    i = i + 1
  }
  let shape: Arr[I64] = copy_shape(x.shape)
  shape[0] = len(idx)
  Ok(mk_raw(shape, out, x.dtype))
}
# ---- einsum ----------------------------------------------------------------
#
# Complete, and complete on purpose: src/check.tw calls parse_einsum to validate
# a literal spec, and a second implementation of the parser would mean a second
# set of error messages for the same mistake. Sharing it is the reason the
# checker's einsum diagnostics read the same as the runtime's.

struct EinsumSpec {
  inputs: Arr[Str],
  output: Str,
}

# parse_einsum parses a spec like "ij,jk->ik" for n inputs. Without an explicit
# "->", the output is the labels that appear exactly once, in sorted order,
# which is the NumPy implicit convention. Repeated labels within a single input
# subscript, which would mean a trace or a diagonal, are not supported.
fn parse_einsum(spec_in: Str, n: I64) -> Res[EinsumSpec, Str] {
  let spec: Str = remove_spaces(spec_in)
  let in_part: Str = spec
  let out_sub: Str = ""
  let explicit: Bool = false
  let arrow: I64 = bytes.index_of(spec, "->")
  if arrow >= 0 {
    in_part = spec[0:arrow]
    out_sub = spec[arrow + 2:len(spec)]
    explicit = true
  }
  let in_subs: Arr[Str] = split_on(in_part, 44)
  if len(in_subs) != n {
    return Err(bytes.concat("einsum: spec has ", bytes.concat(str(len(in_subs)),
      bytes.concat(" operands but got ", str(n)))))
  }

  # counts is label to occurrence count across all operands. It decides the
  # implicit output and validates an explicit one, so it is built first.
  let counts: Dict[Str, I64] = dict_new()
  let k: I64 = 0
  while k < len(in_subs) {
    let sub: Str = in_subs[k]
    let seen: Dict[Str, Bool] = dict_new()
    let i: I64 = 0
    while i < len(sub) {
      let ch: Str = sub[i:i + 1]
      if sub[i] < 97 or sub[i] > 122 {
        return Err(bytes.concat("einsum: labels must be lowercase letters, found ", quoted(ch)))
      }
      if dict_has(seen, ch) {
        return Err(bytes.concat("einsum: repeated label ", bytes.concat(quoted(ch),
          " within one operand is not supported")))
      }
      dict_set(seen, ch, true)
      dict_set(counts, ch, dict_or(counts, ch, 0) + 1)
      i = i + 1
    }
    k = k + 1
  }

  if not explicit {
    # A label that appears once is a free index and survives; one that appears
    # twice or more is summed over. Sorted so the result does not depend on the
    # order the labels happened to be written in, which is the property that
    # makes the implicit form usable at all.
    let once: Arr[Str] = arr_new()
    for ch in dict_keys(counts) {
      if dict_must(counts, ch) == 1 {
        push(once, ch)
      }
    }
    sort_labels(once)
    out_sub = bytes.join(once, "")
  }

  let oseen: Dict[Str, Bool] = dict_new()
  let i: I64 = 0
  while i < len(out_sub) {
    let ch: Str = out_sub[i:i + 1]
    if dict_or(counts, ch, 0) == 0 {
      return Err(bytes.concat("einsum: output label ", bytes.concat(quoted(ch),
        " does not appear in the inputs")))
    }
    if dict_has(oseen, ch) {
      return Err(bytes.concat("einsum: repeated output label ", quoted(ch)))
    }
    dict_set(oseen, ch, true)
    i = i + 1
  }
  Ok(EinsumSpec { inputs: in_subs, output: out_sub })
}

# einsum_output_dims resolves the output shape from the input shapes. A
# dimension may be -1 for unknown, which is how the checker calls it; at run
# time every dimension is known and the inconsistency check below is exact.
fn einsum_output_dims(in_subs: Arr[Str], out_sub: Str, input_dims: Arr[Arr[I64]]) -> Res[Arr[I64], Str] {
  let label_dim: Dict[Str, I64] = dict_new()
  let k: I64 = 0
  while k < len(in_subs) {
    let sub: Str = in_subs[k]
    if len(sub) != len(input_dims[k]) {
      return Err(bytes.concat("einsum: operand ", bytes.concat(str(k),
        bytes.concat(" has rank ", bytes.concat(str(len(input_dims[k])),
        bytes.concat(" but subscript ", bytes.concat(quoted(sub),
        bytes.concat(" has ", bytes.concat(str(len(sub)), " labels")))))))))
    }
    let a: I64 = 0
    while a < len(sub) {
      let ch: Str = sub[a:a + 1]
      let d: I64 = input_dims[k][a]
      match dict_get(label_dim, ch) {
        Some(prev) => {
          if prev >= 0 and d >= 0 and prev != d {
            return Err(bytes.concat("einsum: label ", bytes.concat(quoted(ch),
              bytes.concat(" has inconsistent sizes ", bytes.concat(str(prev),
              bytes.concat(" and ", str(d)))))))
          }
          # An unknown recorded earlier is replaced by a known size found later,
          # so the order the operands are written in does not change the answer.
          if prev < 0 {
            dict_set(label_dim, ch, d)
          }
        },
        None => dict_set(label_dim, ch, d),
      }
      a = a + 1
    }
    k = k + 1
  }
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(out_sub) {
    push(out, dict_or(label_dim, out_sub[i:i + 1], -1))
    i = i + 1
  }
  Ok(out)
}

fn remove_spaces(s: Str) -> Str {
  let b: Bytes = bytes.new()
  let i: I64 = 0
  while i < len(s) {
    if s[i] != 32 {
      bytes.push(b, s[i])
    }
    i = i + 1
  }
  bytes.to_str(b)
}

# Split on a single byte, keeping empty fields. Empty fields matter: "ij,,k" has
# three operands and the count check has to see all three, or the error names
# the wrong number.
fn split_on(s: Str, sep: I64) -> Arr[Str] {
  let out: Arr[Str] = arr_new()
  let start: I64 = 0
  let i: I64 = 0
  while i <= len(s) {
    if i == len(s) or s[i] == sep {
      push(out, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  out
}

# Single-byte labels, so a bytewise insertion sort is a full sort. Same shape as
# the one in check.tw and kept separate rather than shared, because a module
# that both the checker and the runtime depend on for a two-line sort is a
# dependency edge that buys nothing.
fn sort_labels(xs: Arr[Str]) {
  let i: I64 = 1
  while i < len(xs) {
    let v: Str = xs[i]
    let j: I64 = i - 1
    while j >= 0 and xs[j][0] > v[0] {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = v
    i = i + 1
  }
}

fn quoted(s: Str) -> Str = str_quote(s)

# ---- the einsum contraction ------------------------------------------------
#
# The parser above says which labels each operand carries and which survive into
# the output. The contraction is what is left: walk the product space of every
# distinct label once, multiply one element from each operand, and accumulate
# into the output slot the free labels select.
#
# Summation falls out of that rather than being coded: a label that is not in
# the output subscript has an output stride of zero, so every position along it
# accumulates into the same output element. That is the whole trick, and it is
# why this handles a trace-free einsum of any arity with one loop.

# The distinct labels across all operands, in first-appearance order, with their
# sizes. Order does not affect the result, only the traversal, but a fixed order
# makes a dumped tape reproducible.
struct EinsumPlan {
  labels: Arr[Str],
  dims: Arr[I64],
  # contrib[k][li] is the stride into operand k when label li advances; the last
  # entry is the output.
  contrib: Arr[Arr[I64]],
  out_shape: Arr[I64],
}

fn einsum_plan(in_subs: Arr[Str], out_sub: Str, inputs: Arr[Tensor]) -> Res[EinsumPlan, Str] {
  let k: I64 = 0
  while k < len(in_subs) {
    if len(in_subs[k]) != len(inputs[k].shape) {
      return Err(bytes.concat("einsum: operand ", bytes.concat(str(k),
        bytes.concat(" has rank ", bytes.concat(str(len(inputs[k].shape)),
        bytes.concat(" but subscript ", bytes.concat(quoted(in_subs[k]),
        bytes.concat(" has ", bytes.concat(str(len(in_subs[k])), " labels")))))))))
    }
    k = k + 1
  }
  let input_dims: Arr[Arr[I64]] = arr_new()
  k = 0
  while k < len(inputs) {
    push(input_dims, inputs[k].shape)
    k = k + 1
  }
  let out_shape: Arr[I64] = einsum_output_dims(in_subs, out_sub, input_dims)?

  let label_dim: Dict[Str, I64] = dict_new()
  let labels: Arr[Str] = arr_new()
  k = 0
  while k < len(in_subs) {
    let a: I64 = 0
    while a < len(in_subs[k]) {
      let ch: Str = in_subs[k][a:a + 1]
      if not dict_has(label_dim, ch) {
        dict_set(label_dim, ch, inputs[k].shape[a])
        push(labels, ch)
      }
      a = a + 1
    }
    k = k + 1
  }
  let l: I64 = len(labels)
  let dims: Arr[I64] = arr_new()
  let label_index: Dict[Str, I64] = dict_new()
  let i: I64 = 0
  while i < l {
    push(dims, dict_must(label_dim, labels[i]))
    dict_set(label_index, labels[i], i)
    i = i + 1
  }

  # One contribution row per operand, plus one for the output. Strides are
  # added into the row rather than assigned. The parser rejects a repeated label
  # within one operand today, so the add never fires twice; it is written as an
  # add so that allowing a trace later ("ii->i") is a parser change and not a
  # contraction change, because summing the two strides is exactly what walking
  # a diagonal means.
  let contrib: Arr[Arr[I64]] = arr_new()
  k = 0
  while k < len(inputs) + 1 {
    let row: Arr[I64] = arr_new()
    i = 0
    while i < l {
      push(row, 0)
      i = i + 1
    }
    push(contrib, row)
    k = k + 1
  }
  k = 0
  while k < len(inputs) {
    let st: Arr[I64] = strides_of(inputs[k].shape)
    let a: I64 = 0
    while a < len(in_subs[k]) {
      let li: I64 = dict_must(label_index, in_subs[k][a:a + 1])
      contrib[k][li] = contrib[k][li] + st[a]
      a = a + 1
    }
    k = k + 1
  }
  let out_str: Arr[I64] = strides_of(out_shape)
  let a: I64 = 0
  while a < len(out_sub) {
    let li: I64 = dict_must(label_index, out_sub[a:a + 1])
    contrib[len(inputs)][li] = out_str[a]
    a = a + 1
  }
  Ok(EinsumPlan { labels: labels, dims: dims, contrib: contrib, out_shape: out_shape })
}

fn einsum_raw(in_subs: Arr[Str], out_sub: Str, inputs: Arr[Tensor]) -> Res[Tensor, Str] {
  let plan: EinsumPlan = einsum_plan(in_subs, out_sub, inputs)?
  # An einsum is a contraction, so it is in the same operation class as matmul
  # and takes the same accumulation rule: the summed axes run at the
  # accumulation dtype and the store rounds once. The product of the operands is
  # formed in F64 and is exact for every dtype at most as wide as f32.
  let dt: I64 = inputs[0].dtype
  let d: I64 = 1
  while d < len(inputs) {
    dt = promote(dt, inputs[d].dtype)
    d = d + 1
  }
  let acc: I64 = acc_dtype(dt)
  let out: Arr[F64] = alloc(element_count(plan.out_shape))
  let total: I64 = element_count(plan.dims)
  let odo: Odometer = odo_new(plan.dims, plan.contrib)
  let out_slot: I64 = len(inputs)
  let step: I64 = 0
  while step < total {
    let prod: F64 = 1.0
    let k: I64 = 0
    while k < len(inputs) {
      prod = prod * buf.get(inputs[k].data, inputs[k].dtype, odo.offs[k])
      k = k + 1
    }
    out[odo.offs[out_slot]] = acc_add(acc, out[odo.offs[out_slot]], prod)
    odo_step(odo)
    step = step + 1
  }
  Ok(mk(plan.out_shape, out, dt))
}

# einsum parses the spec and contracts.
#
# Gradient: an einsum is multilinear in its operands, so the derivative with
# respect to operand p is another einsum. Take the original, replace operand p
# by the upstream cotangent, swap operand p's subscript into the output position
# and the old output subscript into the input position, and contract. In symbols,
# for "ij,jk->ik", the gradient of the first operand is "ik,jk->ij" over
# (g, b), which is the g @ b^T everyone writes by hand for a matmul.
#
# The reason this is exactly right and not an analogy: einsum computes a sum of
# products over an index space, each output element is a sum of terms each
# linear in one element of operand p, and the coefficient of that element is the
# product of the other operands' entries at the same point in the index space.
# Summing coefficient times upstream over the contracted labels is precisely the
# swapped einsum.
#
# The one thing it does not handle is a label that appears in an operand and not
# in the output *and* not in any other operand, which sums an axis away with no
# partner. The swapped einsum then has a label in its output that is in none of
# its inputs, and the parser rejects it. That case is a plain sum and could be
# special-cased; it is left as an error rather than guessed at, and it is the
# one place below where the gradient is knowingly incomplete.
fn einsum(spec: Str, inputs: Arr[Tensor]) -> Res[Tensor, Str] {
  let parsed: EinsumSpec = parse_einsum(spec, len(inputs))?
  einsum_raw(parsed.inputs, parsed.output, inputs)
}

# The gradient of operand p of an einsum, given the upstream cotangent.
fn einsum_grad(parsed: EinsumSpec, inputs: Arr[Tensor], p: I64, g: Tensor) -> Res[Tensor, Str] {
  let g_inputs: Arr[Tensor] = arr_new()
  let g_subs: Arr[Str] = arr_new()
  push(g_inputs, g)
  push(g_subs, parsed.output)
  let j: I64 = 0
  while j < len(inputs) {
    if j != p {
      push(g_inputs, inputs[j])
      push(g_subs, parsed.inputs[j])
    }
    j = j + 1
  }
  einsum_raw(g_subs, parsed.inputs[p], g_inputs)
}

# ---- the tape --------------------------------------------------------------
#
# Reverse-mode autodiff over a taped graph: the forward pass records each op
# with its inputs and its output, and the backward pass walks the tape in
# reverse accumulating cotangents.
#
# The bootstrap instead hangs parent pointers and a closure off each tensor and
# topologically sorts them at Backward time. A tape is the same graph with the
# sort already done, because an entry can only name entries recorded before it,
# so index order is a topological order and walking it backwards is a valid
# reverse pass with no visit and no seen set. That is the one structural
# difference from internal/tensor and it is a simplification, not a compromise.
#
# It also keeps the tape a flat Arr, which is the only shape a bytecode emitter
# can serialise without inventing a graph format.

struct TapeEntry {
  op: Op,
  # Indices of earlier entries. A leaf has none.
  inputs: Arr[I64],
  out: Tensor,
  # Integer parameters of the op: an axis, an index, a permutation, a gather
  # list. By convention iattr[0] is a normalized axis where the op has one, and
  # -1 there means "over every element".
  iattr: Arr[I64],
  # Float parameters: the exponent of a pow, the bounds of a clip.
  fattr: Arr[F64],
  # The einsum spec. The only op whose parameter is text.
  sattr: Str,
}

struct Tape {
  entries: Arr[TapeEntry],
  # The nodes gradients are taken with respect to, in the order the caller named
  # them, because `grads(loss)(W, b)` returns a list in that order and the order
  # is part of the contract.
  leaves: Arr[I64],
}

fn new_tape() -> Tape = Tape { entries: arr_new(), leaves: arr_new() }

fn no_ints() -> Arr[I64] = arr_new()
fn no_floats() -> Arr[F64] = arr_new()

fn record(tp: Tape, op: Op, inputs: Arr[I64], out: Tensor,
          iattr: Arr[I64], fattr: Arr[F64], sattr: Str) -> I64 {
  push(tp.entries, TapeEntry { op: op, inputs: inputs, out: out,
    iattr: iattr, fattr: fattr, sattr: sattr })
  len(tp.entries) - 1
}

fn value_of(tp: Tape, node: I64) -> Tensor = tp.entries[node].out

# A leaf is a value a gradient is wanted for. A const is a value that is on the
# tape only so that a later entry can name it; it gets a cotangent slot like
# everything else and nobody reads it.
# A differentiated input, registered as its own node.
#
# The tensor is cloned, and that is load-bearing rather than tidy. A node is
# found again by tensor identity (tape_node_of_tensor scans for the object), so
# two leaves holding the same object are indistinguishable -- and
# `grads(f)(c, c)`, one tensor passed as two arguments, is exactly that. Every
# operand inside f resolved to whichever leaf was registered last, so the whole
# gradient landed on the second parameter and the first came back zeros.
#
# The copy costs one buffer per differentiated argument per call. The reference
# implementation is the one that has to be right; the bootstrap is the one that
# has to be quick.
fn leaf(tp: Tape, t: Tensor) -> I64 {
  let n: I64 = record(tp, OpLeaf, arr_new(), clone(t), no_ints(), no_floats(), "")
  push(tp.leaves, n)
  n
}

fn konst(tp: Tape, t: Tensor) -> I64 =
  record(tp, OpConst, arr_new(), t, no_ints(), no_floats(), "")

fn one_input(a: I64) -> Arr[I64] {
  let v: Arr[I64] = arr_new()
  push(v, a)
  v
}

fn two_inputs(a: I64, b: I64) -> Arr[I64] {
  let v: Arr[I64] = arr_new()
  push(v, a)
  push(v, b)
  v
}

fn one_int(a: I64) -> Arr[I64] = one_input(a)

fn two_ints(a: I64, b: I64) -> Arr[I64] = two_inputs(a, b)

fn three_ints(a: I64, b: I64, c: I64) -> Arr[I64] {
  let v: Arr[I64] = arr_new()
  push(v, a)
  push(v, b)
  push(v, c)
  v
}

fn one_float(x: F64) -> Arr[F64] {
  let v: Arr[F64] = arr_new()
  push(v, x)
  v
}

fn two_floats(x: F64, y: F64) -> Arr[F64] {
  let v: Arr[F64] = arr_new()
  push(v, x)
  push(v, y)
  v
}

# ---- the taped ops ---------------------------------------------------------
#
# Each of these is the forward kernel plus one record. They are mechanical on
# purpose: nothing here decides anything, so a wrong gradient is always in the
# vjp below and never in this section.

fn t_binary(tp: Tape, op: Op, a: I64, b: I64) -> Res[I64, Str] {
  let out: Tensor = binary(op, value_of(tp, a), value_of(tp, b))?
  Ok(record(tp, op, two_inputs(a, b), out, no_ints(), no_floats(), ""))
}

fn t_unary(tp: Tape, op: Op, a: I64) -> I64 {
  let out: Tensor = unary(op, value_of(tp, a))
  record(tp, op, one_input(a), out, no_ints(), no_floats(), "")
}

fn t_pow_scalar(tp: Tape, a: I64, p: F64) -> I64 {
  let out: Tensor = pow_scalar(value_of(tp, a), p)
  record(tp, OpPow, one_input(a), out, no_ints(), one_float(p), "")
}

fn t_clip(tp: Tape, a: I64, lo: F64, hi: F64) -> I64 {
  let out: Tensor = clip(value_of(tp, a), lo, hi)
  record(tp, OpClip, one_input(a), out, no_ints(), two_floats(lo, hi), "")
}

# The taped cast. The target dtype rides in iattr[0], and the forward is `cast`,
# so the recorded value is already rounded to dt and carries it. The gradient is
# the straight-through estimator (see the vjp), so a cast inside a differentiated
# function no longer detaches its input, which is what makes bf16 weights with an
# f32 master trainable rather than merely storable.
fn t_cast(tp: Tape, a: I64, dt: I64) -> I64 {
  let out: Tensor = cast(value_of(tp, a), dt)
  record(tp, OpCast, one_input(a), out, one_int(dt), no_floats(), "")
}

fn t_where(tp: Tape, cond: I64, a: I64, b: I64) -> Res[I64, Str] {
  let out: Tensor = where3(value_of(tp, cond), value_of(tp, a), value_of(tp, b))?
  Ok(record(tp, OpWhere, three_ints(cond, a, b), out, no_ints(), no_floats(), ""))
}

fn t_matmul(tp: Tape, a: I64, b: I64) -> Res[I64, Str] {
  let out: Tensor = matmul(value_of(tp, a), value_of(tp, b))?
  Ok(record(tp, OpMatMul, two_inputs(a, b), out, no_ints(), no_floats(), ""))
}

fn t_einsum(tp: Tape, spec: Str, inputs: Arr[I64]) -> Res[I64, Str] {
  let vals: Arr[Tensor] = arr_new()
  let i: I64 = 0
  while i < len(inputs) {
    push(vals, value_of(tp, inputs[i]))
    i = i + 1
  }
  let out: Tensor = einsum(spec, vals)?
  Ok(record(tp, OpEinsum, inputs, out, no_ints(), no_floats(), spec))
}

# Reductions. An axis of -1 on the tape means the whole tensor, which is why the
# axis is normalized before it is recorded and never after.
fn t_reduce_all(tp: Tape, op: Op, a: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let out: Tensor = reduce_all_by(v, op)?
  Ok(record(tp, op, one_input(a), out, one_int(0 - 1), no_floats(), ""))
}

fn reduce_all_by(v: Tensor, op: Op) -> Res[Tensor, Str] {
  if op == OpSum { return Ok(sum_all(v)) }
  if op == OpMean { return Ok(mean_all(v)) }
  if op == OpMax { return Ok(max_all(v)) }
  if op == OpMin { return Ok(min_all(v)) }
  if op == OpProd { return Ok(prod_all(v)) }
  if op == OpMedian { return Ok(median_all(v)) }
  Err(bytes.concat("reduce_all_by: not a reduction: ", op_name(op)))
}

fn t_reduce_axis(tp: Tape, op: Op, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = reduce_axis_by(v, axis, op)?
  Ok(record(tp, op, one_input(a), out, one_int(axis), no_floats(), ""))
}

# The keepdims form is the dropping form followed by a reshape, so it is two
# tape entries and needs no gradient rule of its own.
fn t_reduce_axis_keep(tp: Tape, op: Op, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let dropped: I64 = t_reduce_axis(tp, op, a, axis)?
  t_reshape(tp, dropped, keep_axis(v.shape, axis))
}

fn t_softmax(tp: Tape, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = softmax(v, axis)?
  Ok(record(tp, OpSoftmax, one_input(a), out, one_int(axis), no_floats(), ""))
}

fn t_reshape(tp: Tape, a: I64, shape: Arr[I64]) -> Res[I64, Str] {
  let out: Tensor = reshape(value_of(tp, a), shape)?
  Ok(record(tp, OpReshape, one_input(a), out, no_ints(), no_floats(), ""))
}

fn t_transpose(tp: Tape, a: I64, axes: Arr[I64]) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let perm: Arr[I64] = resolve_perm(len(v.shape), axes)?
  let out: Tensor = transpose(v, perm)?
  # The resolved permutation is recorded, not the argument: an empty argument
  # means "reverse", and the backward pass would otherwise have to re-derive
  # that from a rank it no longer trivially has.
  Ok(record(tp, OpTranspose, one_input(a), out, perm, no_floats(), ""))
}

fn t_broadcast_to(tp: Tape, a: I64, shape: Arr[I64]) -> Res[I64, Str] {
  let out: Tensor = broadcast_to(value_of(tp, a), shape)?
  Ok(record(tp, OpBroadcastTo, one_input(a), out, no_ints(), no_floats(), ""))
}

fn t_concat(tp: Tape, inputs: Arr[I64], axis_in: I64) -> Res[I64, Str] {
  let vals: Arr[Tensor] = arr_new()
  let i: I64 = 0
  while i < len(inputs) {
    push(vals, value_of(tp, inputs[i]))
    i = i + 1
  }
  if len(vals) == 0 { return Err("concat: need at least one tensor") }
  let axis: I64 = normalize_axis(axis_in, len(vals[0].shape))?
  let out: Tensor = concat(vals, axis)?
  Ok(record(tp, OpConcat, inputs, out, one_int(axis), no_floats(), ""))
}

# Each piece of a split is its own node, so a program that uses two pieces
# differently gets one accumulated gradient in the parent without split needing
# to know that happened.
fn t_split(tp: Tape, a: I64, sizes: Arr[I64], axis_in: I64) -> Res[Arr[I64], Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let pieces: Arr[Tensor] = split(v, sizes, axis)?
  let out: Arr[I64] = arr_new()
  let offset: I64 = 0
  let p: I64 = 0
  while p < len(pieces) {
    push(out, record(tp, OpSplit, one_input(a), pieces[p],
      three_ints(axis, offset, sizes[p]), no_floats(), ""))
    offset = offset + sizes[p]
    p = p + 1
  }
  Ok(out)
}

fn t_index_axis0(tp: Tape, a: I64, idx: I64) -> Res[I64, Str] {
  let out: Tensor = index_axis0(value_of(tp, a), idx)?
  Ok(record(tp, OpIndex0, one_input(a), out, one_int(idx), no_floats(), ""))
}

fn t_slice_axis0(tp: Tape, a: I64, start: I64, end: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let out: Tensor = slice_axis0(v, start, end)?
  # The resolved bounds, so the backward pass never re-normalizes a negative
  # index against a shape it would have to look up again.
  let s: I64 = start
  let e: I64 = end
  if s < 0 { s = s + v.shape[0] }
  if e < 0 { e = e + v.shape[0] }
  Ok(record(tp, OpSlice0, one_input(a), out, two_ints(s, e), no_floats(), ""))
}

fn t_gather(tp: Tape, a: I64, idx: Arr[I64]) -> Res[I64, Str] {
  let out: Tensor = gather(value_of(tp, a), idx)?
  Ok(record(tp, OpGather, one_input(a), out, idx, no_floats(), ""))
}

fn t_flip_axis(tp: Tape, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = flip_axis(v, axis)?
  Ok(record(tp, OpFlip, one_input(a), out, one_int(axis), no_floats(), ""))
}

fn t_sort_axis(tp: Tape, a: I64, axis_in: I64, descending: Bool) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = sort_axis(v, axis, descending)?
  Ok(record(tp, OpSort, one_input(a), out,
    two_ints(axis, bool_to_int(descending)), no_floats(), ""))
}

fn t_topk_axis(tp: Tape, a: I64, k: I64, axis_in: I64, largest: Bool) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = topk_axis(v, k, axis, largest)?
  Ok(record(tp, OpTopK, one_input(a), out,
    three_ints(axis, k, bool_to_int(largest)), no_floats(), ""))
}

fn bool_to_int(b: Bool) -> I64 {
  if b { return 1 }
  0
}

fn int_to_bool(i: I64) -> Bool = i != 0

# ---- the backward pass -----------------------------------------------------

# Cotangent accumulation. Add, never assign: a value used twice receives a
# contribution from each use, and assigning would silently drop one of them.
# This is the single most important line in the file.
#
# It is also the only place a gradient is stored, which is what makes the
# gradient dtype rule enforceable in one function instead of in forty. Every
# vjp_ below hands this a plain F64 buffer it computed at full width; the
# rounding to the gradient's own dtype happens here, once per contribution, at
# the dtype `backward` chose. A rule that wanted to round earlier would be
# rounding an intermediate, which is the thing `acc_dtype` exists to forbid.
fn accumulate(cot: Arr[Tensor], touched: Arr[Bool], node: I64, part: Arr[F64]) {
  let dst: Buf = cot[node].data
  let dt: I64 = cot[node].dtype
  let i: I64 = 0
  while i < len(part) {
    buf.set(dst, dt, i, acc_add(dt, buf.get(dst, dt, i), part[i]))
    i = i + 1
  }
  touched[node] = true
}

# Spans for an op whose recorded axis may be -1, meaning "every element". The
# all-elements case is one run over the whole buffer, which makes every
# axis-wise gradient below serve both forms with no branch.
fn spans_for(t: Tensor, axis: I64) -> Spans {
  if axis < 0 {
    return Spans { before: 1, length: element_count(t.shape), after: 1 }
  }
  axis_spans(t.shape, axis)
}

# backward seeds `root` with `seed` and walks the tape in reverse, returning the
# cotangent of each leaf in the order the leaves were declared.
#
# Two details are the ones a reimplementation gets wrong. The skip on an
# untouched node is what keeps a dead branch of the graph from costing a full
# backward pass; it is a cost property only, since an untouched cotangent is
# zero and adding zero changes nothing. And accumulate adds rather than assigns,
# for the reason stated on it.
fn backward(tp: Tape, root: I64, seed: Tensor) -> Res[Arr[Tensor], Str] {
  let n: I64 = len(tp.entries)
  if root < 0 or root >= n {
    return Err(bytes.concat("backward: no such tape node ", str(root)))
  }
  if not shape_equal(seed.shape, tp.entries[root].out.shape) {
    return Err(bytes.concat("backward: seed has shape ",
      bytes.concat(shape_string(seed.shape),
      bytes.concat(" but the output has ", shape_string(tp.entries[root].out.shape)))))
  }
  let cot: Arr[Tensor] = arr_new()
  let touched: Arr[Bool] = arr_new()
  let i: I64 = 0
  while i < n {
    # A zero cotangent per node, allocated up front. The bootstrap allocates one
    # only when a node is first reached; doing that here needs an Opt per slot
    # and buys memory, not correctness, so it is the optimisation that goes here.
    #
    # `grad_dtype` and not `zeros_like`: the cotangent of a bf16 value is f32.
    # Deciding it here, once, is what keeps every rule below from having to
    # decide it and is why none of them mention a dtype at all.
    push(cot, zeros_dt(tp.entries[i].out.shape, grad_dtype(tp.entries[i].out.dtype)))
    push(touched, false)
    i = i + 1
  }
  accumulate(cot, touched, root, data_arr(seed))

  i = n - 1
  while i >= 0 {
    if touched[i] {
      vjp(tp, i, cot, touched)?
    }
    i = i - 1
  }

  let out: Arr[Tensor] = arr_new()
  i = 0
  while i < len(tp.leaves) {
    push(out, cot[tp.leaves[i]])
    i = i + 1
  }
  Ok(out)
}

# Loss scaling, for f16. docs/dtypes.md "Loss scaling, and the f16 story" is
# the design and NEEDS-112 is the entry; this is the surface, and it is two
# functions rather than a loop left to callers because a hand-written loop that
# forgets the skip below looks like it works.
#
# The seed is multiplied by `scale` before the walk, so by the chain rule every
# gradient comes back scaled by exactly that factor, and the caller divides it
# out after checking grads_finite. The multiply runs at f64, by `scalar` and
# promotion, not in the seed's own dtype: a scale of 65536 is representable in
# every float format except f16, and rounding it into an f16 seed would turn
# the scale itself into the infinity the scaling exists to avoid. The widened
# seed costs nothing downstream, because `backward` allocates every cotangent
# at `grad_dtype` of its own node and `accumulate` rounds on store.
fn backward_scaled(tp: Tape, root: I64, seed: Tensor, scale: F64) -> Res[Arr[Tensor], Str] {
  let scaled: Tensor = binary(OpMul, seed, scalar(scale))?
  backward(tp, root, scaled)
}

# True iff every element of every gradient is finite. This is the overflow
# check that decides whether a step happens at all, and the decision it feeds
# is skip-or-step, never clip: on false the caller skips the step entirely and
# shrinks the scale. Clipping an infinity to a large finite number instead is a
# plausible-looking update in an arbitrary direction, and a loop that does it
# trains to a worse model while reporting nothing, which is why the skip is the
# load-bearing half of the design and not an implementation detail.
fn grads_finite(gs: Arr[Tensor]) -> Bool {
  let i: I64 = 0
  while i < len(gs) {
    let g: Tensor = gs[i]
    let n: I64 = element_count(g.shape)
    let j: I64 = 0
    while j < n {
      if not f64_is_finite(buf.get(g.data, g.dtype, j)) { return false }
      j = j + 1
    }
    i = i + 1
  }
  true
}

# vjp adds node i's contribution to each of its inputs' cotangents.
#
# One function with a long branch rather than a closure recorded per entry. The
# closure form is what the bootstrap uses and it is better for a language with
# cheap closures; this form is better for reading, because every gradient rule
# in the system is on one screen's scroll and can be checked against its forward
# kernel without chasing a capture.
fn vjp(tp: Tape, i: I64, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let e: TapeEntry = tp.entries[i]
  let g: Tensor = cot[i]

  # Leaves and constants have no inputs, and a comparison or an argmax has a
  # zero derivative wherever it has one at all.
  if len(e.inputs) == 0 { return Ok(0) }
  if is_comparison(e.op) { return Ok(0) }
  if e.op == OpArgmax or e.op == OpArgmin { return Ok(0) }

  if is_binary_op(e.op) { return vjp_binary(tp, e, g, cot, touched) }
  if is_unary_op(e.op) { return vjp_unary(tp, e, g, cot, touched) }
  if e.op == OpWhere { return vjp_where(tp, e, g, cot, touched) }
  if e.op == OpMatMul { return vjp_matmul(tp, e, g, cot, touched) }
  if e.op == OpEinsum { return vjp_einsum(tp, e, g, cot, touched) }
  if e.op == OpSum or e.op == OpMean {
    return vjp_sum_mean(tp, e, g, cot, touched)
  }
  if e.op == OpMax or e.op == OpMin {
    return vjp_extreme(tp, e, g, cot, touched)
  }
  if e.op == OpProd { return vjp_prod(tp, e, g, cot, touched) }
  if e.op == OpMedian { return vjp_median(tp, e, g, cot, touched) }
  if e.op == OpLogSumExp { return vjp_logsumexp(tp, e, g, cot, touched) }
  if e.op == OpSoftmax { return vjp_softmax(tp, e, g, cot, touched) }
  if e.op == OpReshape {
    # The identity on the buffer, which is why it has no helper.
    accumulate(cot, touched, e.inputs[0], data_arr(g))
    return Ok(0)
  }
  if e.op == OpCast {
    # The straight-through estimator: the forward rounds to dt, and the
    # gradient of a rounding is taken to be one. So the cotangent passes to the
    # input unchanged, exactly as reshape does, and accumulate stores it at the
    # input's own gradient dtype. This is the whole reason a cast is on the tape
    # rather than a graph break: an f32 master weight narrowed to bf16 receives
    # the bf16 activation's f32 cotangent, and learns. Rounding the gradient a
    # second time here, to match the forward rounding, is the thing loss scaling
    # exists to avoid and is deliberately not done.
    accumulate(cot, touched, e.inputs[0], data_arr(g))
    return Ok(0)
  }
  if e.op == OpTranspose { return vjp_permutation(tp, e, g, cot, touched) }
  if e.op == OpFlip { return vjp_flip(tp, e, g, cot, touched) }
  if e.op == OpSort or e.op == OpTopK {
    return vjp_selection(tp, e, g, cot, touched)
  }
  if e.op == OpBroadcastTo { return vjp_broadcast_to(tp, e, g, cot, touched) }
  if e.op == OpConcat { return vjp_concat(tp, e, g, cot, touched) }
  if e.op == OpSplit { return vjp_split(tp, e, g, cot, touched) }
  if e.op == OpIndex0 or e.op == OpSlice0 {
    return vjp_rows(tp, e, g, cot, touched)
  }
  if e.op == OpGather { return vjp_gather(tp, e, g, cot, touched) }
  if e.op == OpConv2D { return vjp_conv2d(tp, e, g, cot, touched) }
  if e.op == OpMaxPool2D { return vjp_maxpool2d(tp, e, g, cot, touched) }
  if e.op == OpCumSum { return vjp_cumsum(tp, e, g, cot, touched) }
  if e.op == OpCumProd { return vjp_cumprod(tp, e, g, cot, touched) }
  if e.op == OpCumMax or e.op == OpCumMin {
    return vjp_cumextreme(tp, e, g, cot, touched)
  }
  if e.op == OpDiff { return vjp_diff(tp, e, g, cot, touched) }
  if e.op == OpRoll { return vjp_roll(tp, e, g, cot, touched) }

  Err(bytes.concat("backward: no gradient rule for ", op_name(e.op)))
}

fn is_binary_op(op: Op) -> Bool {
  if is_comparison(op) { return true }
  if op == OpAdd or op == OpSub { return true }
  if op == OpMul or op == OpDiv { return true }
  if op == OpMod { return true }
  if op == OpMaximum or op == OpMinimum { return true }
  false
}

fn is_unary_op(op: Op) -> Bool {
  if op == OpNeg or op == OpRelu { return true }
  if op == OpExp or op == OpLog { return true }
  if op == OpLog1p or op == OpExpm1 { return true }
  if op == OpSin or op == OpCos { return true }
  if op == OpSqrt or op == OpTanh { return true }
  if op == OpSigmoid or op == OpSquare { return true }
  if op == OpPow or op == OpClip { return true }
  false
}

# Elementwise binary, with broadcasting.
#
# This is the rule the whole file is arranged around, so it is worth being
# explicit. Walk the output index space. At output position o the operands
# contributed their elements at offsets ia and ib, which the same effective
# strides the forward pass used give incrementally. The local derivatives are
# d/da and d/db at that pair. Add `d * g[o]` at ia and at ib.
#
# When an operand broadcast along an axis its effective stride there is zero, so
# many different o map to the same ia, and the `+=` sums all of their
# contributions into it. That is the summing-back, and doing it this way means
# it is not a separate step that can be forgotten: it is the same loop that
# produced the forward value, read backwards.
#
# The alternative spelling is to build a full-size gradient of the output's
# shape and then reduce it to the operand's shape with sum_to_shape. That is
# equivalent, and it is where the bug usually lives, because the reduction is a
# second piece of code that has to agree with the first about which axes were
# stretched.
fn vjp_binary(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let b: Tensor = value_of(tp, e.inputs[1])
  let shape: Arr[I64] = e.out.shape
  let n: I64 = element_count(e.out.shape)

  let ga: Arr[F64] = alloc(element_count(a.shape))
  let gb: Arr[F64] = alloc(element_count(b.shape))

  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(a.shape, shape))
  push(contrib, eff_strides(b.shape, shape))
  let odo: Odometer = odo_new(shape, contrib)

  let o: I64 = 0
  while o < n {
    let x: F64 = buf.get(a.data, a.dtype, odo.offs[0])
    let y: F64 = buf.get(b.data, b.dtype, odo.offs[1])
    let ov: F64 = buf.get(e.out.data, e.out.dtype, o)
    let gv: F64 = buf.get(g.data, g.dtype, o)
    ga[odo.offs[0]] = ga[odo.offs[0]] + d_binary_a(e.op, x, y, ov) * gv
    gb[odo.offs[1]] = gb[odo.offs[1]] + d_binary_b(e.op, x, y, ov) * gv
    odo_step(odo)
    o = o + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  accumulate(cot, touched, e.inputs[1], gb)
  Ok(0)
}

# Elementwise unary. No broadcasting, so no summing back: the output has the
# input's shape and position i came from position i.
fn vjp_unary(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let p0: F64 = 0.0
  let p1: F64 = 0.0
  if len(e.fattr) > 0 { p0 = e.fattr[0] }
  if len(e.fattr) > 1 { p1 = e.fattr[1] }
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < element_count(a.shape) {
    ga[i] = d_unary(e.op, buf.get(a.data, a.dtype, i), buf.get(e.out.data, e.out.dtype, i), p0, p1) * buf.get(g.data, g.dtype, i)
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# where. The cotangent goes wholly to whichever operand was selected at each
# output position, and nothing goes to the condition: it is not differentiable
# and it is on the tape only so its value can be read here.
#
# Both operands broadcast, so this has the same summing-back as vjp_binary and
# for the same reason.
fn vjp_where(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let cond: Tensor = value_of(tp, e.inputs[0])
  let a: Tensor = value_of(tp, e.inputs[1])
  let b: Tensor = value_of(tp, e.inputs[2])
  let shape: Arr[I64] = e.out.shape
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let gb: Arr[F64] = alloc(element_count(b.shape))

  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(cond.shape, shape))
  push(contrib, eff_strides(a.shape, shape))
  push(contrib, eff_strides(b.shape, shape))
  let odo: Odometer = odo_new(shape, contrib)

  let o: I64 = 0
  while o < element_count(e.out.shape) {
    if buf.get(cond.data, cond.dtype, odo.offs[0]) != 0.0 {
      ga[odo.offs[1]] = ga[odo.offs[1]] + buf.get(g.data, g.dtype, o)
    } else {
      gb[odo.offs[2]] = gb[odo.offs[2]] + buf.get(g.data, g.dtype, o)
    }
    odo_step(odo)
    o = o + 1
  }
  accumulate(cot, touched, e.inputs[1], ga)
  accumulate(cot, touched, e.inputs[2], gb)
  Ok(0)
}

# matmul.
#
# For C = A B with A of [m, k] and B of [k, n], dL/dA = G B^T and dL/dB = A^T G.
# The derivation in one line: C[i,j] = sum_p A[i,p] B[p,j], so dC[i,j]/dA[i,p]
# is B[p,j], and dL/dA[i,p] = sum_j G[i,j] B[p,j], which is G B^T.
#
# The rank-1 promotion needs care and is the part most likely to be wrong. A
# vector operand was promoted to [1, k] or [k, 1] for the forward pass, and the
# promoted axis was dropped from the result. The gradient is computed entirely
# in promoted space, where the shapes are honest, and the result is then already
# the right length for the operand's real shape, because dropping a size-1 axis
# does not change how many elements there are.
#
# The upstream cotangent is read as a flat m*n buffer regardless of the result's
# rank, which is sound for the same reason: the promoted result is [m, n] and
# the actual result is that same buffer with size-1 axes dropped.
fn vjp_matmul(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let b: Tensor = value_of(tp, e.inputs[1])
  let a2: Arr[I64] = matmul_promote(a.shape, true)
  let b2: Arr[I64] = matmul_promote(b.shape, false)
  let m: I64 = a2[0]
  let k: I64 = a2[1]
  let n: I64 = b2[1]

  # Both products accumulate at the cotangent's accumulation dtype, not the
  # forward operands'. A bf16 forward has an f32 cotangent, and reducing the
  # backward accumulator to bf16 because the weights are bf16 would undo exactly
  # what the wider gradient was for.
  let gacc: I64 = acc_dtype(g.dtype)
  let gd: Arr[F64] = data_arr(g)

  let bt: Arr[F64] = transpose2d(data_arr(b), k, n)
  accumulate(cot, touched, e.inputs[0], mm(gd, m, n, bt, k, gacc))

  let at: Arr[F64] = transpose2d(data_arr(a), m, k)
  accumulate(cot, touched, e.inputs[1], mm(at, k, m, gd, n, gacc))
  Ok(0)
}

# einsum. See einsum_grad: the gradient of a multilinear contraction is the same
# contraction with the operand and the output swapped.
fn vjp_einsum(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let vals: Arr[Tensor] = arr_new()
  let i: I64 = 0
  while i < len(e.inputs) {
    push(vals, value_of(tp, e.inputs[i]))
    i = i + 1
  }
  let parsed: EinsumSpec = parse_einsum(e.sattr, len(vals))?
  i = 0
  while i < len(e.inputs) {
    let gp: Tensor = einsum_grad(parsed, vals, i, g)?
    accumulate(cot, touched, e.inputs[i], data_arr(gp))
    i = i + 1
  }
  Ok(0)
}

# sum and mean, over an axis or over everything.
#
# The output at (i, j) is the sum of the L elements of its run, each with
# coefficient 1, or 1/L for mean. So the upstream value is copied back to every
# element of the run, scaled. This is a broadcast, and it is the gradient of a
# reduction being an expansion, which is the dual of broadcast_to's gradient
# being a reduction.
fn vjp_sum_mean(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  let scale: F64 = 1.0
  if e.op == OpMean { scale = 1.0 / f64_of_i64(sp.length) }
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let gv: F64 = buf.get(g.data, g.dtype, i * sp.after + j) * scale
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        ga[base + k * sp.after] = ga[base + k * sp.after] + gv
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# max and min. The whole upstream value routes to the offset that was selected
# and every other element of the run gets nothing. Recomputing the selection is
# exact because the forward kernel is deterministic and its input is on the tape.
fn vjp_extreme(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let want_max: Bool = e.op == OpMax
  let ga: Arr[F64] = alloc(element_count(a.shape))
  if e.iattr[0] < 0 {
    let idx: I64 = extreme_all_origin(a, want_max)
    ga[idx] = ga[idx] + buf.get(g.data, g.dtype, 0)
  } else {
    let origin: Arr[I64] = extreme_axis_origins(a, e.iattr[0], want_max)
    let o: I64 = 0
    while o < len(origin) {
      ga[origin[o]] = ga[origin[o]] + buf.get(g.data, g.dtype, o)
      o = o + 1
    }
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# prod. The three-case rule stated on prod_over, applied per run.
fn vjp_prod(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  # The same accumulation dtype the forward pass used, so the recomputed
  # products are the ones it produced rather than merely close to them.
  let aux: ProdAux = prod_over(a, sp.length, sp.before, sp.after, acc_dtype(a.dtype))
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let idx: I64 = i * sp.after + j
      let gv: F64 = buf.get(g.data, g.dtype, idx)
      if gv != 0.0 {
        let base: I64 = i * sp.length * sp.after + j
        let k: I64 = 0
        while k < sp.length {
          let p: I64 = base + k * sp.after
          if aux.zeros[idx] == 0 {
            # Every factor is non-zero, so the product of the others is the
            # whole product divided by this one.
            ga[p] = ga[p] + gv * aux.out[idx] / buf.get(a.data, a.dtype, p)
          } else {
            # Exactly one zero: only that factor has a non-zero derivative,
            # because every other factor's product of the rest still contains
            # the zero. With two or more zeros nothing survives, which is why
            # there is no third branch.
            if aux.zeros[idx] == 1 and buf.get(a.data, a.dtype, p) == 0.0 {
              ga[p] = ga[p] + gv * aux.nz_prod[idx]
            }
          }
          k = k + 1
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# median. The selected element takes the whole value; an even-length run splits
# it between the two middle elements.
fn vjp_median(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  let aux: MedianAux = median_over(a, sp.length, sp.before, sp.after)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let idx: I64 = 0
  while idx < len(aux.out) {
    let gv: F64 = buf.get(g.data, g.dtype, idx)
    if gv != 0.0 {
      if aux.lo[idx] == aux.hi[idx] {
        ga[aux.lo[idx]] = ga[aux.lo[idx]] + gv
      } else {
        ga[aux.lo[idx]] = ga[aux.lo[idx]] + gv / 2.0
        ga[aux.hi[idx]] = ga[aux.hi[idx]] + gv / 2.0
      }
    }
    idx = idx + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# logsumexp. d/dx log sum exp(x) = softmax(x), so the upstream value is spread
# along the run weighted by the softmax.
#
# The weights are recovered as exp(x - out) rather than by recomputing the
# maximum and the sum. That identity is exact: out is log sum exp(x), so
# exp(x_k - out) = exp(x_k) / sum exp(x) = softmax_k. It is stable for the same
# reason the forward pass is, since x_k - out is never above zero by more than
# the log of the run length.
fn vjp_logsumexp(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let oi: I64 = i * sp.after + j
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        ga[p] = ga[p] + f64_exp(buf.get(a.data, a.dtype, p) - buf.get(e.out.data, e.out.dtype, oi)) * buf.get(g.data, g.dtype, oi)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# softmax. With s the output, the gradient is s * (g - dot(g, s)) over each run.
#
# The dot term is the part that gets dropped by mistake. Softmax's outputs sum
# to 1 along the run, so the Jacobian is not diagonal: raising one input lowers
# every other output. Formally J = diag(s) - s s^T, and J^T g is s * g - s (s.g),
# which is the expression below. Without the second term the gradient is wrong
# by a rank-one correction that vanishes only when g is constant along the run,
# which is exactly the case a quick hand test uses.
fn vjp_softmax(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = axis_spans(a.shape, e.iattr[0])
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let dot: F64 = 0.0
      let k: I64 = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        dot = dot + buf.get(g.data, g.dtype, p) * buf.get(e.out.data, e.out.dtype, p)
        k = k + 1
      }
      k = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        ga[p] = ga[p] + buf.get(e.out.data, e.out.dtype, p) * (buf.get(g.data, g.dtype, p) - dot)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# transpose. A permutation of the buffer, so its inverse. Expressed as a scatter
# through the same origin table the forward pass read through, which is the
# inverse by construction and cannot be applied the wrong way round.
fn vjp_permutation(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let origin: Arr[I64] = transpose_origins(a.shape, e.iattr, e.out.shape)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let o: I64 = 0
  while o < len(origin) {
    ga[origin[o]] = ga[origin[o]] + buf.get(g.data, g.dtype, o)
    o = o + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# flip. A permutation that is its own inverse, so the backward pass is the same
# reversal.
fn vjp_flip(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = axis_spans(a.shape, e.iattr[0])
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        let dst: I64 = base + (sp.length - 1 - k) * sp.after
        ga[dst] = ga[dst] + buf.get(g.data, g.dtype, base + k * sp.after)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# sort and topk. Both are selections: each output element is one input element,
# so its cotangent goes home to whichever input supplied it, and an input that
# was not selected gets nothing. For a full sort every input is selected exactly
# once, which makes it a permutation; for topk the unselected ones are genuinely
# zero, because moving one of them does not move the output.
fn vjp_selection(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let axis: I64 = e.iattr[0]
  let keep: I64 = a.shape[axis]
  let direction: Bool = int_to_bool(e.iattr[1])
  if e.op == OpTopK {
    keep = e.iattr[1]
    direction = int_to_bool(e.iattr[2])
  }
  let origin: Arr[I64] = sort_origins(a, axis, direction, keep)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let o: I64 = 0
  while o < len(origin) {
    ga[origin[o]] = ga[origin[o]] + buf.get(g.data, g.dtype, o)
    o = o + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# broadcast_to. The reverse of the expansion: every output that read a given
# input element sends its cotangent back to it, so a broadcast axis sums. Same
# scatter as vjp_binary and the same reasoning; see the comment on broadcast_to.
fn vjp_broadcast_to(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let contrib: Arr[Arr[I64]] = arr_new()
  push(contrib, eff_strides(a.shape, e.out.shape))
  let odo: Odometer = odo_new(e.out.shape, contrib)
  let o: I64 = 0
  while o < element_count(e.out.shape) {
    ga[odo.offs[0]] = ga[odo.offs[0]] + buf.get(g.data, g.dtype, o)
    odo_step(odo)
    o = o + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# concat. Each input takes back the slab of the cotangent it filled. The slabs
# are disjoint, so nothing sums here.
fn vjp_concat(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let axis: I64 = e.iattr[0]
  let sp: Spans = axis_spans(e.out.shape, axis)
  let total: I64 = sp.length
  let vals: Arr[Tensor] = arr_new()
  let p: I64 = 0
  while p < len(e.inputs) {
    push(vals, value_of(tp, e.inputs[p]))
    p = p + 1
  }
  p = 0
  while p < len(e.inputs) {
    let l: I64 = vals[p].shape[axis]
    let offset: I64 = concat_offset(vals, axis, p)
    let ga: Arr[F64] = alloc(element_count(vals[p].shape))
    let i: I64 = 0
    while i < sp.before {
      let k: I64 = 0
      while k < l {
        let j: I64 = 0
        while j < sp.after {
          ga[i * l * sp.after + k * sp.after + j] =
            ga[i * l * sp.after + k * sp.after + j] +
            buf.get(g.data, g.dtype, i * total * sp.after + (offset + k) * sp.after + j)
          j = j + 1
        }
        k = k + 1
      }
      i = i + 1
    }
    accumulate(cot, touched, e.inputs[p], ga)
    p = p + 1
  }
  Ok(0)
}

# split. One piece's cotangent lands in the slab of the parent it came from.
# Two pieces used in the same expression are two tape nodes with the same input,
# and the accumulate in the backward loop adds their contributions; nothing here
# has to know that happened.
fn vjp_split(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let axis: I64 = e.iattr[0]
  let offset: I64 = e.iattr[1]
  let size: I64 = e.iattr[2]
  let sp: Spans = axis_spans(a.shape, axis)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let k: I64 = 0
    while k < size {
      let j: I64 = 0
      while j < sp.after {
        let dst: I64 = i * sp.length * sp.after + (offset + k) * sp.after + j
        ga[dst] = ga[dst] + buf.get(g.data, g.dtype, i * size * sp.after + k * sp.after + j)
        j = j + 1
      }
      k = k + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# index and slice along axis 0. Both are a contiguous run of rows, so the
# cotangent copies into the parent at the row offset and nowhere else.
fn vjp_rows(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let rs: I64 = row_size(a.shape)
  let start: I64 = e.iattr[0]
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < element_count(g.shape) {
    ga[start * rs + i] = ga[start * rs + i] + buf.get(g.data, g.dtype, i)
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# gather. Scatter-add each output row's cotangent back to its source row. The
# add rather than the assign is what makes a repeated index correct: an
# embedding row read by three tokens in a batch receives all three
# contributions, and an assignment would keep only the last.
fn vjp_gather(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let rs: I64 = row_size(a.shape)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < len(e.iattr) {
    let base: I64 = e.iattr[i] * rs
    let obase: I64 = i * rs
    let j: I64 = 0
    while j < rs {
      ga[base + j] = ga[base + j] + buf.get(g.data, g.dtype, obase + j)
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# ---- convolution and pooling -----------------------------------------------
#
# NEEDS-54's first two entries, and the two whose gradients are easiest to get
# wrong, so both are spelled out rather than left to the reader.

# conv2d is a cross-correlation, which is what machine learning calls a
# convolution: the kernel is not flipped. input is [Cin, H, W], weight is
# [Cout, Cin, KH, KW], output is [Cout, H-KH+1, W-KW+1]. Valid padding, unit
# stride, no dilation and no groups, exactly as internal/tensor/conv.go.
#
# OPTIMISATION, not taken: the standard im2col reshape turns the six nested
# loops below into one matmul and is several times faster. It is not written
# because the loop nest is the definition of the operation, and the gradient
# rule below is read against it.
fn conv2d(input: Tensor, weight: Tensor) -> Res[Tensor, Str] {
  if len(input.shape) != 3 {
    return Err(bytes.concat("conv2d: input must be [channels, height, width], got ",
      shape_string(input.shape)))
  }
  if len(weight.shape) != 4 {
    return Err(bytes.concat("conv2d: weight must be [out, in, kh, kw], got ",
      shape_string(weight.shape)))
  }
  let cin: I64 = input.shape[0]
  let h: I64 = input.shape[1]
  let w: I64 = input.shape[2]
  let cout: I64 = weight.shape[0]
  let wcin: I64 = weight.shape[1]
  let kh: I64 = weight.shape[2]
  let kw: I64 = weight.shape[3]
  if wcin != cin {
    return Err(bytes.concat("conv2d: input has ", bytes.concat(str(cin),
      bytes.concat(" channels but weight expects ", str(wcin)))))
  }
  if kh > h or kw > w {
    return Err(bytes.concat("conv2d: kernel ", bytes.concat(str(kh),
      bytes.concat("x", bytes.concat(str(kw),
      bytes.concat(" is larger than input ", bytes.concat(str(h),
      bytes.concat("x", str(w)))))))))
  }
  let oh: I64 = h - kh + 1
  let ow: I64 = w - kw + 1
  let hw: I64 = h * w
  let khw: I64 = kh * kw
  let cinkhw: I64 = cin * khw
  let ohw: I64 = oh * ow
  # A convolution is a contraction over cin, kh and kw, so it is in matmul's
  # operation class and takes matmul's accumulation rule.
  let dt: I64 = promote(input.dtype, weight.dtype)
  let acc: I64 = acc_dtype(dt)
  let out: Arr[F64] = alloc(cout * ohw)
  let co: I64 = 0
  while co < cout {
    let i: I64 = 0
    while i < oh {
      let j: I64 = 0
      while j < ow {
        let sum: F64 = 0.0
        let ci: I64 = 0
        while ci < cin {
          let a: I64 = 0
          while a < kh {
            let b: I64 = 0
            while b < kw {
              sum = acc_add(acc, sum, buf.get(input.data, input.dtype, ci * hw + (i + a) * w + (j + b))
                * buf.get(weight.data, weight.dtype, co * cinkhw + ci * khw + a * kw + b))
              b = b + 1
            }
            a = a + 1
          }
          ci = ci + 1
        }
        out[co * ohw + i * ow + j] = sum
        j = j + 1
      }
      i = i + 1
    }
    co = co + 1
  }
  let shape: Arr[I64] = arr_new()
  push(shape, cout)
  push(shape, oh)
  push(shape, ow)
  Ok(mk(shape, out, dt))
}

# maxpool2d: non-overlapping k by k max pooling per channel of a [C, H, W],
# giving [C, H/k, W/k]. A ragged remainder along either spatial axis is dropped
# rather than padded, because padding with anything finite would let an invented
# value win a max.
#
# The winner of each window is computed here and recorded on the tape rather
# than recomputed in the backward pass. Recomputing would be correct only if the
# tie-break were reproduced exactly, and the rule is `>` and not `>=`, so the
# *first* maximum in scan order wins. That one character is the difference
# between a gradient that matches the bootstrap and one that is wrong on
# repeated values, which is every pooled relu output with a flat region in it.
fn maxpool_argmax(input: Tensor, k: I64) -> Arr[I64] {
  let c: I64 = input.shape[0]
  let h: I64 = input.shape[1]
  let w: I64 = input.shape[2]
  let oh: I64 = h / k
  let ow: I64 = w / k
  let hw: I64 = h * w
  let arg: Arr[I64] = arr_new()
  let ch: I64 = 0
  while ch < c {
    let i: I64 = 0
    while i < oh {
      let j: I64 = 0
      while j < ow {
        let best_idx: I64 = ch * hw + (i * k) * w + (j * k)
        let best: F64 = buf.get(input.data, input.dtype, best_idx)
        let a: I64 = 0
        while a < k {
          let b: I64 = 0
          while b < k {
            let idx: I64 = ch * hw + (i * k + a) * w + (j * k + b)
            if buf.get(input.data, input.dtype, idx) > best {
              best = buf.get(input.data, input.dtype, idx)
              best_idx = idx
            }
            b = b + 1
          }
          a = a + 1
        }
        push(arg, best_idx)
        j = j + 1
      }
      i = i + 1
    }
    ch = ch + 1
  }
  arg
}

fn maxpool2d(input: Tensor, k: I64) -> Res[Tensor, Str] {
  if len(input.shape) != 3 {
    return Err(bytes.concat("maxpool2d: input must be [channels, height, width], got ",
      shape_string(input.shape)))
  }
  if k < 1 {
    return Err(bytes.concat("maxpool2d: window must be >= 1, got ", str(k)))
  }
  let c: I64 = input.shape[0]
  let h: I64 = input.shape[1]
  let w: I64 = input.shape[2]
  let oh: I64 = h / k
  let ow: I64 = w / k
  if oh == 0 or ow == 0 {
    return Err(bytes.concat("maxpool2d: window ", bytes.concat(str(k),
      bytes.concat(" is larger than input ", bytes.concat(str(h),
      bytes.concat("x", str(w)))))))
  }
  let arg: Arr[I64] = maxpool_argmax(input, k)
  let out: Arr[F64] = alloc(len(arg))
  let o: I64 = 0
  while o < len(arg) {
    out[o] = buf.get(input.data, input.dtype, arg[o])
    o = o + 1
  }
  let shape: Arr[I64] = arr_new()
  push(shape, c)
  push(shape, oh)
  push(shape, ow)
  # A max pool selects; it does not compute. Nothing to round.
  Ok(mk_raw(shape, out, input.dtype))
}

# ---- scans, differences and shifts -----------------------------------------
#
# A scan keeps the shape: output j depends on every input at or before j, so
# unlike an elementwise op the backward pass walks the chain in reverse rather
# than pairing element with element.
#
# The flat forms run over the buffer in row-major order, which is what a
# sequence means and is all a 1-D tensor can mean. The axis forms scan along one
# axis instead. Both share one implementation over `Spans`, so the flat form is
# the axis form with before = after = 1. That is the trick `spans_for` already
# plays in the backward pass, and sharing it is what keeps the two from
# drifting apart on a tie-break or an edge.

fn alloc_ints(n: I64) -> Arr[I64] {
  let v: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < n {
    push(v, 0)
    i = i + 1
  }
  v
}

fn is_scan_op(op: Op) -> Bool {
  if op == OpCumSum or op == OpCumProd { return true }
  op == OpCumMax or op == OpCumMin
}

# The running sum, product, max or min over each run of `sp`. `arg` is filled
# for the two extremes with the input position each output came from, which is
# the whole of what their gradient needs, and is left at zero for the other two.
#
# `acc` is the accumulation dtype. A scan is a reduction that stores every
# partial result, so the two dtypes are both live at once: the running value is
# carried at `acc` from one element to the next, and each partial result is
# rounded to the tensor's dtype as it is stored. Carrying the rounded value
# forward instead would compound the store rounding over the length of the run,
# which is the same failure a narrow reduction accumulator has, spread out.
fn scan_run(op: Op, t: Tensor, sp: Spans, out: Arr[F64], arg: Arr[I64], acc: I64) {
  let want_extreme: Bool = op == OpCumMax or op == OpCumMin
  let want_max: Bool = op == OpCumMax
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let run: F64 = 0.0
      if op == OpCumProd { run = 1.0 }
      let k: I64 = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        if op == OpCumSum {
          run = acc_add(acc, run, buf.get(t.data, t.dtype, p))
          out[p] = run
        }
        if op == OpCumProd {
          run = acc_mul(acc, run, buf.get(t.data, t.dtype, p))
          out[p] = run
        }
        if want_extreme {
          if k == 0 {
            out[p] = buf.get(t.data, t.dtype, p)
            arg[p] = p
          } else {
            let prev: F64 = out[p - sp.after]
            let v: F64 = buf.get(t.data, t.dtype, p)
            # A tie keeps the earlier element. Whichever rule is chosen has to
            # be the one sort and argmax use as well, or a gradient moves when a
            # value is merely repeated.
            let takes: Bool = false
            if want_max { takes = v > prev } else { takes = v < prev }
            if takes {
              out[p] = v
              arg[p] = p
            } else {
              out[p] = prev
              arg[p] = arg[p - sp.after]
            }
          }
        }
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
}

fn scan_all_by(t: Tensor, op: Op) -> Res[Tensor, Str] {
  if not is_scan_op(op) {
    return Err(bytes.concat("scan_all_by: not a scan: ", op_name(op)))
  }
  let sp: Spans = Spans { before: 1, length: element_count(t.shape), after: 1 }
  let out: Arr[F64] = alloc(element_count(t.shape))
  scan_run(op, t, sp, out, alloc_ints(element_count(t.shape)), acc_dtype(t.dtype))
  Ok(mk(copy_shape(t.shape), out, t.dtype))
}

fn scan_axis_by(t: Tensor, axis_in: I64, op: Op) -> Res[Tensor, Str] {
  if not is_scan_op(op) {
    return Err(bytes.concat("scan_axis_by: not a scan: ", op_name(op)))
  }
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let out: Arr[F64] = alloc(element_count(t.shape))
  scan_run(op, t, sp, out, alloc_ints(element_count(t.shape)), acc_dtype(t.dtype))
  Ok(mk(copy_shape(t.shape), out, t.dtype))
}

# The four flat names are total, so they take the Tensor form rather than a Res.
# The op is one of the four literals below and cannot be wrong, so unwrapping
# here hides no error a caller could have seen.
fn scan_all_unchecked(t: Tensor, op: Op) -> Tensor {
  match scan_all_by(t, op) {
    Ok(v) => v,
    Err(m) => abort(m),
  }
}

fn cumsum(t: Tensor) -> Tensor = scan_all_unchecked(t, OpCumSum)
fn cumprod(t: Tensor) -> Tensor = scan_all_unchecked(t, OpCumProd)
fn cummax(t: Tensor) -> Tensor = scan_all_unchecked(t, OpCumMax)
fn cummin(t: Tensor) -> Tensor = scan_all_unchecked(t, OpCumMin)

fn cumsum_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = scan_axis_by(t, axis, OpCumSum)
fn cumprod_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = scan_axis_by(t, axis, OpCumProd)
fn cummax_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = scan_axis_by(t, axis, OpCumMax)
fn cummin_axis(t: Tensor, axis: I64) -> Res[Tensor, Str] = scan_axis_by(t, axis, OpCumMin)

# diff_axis: the difference between neighbours along an axis, shortening that
# axis by one. Shortening rather than padding, because there is no honest value
# for the first difference: a zero says "no change", which is a claim about data
# that does not exist and the one most likely to be believed downstream.
fn diff_axis(t: Tensor, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  if sp.length < 2 {
    return Err(bytes.concat("diff needs at least 2 elements along axis ",
      bytes.concat(str(axis), bytes.concat(", got ", str(sp.length)))))
  }
  let out_shape: Arr[I64] = copy_shape(t.shape)
  out_shape[axis] = sp.length - 1
  let out: Arr[F64] = alloc(sp.before * (sp.length - 1) * sp.after)
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let src: I64 = i * sp.length * sp.after + j
      let dst: I64 = i * (sp.length - 1) * sp.after + j
      let k: I64 = 0
      while k < sp.length - 1 {
        out[dst + k * sp.after] = buf.get(t.data, t.dtype, src + (k + 1) * sp.after) - buf.get(t.data, t.dtype, src + k * sp.after)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  # A single subtraction per element, so F64 and one rounding on store is the
  # dtype's own subtraction exactly. No accumulator is live here.
  Ok(mk(out_shape, out, t.dtype))
}

# roll_axis: shift along an axis, wrapping what falls off the end back to the
# start. A positive shift moves elements towards the end, so roll(x, 1) puts the
# previous value where the current one was, which is what makes `x - roll(x, 1)`
# the comparison of a series with its own past.
fn roll_axis(t: Tensor, shift: I64, axis_in: I64) -> Res[Tensor, Str] {
  let axis: I64 = normalize_axis(axis_in, len(t.shape))?
  let sp: Spans = axis_spans(t.shape, axis)
  let s: I64 = roll_amount(shift, sp.length)
  let out: Arr[F64] = alloc(element_count(t.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        out[base + ((k + s) % sp.length) * sp.after] = buf.get(t.data, t.dtype, base + k * sp.after)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(mk_raw(copy_shape(t.shape), out, t.dtype))
}

# `%` keeps the sign of the dividend, here as in Go, so a negative shift has to
# be brought back into range before it can be used as an index.
fn roll_amount(shift: I64, length: I64) -> I64 {
  if length == 0 { return 0 }
  ((shift % length) + length) % length
}

# ---- nested literals -------------------------------------------------------
#
# NEEDS-62 said this type would move here when the tensor engine owned the
# constructor. It does now, so it has.

enum Nested {
  NLeaf(F64),
  NList(Arr[Nested]),
}

# The shape is read off the first element at each depth, and every other element
# is then checked against it. Reading and checking in one pass would accept
# `[[1, 2], [3]]` as a rank-1 shape with a stray list inside it, which is the
# ragged case the bootstrap rejects by name.
fn nested_shape(n: Nested) -> Arr[I64] {
  let shape: Arr[I64] = arr_new()
  let probe: Nested = n
  let going: Bool = true
  while going {
    match probe {
      NList(items) => {
        push(shape, len(items))
        if len(items) == 0 {
          going = false
        } else {
          probe = items[0]
        }
      },
      NLeaf(_) => going = false,
    }
  }
  shape
}

fn nested_walk(n: Nested, depth: I64, shape: Arr[I64], flat: Arr[F64]) -> Res[I64, Str] {
  match n {
    NList(items) => {
      if depth >= len(shape) or len(items) != shape[depth] {
        return Err("ragged tensor literal: inconsistent row lengths")
      }
      let i: I64 = 0
      while i < len(items) {
        nested_walk(items[i], depth + 1, shape, flat)?
        i = i + 1
      }
      Ok(0)
    },
    NLeaf(x) => {
      push(flat, x)
      Ok(0)
    },
  }
}

# A literal is f64. docs/dtypes.md argues the default at length; the short form
# is that the differential harness compares printed numbers against a bootstrap
# that computes in float64, so a narrower default changes every golden in
# `testdata/` before it changes anything about a model. A narrow tensor is asked
# for with a cast, never arrived at by inference.
fn from_nested(n: Nested) -> Res[Tensor, Str] {
  let shape: Arr[I64] = nested_shape(n)
  let flat: Arr[F64] = arr_new()
  nested_walk(n, 0, shape, flat)?
  Ok(mk_raw(shape, flat, DT_F64))
}

struct NestedAt {
  value: Nested,
  next: I64,
}

fn to_nested(t: Tensor) -> Nested {
  if is_scalar(t) { return NLeaf(buf.get(t.data, t.dtype, 0)) }
  to_nested_at(t, 0, 0).value
}

fn to_nested_at(t: Tensor, offset: I64, dim: I64) -> NestedAt {
  if dim == len(t.shape) - 1 {
    let row: Arr[Nested] = arr_new()
    let i: I64 = 0
    while i < t.shape[dim] {
      push(row, NLeaf(buf.get(t.data, t.dtype, offset + i)))
      i = i + 1
    }
    return NestedAt { value: NList(row), next: offset + t.shape[dim] }
  }
  let rows: Arr[Nested] = arr_new()
  let off: I64 = offset
  let i: I64 = 0
  while i < t.shape[dim] {
    let r: NestedAt = to_nested_at(t, off, dim + 1)
    push(rows, r.value)
    off = r.next
    i = i + 1
  }
  NestedAt { value: NList(rows), next: off }
}

# ---- the taped twins for the kernels above ---------------------------------

fn t_conv2d(tp: Tape, input: I64, weight: I64) -> Res[I64, Str] {
  let out: Tensor = conv2d(value_of(tp, input), value_of(tp, weight))?
  Ok(record(tp, OpConv2D, two_inputs(input, weight), out, no_ints(), no_floats(), ""))
}

# iattr is [k, then the flat input index of every window's winner]. The winners
# are recorded rather than recomputed for the tie-break reason on maxpool_argmax.
fn t_maxpool2d(tp: Tape, a: I64, k: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let out: Tensor = maxpool2d(v, k)?
  let iattr: Arr[I64] = arr_new()
  push(iattr, k)
  let arg: Arr[I64] = maxpool_argmax(v, k)
  let i: I64 = 0
  while i < len(arg) {
    push(iattr, arg[i])
    i = i + 1
  }
  Ok(record(tp, OpMaxPool2D, one_input(a), out, iattr, no_floats(), ""))
}

fn t_diff_axis(tp: Tape, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = diff_axis(v, axis)?
  Ok(record(tp, OpDiff, one_input(a), out, one_int(axis), no_floats(), ""))
}

# The normalized shift is recorded next to the axis, so the backward pass never
# redoes the sign correction against a length it would have to look up again.
fn t_roll_axis(tp: Tape, a: I64, shift: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = roll_axis(v, shift, axis)?
  let sp: Spans = axis_spans(v.shape, axis)
  Ok(record(tp, OpRoll, one_input(a), out,
    two_ints(axis, roll_amount(shift, sp.length)), no_floats(), ""))
}

# An axis of -1 means the flat scan, which is the convention `spans_for` already
# reads, so the two scan forms share one gradient rule between them.
fn t_scan_all(tp: Tape, op: Op, a: I64) -> Res[I64, Str] {
  let out: Tensor = scan_all_by(value_of(tp, a), op)?
  Ok(record(tp, op, one_input(a), out, one_int(0 - 1), no_floats(), ""))
}

fn t_scan_axis(tp: Tape, op: Op, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = scan_axis_by(v, axis, op)?
  Ok(record(tp, op, one_input(a), out, one_int(axis), no_floats(), ""))
}

fn t_logsumexp_axis(tp: Tape, a: I64, axis_in: I64) -> Res[I64, Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  let out: Tensor = logsumexp_axis(v, axis)?
  Ok(record(tp, OpLogSumExp, one_input(a), out, one_int(axis), no_floats(), ""))
}

# split_equal is split with the sizes worked out first. They are worked out here
# too, and the kernel is called first for its side effect of reporting the
# divisibility error, so that the message is the same one whether or not a tape
# is installed.
fn t_split_equal(tp: Tape, a: I64, parts: I64, axis_in: I64) -> Res[Arr[I64], Str] {
  let v: Tensor = value_of(tp, a)
  let axis: I64 = normalize_axis(axis_in, len(v.shape))?
  split_equal(v, parts, axis)?
  let each: I64 = v.shape[axis] / parts
  let sizes: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < parts {
    push(sizes, each)
    i = i + 1
  }
  t_split(tp, a, sizes, axis)
}

# ---- gradient rules for the kernels above ----------------------------------

# conv2d. The forward pass is
#
#   out[co, i, j] = sum over ci, a, b of  in[ci, i+a, j+b] * wt[co, ci, a, b]
#
# and it is linear in each of its two inputs separately, so each gradient is the
# same sum with the other factor in place of the output:
#
#   d in[ci, i+a, j+b] += g[co, i, j] * wt[co, ci, a, b]
#   d wt[co, ci, a, b] += g[co, i, j] * in[ci, i+a, j+b]
#
# Written as one loop nest over exactly the index quadruples the forward pass
# visited, which is the part that is easy to get wrong. The two textbook
# spellings of the input gradient, a full convolution of g with the flipped
# kernel and a transposed convolution, are the same numbers arrived at by
# re-deriving the index arithmetic, and each is one off-by-one away from a
# gradient that is wrong only at the borders. Reusing the forward loops cannot
# make that mistake, because the bounds are the forward bounds.
#
# The skip on a zero incoming gradient is the bootstrap's and it is a cost
# property only: adding zero changes nothing.
fn vjp_conv2d(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let input: Tensor = value_of(tp, e.inputs[0])
  let weight: Tensor = value_of(tp, e.inputs[1])
  let cin: I64 = input.shape[0]
  let h: I64 = input.shape[1]
  let w: I64 = input.shape[2]
  let cout: I64 = weight.shape[0]
  let kh: I64 = weight.shape[2]
  let kw: I64 = weight.shape[3]
  let oh: I64 = h - kh + 1
  let ow: I64 = w - kw + 1
  let hw: I64 = h * w
  let khw: I64 = kh * kw
  let cinkhw: I64 = cin * khw
  let ohw: I64 = oh * ow
  let gi: Arr[F64] = alloc(element_count(input.shape))
  let gw: Arr[F64] = alloc(element_count(weight.shape))
  let co: I64 = 0
  while co < cout {
    let i: I64 = 0
    while i < oh {
      let j: I64 = 0
      while j < ow {
        let gv: F64 = buf.get(g.data, g.dtype, co * ohw + i * ow + j)
        if gv != 0.0 {
          let ci: I64 = 0
          while ci < cin {
            let a: I64 = 0
            while a < kh {
              let b: I64 = 0
              while b < kw {
                let in_idx: I64 = ci * hw + (i + a) * w + (j + b)
                let w_idx: I64 = co * cinkhw + ci * khw + a * kw + b
                gi[in_idx] = gi[in_idx] + gv * buf.get(weight.data, weight.dtype, w_idx)
                gw[w_idx] = gw[w_idx] + gv * buf.get(input.data, input.dtype, in_idx)
                b = b + 1
              }
              a = a + 1
            }
            ci = ci + 1
          }
        }
        j = j + 1
      }
      i = i + 1
    }
    co = co + 1
  }
  accumulate(cot, touched, e.inputs[0], gi)
  accumulate(cot, touched, e.inputs[1], gw)
  Ok(0)
}

# maxpool2d. Each output is one input element, so its gradient goes to that one
# element and nowhere else: no averaging over the window, no spreading, nothing
# to the losers. The window's winner is read from the tape rather than found
# again, so the backward pass cannot disagree with the forward pass about a tie.
#
# The add rather than the assign matters here even though the windows do not
# overlap, because the same node can be pooled twice in one graph and each use
# has to contribute.
fn vjp_maxpool2d(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let input: Tensor = value_of(tp, e.inputs[0])
  let gi: Arr[F64] = alloc(element_count(input.shape))
  let o: I64 = 0
  while o < element_count(g.shape) {
    # iattr[0] is the window, so the winners start at 1.
    let src: I64 = e.iattr[o + 1]
    gi[src] = gi[src] + buf.get(g.data, g.dtype, o)
    o = o + 1
  }
  accumulate(cot, touched, e.inputs[0], gi)
  Ok(0)
}

# cumsum. Every d(out_j)/d(in_i) with i <= j is 1, so the gradient of in_i is
# the sum of the incoming gradients from i onward. That is the running sum
# again, taken from the end, which is why this is one reverse pass and not a
# nested loop.
fn vjp_cumsum(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let run: F64 = 0.0
      let k: I64 = sp.length - 1
      while k >= 0 {
        run = run + buf.get(g.data, g.dtype, base + k * sp.after)
        ga[base + k * sp.after] = ga[base + k * sp.after] + run
        k = k - 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# cumprod. out[n] is the product of x[0..n], so d(out[n])/d(x[k]) for n >= k is
# that product with x[k] left out of it, and the gradient of x[k] is the sum of
# those over every n at or after k.
#
# The tempting shortcut is out[n] / x[k], and it is wrong exactly when x[k] is
# zero, which is not a rare value for a tensor: it turns a finite gradient into
# a NaN. Rebuilding the product without x[k] costs a factor of the run length
# and is always right. The runs are one axis long, not the whole tensor, so this
# stays cheap in the shapes anybody writes.
#
# OPTIMISATION, not taken: the prefix-and-suffix form in internal/tensor's
# CumProd does it in two linear passes. It is a different derivation, and the
# quadratic form here is the one that can be checked against the definition
# above line by line.
fn vjp_cumprod(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        let total: F64 = 0.0
        # The product of x[0..n] with x[k] left out, built forwards so it
        # carries from one n to the next.
        let without: F64 = 1.0
        let m: I64 = 0
        while m < k {
          without = without * buf.get(a.data, a.dtype, base + m * sp.after)
          m = m + 1
        }
        let n: I64 = k
        while n < sp.length {
          if n > k { without = without * buf.get(a.data, a.dtype, base + n * sp.after) }
          total = total + buf.get(g.data, g.dtype, base + n * sp.after) * without
          n = n + 1
        }
        ga[base + k * sp.after] = ga[base + k * sp.after] + total
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# cummax and cummin. Each output *is* one of the inputs, the best seen so far,
# so the gradient goes straight to that element and nowhere else. The winner is
# recovered by re-running the forward scan rather than being recorded, which is
# safe here and not in maxpool2d for one reason: the scan is deterministic in
# the input alone and the tie-break lives in a single shared function, so a
# re-run cannot disagree with the original.
fn vjp_cumextreme(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let sp: Spans = spans_for(a, e.iattr[0])
  let out: Arr[F64] = alloc(element_count(a.shape))
  let arg: Arr[I64] = alloc_ints(element_count(a.shape))
  # The forward pass's accumulation dtype, so the replay reproduces it rather
  # than approximating it.
  scan_run(e.op, a, sp, out, arg, acc_dtype(a.dtype))
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let p: I64 = 0
  while p < element_count(a.shape) {
    ga[arg[p]] = ga[arg[p]] + buf.get(g.data, g.dtype, p)
    p = p + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# diff. Each difference is out[k] = x[k+1] - x[k], so its gradient goes forward
# to the later element and backward, negated, to the earlier one. An interior
# element appears in two differences and collects both, which is what makes the
# add rather than the assign load-bearing here.
fn vjp_diff(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let axis: I64 = e.iattr[0]
  let sp: Spans = axis_spans(a.shape, axis)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let src: I64 = i * sp.length * sp.after + j
      let dst: I64 = i * (sp.length - 1) * sp.after + j
      let k: I64 = 0
      while k < sp.length - 1 {
        let gv: F64 = buf.get(g.data, g.dtype, dst + k * sp.after)
        ga[src + (k + 1) * sp.after] = ga[src + (k + 1) * sp.after] + gv
        ga[src + k * sp.after] = ga[src + k * sp.after] - gv
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# roll. A shift is a permutation, so the gradient is the shift undone: whatever
# went to position (k + s) mod L comes back from there. Reading the recorded
# normalized shift rather than re-deriving it is what keeps the inverse exact
# for a negative argument.
fn vjp_roll(tp: Tape, e: TapeEntry, g: Tensor, cot: Arr[Tensor], touched: Arr[Bool]) -> Res[I64, Str] {
  let a: Tensor = value_of(tp, e.inputs[0])
  let axis: I64 = e.iattr[0]
  let s: I64 = e.iattr[1]
  let sp: Spans = axis_spans(a.shape, axis)
  let ga: Arr[F64] = alloc(element_count(a.shape))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let k: I64 = 0
      while k < sp.length {
        ga[base + k * sp.after] = ga[base + k * sp.after] +
          buf.get(g.data, g.dtype, base + ((k + s) % sp.length) * sp.after)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  accumulate(cot, touched, e.inputs[0], ga)
  Ok(0)
}

# ---- forward mode, for hessian ---------------------------------------------
#
# The reverse-mode pass above is first order and not re-differentiable. Second
# derivatives come from forward-mode 2-jets instead: each node carries a first
# and a second directional derivative (d, dd) alongside its value, seeding the
# leaf with a direction v and walking the tape *forwards* gives the output's
# derivatives along v, and the full Hessian follows by polarization.
#
# internal/tensor/jet.go wires a `jvp` closure onto each forward op while
# `recordJets` is set, because there a graph is parent pointers and closures and
# the walk order has to be recovered by a topological sort. Here the tape is
# already in topological order and already holds every input value, so the
# forward walk is a loop over the entries and there is nothing to wire.
#
# That is why set_record_jets below does nothing. It is kept because
# src/eval.tw's do_hessian calls it around the graph build, mirroring
# internal/interp/builtins.go, and because the shape of that call site is the
# thing to preserve if the tape ever stops carrying the inputs. The cost the Go
# flag exists to avoid is not paid here at all: an ordinary tape is a jet-ready
# tape.
fn set_record_jets(on: Bool) {
  let ignored: Bool = on
}

# The (d, dd) state of every node, indexed by node.
struct Jets {
  d: Arr[Arr[F64]],
  dd: Arr[Arr[F64]],
}

fn jets_new(tp: Tape) -> Jets {
  let d: Arr[Arr[F64]] = arr_new()
  let dd: Arr[Arr[F64]] = arr_new()
  let i: I64 = 0
  while i < len(tp.entries) {
    push(d, alloc(element_count(tp.entries[i].out.shape)))
    push(dd, alloc(element_count(tp.entries[i].out.shape)))
    i = i + 1
  }
  Jets { d: d, dd: dd }
}

# The second partial derivatives of a binary op, the terms jetBinary needs that
# d_binary_a and d_binary_b do not supply. Everything piecewise linear is zero,
# which is most of the table.
# Zero for every op in the table: add, sub, mod, maximum, minimum and the
# comparisons are piecewise linear in a, mul is linear in a, and so is div. The
# function exists so jet_binary reads as the full second-order chain rule rather
# than as a version of it with a term quietly missing.
fn d2_binary_aa(op: Op, x: F64, y: F64, o: F64) -> F64 = 0.0

fn d2_binary_ab(op: Op, x: F64, y: F64, o: F64) -> F64 {
  match op {
    OpMul => 1.0,
    OpDiv => 0.0 - 1.0 / (y * y),
    _ => 0.0,
  }
}

fn d2_binary_bb(op: Op, x: F64, y: F64, o: F64) -> F64 {
  match op {
    OpDiv => 2.0 * x / (y * y * y),
    _ => 0.0,
  }
}

# The second derivative of a unary op, written in terms of the forward result
# where that is both cheaper and better conditioned, exactly as d_unary is.
fn d2_unary(op: Op, x: F64, o: F64, p0: F64, p1: F64) -> F64 {
  match op {
    OpExp => o,
    OpLog => 0.0 - 1.0 / (x * x),
    OpLog1p => 0.0 - 1.0 / ((1.0 + x) * (1.0 + x)),
    OpExpm1 => o + 1.0,
    # o is sin(x) and cos(x) respectively, and both are their own negated
    # second derivative.
    OpSin => 0.0 - o,
    OpCos => 0.0 - o,
    # f = x^(1/2), f'' = -1/4 x^(-3/2), and x^(3/2) is o^3.
    OpSqrt => (0.0 - 0.25) / (o * o * o),
    OpTanh => (0.0 - 2.0) * o * (1.0 - o * o),
    OpSigmoid => o * (1.0 - o) * (1.0 - 2.0 * o),
    OpSquare => 2.0,
    OpPow => p0 * (p0 - 1.0) * f64_pow(x, p0 - 2.0),
    # neg and relu are linear where they are differentiable at all, and clip is
    # constant off the interior and linear on it.
    _ => 0.0,
  }
}

# One forward-mode pass: seed `leaf` with direction v and propagate (d, dd)
# through every entry up to and including `root`.
#
# The chain rule at second order is where this earns its comments. For a unary
# op o = f(x) with the input carrying (dx, ddx):
#
#   d  = f'(x) dx
#   dd = f'(x) ddx + f''(x) dx^2
#
# The second term is the one a first-order implementation drops, and dropping it
# gives a Hessian that is right only where f is linear, which is exactly where
# nobody checks it. For a binary op o = f(x, y):
#
#   dd = fa ddx + fb ddy + faa dx^2 + 2 fab dx dy + fbb dy^2
#
# and the factor of 2 on the cross term is the other place this goes quietly
# wrong.
fn jet_forward(tp: Tape, root: I64, leaf: I64, v: Arr[F64]) -> Res[Jets, Str] {
  let js: Jets = jets_new(tp)
  let i: I64 = 0
  while i < len(v) {
    js.d[leaf][i] = v[i]
    i = i + 1
  }
  let n: I64 = 0
  while n <= root {
    if n != leaf {
      jet_node(tp, n, js)?
    }
    n = n + 1
  }
  Ok(js)
}

# The ops without a forward-mode rule report rather than silently propagating a
# zero tangent, because a zero tangent is a plausible Hessian and an error is
# not. The message is internal/tensor/jet.go's, byte for byte.
fn jet_unsupported(op: Op) -> Str =
  "second-order autodiff: the function uses an operation without forward-mode support"

fn jet_node(tp: Tape, n: I64, js: Jets) -> Res[I64, Str] {
  let e: TapeEntry = tp.entries[n]
  # A leaf other than the seeded one, and a constant, both have a zero tangent,
  # which is what jets_new already left there.
  if len(e.inputs) == 0 { return Ok(0) }
  # A comparison, an argmax and the ordering ops are piecewise constant in the
  # values they select on, so their tangent is zero rather than unsupported.
  if is_comparison(e.op) { return Ok(0) }
  if e.op == OpArgmax or e.op == OpArgmin { return Ok(0) }

  if is_binary_op(e.op) { return jet_binary(tp, n, e, js) }
  if is_unary_op(e.op) { return jet_unary(tp, n, e, js) }
  if e.op == OpSum or e.op == OpMean { return jet_sum_mean(tp, n, e, js) }
  if e.op == OpMatMul { return jet_matmul(tp, n, e, js) }
  if e.op == OpCumSum { return jet_cumsum(tp, n, e, js) }
  if e.op == OpCumProd { return jet_cumprod(tp, n, e, js) }
  if e.op == OpCumMax or e.op == OpCumMin {
    return jet_select_by_value(tp, n, e, js)
  }
  if e.op == OpWhere { return jet_where(tp, n, e, js) }
  # Concat is linear and n-ary: the tangent of a concat is the concat of the
  # tangents. It is not in is_rearrangement because that path replays a unary
  # kernel on one tangent buffer, and concat has several; jet_concat is the same
  # idea for many inputs. internal/tensor/ops.go's Concat carries this jvp, so
  # adding it here matches the bootstrap rather than diverging from it (NEEDS-83).
  if e.op == OpConcat { return jet_concat(tp, n, e, js) }
  # Sort and topk are permutations chosen by value: the output at o took its
  # value from input origin[o], so its tangent is the input's tangent there.
  # That is the forward twin of vjp_selection's scatter, and the bootstrap grew
  # the same jvp in the same change, so the two agree (NEEDS-83).
  if e.op == OpSort or e.op == OpTopK {
    return jet_selection(tp, n, e, js)
  }
  # Softmax has a real second derivative, not a permutation. Its jacobian is
  # y_i(delta_ij - y_j), so jet_softmax carries the tangents through it and its
  # derivative; the bootstrap grew the same jvp in the same change (NEEDS-83).
  if e.op == OpSoftmax { return jet_softmax(tp, n, e, js) }
  # The gradient of logsumexp is softmax, so its first output tangent is the
  # y-weighted mean of the input tangents and its second is that derivative.
  # Both sides recompute y as exp(x - out) to stay bit-identical (NEEDS-83).
  if e.op == OpLogSumExp { return jet_logsumexp(tp, n, e, js) }
  # Median is a selection, locally linear, so its jet gathers the tangent of the
  # element it selects, or averages the two for an even length, with no
  # second-order term of its own. It is the forward twin of vjp_median (NEEDS-83).
  if e.op == OpMedian { return jet_median(tp, n, e, js) }
  # maxpool2d is a selection, locally linear: its jet gathers the tangent of the
  # value that won each window, with no second-order term. The forward twin of
  # vjp_maxpool2d, reading the same winners from iattr (NEEDS-83).
  if e.op == OpMaxPool2D { return jet_maxpool2d(tp, n, e, js) }
  # prod has a genuine second-order term. The first tangent is p * sum(d_k/x_k),
  # the second follows by differentiating it, and zeros split it into cases the
  # same way vjp_prod's backward does: one zero leaves only that factor, two
  # leave only their cross term, three or more leave nothing (NEEDS-83).
  if e.op == OpProd { return jet_prod(tp, n, e, js) }
  # conv2d is bilinear in (input, weight): each output is a sum of products over
  # the receptive field, so the first tangent is the sum of xd*w + x*wd and the
  # second is the bilinear product rule xdd*w + 2*xd*wd + x*wdd. A constant
  # operand has zero tangents, which drops its term (NEEDS-83).
  if e.op == OpConv2D { return jet_conv2d(tp, n, e, js) }
  # Reshape, broadcast, transpose, flip, gather, index, slice and split move
  # numbers without changing them, so their jet is the same rearrangement
  # applied to the tangents. That is one rule, and it is expressed by replaying
  # the forward kernel on the tangent buffers rather than by writing the index
  # arithmetic out a second time per op, which is the part a hand-written
  # version gets wrong.
  if is_rearrangement(e.op) { return jet_rearrangement(tp, n, e, js) }
  Err(jet_unsupported(e.op))
}

# Sort, topk, concat, prod, median, softmax, logsumexp, conv2d and maxpool2d
# are deliberately absent. Each is either a selection made by comparing values,
# which the replay below must not be given, or an op internal/tensor never wired
# a jvp onto either. They report through jet_unsupported rather than propagating
# a zero tangent, so a hessian over one of them says so instead of returning a
# plausible matrix of zeros.
fn is_rearrangement(op: Op) -> Bool {
  if op == OpReshape or op == OpBroadcastTo { return true }
  if op == OpTranspose or op == OpFlip { return true }
  if op == OpGather or op == OpIndex0 { return true }
  if op == OpSlice0 or op == OpSplit { return true }
  false
}

# A rearrangement carries tangents by the same map it carried values by. It is
# obtained by running the op's own vjp *transposed*: for a permutation or a
# selection the forward map and the reverse map are transposes of each other, so
# the tangent of the output at position p is the tangent of whichever input
# position fed it. Rather than invert the vjp, this replays the forward kernel
# on a tensor whose data is the tangent buffer, which is the same numbers by
# construction and cannot drift from the value path.
fn jet_rearrangement(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  # A tangent is a derivative, so it carries the gradient dtype rather than the
  # value's, by the rule `grad_dtype` states. The rearrangement replayed on it
  # only moves elements, so the dtype it is wrapped in is the dtype it keeps.
  let jdt: I64 = grad_dtype(value_of(tp, a).dtype)
  let src_d: Tensor = mk_raw(copy_shape(value_of(tp, a).shape), js.d[a], jdt)
  let src_dd: Tensor = mk_raw(copy_shape(value_of(tp, a).shape), js.dd[a], jdt)
  let out_d: Tensor = replay_rearrangement(tp, e, src_d)?
  let out_dd: Tensor = replay_rearrangement(tp, e, src_dd)?
  let i: I64 = 0
  while i < element_count(e.out.shape) {
    js.d[n][i] = buf.get(out_d.data, out_d.dtype, i)
    js.dd[n][i] = buf.get(out_dd.data, out_dd.dtype, i)
    i = i + 1
  }
  Ok(0)
}

# The 2-jet of concat: concatenate the input tangents the same way the forward
# pass concatenated the values. Each input's tangent buffers are wrapped as a
# tensor of that input's shape at the gradient dtype (a tangent is a derivative,
# so it carries grad_dtype, exactly as jet_rearrangement wraps its one input),
# and the pieces are concatenated in input order along the recorded axis. That is
# internal/tensor/ops.go's Concat jvp written forward instead of as a scatter.
fn jet_concat(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let axis: I64 = e.iattr[0]
  let ds: Arr[Tensor] = arr_new()
  let dds: Arr[Tensor] = arr_new()
  let p: I64 = 0
  while p < len(e.inputs) {
    let a: I64 = e.inputs[p]
    let sh: Arr[I64] = value_of(tp, a).shape
    let jdt: I64 = grad_dtype(value_of(tp, a).dtype)
    push(ds, mk_raw(copy_shape(sh), js.d[a], jdt))
    push(dds, mk_raw(copy_shape(sh), js.dd[a], jdt))
    p = p + 1
  }
  let out_d: Tensor = concat(ds, axis)?
  let out_dd: Tensor = concat(dds, axis)?
  let i: I64 = 0
  while i < element_count(e.out.shape) {
    js.d[n][i] = buf.get(out_d.data, out_d.dtype, i)
    js.dd[n][i] = buf.get(out_dd.data, out_dd.dtype, i)
    i = i + 1
  }
  Ok(0)
}

# The 2-jet of sort and topk. It reads the same selection vjp_selection reads,
# sort_origins, which for output o gives the input index the value came from, and
# gathers the tangents by it: the forward pass carries a tangent wherever it
# carries a value. It is the mirror of vjp_selection: that one scatters the
# output cotangent back to origin[o], this one gathers the input tangent forward
# from origin[o]. topk's origin covers only the kept outputs, so a dropped input
# contributes no tangent, which is correct and matches the backward pass.
fn jet_selection(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let axis: I64 = e.iattr[0]
  let keep: I64 = x.shape[axis]
  let direction: Bool = int_to_bool(e.iattr[1])
  if e.op == OpTopK {
    keep = e.iattr[1]
    direction = int_to_bool(e.iattr[2])
  }
  let origin: Arr[I64] = sort_origins(x, axis, direction, keep)
  let o: I64 = 0
  while o < len(origin) {
    js.d[n][o] = js.d[a][origin[o]]
    js.dd[n][o] = js.dd[a][origin[o]]
    o = o + 1
  }
  Ok(0)
}

# The 2-jet of softmax, per row along its axis. The jacobian is y_i(delta_ij -
# y_j), so the first output tangent is yd_i = y_i(xd_i - s) with s the y-weighted
# mean of the input tangents; the second is that differentiated once more along
# the direction, where sdot is d/dt of s. It reads y from e.out, the softmax
# values the forward pass already stored, and needs no max subtraction because
# the max cancels out of y. This is internal/tensor's Softmax jvp, term for term.
fn jet_softmax(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let y: Tensor = e.out
  let sp: Spans = spans_for(y, e.iattr[0])
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let s: F64 = 0.0
      let k: I64 = 0
      while k < sp.length {
        let o: I64 = base + k * sp.after
        s = s + buf.get(y.data, y.dtype, o) * js.d[a][o]
        k = k + 1
      }
      let sdot: F64 = 0.0
      k = 0
      while k < sp.length {
        let o: I64 = base + k * sp.after
        let yd: F64 = buf.get(y.data, y.dtype, o) * (js.d[a][o] - s)
        js.d[n][o] = yd
        sdot = sdot + yd * js.d[a][o] + buf.get(y.data, y.dtype, o) * js.dd[a][o]
        k = k + 1
      }
      k = 0
      while k < sp.length {
        let o: I64 = base + k * sp.after
        js.dd[n][o] = (js.d[n][o] * (js.d[a][o] - s)) + (buf.get(y.data, y.dtype, o) * (js.dd[a][o] - sdot))
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(0)
}

# The 2-jet of logsumexp, per reduced span. Its gradient is softmax, so the
# first output tangent is s, the y-weighted mean of the input tangents, and the
# second is s differentiated once more along the direction. The output has the
# axis removed, so each span writes one scalar at oi. y is recomputed as
# exp(x - out), not read from a stored softmax, which is what the bootstrap's jvp
# does too so the two agree, and the same form vjp_logsumexp already uses.
fn jet_logsumexp(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let sp: Spans = spans_for(x, e.iattr[0])
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let oi: I64 = i * sp.after + j
      let base: I64 = i * sp.length * sp.after + j
      let lse: F64 = buf.get(e.out.data, e.out.dtype, oi)
      let s: F64 = 0.0
      let k: I64 = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        s = s + f64_exp(buf.get(x.data, x.dtype, p) - lse) * js.d[a][p]
        k = k + 1
      }
      let ldd: F64 = 0.0
      k = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        let y: F64 = f64_exp(buf.get(x.data, x.dtype, p) - lse)
        ldd = ldd + (y * ((js.d[a][p] * (js.d[a][p] - s)) + js.dd[a][p]))
        k = k + 1
      }
      js.d[n][oi] = s
      js.dd[n][oi] = ldd
      j = j + 1
    }
    i = i + 1
  }
  Ok(0)
}

# The 2-jet of median. Median selects the middle element, or averages the two
# when the axis is even, and is linear in a neighbourhood of the point, so a
# tangent rides with the value it selects and there is no term of its own. This
# gathers where vjp_median scatters: it reads the same lo and hi from median_over
# and carries the input's first and second tangents through to the output.
fn jet_median(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let ai: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, ai)
  let sp: Spans = spans_for(x, e.iattr[0])
  let aux: MedianAux = median_over(x, sp.length, sp.before, sp.after)
  let idx: I64 = 0
  while idx < len(aux.out) {
    if aux.lo[idx] == aux.hi[idx] {
      js.d[n][idx] = js.d[ai][aux.lo[idx]]
      js.dd[n][idx] = js.dd[ai][aux.lo[idx]]
    } else {
      js.d[n][idx] = (js.d[ai][aux.lo[idx]] + js.d[ai][aux.hi[idx]]) / 2.0
      js.dd[n][idx] = (js.dd[ai][aux.lo[idx]] + js.dd[ai][aux.hi[idx]]) / 2.0
    }
    idx = idx + 1
  }
  Ok(0)
}

# The 2-jet of maxpool2d. It selects the largest value in each window and is
# linear in a neighbourhood of the point, so a tangent rides with the value that
# won and there is no second-order term. This gathers where vjp_maxpool2d
# scatters, reading the same winners from iattr, whose first entry is the window
# so the winner of output o is iattr[o + 1].
fn jet_maxpool2d(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let o: I64 = 0
  while o < element_count(e.out.shape) {
    let src: I64 = e.iattr[o + 1]
    js.d[n][o] = js.d[a][src]
    js.dd[n][o] = js.dd[a][src]
    o = o + 1
  }
  Ok(0)
}

# The 2-jet of prod, per reduced span, split by the zero count the same way
# vjp_prod splits the backward. With no zeros the first tangent is p times the
# sum of d_k/x_k and the second is p*(u*u + v - w); with one zero at q only that
# factor's derivative survives; with two, only their cross term; with three or
# more, nothing. It recomputes the products through prod_over, the way vjp_prod
# does, so the zero count and nz product are the ones the forward pass had.
fn jet_prod(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let sp: Spans = spans_for(x, e.iattr[0])
  let aux: ProdAux = prod_over(x, sp.length, sp.before, sp.after, acc_dtype(x.dtype))
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let idx: I64 = i * sp.after + j
      let base: I64 = i * sp.length * sp.after + j
      let p: F64 = aux.out[idx]
      let nz: F64 = aux.nz_prod[idx]
      let z: I64 = aux.zeros[idx]
      if z == 0 {
        let u: F64 = 0.0
        let v: F64 = 0.0
        let w: F64 = 0.0
        let k: I64 = 0
        while k < sp.length {
          let pk: I64 = base + k * sp.after
          let rk: F64 = js.d[a][pk] / buf.get(x.data, x.dtype, pk)
          u = u + rk
          v = v + (js.dd[a][pk] / buf.get(x.data, x.dtype, pk))
          w = w + (rk * rk)
          k = k + 1
        }
        js.d[n][idx] = p * u
        js.dd[n][idx] = p * (((u * u) + v) - w)
      } else {
        if z == 1 {
          let q: I64 = 0 - 1
          let r: F64 = 0.0
          let k: I64 = 0
          while k < sp.length {
            let pk: I64 = base + k * sp.after
            if buf.get(x.data, x.dtype, pk) == 0.0 {
              q = pk
            } else {
              r = r + (js.d[a][pk] / buf.get(x.data, x.dtype, pk))
            }
            k = k + 1
          }
          js.d[n][idx] = nz * js.d[a][q]
          js.dd[n][idx] = (2.0 * nz * js.d[a][q] * r) + (nz * js.dd[a][q])
        } else {
          if z == 2 {
            let q1: I64 = 0 - 1
            let q2: I64 = 0 - 1
            let k: I64 = 0
            while k < sp.length {
              let pk: I64 = base + k * sp.after
              if buf.get(x.data, x.dtype, pk) == 0.0 {
                if q1 < 0 {
                  q1 = pk
                } else {
                  q2 = pk
                }
              }
              k = k + 1
            }
            js.d[n][idx] = 0.0
            js.dd[n][idx] = 2.0 * nz * js.d[a][q1] * js.d[a][q2]
          } else {
            js.d[n][idx] = 0.0
            js.dd[n][idx] = 0.0
          }
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(0)
}

# The 2-jet of conv2d, over the same loop the forward pass runs. conv is bilinear
# in the input and the weight, so each output's first tangent is the sum over its
# receptive field of xd*w + x*wd, and its second is the bilinear product rule,
# xdd*w + 2*xd*wd + x*wdd. It reads both operands' tangents; a constant operand's
# are zero and its term drops, so the one form serves whichever carries a jet.
fn jet_conv2d(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let ain: I64 = e.inputs[0]
  let awt: I64 = e.inputs[1]
  let input: Tensor = value_of(tp, ain)
  let weight: Tensor = value_of(tp, awt)
  let cin: I64 = input.shape[0]
  let h: I64 = input.shape[1]
  let w: I64 = input.shape[2]
  let cout: I64 = weight.shape[0]
  let kh: I64 = weight.shape[2]
  let kw: I64 = weight.shape[3]
  let oh: I64 = h - kh + 1
  let ow: I64 = w - kw + 1
  let hw: I64 = h * w
  let khw: I64 = kh * kw
  let cinkhw: I64 = cin * khw
  let ohw: I64 = oh * ow
  let co: I64 = 0
  while co < cout {
    let i: I64 = 0
    while i < oh {
      let j: I64 = 0
      while j < ow {
        let sd: F64 = 0.0
        let sdd: F64 = 0.0
        let ci: I64 = 0
        while ci < cin {
          let a: I64 = 0
          while a < kh {
            let b: I64 = 0
            while b < kw {
              let in_idx: I64 = ci * hw + (i + a) * w + (j + b)
              let w_idx: I64 = co * cinkhw + ci * khw + a * kw + b
              let x: F64 = buf.get(input.data, input.dtype, in_idx)
              let wv: F64 = buf.get(weight.data, weight.dtype, w_idx)
              let xd: F64 = js.d[ain][in_idx]
              let xdd: F64 = js.dd[ain][in_idx]
              let wd: F64 = js.d[awt][w_idx]
              let wdd: F64 = js.dd[awt][w_idx]
              sd = sd + ((xd * wv) + (x * wd))
              sdd = sdd + (((xdd * wv) + (2.0 * xd * wd)) + (x * wdd))
              b = b + 1
            }
            a = a + 1
          }
          ci = ci + 1
        }
        let oi: I64 = co * ohw + i * ow + j
        js.d[n][oi] = sd
        js.dd[n][oi] = sdd
        j = j + 1
      }
      i = i + 1
    }
    co = co + 1
  }
  Ok(0)
}

# The forward kernel of a rearrangement, applied to a buffer that is not the
# value. Every case reads its parameters from the tape entry rather than
# recomputing them, so a normalized axis stays normalized.
fn replay_rearrangement(tp: Tape, e: TapeEntry, src: Tensor) -> Res[Tensor, Str] {
  if e.op == OpReshape { return reshape(src, copy_shape(e.out.shape)) }
  if e.op == OpBroadcastTo { return broadcast_to(src, copy_shape(e.out.shape)) }
  if e.op == OpTranspose { return transpose(src, e.iattr) }
  if e.op == OpFlip { return flip_axis(src, e.iattr[0]) }
  if e.op == OpGather { return gather(src, e.iattr) }
  if e.op == OpIndex0 { return index_axis0(src, e.iattr[0]) }
  if e.op == OpSlice0 { return slice_axis0(src, e.iattr[0], e.iattr[1]) }
  if e.op == OpSplit {
    return split_piece(src, e.iattr[0], e.iattr[1], e.iattr[2])
  }
  Err(jet_unsupported(e.op))
}

# cummax and cummin select by comparing *values*, so the selection is taken from
# the values and only then applied to the tangents. Replaying the kernel on the
# tangent buffer instead would scan the tangents, which is a different and wrong
# answer, and it is the mistake routing these through jet_rearrangement would
# make silently.
fn jet_select_by_value(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let sp: Spans = spans_for(x, e.iattr[0])
  let out: Arr[F64] = alloc(element_count(x.shape))
  let arg: Arr[I64] = alloc_ints(element_count(x.shape))
  scan_run(e.op, x, sp, out, arg, acc_dtype(x.dtype))
  let p: I64 = 0
  while p < element_count(x.shape) {
    js.d[n][p] = js.d[a][arg[p]]
    js.dd[n][p] = js.dd[a][arg[p]]
    p = p + 1
  }
  Ok(0)
}

# where picks from its second or third input by the truth of its first, and
# never differentiates through the condition: a selector changes nothing until
# it crosses, and at the crossing it is not differentiable at all. So the
# tangent is whichever branch's tangent the value itself came from.
fn jet_where(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let cond: Tensor = value_of(tp, e.inputs[0])
  let i: I64 = 0
  while i < element_count(e.out.shape) {
    let idx: Arr[I64] = unravel(e.out.shape, i)
    let src: I64 = e.inputs[1]
    if buf.get(cond.data, cond.dtype, broadcast_offset(cond.shape, idx)) == 0.0 { src = e.inputs[2] }
    let off: I64 = broadcast_offset(value_of(tp, src).shape, idx)
    js.d[n][i] = js.d[src][off]
    js.dd[n][i] = js.dd[src][off]
    i = i + 1
  }
  Ok(0)
}

# The multi-dimensional index of a flat offset, needed only by the where case
# above, which has to broadcast three shapes against each other.
fn unravel(shape: Arr[I64], flat: I64) -> Arr[I64] {
  let st: Arr[I64] = strides_of(shape)
  let idx: Arr[I64] = arr_new()
  let rem: I64 = flat
  let i: I64 = 0
  while i < len(shape) {
    push(idx, rem / st[i])
    rem = rem % st[i]
    i = i + 1
  }
  idx
}

fn jet_unary(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let p0: F64 = 0.0
  let p1: F64 = 0.0
  if len(e.fattr) > 0 { p0 = e.fattr[0] }
  if len(e.fattr) > 1 { p1 = e.fattr[1] }
  let i: I64 = 0
  while i < element_count(e.out.shape) {
    let xv: F64 = buf.get(x.data, x.dtype, i)
    let ov: F64 = buf.get(e.out.data, e.out.dtype, i)
    let f1: F64 = d_unary(e.op, xv, ov, p0, p1)
    let f2: F64 = d2_unary(e.op, xv, ov, p0, p1)
    let dx: F64 = js.d[a][i]
    js.d[n][i] = f1 * dx
    js.dd[n][i] = f1 * js.dd[a][i] + f2 * dx * dx
    i = i + 1
  }
  Ok(0)
}

# The broadcast offsets are recomputed per element rather than carried in an
# odometer, which is the slow and obviously correct choice. OPTIMISATION, not
# taken: jetBinary in the bootstrap walks the two inputs with effective strides
# and no division at all.
fn jet_binary(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let ai: I64 = e.inputs[0]
  let bi: I64 = e.inputs[1]
  let a: Tensor = value_of(tp, ai)
  let b: Tensor = value_of(tp, bi)
  let i: I64 = 0
  while i < element_count(e.out.shape) {
    let idx: Arr[I64] = unravel(e.out.shape, i)
    let oa: I64 = broadcast_offset(a.shape, idx)
    let ob: I64 = broadcast_offset(b.shape, idx)
    let x: F64 = buf.get(a.data, a.dtype, oa)
    let y: F64 = buf.get(b.data, b.dtype, ob)
    let ov: F64 = buf.get(e.out.data, e.out.dtype, i)
    let dx: F64 = js.d[ai][oa]
    let dy: F64 = js.d[bi][ob]
    let fa: F64 = d_binary_a(e.op, x, y, ov)
    let fb: F64 = d_binary_b(e.op, x, y, ov)
    js.d[n][i] = fa * dx + fb * dy
    js.dd[n][i] = fa * js.dd[ai][oa] + fb * js.dd[bi][ob] +
      d2_binary_aa(e.op, x, y, ov) * dx * dx +
      2.0 * d2_binary_ab(e.op, x, y, ov) * dx * dy +
      d2_binary_bb(e.op, x, y, ov) * dy * dy
    i = i + 1
  }
  Ok(0)
}

# A sum is linear, so the tangent of the sum is the sum of the tangents, at both
# orders and with no second-order term at all. Mean is the same divided by the
# run length.
fn jet_sum_mean(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let sp: Spans = spans_for(x, e.iattr[0])
  let scale: F64 = 1.0
  if e.op == OpMean { scale = 1.0 / f64_of_i64(sp.length) }
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let o: I64 = i * sp.after + j
      let sd: F64 = 0.0
      let sdd: F64 = 0.0
      let k: I64 = 0
      while k < sp.length {
        sd = sd + js.d[a][base + k * sp.after]
        sdd = sdd + js.dd[a][base + k * sp.after]
        k = k + 1
      }
      js.d[n][o] = sd * scale
      js.dd[n][o] = sdd * scale
      j = j + 1
    }
    i = i + 1
  }
  Ok(0)
}

# A matmul is bilinear: d(AB) = dA B + A dB, and differentiating that once more
# leaves only the cross term, dd(AB) = ddA B + 2 dA dB + A ddB. The 2 is the
# same factor jet_binary carries on its cross term and for the same reason.
fn jet_matmul(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let ai: I64 = e.inputs[0]
  let bi: I64 = e.inputs[1]
  let a: Tensor = value_of(tp, ai)
  let b: Tensor = value_of(tp, bi)
  # Tangents at the gradient dtype, so the matmuls below accumulate at f32 for a
  # bf16 forward instead of inheriting bf16 from the values.
  let adt: I64 = grad_dtype(a.dtype)
  let bdt: I64 = grad_dtype(b.dtype)
  let da: Tensor = mk_raw(copy_shape(a.shape), js.d[ai], adt)
  let db: Tensor = mk_raw(copy_shape(b.shape), js.d[bi], bdt)
  let dda: Tensor = mk_raw(copy_shape(a.shape), js.dd[ai], adt)
  let ddb: Tensor = mk_raw(copy_shape(b.shape), js.dd[bi], bdt)
  let t1: Tensor = matmul(da, b)?
  let t2: Tensor = matmul(a, db)?
  let s1: Tensor = matmul(dda, b)?
  let s2: Tensor = matmul(da, db)?
  let s3: Tensor = matmul(a, ddb)?
  let i: I64 = 0
  while i < element_count(e.out.shape) {
    js.d[n][i] = buf.get(t1.data, t1.dtype, i) + buf.get(t2.data, t2.dtype, i)
    js.dd[n][i] = buf.get(s1.data, s1.dtype, i) + 2.0 * buf.get(s2.data, s2.dtype, i) + buf.get(s3.data, s3.dtype, i)
    i = i + 1
  }
  Ok(0)
}

# cumsum is linear, so its jet is cumsum of the tangents at both orders.
fn jet_cumsum(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let sp: Spans = spans_for(x, e.iattr[0])
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let rd: F64 = 0.0
      let rdd: F64 = 0.0
      let k: I64 = 0
      while k < sp.length {
        rd = rd + js.d[a][base + k * sp.after]
        rdd = rdd + js.dd[a][base + k * sp.after]
        js.d[n][base + k * sp.after] = rd
        js.dd[n][base + k * sp.after] = rdd
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(0)
}

# cumprod is out[j] = out[j-1] * in[j], so its jet is the product rule carried
# along the run: d = d(prev)*x + prev*dx, and dd by differentiating that again,
# dd = dd(prev)*x + 2 d(prev) dx + prev*ddx. The same factor of 2 on the cross
# term as everywhere else in this section, and the same one to lose.
fn jet_cumprod(tp: Tape, n: I64, e: TapeEntry, js: Jets) -> Res[I64, Str] {
  let a: I64 = e.inputs[0]
  let x: Tensor = value_of(tp, a)
  let sp: Spans = spans_for(x, e.iattr[0])
  let i: I64 = 0
  while i < sp.before {
    let j: I64 = 0
    while j < sp.after {
      let base: I64 = i * sp.length * sp.after + j
      let prev: F64 = 1.0
      let d_prev: F64 = 0.0
      let dd_prev: F64 = 0.0
      let k: I64 = 0
      while k < sp.length {
        let p: I64 = base + k * sp.after
        let xv: F64 = buf.get(x.data, x.dtype, p)
        let dx: F64 = js.d[a][p]
        let ddx: F64 = js.dd[a][p]
        let d: F64 = d_prev * xv + prev * dx
        let dd: F64 = dd_prev * xv + 2.0 * d_prev * dx + prev * ddx
        js.d[n][p] = d
        js.dd[n][p] = dd
        prev = buf.get(e.out.data, e.out.dtype, p)
        d_prev = d
        dd_prev = dd
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  Ok(0)
}

# hessian: the n by n second derivative of a scalar output with respect to the
# leaf, by forward-mode 2-jets.
#
# The diagonal comes straight out: seeding direction e_i gives dd = e_i' H e_i,
# which is H[i][i]. The off-diagonals come by polarization, seeding e_i + e_j:
#
#   dd = (e_i + e_j)' H (e_i + e_j) = H[i][i] + 2 H[i][j] + H[j][j]
#
# so H[i][j] is that minus the two diagonal entries, halved. The result is
# symmetrised by construction rather than by averaging two computed halves,
# which is what makes a Hessian that is exactly symmetric rather than symmetric
# to within rounding.
#
# OPTIMISATION, not taken: this is n(n+1)/2 forward passes. Reverse-over-forward
# would need n, and is a different engine.
fn hessian(tp: Tape, root: I64, leaf: I64) -> Res[Tensor, Str] {
  let n: I64 = element_count(value_of(tp, leaf).shape)
  let shape: Arr[I64] = arr_new()
  push(shape, n)
  push(shape, n)
  # A root of -1 is f ignoring its argument, and a root before the leaf cannot
  # depend on it. Zeros rather than an error, for the reason
  # internal/tensor/jet.go gives: a function the output does not depend on
  # differentiably has an all-zero second derivative, floor is piecewise
  # constant so its true Hessian is zero, and grad already answers zeros for the
  # same expression. Erring here would make hessian stricter than grad.
  let hdt: I64 = grad_dtype(value_of(tp, leaf).dtype)
  if root < 0 or root < leaf {
    return Ok(mk_raw(shape, alloc(n * n), hdt))
  }
  if not is_scalar(tp.entries[root].out) {
    return Err("hessian: the function must return a scalar")
  }
  let h: Arr[F64] = alloc(n * n)
  let diag: Arr[F64] = alloc(n)
  let e: Arr[F64] = alloc(n)
  let i: I64 = 0
  while i < n {
    let z: I64 = 0
    while z < n {
      e[z] = 0.0
      z = z + 1
    }
    e[i] = 1.0
    let js: Jets = jet_forward(tp, root, leaf, e)?
    diag[i] = js.dd[root][0]
    h[i * n + i] = js.dd[root][0]
    i = i + 1
  }
  i = 0
  while i < n {
    let j: I64 = i + 1
    while j < n {
      let z: I64 = 0
      while z < n {
        e[z] = 0.0
        z = z + 1
      }
      e[i] = 1.0
      e[j] = 1.0
      let js: Jets = jet_forward(tp, root, leaf, e)?
      let v: F64 = (js.dd[root][0] - diag[i] - diag[j]) / 2.0
      h[i * n + j] = v
      h[j * n + i] = v
      j = j + 1
    }
    i = i + 1
  }
  # A Hessian is a second derivative and takes the gradient dtype for the same
  # reason a gradient does, with more of it: the divided difference above
  # subtracts two nearly equal numbers, which is where precision is lost fastest.
  Ok(mk(shape, h, hdt))
}

# jet_forward_multi seeds several leaves in one forward sweep, which is what a
# jvp over a parameter tree needs: `jvp(loss)({w: ..., b: ...}, {w: ..., b: ...})`
# has one leaf per field and one tangent per leaf, and they all travel together
# in a single pass.
#
# The single-leaf jet_forward above is this with one entry, kept separate only
# because hessian calls it in a loop and reads better for it.
fn jet_forward_multi(tp: Tape, root: I64, leaves: Arr[I64], vs: Arr[Arr[F64]]) -> Res[Jets, Str] {
  let js: Jets = jets_new(tp)
  let k: I64 = 0
  while k < len(leaves) {
    let l: I64 = leaves[k]
    let v: Arr[F64] = vs[k]
    let i: I64 = 0
    # A leaf the output does not reach, or a tangent longer than the leaf, is
    # trimmed here rather than refused: the caller has already checked the
    # shapes, and a leaf past the root contributes nothing to the sweep.
    while i < len(v) and i < len(js.d[l]) {
      js.d[l][i] = v[i]
      i = i + 1
    }
    k = k + 1
  }
  # A leaf entry has no inputs, so jet_node returns without touching its tangent
  # and the seeding above survives the sweep. That is why this loop, unlike
  # jet_forward's, does not need to skip the leaves by index.
  let n: I64 = 0
  while n <= root {
    jet_node(tp, n, js)?
    n = n + 1
  }
  Ok(js)
}

# hessian_vector: H v for a scalar output, without forming the n by n matrix.
#
# Polarization one step further out than hessian's. A forward 2-jet in direction
# u gives the scalar u' H u, so
#
#   (e_i + v)' H (e_i + v) = e_i' H e_i + 2 e_i' H v + v' H v
#
# and component i of H v is (dd(e_i + v) - dd(e_i) - dd(v)) / 2.
#
# THE COST, PLAINLY. 2n+1 forward passes, not the single forward-over-reverse
# pass JAX charges for the same product. Decision 2 in docs/DECISIONS.md is the
# reason: the reverse pass is not re-differentiable, so the gradient cannot be
# sent through forward mode, and the forward 2-jet is the only exact
# second-order machinery there is. What it does buy over hessian(f)(x) @ v is
# real: n(n+1)/2 passes become 2n+1, and the n by n result is never allocated.
fn hessian_vector(tp: Tape, root: I64, leaf: I64, v: Arr[F64]) -> Res[Tensor, Str] {
  let lt: Tensor = value_of(tp, leaf)
  let n: I64 = element_count(lt.shape)
  let hdt: I64 = grad_dtype(lt.dtype)
  if len(v) != n {
    return Err(bytes.concat("hvp: the direction has ",
      bytes.concat(num_to_text(len(v)), bytes.concat(" elements but the input has ",
        num_to_text(n)))))
  }
  # A root of -1 is f ignoring its argument, and a root before the leaf cannot
  # depend on it. Zeros rather than an error, for the reason hessian gives.
  if root < 0 or root < leaf {
    return Ok(mk_raw(copy_shape(lt.shape), alloc(n), hdt))
  }
  if not is_scalar(tp.entries[root].out) {
    return Err("hvp: the function must return a scalar")
  }
  let jv: Jets = jet_forward(tp, root, leaf, v)?
  let vhv: F64 = jv.dd[root][0]
  let out: Arr[F64] = alloc(n)
  let e: Arr[F64] = alloc(n)
  let i: I64 = 0
  while i < n {
    let z: I64 = 0
    while z < n {
      e[z] = 0.0
      z = z + 1
    }
    e[i] = 1.0
    let ji: Jets = jet_forward(tp, root, leaf, e)?
    let eihei: F64 = ji.dd[root][0]
    z = 0
    while z < n {
      e[z] = v[z]
      z = z + 1
    }
    e[i] = 1.0 + v[i]
    let jm: Jets = jet_forward(tp, root, leaf, e)?
    out[i] = (jm.dd[root][0] - eihei - vhv) / 2.0
    i = i + 1
  }
  Ok(mk(copy_shape(lt.shape), out, hdt))
}
