mode systems

# check.tw: the twill shape checker, in twill.
#
# A port of internal/checker/checker.go. The policy is the one that file states
# in its package comment and it is worth restating, because every decision below
# follows from it and none of them makes sense without it:
#
#   The checker is best effort. It infers shapes where it can and reports a
#   diagnostic only when a mismatch is *certain*, meaning both operand shapes
#   are fully known and incompatible. Anything it cannot determine stays
#   Unknown, so dynamic code never produces a false alarm.
#
# That is the right policy for numeric twill and the wrong one for a compiler.
# docs/self-hosting.md section 1.3 changes it in systems mode: there a
# `TUnknown` surviving to the end of inference is a diagnostic rather than
# silence. Same lattice, opposite policy. This file implements the numeric
# policy, because that is what the corpus in testdata/ was generated against and
# what the diagnostics are compared to. The systems policy is NEEDS-49.
#
# A note on why so many paths return TUnknown after reporting nothing: each one
# is a decision that the checker cannot prove a mistake, not an oversight. Where
# the Go file explains a particular silence, that explanation is carried across
# rather than summarised, because the silence is the part a later reader will
# want to change and the reason is the part that stops them.

import "ast.tw" as ast
import "bytes.tw" as bytes
import "tensor.tw" as tensor
import "builtins.tw" as builtins

# ---- diagnostics -----------------------------------------------------------

# Severity uses the same codes as src/cli/diagnostic.tw, so a renderer can pass
# it through without translating. Nearly everything here is an error: a shape
# or unit the program cannot have. The one warning, dtype widening in
# promote_and_warn, is different in kind: the program means what it says and
# will run, it will just run wider than the narrow operand was chosen for.
# main.tw does not yet read the severity when it decides whether to run.
let SEV_ERROR: I64 = 0
let SEV_WARNING: I64 = 1

struct Diagnostic {
  msg: Str,
  line: I64,
  severity: I64,
}

# ---- types -----------------------------------------------------------------

# A dtype the checker cannot name. -1 is outside every tensor.DT_* code, and
# everything downstream treats it the way an unknown dimension is treated:
# promotion with an unknown side is unknown, and no diagnostic ever fires on
# one. Unknown is the common case on purpose, because most code never writes a
# dtype, and a checker that claimed f64 everywhere would be claiming things
# the dtype work in eval.tw is still deciding.
let DT_UNKNOWN: I64 = -1

fn dtype_known(dt: I64) -> Bool = dt >= 0

# dims: -1 means an unknown size; an empty list is a scalar.
# unit is the quantity's physical unit; an empty map is dimensionless.
# dtype is a tensor.DT_* code, or DT_UNKNOWN when the checker cannot name it.
struct TensorType {
  dims: Arr[I64],
  unit: Dict[Str, I64],
  dtype: I64,
}

# elems absent means "a list whose contents are unknown", which is different
# from a list known to be empty. The distinction decides whether concat can say
# anything, so it cannot be collapsed to an empty array.
struct ListType {
  elems: Opt[Arr[Type]],
}

# name is the declared struct's name, or "" for a bare record literal. A
# nominal record only stands where the same name is declared.
struct RecordType {
  fields: Dict[Str, Type],
  name: Str,
  # The type arguments a generic struct was used with: the I64 in `Box[I64]`.
  # Empty for every non-generic struct, which is what keeps two of those
  # comparing by name exactly as they did before 1.7.
  args: Arr[Opt[Type]],
}

# ---- systems-mode types ----------------------------------------------------
#
# The systems dialect names types the numeric lattice above has no case for:
# I64, Bytes, Arr[T], Dict[K, V], the enums, a variant constructor before its
# argument, and a declared function type. They mirror internal/checker/
# systems.go one for one, because the two checkers' diagnostics are compared
# byte for byte.
#
# A None payload is the Go side's nil: a container whose element type is not
# known. That is different from a known-unknown element, which prints, so the
# distinction cannot be collapsed into TUnknown.

# Arr[T]. elem None is an array whose element type is not known.
struct ArrType {
  elem: Opt[Type],
}

# Dict[K, V]; key or val None when not known.
struct DictType {
  key: Opt[Type],
  val: Opt[Type],
}

# A value of an enum: Opt[T], Res[T, E], or a user enum by name. args are the
# type arguments, each None when not known.
struct EnumType {
  name: Str,
  args: Arr[Opt[Type]],
}

struct ParamType { name: Str }

# A payload-carrying variant constructor as a value: calling it yields the
# enum. `Some` before its argument is one.
struct CtorType {
  owner: Str,
  variant: Str,
  payload: Opt[Type],
}

# A declared function type, `fn(I64) -> F64`: what a parameter or a field
# annotated with one holds. Distinct from FnType, whose body is known.
struct FnTypeAnno {
  params: Arr[Type],
  ret: Type,
}

# TupleType is `(F64, F64)`: a fixed-arity positional group. Its arity is part
# of its identity -- a 2-tuple is not a 3-tuple -- and so is the order of its
# elements, since nothing names them. There is no nominal tuple type and no
# field access, so this is the whole of what the checker can know about one: how
# many values, and what each is. See docs/roadmap.md entry 1.
struct TupleType {
  elems: Arr[Type],
}

# node_id rather than a node handle: the recursion guard needs identity and
# serial numbers give it without making heap identity a language feature. See
# NEEDS-21 and the comment in ast.tw.
struct FnType {
  node_id: I64,
  params: Arr[ast.Param],
  ret: Opt[ast.ShapeAnno],
  ret_unit: Opt[ast.UnitAnno],
  # The named return type as text (`-> Res[Str]`, `-> I64`), or "". Read by the
  # `?` rule, which needs the annotation as written.
  ret_type: Str,
  body: ast.Expr,
  env: CheckEnv,
}

struct BuiltinType {
  name: Str,
}

enum Type {
  TTensor(TensorType),
  TUnknown,
  TBool,
  TStr,
  TUnit,
  TList(ListType),
  TRecord(RecordType),
  TFn(FnType),
  TBuiltin(BuiltinType),
  TInt,
  TBytes,
  TArr(ArrType),
  TDict(DictType),
  TEnum(EnumType),
  TCtor(CtorType),
  TFnType(FnTypeAnno),
  TTuple(TupleType),
  # A declaration's type parameter -- the T in `struct Box[T]` -- standing for a
  # type the declaration does not name. It survives only inside the declaration
  # it belongs to: at a use site the parameters are substituted for the
  # arguments written there, so a Box[I64]'s value field is an I64 and never a
  # TParam. One reaching a judgement means the use site did not say what T is,
  # and it judges nothing, the way an unknown does.
  TParam(ParamType),
}

fn no_unit() -> Dict[Str, I64] = dict_new()

# scalar is a rank-0 tensor of unknown dtype. Deliberately unknown and not
# f64: what a bare number literal lands as when it meets a narrow tensor is
# exactly NEEDS-113's open second example (`i32_tensor / 2`), and claiming
# f64 here would turn every `w * 0.01` on narrow weights into a warning
# today and into a wrong one the day literals learn to adapt. Unknown says
# nothing, which is the policy.
fn scalar() -> Type = TTensor(TensorType { dims: arr_new(), unit: no_unit(), dtype: DT_UNKNOWN })

fn tensor_of(dims: Arr[I64]) -> Type =
  TTensor(TensorType { dims: dims, unit: no_unit(), dtype: DT_UNKNOWN })

fn tensor_with_unit(dims: Arr[I64], u: Dict[Str, I64]) -> Type =
  TTensor(TensorType { dims: dims, unit: u, dtype: DT_UNKNOWN })

fn tensor_with_dtype(dims: Arr[I64], dt: I64) -> Type =
  TTensor(TensorType { dims: dims, unit: no_unit(), dtype: dt })

fn as_tensor(t: Type) -> Opt[TensorType] {
  match t {
    TTensor(v) => Some(v),
    _ => None,
  }
}

fn is_scalar(t: TensorType) -> Bool = len(t.dims) == 0

fn fully_known(t: TensorType) -> Bool {
  let i: I64 = 0
  while i < len(t.dims) {
    if t.dims[i] < 0 { return false }
    i = i + 1
  }
  true
}

fn dims_string(t: TensorType) -> Str {
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(t.dims) {
    if t.dims[i] < 0 {
      push(parts, "_")
    } else {
      push(parts, str(t.dims[i]))
    }
    i = i + 1
  }
  bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]"))
}

# A definite non-tensor operand to arithmetic is a type error rather than an
# unknown. TUnknown is missing from this list on purpose: it is the whole
# best-effort escape hatch.
fn is_definite_non_tensor(t: Type) -> Bool {
  match t {
    TBool => true,
    TStr => true,
    TUnit => true,
    TList(_) => true,
    TRecord(_) => true,
    TFn(_) => true,
    TBuiltin(_) => true,
    TArr(_) => true,
    TDict(_) => true,
    TEnum(_) => true,
    TBytes => true,
    TCtor(_) => true,
    TFnType(_) => true,
    TTuple(_) => true,
    _ => false,
  }
}

fn is_str_type(t: Type) -> Bool {
  match t {
    TStr => true,
    _ => false,
  }
}

fn is_unknown_type(t: Type) -> Bool {
  match t {
    TUnknown => true,
    _ => false,
  }
}

# ---- dtypes ----------------------------------------------------------------
#
# The checker mirrors tensor.promote by calling it, never by restating it: a
# second copy of the lattice is how the static answer and the runtime answer
# drift apart. Everything here degrades to DT_UNKNOWN rather than guessing,
# for the same reason a dimension degrades to -1.

# set_dtype attaches a dtype to a tensor result and leaves anything else
# alone, the same shape as with_unit.
fn set_dtype(res: Type, dt: I64) -> Type {
  match as_tensor(res) {
    Some(t) => TTensor(TensorType { dims: t.dims, unit: t.unit, dtype: dt }),
    None => res,
  }
}

# promote_dtype is tensor.promote lifted over unknowns: an unknown side makes
# an unknown answer, and nothing is reported.
fn promote_dtype(a: I64, b: I64) -> I64 {
  if not dtype_known(a) or not dtype_known(b) { return DT_UNKNOWN }
  tensor.promote(a, b)
}

# promote_and_warn is promote_dtype plus the one warning this file emits: a
# narrow float silently widened by a wider one. `bf16_weights + f64_bias` is
# f64, which is a perfectly correct answer that undoes the reason the weights
# were narrow, and the checker is the only place it can be seen before it
# runs (NEEDS-113). It is a warning and not an error: the program means what
# it says.
#
# Only a float widened by a wider float qualifies. An integer meeting a float
# keeps the float unchanged, which is the lattice doing its job, and f16
# meeting bf16 promotes past both to f32, where neither operand was the wider
# one. Both stay silent.
fn promote_and_warn(c: Checker, line: I64, a: I64, b: I64) -> I64 {
  let dt: I64 = promote_dtype(a, b)
  if not dtype_known(dt) { return dt }
  if a == b { return dt }
  if not tensor.is_float_dtype(a) or not tensor.is_float_dtype(b) { return dt }
  if dt != a and dt != b { return dt }
  let narrow: I64 = a
  if dt == a { narrow = b }
  warn(c, line, bytes.concat("dtype widening: ", bytes.concat(tensor.dtype_name(a),
    bytes.concat(" and ", bytes.concat(tensor.dtype_name(b),
    bytes.concat(" promote to ", bytes.concat(tensor.dtype_name(dt),
    bytes.concat(", which undoes the reason the ", bytes.concat(tensor.dtype_name(narrow),
    " operand is narrow")))))))))
  dt
}

# float_result_dtype is the dtype of an operation that cannot return an
# integer: exp, sqrt, mean and their kin. The runtime promotes an integer
# input to f32 (tensor.unary_result_dtype). The checker instead declines to
# know it: claiming f32 would be true, and it would also let the widening
# warning fire on a program that never wrote a dtype, through a chain like
# exp(argmax(x)) meeting an ordinary f64. Zero new diagnostics on dtype-free
# programs is the harder promise, so an integer input degrades to unknown.
fn float_result_dtype(dt: I64) -> I64 {
  if not dtype_known(dt) { return DT_UNKNOWN }
  if tensor.is_int_dtype(dt) { return DT_UNKNOWN }
  dt
}

# The dtype named by an argument, or DT_UNKNOWN when the argument is not a
# dtype name. It is the checker's copy of eval.tw's contextual rule and reads
# a name as a dtype under exactly the same three conditions: the argument is a
# bare identifier, tensor.dtype_of_name knows it, and the environment does
# not. The last condition is what keeps `f32` an ordinary identifier
# everywhere it is bound to a value, so `let f32 = x; zeros(f32)` is a shape
# and not a dtype, matching how the program will actually run.
fn dtype_token(env: CheckEnv, e: ast.Expr) -> I64 {
  match e {
    EIdent(id) => {
      match env_get(env, id.name) {
        Some(_) => DT_UNKNOWN,
        None => {
          match tensor.dtype_of_name(id.name) {
            Some(dt) => dt,
            None => DT_UNKNOWN,
          }
        },
      }
    },
    _ => DT_UNKNOWN,
  }
}

# ---- units -----------------------------------------------------------------
#
# A unit is base name to integer exponent. Units are checked statically and
# erased at runtime, so nothing here affects what a program computes; it only
# decides whether the program is allowed to say it.

fn unit_clean(u: Dict[Str, I64]) -> Dict[Str, I64] {
  let out: Dict[Str, I64] = dict_new()
  for name in dict_keys(u) {
    let v: I64 = dict_must(u, name)
    if v != 0 {
      dict_set(out, name, v)
    }
  }
  out
}

fn unit_equal(a: Dict[Str, I64], b: Dict[Str, I64]) -> Bool {
  if len(a) != len(b) { return false }
  for name in dict_keys(a) {
    match dict_get(b, name) {
      Some(v) => {
        if v != dict_must(a, name) { return false }
      },
      None => return false,
    }
  }
  true
}

fn unit_mul(a: Dict[Str, I64], b: Dict[Str, I64]) -> Dict[Str, I64] {
  let r: Dict[Str, I64] = dict_new()
  for name in dict_keys(a) {
    dict_set(r, name, dict_or(r, name, 0) + dict_must(a, name))
  }
  for name in dict_keys(b) {
    dict_set(r, name, dict_or(r, name, 0) + dict_must(b, name))
  }
  unit_clean(r)
}

fn unit_div(a: Dict[Str, I64], b: Dict[Str, I64]) -> Dict[Str, I64] {
  let r: Dict[Str, I64] = dict_new()
  for name in dict_keys(a) {
    dict_set(r, name, dict_or(r, name, 0) + dict_must(a, name))
  }
  for name in dict_keys(b) {
    dict_set(r, name, dict_or(r, name, 0) - dict_must(b, name))
  }
  unit_clean(r)
}

fn unit_pow(a: Dict[Str, I64], k: I64) -> Dict[Str, I64] {
  if k == 0 or len(a) == 0 { return dict_new() }
  let r: Dict[Str, I64] = dict_new()
  for name in dict_keys(a) {
    dict_set(r, name, dict_must(a, name) * k)
  }
  unit_clean(r)
}

# unit_sqrt halves each exponent. An odd exponent has no whole square root, and
# the caller reports that rather than rounding, because sqrt(USD) is not a unit
# and pretending it is would let the mistake travel.
struct UnitSqrt {
  unit: Dict[Str, I64],
  ok: Bool,
}

fn unit_sqrt(a: Dict[Str, I64]) -> UnitSqrt {
  let r: Dict[Str, I64] = dict_new()
  for name in dict_keys(a) {
    let v: I64 = dict_must(a, name)
    if v % 2 != 0 {
      return UnitSqrt { unit: dict_new(), ok: false }
    }
    dict_set(r, name, v // 2)
  }
  UnitSqrt { unit: unit_clean(r), ok: true }
}

# The rendering is sorted by name, and that is not cosmetic: a Dict iterates in
# insertion order, two quantities can reach the same unit by different routes,
# and a diagnostic that prints `USD*year^-1` in one place and `year^-1*USD` in
# another is two messages for one problem. The Go side calls sort.Strings here
# for the same reason.
fn unit_string(u: Dict[Str, I64]) -> Str {
  if len(u) == 0 { return "1" }
  let names: Arr[Str] = arr_new()
  for name in dict_keys(u) {
    push(names, name)
  }
  sort_strings(names)
  let parts: Arr[Str] = arr_new()
  let i: I64 = 0
  while i < len(names) {
    let n: Str = names[i]
    let e: I64 = dict_must(u, n)
    if e == 1 {
      push(parts, n)
    } else {
      push(parts, bytes.concat(n, bytes.concat("^", str(e))))
    }
    i = i + 1
  }
  bytes.join(parts, "*")
}

# Insertion sort, bytewise ascending, to match sort.Strings. The lists are two
# or three elements: a comparator-taking `sort` builtin would be a larger
# language question than this needs. See NEEDS-23.
fn sort_strings(xs: Arr[Str]) {
  let i: I64 = 1
  while i < len(xs) {
    let v: Str = xs[i]
    let j: I64 = i - 1
    while j >= 0 and str_greater(xs[j], v) {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = v
    i = i + 1
  }
}

fn str_greater(a: Str, b: Str) -> Bool {
  let i: I64 = 0
  while i < len(a) and i < len(b) {
    if a[i] != b[i] { return a[i] > b[i] }
    i = i + 1
  }
  len(a) > len(b)
}

fn unit_from_anno(a: ast.UnitAnno) -> Dict[Str, I64] {
  let r: Dict[Str, I64] = dict_new()
  let i: I64 = 0
  while i < len(a.factors) {
    let f: ast.UnitFactor = a.factors[i]
    dict_set(r, f.name, dict_or(r, f.name, 0) + f.exp)
    i = i + 1
  }
  unit_clean(r)
}

# ---- environment -----------------------------------------------------------

struct CheckEnv {
  vars: Dict[Str, Type],
  # The subset of vars bound by `const`, each mapped to the line it was bound
  # on. Kept per scope rather than per name so that a `let` shadowing a `const`
  # in an inner scope is an ordinary mutable binding.
  consts: Dict[Str, I64],
  parent: Opt[CheckEnv],
}

fn new_env(parent: Opt[CheckEnv]) -> CheckEnv =
  CheckEnv { vars: dict_new(), consts: dict_new(), parent: parent }

fn env_get(e: CheckEnv, name: Str) -> Opt[Type] {
  let cur: Opt[CheckEnv] = Some(e)
  while true {
    match cur {
      Some(env) => {
        match dict_get(env.vars, name) {
          Some(t) => return Some(t),
          None => cur = env.parent,
        }
      },
      None => return None,
    }
  }
  None
}

fn env_define(e: CheckEnv, name: Str, t: Type) {
  dict_set(e.vars, name, t)
}

# The line a name's `const` binding was made on, or None if the name resolves to
# an ordinary binding or to nothing. It stops at the first scope that binds the
# name, so a `let` of the same name in a nearer scope shadows the const and is
# mutable.
fn env_const_line(e: CheckEnv, name: Str) -> Opt[I64] {
  let cur: Opt[CheckEnv] = Some(e)
  while true {
    match cur {
      Some(env) => {
        if dict_has(env.vars, name) { return dict_get(env.consts, name) }
        cur = env.parent
      },
      None => return None,
    }
  }
  None
}

# Assignment rebinds where the name was defined, walking outward, and defines
# locally only if it was never defined at all. That mirrors interp.Env.assign,
# and it is what makes `total = total - x` inside a loop body update the
# variable declared outside it.
fn env_assign(e: CheckEnv, name: Str, t: Type) {
  let cur: Opt[CheckEnv] = Some(e)
  while true {
    match cur {
      Some(env) => {
        if dict_has(env.vars, name) {
          dict_set(env.vars, name, t)
          return
        }
        cur = env.parent
      },
      None => {
        env_define(e, name, t)
        return
      },
    }
  }
}

# ---- the checker -----------------------------------------------------------

struct Checker {
  diags: Arr[Diagnostic],
  # User functions currently being inferred, keyed by node id. Without this a
  # recursive function inferred at a call site recurses forever.
  stack: Dict[I64, Bool],
  types: Dict[Str, RecordType],
  units: Dict[Str, Bool],
  # Set when a file imports without an alias, which makes any unknown name
  # unprovable. See check().
  blind_import: Bool,
  # Set when a file imports under an alias. An enum's variant constructors are
  # registered program-wide at run time, so a constructor declared in an aliased
  # module (`SFn`, `EBlock`) is in scope unqualified even though this single-file
  # checker never read that module. See cross_module_variant().
  aliased_import: Bool,
  # Set for a `mode systems` file. The systems dialect names types the bootstrap
  # has no definition for (I64, Str, Bool, and qualified names like cp.Caps), so
  # an unresolved type annotation is advisory there rather than an error.
  systems: Bool,
  # Lexical count of enclosing loops for the statement being checked, reset to
  # zero at every function boundary (infer_fn_body). A `break`/`continue` is a
  # diagnostic when this is zero: outside any loop, or inside a function nested
  # in one, which the language forbids crossing.
  loop_depth: I64,
  # fn_ret is the return annotation of each function whose body is being
  # inferred, innermost last: "" for none. A `?` reads the top to know what it
  # returns the failure from. Empty at the top of a file, which is what makes a
  # top-level `?` an error.
  fn_ret: Arr[Str],
  # enums is each declared enum's variant names in declaration order;
  # variant_owner maps a variant back to its enum, or "" when two enums declare
  # the same name and a bare match on it cannot be judged.
  enums: Dict[Str, Arr[Str]],
  variant_owner: Dict[Str, Str],
  # payloads is each payload-carrying variant's declared payload type, keyed by
  # variant name. Presence is what says the variant takes an argument at all;
  # a None value is a payload whose type is not known, which is what the
  # built-in Some/Ok/Err have.
  payloads: Dict[Str, Opt[Type]],
  # The names declared with `struct`, as opposed to `type`. Only a struct
  # literal is checked field by field against its declaration.
  struct_decls: Dict[Str, Bool],
  # type_params is the `[T, U]` a struct or enum declares, by declaration name.
  # active_params is the set in scope right now -- while a declaration's own
  # field and payload types are being read, and while a generic function's
  # signature and body are being checked -- which is what makes a bare `T` there
  # resolve to the parameter rather than to an unknown name.
  type_params: Dict[Str, Arr[Str]],
  active_params: Dict[Str, Bool],
  # Set while the callee of a call is being inferred. `a.push(v)` is uniform
  # call syntax for `push(a, v)` and works on any value, so a field access
  # there is a function name and not a field at all.
  in_callee: Bool,
}

fn report(c: Checker, line: I64, msg: Str) {
  push(c.diags, Diagnostic { msg: msg, line: line, severity: SEV_ERROR })
}

fn warn(c: Checker, line: I64, msg: Str) {
  push(c.diags, Diagnostic { msg: msg, line: line, severity: SEV_WARNING })
}

# cross_module_variant reports whether an unresolved name is plausibly an enum
# variant constructor borrowed from an aliased import. Variant constructors are
# registered program-wide at run time and are capitalized by convention, so a
# capitalized unknown in a systems file that imports another module cannot be
# proven undefined from this file alone. A lowercase unknown (a value or a
# function) is still a typo and still reported.
fn cross_module_variant(c: Checker, name: Str) -> Bool {
  if not c.systems { return false }
  if not c.aliased_import { return false }
  if len(name) == 0 { return false }
  let first: I64 = name[0]
  first >= 65 and first <= 90
}

# check analyses a program and returns any diagnostics found.
fn check(prog: ast.Program) -> Arr[Diagnostic] {
  let c: Checker = Checker {
    diags: arr_new(),
    stack: dict_new(),
    types: dict_new(),
    units: dict_new(),
    blind_import: false,
    aliased_import: false,
    systems: bytes.equal(prog.mode, "systems"),
    loop_depth: 0,
    fn_ret: arr_new(),
    enums: dict_new(),
    variant_owner: dict_new(),
    payloads: dict_new(),
    struct_decls: dict_new(),
    type_params: dict_new(),
    active_params: dict_new(),
    in_callee: false,
  }
  dict_set(c.enums, "Opt", ["Some", "None"])
  dict_set(c.enums, "Res", ["Ok", "Err"])
  dict_set(c.variant_owner, "Some", "Opt")
  dict_set(c.variant_owner, "None", "Opt")
  dict_set(c.variant_owner, "Ok", "Res")
  dict_set(c.variant_owner, "Err", "Res")
  # The built-in constructors take a payload whose type the declaration does
  # not name. Presence in payloads is what makes them constructors rather than
  # bare cases; None is the unknown payload type.
  dict_set(c.payloads, "Some", None)
  dict_set(c.payloads, "Ok", None)
  dict_set(c.payloads, "Err", None)

  # Register declared record types and units first so forward references
  # resolve. A file that declares `type Model` at the bottom and uses it at the
  # top is legal and common.
  for s in prog.body {
    match s {
      STypeDecl(d) => register_type(c, d),
      SStruct(d) => register_struct(c, d),
      SUnitDecl(d) => dict_set(c.units, d.name, true),
      _ => unit,
    }
  }

  let env: CheckEnv = new_env(None)
  for name in builtin_names() {
    env_define(env, name, TBuiltin(BuiltinType { name: name }))
  }
  # The built-in enums' cases are values with types, not builtin functions:
  # Some/Ok/Err are constructors, None is an Opt, and `unit` is the Unit value,
  # so a match arm or a body that ends in it evaluates to Unit.
  env_define(env, "Some", TCtor(CtorType { owner: "Opt", variant: "Some", payload: None }))
  env_define(env, "Ok", TCtor(CtorType { owner: "Res", variant: "Ok", payload: None }))
  env_define(env, "Err", TCtor(CtorType { owner: "Res", variant: "Err", payload: None }))
  env_define(env, "None", TEnum(EnumType { name: "Opt", args: arr_new() }))
  env_define(env, "unit", TUnit)

  # An import with no alias brings its names in unqualified, and this checker
  # does not read the imported file, so it cannot know what those names are. One
  # of them is enough to make every unknown name unreliable, so the whole check
  # stands down for the file rather than reporting a definition it simply cannot
  # see. `import "std/nn" as nn` keeps the check, since then every borrowed name
  # arrives with the alias on it.
  for s in prog.body {
    match s {
      SImport(imp) => {
        if len(imp.alias) == 0 {
          c.blind_import = true
        } else {
          c.aliased_import = true
        }
      },
      _ => unit,
    }
  }

  # Every top-level function name, before any body is checked. A file may call a
  # function declared further down and does at run time, so a checker that
  # walked strictly in order would report a name that is perfectly well defined.
  # Forward references resolve for types and units above; until this pass existed
  # they did not for functions.
  #
  # The declaration is not typed here, only named: check_fn_def does the real
  # work when the walk reaches it, and this is about knowing the name exists.
  #
  # A name declared twice in one file is refused here. The evaluator takes the
  # last definition, silently, which reads as the first one having been replaced
  # when it has only been shadowed: twill-lang/spool#4 fixed two functions whose
  # replacements were written above the bodies they were meant to replace, and
  # which kept running the old ones through a passing test suite, a passing
  # source gate and passing CI. There is no conditional compilation in this
  # language, so a second declaration of one name in one file is an edit that
  # went wrong every time.
  let first_line: Dict[Str, I64] = dict_new()
  for s in prog.body {
    match s {
      # A declaration also wins over a builtin of the same name. Builtins were
      # just defined into this environment, so a plain "already seen?" guard
      # would let the builtin beat the file's own function -- but only for calls
      # written above the declaration, since reaching the declaration rebinds
      # the name. That made a shadow legal or illegal depending on where in the
      # file it was called from, and reported the builtin's arity against the
      # user's function.
      SFn(fd) => {
        match dict_get(first_line, fd.name) {
          Some(at) => report(c, fd.line, bytes.concat(fd.name,
            bytes.concat(" is already defined on line ",
            bytes.concat(str(at),
              "; the later definition is the one that runs, so the earlier one is dead. Delete whichever is stale, or rename one.")))),
          None => {
            dict_set(first_line, fd.name, fd.line)
            match env_get(env, fd.name) {
              Some(t) => {
                match t {
                  TBuiltin(_) => env_define(env, fd.name, TUnknown),
                  _ => unit,
                }
              },
              None => env_define(env, fd.name, TUnknown),
            }
          },
        }
      },
      _ => unit,
    }
  }

  # Enum cases are names too: `Some`/`None`/`Ok`/`Err` and every user variant
  # must resolve wherever they are constructed, so they are defined before any
  # body is checked. The type they belong to is left advisory.
  for s in prog.body {
    match s {
      SEnum(ed) => {
        let names: Arr[Str] = arr_new()
        let i: I64 = 0
        while i < len(ed.variants) {
          let v: ast.EnumVariant = ed.variants[i]
          push(names, v.name)
          # A variant name shared by two enums is ambiguous as a bare name;
          # owner is left unset so a match on it is not judged.
          match dict_get(c.variant_owner, v.name) {
            Some(owner) => {
              if not bytes.equal(owner, ed.name) {
                dict_set(c.variant_owner, v.name, "")
              } else {
                dict_set(c.variant_owner, v.name, ed.name)
              }
            },
            None => dict_set(c.variant_owner, v.name, ed.name),
          }
          i = i + 1
        }
        dict_set(c.enums, ed.name, names)
      },
      _ => unit,
    }
  }

  # With every enum and struct named, their payload and field types can be
  # parsed: a field written `Arr[Tok]` or a payload written `Res[Str, Str]`
  # resolves only once the names it may mention are all registered.
  for s in prog.body {
    match s {
      SEnum(ed) => {
        if len(ed.type_params) > 0 { dict_set(c.type_params, ed.name, ed.type_params) }
        let shadowed: Dict[Str, Bool] = with_params(c, ed.type_params)
        for v in ed.variants {
          if v.has_payload {
            dict_set(c.payloads, v.name, Some(parse_type(c, v.payload)))
          }
        }
        end_params(c, shadowed)
      },
      _ => unit,
    }
  }
  struct_field_types(c, prog)

  # Each variant is then bound as the value it is: a constructor for a payload
  # case, the enum itself for a bare one. A name already bound stays bound,
  # except for the four built-in cases, which a file's own enum may re-declare
  # and then owns.
  for s in prog.body {
    match s {
      SEnum(ed) => {
        for v in ed.variants {
          let taken: Bool = match env_get(env, v.name) {
            Some(_) => true,
            None => false,
          }
          if taken and not is_builtin_ctor(v.name) { continue }
          match enum_value_type(c, v.name) {
            Some(t) => env_define(env, v.name, t),
            None => env_define(env, v.name, TUnknown),
          }
        }
      },
      _ => unit,
    }
  }

  # Top-level `let` names too: a module-level constant may be referenced by a
  # function declared above its definition line (DTYPE_MAKERS is used this way).
  # As with functions this only asserts the name exists; infer_stmt still types
  # the binding when the walk reaches it, and evaluation order is the evaluator's
  # concern, not the checker's.
  #
  # A top-level `const` is registered as one here rather than when the walk
  # reaches it, because a function declared above the binding may assign to it,
  # and that assignment is checked when its declaration is reached. warp's
  # `examples/train.tw` has exactly that shape: `train_step` writes `STEPS`
  # several lines above the `let STEPS` that binds it.
  for s in prog.body {
    match s {
      SLet(st) => {
        match env_get(env, st.name) {
          Some(_) => unit,
          None => env_define(env, st.name, TUnknown),
        }
        if st.is_const and not dict_has(env.consts, st.name) {
          dict_set(env.consts, st.name, st.line)
        }
      },
      # Each name a destructuring binding introduces is a top-level name too, so
      # a function written above it may refer to one.
      SLetTuple(st) => {
        for name in st.names {
          if not bytes.equal(name, "_") {
            match env_get(env, name) {
              Some(_) => unit,
              None => env_define(env, name, TUnknown),
            }
          }
        }
      },
      _ => unit,
    }
  }

  # The file's top level is a scope like any other, so a second binding of a
  # const name here is refused the same way one inside a block is.
  report_const_rebinds(c, prog.body)

  for s in prog.body {
    infer_stmt(c, s, env)
  }
  dedupe(c.diags)
}

# dedupe removes repeated diagnostics. A body is checked once at its definition
# and again at each call site, so one mistake in a function called three times
# would otherwise be reported four times.
fn dedupe(diags: Arr[Diagnostic]) -> Arr[Diagnostic] {
  if len(diags) < 2 { return diags }
  let seen: Dict[Str, Bool] = dict_new()
  let out: Arr[Diagnostic] = arr_new()
  let i: I64 = 0
  while i < len(diags) {
    let d: Diagnostic = diags[i]
    # The key joins line and message. A line number is digits only, so the first
    # space separates the two unambiguously and two different findings cannot
    # collide into one.
    let key: Str = bytes.concat(str(d.line), bytes.concat(" ", d.msg))
    if not dict_has(seen, key) {
      dict_set(seen, key, true)
      push(out, d)
    }
    i = i + 1
  }
  out
}

fn register_type(c: Checker, td: ast.TypeDecl) {
  let fields: Dict[Str, Type] = dict_new()
  let i: I64 = 0
  while i < len(td.fields) {
    let f: ast.TypeField = td.fields[i]
    dict_set(fields, f.name, tensor_of(ast.concrete_dims(f.shape)))
    i = i + 1
  }
  dict_set(c.types, td.name, RecordType { fields: fields, name: td.name, args: [] })
}

# A struct registers as a record type whose fields exist but whose field types
# are advisory (the systems types the bootstrap does not model), so `m.field` is
# checked for existence and left unknown.
fn register_struct(c: Checker, sd: ast.StructDecl) {
  if len(sd.type_params) > 0 { dict_set(c.type_params, sd.name, sd.type_params) }
  let fields: Dict[Str, Type] = dict_new()
  let i: I64 = 0
  while i < len(sd.fields) {
    dict_set(fields, sd.fields[i].name, TUnknown)
    i = i + 1
  }
  dict_set(c.types, sd.name, RecordType { fields: fields, name: sd.name, args: [] })
}

# is_builtin_ctor reports whether a name is one of the built-in enums' cases,
# which a user enum may re-declare and then owns.
fn is_builtin_ctor(name: Str) -> Bool =
  bytes.equal(name, "Some") or bytes.equal(name, "None")
    or bytes.equal(name, "Ok") or bytes.equal(name, "Err")

# struct_field_types parses each declared struct's field types, once every enum
# and struct name is registered, so a field written `Arr[Tok]` resolves.
fn struct_field_types(c: Checker, prog: ast.Program) {
  for s in prog.body {
    match s {
      SStruct(sd) => {
        let shadowed: Dict[Str, Bool] = with_params(c, sd.type_params)
        let fields: Dict[Str, Type] = dict_new()
        let i: I64 = 0
        while i < len(sd.fields) {
          dict_set(fields, sd.fields[i].name, parse_type(c, sd.fields[i].type_name))
          i = i + 1
        }
        end_params(c, shadowed)
        dict_set(c.types, sd.name, RecordType { fields: fields, name: sd.name, args: [] })
        dict_set(c.struct_decls, sd.name, true)
      },
      _ => unit,
    }
  }
}

# variant_payload_type is the declared payload type of an enum case, or None.
fn variant_payload_type(c: Checker, variant: Str) -> Opt[Type] {
  match dict_get(c.payloads, variant) {
    Some(t) => t,
    None => None,
  }
}

# enum_value_type is the type of a variant reached as a value: `None` is an
# Opt, a user variant its enum. None when the name is not a variant this file
# knows, or when two enums share it and the owner cannot be named.
fn enum_value_type(c: Checker, name: Str) -> Opt[Type] {
  let owner: Str = match dict_get(c.variant_owner, name) {
    Some(o) => o,
    None => return None,
  }
  if len(owner) == 0 { return None }
  match dict_get(c.payloads, name) {
    Some(pl) => return Some(TCtor(CtorType { owner: owner, variant: name, payload: pl })),
    None => unit,
  }
  Some(TEnum(EnumType { name: owner, args: arr_new() }))
}

# resolve_unit builds a unit map from an annotation and reports any factor that
# names a unit which was never declared with `unit NAME`. A typo in a unit name
# is otherwise indistinguishable from a new unit, and silently accepting it is
# how annotations come to mean nothing.
fn resolve_unit(c: Checker, a: ast.UnitAnno, line: I64) -> Dict[Str, I64] {
  let i: I64 = 0
  while i < len(a.factors) {
    let f: ast.UnitFactor = a.factors[i]
    if not dict_has(c.units, f.name) {
      report(c, line, bytes.concat("unknown unit ", bytes.concat(quoted(f.name),
        bytes.concat(" (declare it with `unit ", bytes.concat(f.name, "`)")))))
    }
    i = i + 1
  }
  unit_from_anno(a)
}

# ---- systems-mode annotations ----------------------------------------------
#
# parse_type turns an annotation's text into a type. Anything it does not
# recognise -- a name from another module, a type alias it cannot see -- is
# unknown, which judges nothing. It is a hand-written recursive descent over
# the annotation string, the same one internal/checker/systems.go runs.

struct TypeParser {
  s: Str,
  pos: I64,
  err: Bool,
}

fn is_space_byte(ch: I64) -> Bool = ch == 32 or ch == 9 or ch == 10 or ch == 13

# The annotation text with leading and trailing whitespace removed. Written out
# because the string library has no trim and the parser's end-of-input test
# (the whole text was consumed) depends on there being none.
fn trim_space(s: Str) -> Str {
  let a: I64 = 0
  let b: I64 = len(s)
  while a < b and is_space_byte(s[a]) { a = a + 1 }
  while b > a and is_space_byte(s[b - 1]) { b = b - 1 }
  s[a:b]
}

fn parse_type(c: Checker, text: Str) -> Type {
  let p: TypeParser = TypeParser { s: trim_space(text), pos: 0, err: false }
  let t: Type = tp_parse(c, p)
  # A trailing remainder means the text was not an annotation this parser
  # understands, and half of one is not evidence of anything.
  if p.err or p.pos != len(p.s) { return TUnknown }
  t
}

fn tp_skip_space(p: TypeParser) {
  while p.pos < len(p.s) and (p.s[p.pos] == 32 or p.s[p.pos] == 9) {
    p.pos = p.pos + 1
  }
}

fn tp_ident(p: TypeParser) -> Str {
  tp_skip_space(p)
  let start: I64 = p.pos
  while p.pos < len(p.s) {
    let ch: I64 = p.s[p.pos]
    # A dot is part of the name so a qualified name arrives whole.
    if ch == 95 or ch == 46 or (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90)
      or (ch >= 48 and ch <= 57) {
      p.pos = p.pos + 1
      continue
    }
    break
  }
  p.s[start:p.pos]
}

fn tp_accept(p: TypeParser, tok: Str) -> Bool {
  tp_skip_space(p)
  if bytes.has_prefix(p.s[p.pos:len(p.s)], tok) {
    p.pos = p.pos + len(tok)
    return true
  }
  false
}

fn tp_parse(c: Checker, p: TypeParser) -> Type {
  tp_skip_space(p)
  if tp_accept(p, "fn(") or tp_accept(p, "Fn(") {
    let params: Arr[Type] = arr_new()
    if not tp_accept(p, ")") {
      while true {
        # A parameter may be named, as in fn(a: Str, b: Str) -> Bool.
        let save: I64 = p.pos
        let pname: Str = tp_ident(p)
        if len(pname) == 0 or not tp_accept(p, ":") { p.pos = save }
        push(params, tp_parse(c, p))
        if tp_accept(p, ",") { continue }
        if not tp_accept(p, ")") {
          p.err = true
          return TUnknown
        }
        break
      }
    }
    let ret: Type = TUnit
    if tp_accept(p, "->") { ret = tp_parse(c, p) }
    return TFnType(FnTypeAnno { params: params, ret: ret })
  }
  if tp_accept(p, "(") {
    # A tuple type, `(F64, F64)`. The source parser has already refused a
    # one-element one, so anything with fewer than two elements arriving here
    # came from text this checker did not write, and is not a type.
    let elems: Arr[Type] = arr_new()
    while true {
      push(elems, tp_parse(c, p))
      if tp_accept(p, ",") { continue }
      if not tp_accept(p, ")") {
        p.err = true
        return TUnknown
      }
      break
    }
    if len(elems) < 2 {
      p.err = true
      return TUnknown
    }
    return TTuple(TupleType { elems: elems })
  }
  let name: Str = tp_ident(p)
  if len(name) == 0 {
    p.err = true
    return TUnknown
  }
  let args: Arr[Type] = arr_new()
  if tp_accept(p, "[") {
    while true {
      push(args, tp_parse(c, p))
      if tp_accept(p, ",") { continue }
      if not tp_accept(p, "]") {
        p.err = true
        return TUnknown
      }
      break
    }
  }
  named_type(c, name, args)
}

# opt_arg is the i-th type argument, or None when the annotation gave fewer
# than that: a bare Arr says nothing about its elements.
fn opt_arg(args: Arr[Type], i: I64) -> Opt[Type] {
  if i < len(args) { return Some(args[i]) }
  None
}

fn opt_args(args: Arr[Type]) -> Arr[Opt[Type]] {
  let out: Arr[Opt[Type]] = arr_new()
  for a in args {
    push(out, Some(a))
  }
  out
}

# named_type resolves a type name with its arguments. A declaration in the file
# wins over a built-in name: the self-hosted tensor engine declares its own
# struct Tensor.
fn named_type(c: Checker, name: Str, args: Arr[Type]) -> Type {
  # A type parameter of the declaration being read wins over everything: `T`
  # inside `struct Box[T]` is the parameter, not a type called T.
  if dict_has(c.active_params, name) {
    return TParam(ParamType { name: name })
  }
  if dict_has(c.enums, name) {
    return TEnum(EnumType { name: name, args: opt_args(args) })
  }
  match dict_get(c.types, name) {
    # A generic struct written with arguments -- `Box[I64]` -- is that struct
    # with its parameters replaced, so the field types the use site sees are the
    # ones it asked for.
    Some(rec) => {
      let out: Type = subst_params(TRecord(rec), param_bindings(c, name, opt_args(args)))
      match out {
        TRecord(r) => return TRecord(RecordType { fields: r.fields, name: r.name, args: opt_args(args) }),
        _ => return out,
      }
    },
    None => unit,
  }
  if bytes.equal(name, "I64") or bytes.equal(name, "Byte") { return TInt }
  if bytes.equal(name, "F64") { return scalar() }
  if bytes.equal(name, "Bool") { return TBool }
  if bytes.equal(name, "Str") { return TStr }
  if bytes.equal(name, "Bytes") { return TBytes }
  if bytes.equal(name, "Unit") { return TUnit }
  # A tensor of any rank. The shape checker's own annotations say the shape;
  # this name says only that it is one, which is not enough to judge anything
  # against, so it is unknown here.
  if bytes.equal(name, "Tensor") { return TUnknown }
  if bytes.equal(name, "Arr") or bytes.equal(name, "List") {
    return TArr(ArrType { elem: opt_arg(args, 0) })
  }
  if bytes.equal(name, "Dict") {
    return TDict(DictType { key: opt_arg(args, 0), val: opt_arg(args, 1) })
  }
  if bytes.equal(name, "Opt") or bytes.equal(name, "Res") {
    return TEnum(EnumType { name: name, args: opt_args(args) })
  }
  TUnknown
}

# ---- generics --------------------------------------------------------------
#
# There is no monomorphization: the runtime is the same code whatever T is, so a
# use site's arguments only ever have to reach the types the checker judges
# against. That is the whole of what generics do here.

# param_bindings pairs a declaration's type parameters with the arguments a use
# site supplied. An argument that was not written leaves that parameter unbound,
# and an unbound parameter substitutes to an unknown, which judges nothing --
# `Box` on its own says no more than it did before 1.7.
fn param_bindings(c: Checker, decl: Str, args: Arr[Opt[Type]]) -> Dict[Str, Type] {
  let binding: Dict[Str, Type] = dict_new()
  let params: Arr[Str] = match dict_get(c.type_params, decl) {
    Some(ps) => ps,
    None => return binding,
  }
  let i: I64 = 0
  while i < len(params) {
    let bound: Type = TUnknown
    if i < len(args) {
      match args[i] {
        Some(t) => bound = t,
        None => unit,
      }
    }
    dict_set(binding, params[i], bound)
    i = i + 1
  }
  binding
}

# subst_params replaces type parameters throughout a type.
fn subst_params(t: Type, binding: Dict[Str, Type]) -> Type {
  if len(binding) == 0 { return t }
  match t {
    TParam(v) => {
      match dict_get(binding, v.name) {
        Some(sub) => sub,
        None => t,
      }
    },
    TTuple(v) => {
      # A tuple inside a generic still judges: `struct Pair[T] { span: (T, T) }`
      # at Pair[I64] has an (I64, I64) field, not a pair of unsubstituted
      # parameters that judge nothing.
      let elems: Arr[Type] = arr_new()
      for e in v.elems { push(elems, subst_params(e, binding)) }
      TTuple(TupleType { elems: elems })
    },
    TArr(v) => TArr(ArrType { elem: subst_params_opt(v.elem, binding) }),
    TDict(v) => TDict(DictType { key: subst_params_opt(v.key, binding),
                                 val: subst_params_opt(v.val, binding) }),
    TEnum(v) => TEnum(EnumType { name: v.name, args: subst_params_args(v.args, binding) }),
    TRecord(v) => {
      let fields: Dict[Str, Type] = dict_new()
      for name in dict_keys(v.fields) {
        match dict_get(v.fields, name) {
          Some(ft) => dict_set(fields, name, subst_params(ft, binding)),
          None => unit,
        }
      }
      TRecord(RecordType { fields: fields, name: v.name, args: subst_params_args(v.args, binding) })
    },
    TFnType(v) => {
      let params: Arr[Type] = arr_new()
      for pt in v.params { push(params, subst_params(pt, binding)) }
      TFnType(FnTypeAnno { params: params, ret: subst_params(v.ret, binding) })
    },
    _ => t,
  }
}

fn subst_params_opt(t: Opt[Type], binding: Dict[Str, Type]) -> Opt[Type] {
  match t {
    Some(v) => Some(subst_params(v, binding)),
    None => None,
  }
}

fn subst_params_args(args: Arr[Opt[Type]], binding: Dict[Str, Type]) -> Arr[Opt[Type]] {
  let out: Arr[Opt[Type]] = arr_new()
  for a in args { push(out, subst_params_opt(a, binding)) }
  out
}

# infer_params reads a use site's type arguments back out of a value: given the
# declared payload `T` and an actual `I64`, it learns T is I64, which is how
# `Leaf(7)` becomes a `Tree[I64]` without the program writing the argument. It
# matches structurally and gives up quietly where it cannot tell, since a wrong
# guess here would be a confident wrong type downstream.
fn infer_params(declared: Type, actual: Type, binding: Dict[Str, Type]) {
  match declared {
    TParam(d) => {
      if not dict_has(binding, d.name) { dict_set(binding, d.name, actual) }
    },
    TTuple(d) => {
      match actual {
        TTuple(a) => {
          if len(a.elems) == len(d.elems) {
            let i: I64 = 0
            while i < len(d.elems) {
              infer_params(d.elems[i], a.elems[i], binding)
              i = i + 1
            }
          }
        },
        _ => unit,
      }
    },
    TArr(d) => {
      match actual {
        TArr(a) => infer_params_opt(d.elem, a.elem, binding),
        _ => unit,
      }
    },
    TDict(d) => {
      match actual {
        TDict(a) => {
          infer_params_opt(d.key, a.key, binding)
          infer_params_opt(d.val, a.val, binding)
        },
        _ => unit,
      }
    },
    TRecord(d) => {
      match actual {
        TRecord(a) => {
          if bytes.equal(a.name, d.name) { infer_params_args(d.args, a.args, binding) }
        },
        _ => unit,
      }
    },
    TEnum(d) => {
      match actual {
        TEnum(a) => {
          if bytes.equal(a.name, d.name) { infer_params_args(d.args, a.args, binding) }
        },
        _ => unit,
      }
    },
    _ => unit,
  }
}

fn infer_params_opt(declared: Opt[Type], actual: Opt[Type], binding: Dict[Str, Type]) {
  match declared {
    None => unit,
    Some(d) => {
      match actual {
        Some(a) => infer_params(d, a, binding),
        None => unit,
      }
    },
  }
}

fn infer_params_args(declared: Arr[Opt[Type]], actual: Arr[Opt[Type]], binding: Dict[Str, Type]) {
  let i: I64 = 0
  while i < len(declared) {
    if i < len(actual) { infer_params_opt(declared[i], actual[i], binding) }
    i = i + 1
  }
}

# with_params brings a declaration's type parameters into scope; end_params
# takes them out again. They nest by saving what they shadow, so a `T` that was
# already a parameter of an enclosing declaration comes back afterwards rather
# than disappearing.
fn with_params(c: Checker, params: Arr[Str]) -> Dict[Str, Bool] {
  let shadowed: Dict[Str, Bool] = dict_new()
  for p in params {
    dict_set(shadowed, p, dict_has(c.active_params, p))
    dict_set(c.active_params, p, true)
  }
  shadowed
}

fn end_params(c: Checker, shadowed: Dict[Str, Bool]) {
  for p in dict_keys(shadowed) {
    let was: Bool = match dict_get(shadowed, p) {
      Some(v) => v,
      None => false,
    }
    if was {
      dict_set(c.active_params, p, true)
    } else {
      dict_del(c.active_params, p)
    }
  }
}

# ---- assignability ---------------------------------------------------------
#
# assignable reports whether a value of type got may stand where want is
# declared. It is true whenever either side is not known well enough to say
# otherwise, and false only for a definite mismatch. One softness is kept on
# purpose: I64 and F64 stand for each other, because an I64 annotation converts
# a number at run time and every caller relies on it.

fn is_fn_type(t: Type) -> Bool {
  match t {
    TFnType(_) => true,
    _ => false,
  }
}

# A None on either side is the Go checker's nil: not known, so not a mismatch.
fn assignable_opt(want: Opt[Type], got: Opt[Type]) -> Bool {
  let w: Type = match want {
    Some(x) => x,
    None => return true,
  }
  let g: Type = match got {
    Some(x) => x,
    None => return true,
  }
  assignable(w, g)
}

fn assignable(want: Type, got: Type) -> Bool {
  if is_unknown_type(want) { return true }
  if is_unknown_type(got) { return true }
  # A type parameter that reached here was not substituted, which means the use
  # site did not say what it stands for. It judges nothing, the same way an
  # unknown does; the alternative would be to refuse every generic declaration
  # whose caller left an argument off.
  match want {
    TParam(w) => {
      return match got {
        TParam(g) => bytes.equal(w.name, g.name),
        _ => true,
      }
    },
    _ => unit,
  }
  match got {
    TParam(_) => return true,
    _ => unit,
  }
  # A constructor or a function value stands wherever a function is expected;
  # nothing else about it is checked here.
  match got {
    TCtor(_) => return is_fn_type(want),
    TFn(_) => return is_fn_type(want),
    TBuiltin(_) => return is_fn_type(want),
    TFnType(_) => return is_fn_type(want),
    _ => unit,
  }
  match want {
    TInt => is_number_type(got),
    TTensor(w) => {
      if is_scalar(w) { return is_number_type(got) }
      # A tensor annotation is checked by the shape rules, not here.
      match got {
        TTensor(_) => true,
        _ => is_number_type(got),
      }
    },
    TBool => {
      match got {
        TBool => true,
        _ => false,
      }
    },
    TStr => {
      match got {
        TStr => true,
        _ => false,
      }
    },
    TBytes => {
      match got {
        TBytes => true,
        _ => false,
      }
    },
    TUnit => true,
    TArr(w) => {
      match got {
        TArr(g) => assignable_opt(w.elem, g.elem),
        TList(g) => {
          match g.elems {
            Some(es) => {
              for e in es {
                if not assignable_opt(w.elem, Some(e)) { return false }
              }
              true
            },
            None => true,
          }
        },
        # A bracket literal of numbers is a tensor to the parser and an array at
        # an Arr annotation, and iterating a rank-n tensor gives rank-(n-1)
        # tensors, which stand for the inner arrays of a nested one. Both are
        # what the runtime does at the annotation, so neither is a mismatch.
        TTensor(_) => true,
        _ => false,
      }
    },
    TDict(w) => {
      match got {
        TDict(g) => assignable_opt(w.key, g.key) and assignable_opt(w.val, g.val),
        # An empty record literal is a record to the parser and a dictionary at
        # a Dict annotation.
        TRecord(g) => len(g.fields) == 0,
        _ => false,
      }
    },
    TEnum(w) => {
      let g: EnumType = match got {
        TEnum(x) => x,
        _ => return false,
      }
      if not bytes.equal(g.name, w.name) { return false }
      let i: I64 = 0
      while i < len(w.args) {
        if i < len(g.args) and not assignable_opt(w.args[i], g.args[i]) { return false }
        i = i + 1
      }
      true
    },
    TRecord(w) => {
      let g: RecordType = match got {
        TRecord(x) => x,
        _ => return false,
      }
      if len(w.name) > 0 and len(g.name) > 0 {
        if not bytes.equal(w.name, g.name) { return false }
        # Two uses of the same generic struct are the same type only if they
        # were given the same arguments: a Box[Str] is not a Box[I64]. An
        # argument that was not written is None and judges nothing, so a bare
        # `Box` still stands for any of them.
        let i: I64 = 0
        while i < len(w.args) {
          if i < len(g.args) {
            if not assignable_opt(w.args[i], g.args[i]) { return false }
          }
          i = i + 1
        }
        return true
      }
      true
    },
    TTuple(w) => {
      let g: TupleType = match got {
        TTuple(x) => x,
        _ => return false,
      }
      if len(g.elems) != len(w.elems) { return false }
      let i: I64 = 0
      while i < len(w.elems) {
        if not assignable(w.elems[i], g.elems[i]) { return false }
        i = i + 1
      }
      true
    },
    # Every function-valued got was answered above, so anything reaching here is
    # not one.
    TFnType(_) => false,
    _ => true,
  }
}

# is_number_type reports whether a type is a scalar number of either kind: an
# I64, or a rank-0 tensor (F64 in systems mode). A tensor whose rank is not
# known counts, since it may be a scalar.
fn is_number_type(t: Type) -> Bool {
  match t {
    TInt => true,
    TTensor(v) => is_scalar(v) or not fully_known(v),
    _ => false,
  }
}

# check_assignable reports a definite mismatch between a declared type and the
# value put there. what names the place: a quoted name for a binding, a field
# of a struct, an argument position.
fn check_assignable(c: Checker, line: I64, what: Str, want: Type, got: Type) -> Bool {
  if assignable(want, got) { return true }
  report(c, line, bytes.concat(what, bytes.concat(" is declared ",
    bytes.concat(type_text(c, want), bytes.concat(" but the value is ",
    type_text(c, got))))))
  false
}

# fractional_literal_at_int is the one I64/F64 mismatch that is reported: a
# fractional literal bound where an I64 is declared, since a 2.5 bound as an
# integer truncates to a number the author did not write.
fn fractional_literal_at_int(c: Checker, line: I64, what: Str, want: Type, e: ast.Expr) {
  match want {
    TInt => unit,
    _ => return,
  }
  # A negated literal is a unary minus over a number, so -2.5 is read through
  # to the digits under it.
  let inner: ast.Expr = e
  match e {
    EUnary(u) => if bytes.equal(u.op, "-") { inner = u.operand },
    _ => unit,
  }
  let lit: ast.NumberLit = match inner {
    ENumber(n) => n,
    _ => return,
  }
  # Truncation rather than a round trip through an integer: that conversion is
  # out of range at or above 2^63 and lands on MIN_I64, so the comparison
  # disagreed with itself and called MAX_I64, the commonest constant in the
  # subset, a fraction. Truncation has no range to fall out of, and it reads
  # 2.5e3 as the whole number it is.
  if lit.value == f64_trunc(lit.value) { return }
  report(c, line, bytes.concat(what,
    bytes.concat(" is declared I64 but the value is the fraction ", lit.text)))
}

# binding_type is the type a let or a parameter takes from its annotation: the
# declared type when it is one this checker knows, else the value's own, so an
# advisory name from another module still lets the value carry what it was.
fn binding_type(declared: Type, got: Type) -> Type {
  if is_unknown_type(declared) { return got }
  # A declared Arr with no element type takes the value's element type when the
  # value has one; and so on for a Dict and an enum.
  match declared {
    TArr(d) => {
      match d.elem {
        None => {
          match got {
            TArr(_) => return got,
            _ => unit,
          }
        },
        Some(_) => unit,
      }
    },
    TDict(d) => {
      match d.key {
        None => {
          match got {
            TDict(_) => return got,
            _ => unit,
          }
        },
        Some(_) => unit,
      }
    },
    TEnum(d) => {
      if len(d.args) == 0 {
        match got {
          TEnum(_) => return got,
          _ => unit,
        }
      }
    },
    _ => unit,
  }
  declared
}

# ---- the wiring the systems types feed -------------------------------------

# unorderable names a type that `<` and its relatives are not defined on, when
# the checker is sure of it. A type it cannot resolve gives "", so nothing is
# judged on a guess.
fn unorderable(c: Checker, t: Type) -> Str {
  match t {
    TEnum(_) => type_text(c, t),
    TArr(_) => type_text(c, t),
    TDict(_) => type_text(c, t),
    TRecord(_) => type_text(c, t),
    TList(_) => type_text(c, t),
    TBytes => type_text(c, t),
    TUnit => type_text(c, t),
    TBool => type_text(c, t),
    TCtor(_) => type_text(c, t),
    TFnType(_) => type_text(c, t),
    TFn(_) => type_text(c, t),
    TBuiltin(_) => type_text(c, t),
    TTuple(_) => type_text(c, t),
    TTensor(v) => {
      # Ordering is scalar-only, so a tensor of known rank above 0 cannot be
      # ordered and the runtime refuses it. A masking `where(A > 0.0, A, B)` is
      # the shape this takes in practice, and it failed at run time for every
      # non-scalar A while the checker, which knew the rank, said nothing.
      if len(v.dims) > 0 and fully_known(v) { return type_text(c, t) }
      ""
    },
    _ => "",
  }
}

# is_definite_non_record reports whether a type certainly has no fields. A
# tensor is left out on purpose: `t.to(f32)` is a field access syntactically.
fn is_definite_non_record(t: Type) -> Bool {
  match t {
    TInt => true,
    TStr => true,
    TBool => true,
    TBytes => true,
    TUnit => true,
    TArr(_) => true,
    TDict(_) => true,
    TEnum(_) => true,
    TList(_) => true,
    TTuple(_) => true,
    _ => false,
  }
}

# match_binding_type is the type a pattern's binding takes: the subject's
# payload for that case, when the subject's type is known.
fn match_binding_type(c: Checker, subject: Type, variant: Str) -> Type {
  let en: EnumType = match subject {
    TEnum(v) => v,
    _ => {
      match variant_payload_type(c, variant) {
        Some(t) => return t,
        None => return TUnknown,
      }
    },
  }
  if bytes.equal(en.name, "Opt") {
    if len(en.args) > 0 {
      match en.args[0] {
        Some(t) => return t,
        None => unit,
      }
    }
    return TUnknown
  }
  if bytes.equal(en.name, "Res") {
    let i: I64 = 0
    if bytes.equal(variant, "Err") { i = 1 }
    if len(en.args) > i {
      match en.args[i] {
        Some(t) => return t,
        None => unit,
      }
    }
    return TUnknown
  }
  match variant_payload_type(c, variant) {
    # A user enum's payload may be written in the enum's own type parameters, so
    # what the arm binds is those replaced by whatever the subject's type
    # supplied: matching a `Tree[I64]` binds an I64, and matching a `Tree[Str]`
    # a Str, from one declaration.
    Some(t) => subst_params(t, param_bindings(c, en.name, en.args)),
    None => TUnknown,
  }
}

# bind_pattern defines every name a pattern introduces, typed as far down the
# tree as the subject's type is known. `Ok(Some(v))` types v from the payload of
# Ok and then the payload of Some; where either step is unknown the rest of the
# tree is unknown too, which is the checker's usual "judge nothing you cannot
# prove".
fn bind_pattern(c: Checker, pat: ast.MatchPattern, subject: Type, env: CheckEnv) {
  if pat.kind == ast.PAT_BINDING {
    if len(pat.binding) > 0 {
      env_define(env, pat.binding, subject)
    }
    return
  }
  if pat.kind == ast.PAT_VARIANT and len(pat.sub) > 0 {
    bind_pattern(c, pat.sub[0], match_binding_type(c, subject, pat.variant), env)
  }
}

# infer_record_lit types a record literal, including the update form
# `{ ..base, f: v }`. The update's type is the base's fields with the named ones
# replacing what they name, which is the value the evaluator builds.
#
# A field named in an update that the base does not have is not reported. The
# record it produces is the one `{ a: base.a, b: 1 }` produces and runs exactly
# as well, and records here are structural, so refusing it would be a diagnostic
# on a correct program -- the one kind of mistake this checker is not allowed to
# make. A typed update, `P { ..base, b: 1 }`, is still checked against P's
# declaration by check_struct_lit below, which is where a misspelt field on a
# struct is caught.
#
# An untyped update produces a plain record rather than the base's struct type.
# Its fields are what a later field access is answered from, and a name it kept
# would be a nominal claim about a value the update may have added a field to.
fn infer_record_lit(c: Checker, ex: ast.RecordLit, env: CheckEnv) -> Type {
  let fields: Dict[Str, Type] = dict_new()
  # The base is inferred first because it is written first: a diagnostic from
  # inside it should come before one from a field that replaces part of it.
  match ex.base {
    Some(b) => {
      let base: Type = infer_expr(c, b, env)
      match as_record(base) {
        Some(rec) => {
          for name in dict_keys(rec.fields) {
            dict_set(fields, name, dict_must(rec.fields, name))
          }
        },
        None => {
          if is_definite_non_record(base) {
            report(c, ex.line, bytes.concat("the base of a record update must be a record, got ",
              type_text(c, base)))
          }
        },
      }
    },
    None => unit,
  }
  let i: I64 = 0
  while i < len(ex.fields) {
    let f: ast.RecordField = ex.fields[i]
    dict_set(fields, f.name, infer_expr(c, f.value, env))
    i = i + 1
  }
  if len(ex.type_name) > 0 { return check_struct_lit(c, ex, fields) }
  TRecord(RecordType { fields: fields, name: "", args: [] })
}

# check_struct_lit types a typed record literal against its struct declaration:
# every field named must exist and its value must be of the declared type. The
# literal's type is the struct.
fn check_struct_lit(c: Checker, ex: ast.RecordLit, fields: Dict[Str, Type]) -> Type {
  let name: Str = ex.type_name
  let dot: I64 = last_index_of_byte(name, 46)
  if dot >= 0 { name = name[dot + 1:len(name)] }
  let decl: RecordType = match dict_get(c.types, name) {
    Some(d) => d,
    None => return TRecord(RecordType { fields: fields, name: "", args: [] }),
  }
  if dict_has(c.struct_decls, name) {
    # A generic struct's literal says its arguments by what it is built from:
    # `Pair { first: b, second: a }` is a `Pair[B, A]`. They are read out of the
    # field values first, because checking the fields against the parameters
    # themselves would compare a value against `A` -- a name that stands for
    # whatever the literal decides -- and report every correct literal as a
    # mismatch.
    let params: Arr[Str] = match dict_get(c.type_params, name) {
      Some(ps) => ps,
      None => arr_new(),
    }
    if len(params) > 0 {
      let binding: Dict[Str, Type] = dict_new()
      for f in ex.fields {
        match dict_get(decl.fields, f.name) {
          Some(want) => {
            match dict_get(fields, f.name) {
              Some(got) => infer_params(want, got, binding),
              None => unit,
            }
          },
          None => unit,
        }
      }
      let inferred: Arr[Opt[Type]] = arr_new()
      for p in params {
        match dict_get(binding, p) {
          Some(t) => push(inferred, Some(t)),
          None => {
            dict_set(binding, p, TUnknown)
            push(inferred, Some(TUnknown))
          },
        }
      }
      match subst_params(TRecord(decl), binding) {
        TRecord(r) => decl = RecordType { fields: r.fields, name: r.name, args: inferred },
        _ => unit,
      }
    }
    for f in ex.fields {
      let want: Type = match dict_get(decl.fields, f.name) {
        Some(t) => t,
        None => {
          report(c, ex.line, bytes.concat(name, bytes.concat(" has no field ", quoted(f.name))))
          continue
        },
      }
      let what: Str = bytes.concat("field ", bytes.concat(quoted(f.name),
        bytes.concat(" of ", name)))
      let got: Type = match dict_get(fields, f.name) {
        Some(t) => t,
        None => TUnknown,
      }
      if check_assignable(c, ex.line, what, want, got) {
        fractional_literal_at_int(c, ex.line, what, want, f.value)
      }
    }
  }
  TRecord(decl)
}

fn last_index_of_byte(s: Str, ch: I64) -> I64 {
  let i: I64 = len(s) - 1
  while i >= 0 {
    if s[i] == ch { return i }
    i = i - 1
  }
  -1
}

# check_body_return_type compares what a function body evaluates to against its
# declared named return type. A block whose last statement is not an expression
# (it returned early, or ends in a loop) evaluates to Unit and is not judged,
# since its `return` statements were checked where they stand.
fn check_body_return_type(c: Checker, line: I64, name: Str, ret_type: Str,
                          body_type: Type, body: ast.Expr) {
  if len(ret_type) == 0 { return }
  let want: Type = parse_type(c, ret_type)
  match body_type {
    TUnit => {
      match want {
        TUnit => return,
        _ => unit,
      }
      # A body that evaluates to Unit against a declared value type is a
      # function that falls off its end, and that is worth reporting -- but only
      # when there is no `return` in it to have produced the value instead.
      # `return` statements are checked where they stand, and a body ending in a
      # loop or an if-without-else evaluates to Unit while still returning
      # properly from inside.
      if has_value_return(body) { return }
    },
    _ => unit,
  }
  if assignable(want, body_type) { return }
  let who: Str = "function"
  if len(name) > 0 { who = bytes.concat("function ", quoted(name)) }
  report(c, line, bytes.concat(who, bytes.concat(" returns ",
    bytes.concat(type_text(c, body_type), bytes.concat(" but its signature declares ",
    type_text(c, want))))))
}

# check_return_type is check_body_return_type for an explicit `return e`,
# against the return type of the innermost function being checked.
fn check_return_type(c: Checker, line: I64, got: Type, e: ast.Expr) {
  if len(c.fn_ret) == 0 { return }
  let ret: Str = c.fn_ret[len(c.fn_ret) - 1]
  if len(ret) == 0 { return }
  let want: Type = parse_type(c, ret)
  if assignable(want, got) { return }
  report(c, line, bytes.concat("return gives ", bytes.concat(type_text(c, got),
    bytes.concat(" but the function declares ", type_text(c, want)))))
}

# has_value_return reports whether a function body contains a `return` carrying
# a value, anywhere that is not inside a nested function: a nested function's
# returns are its own.
fn has_value_return(e: ast.Expr) -> Bool {
  match e {
    EBlock(b) => hvr_block(b),
    EIf(ex) => {
      if hvr_block(ex.then_block) { return true }
      match ex.else_branch {
        ElseBlock(alt) => hvr_block(alt),
        ElseIf(alt) => has_value_return(EIf(alt)),
        NoElse => false,
      }
    },
    EMatch(ex) => {
      for arm in ex.arms {
        if hvr_stmt(arm.body) { return true }
      }
      false
    },
    _ => false,
  }
}

fn hvr_block(b: ast.Block) -> Bool {
  for s in b.body {
    if hvr_stmt(s) { return true }
  }
  false
}

fn hvr_stmt(s: ast.Stmt) -> Bool {
  match s {
    SReturn(st) => {
      match st.value {
        Some(_) => true,
        None => false,
      }
    },
    SBlock(b) => hvr_block(b),
    SWhile(st) => hvr_block(st.body),
    SFor(st) => hvr_block(st.body),
    SExpr(st) => has_value_return(st.x),
    SLet(st) => has_value_return(st.value),
    SLetTuple(st) => has_value_return(st.value),
    SAssign(st) => has_value_return(st.value),
    _ => false,
  }
}

# ---- systems-mode builtin results ------------------------------------------
#
# systems_builtin_result types the systems-mode builtins whose result type is
# fixed, so a value from one of them can be checked where it lands. Only
# builtins whose result the shape cases do not already type are here.

fn opt_of(t: Type) -> Type {
  let a: Arr[Opt[Type]] = arr_new()
  push(a, Some(t))
  TEnum(EnumType { name: "Opt", args: a })
}

fn res_of(ok: Type, err: Type) -> Type {
  let a: Arr[Opt[Type]] = arr_new()
  push(a, Some(ok))
  push(a, Some(err))
  TEnum(EnumType { name: "Res", args: a })
}

fn arr_of(elem: Type) -> Type = TArr(ArrType { elem: Some(elem) })

fn systems_builtin_result(name: Str, args: Arr[Type]) -> Opt[Type] {
  if in_set(name, "i64 i64_of_f64 clock_now_ms mono_ns mtime file_size buf_len buf_get8 rng_open mem_allocs mem_bytes mem_live_bytes mem_tensors") {
    return Some(TInt)
  }
  if in_set(name, "f64 f64_of_i64") { return Some(scalar()) }
  if in_set(name, "chr str_quote f64_to_str bytes_to_str read_text_or resolve_path f64_hex num_to_text sha256 sha256_bytes") {
    return Some(TStr)
  }
  # The barrier hands back exactly what it was given, and the type says so.
  # Deliberately not the treatment `grad` gets: `grad` is a shape barrier and
  # loses the checking downstream of it, which would be a poor trade for a
  # benchmark. Shape, dtype and unit ride straight through.
  if bytes.equal(name, "black_box") {
    if len(args) > 0 { return Some(args[0]) }
    return None
  }
  if in_set(name, "arr_push push") {
    if len(args) > 0 {
      match args[0] {
        TArr(_) => return Some(args[0]),
        _ => unit,
      }
    }
    return Some(TArr(ArrType { elem: None }))
  }
  if in_set(name, "arr arr_new arr_of_tensor") { return Some(TArr(ArrType { elem: None })) }
  # slice(x, a, b) is a Str slice, and only a Str: the builtin rejects anything
  # else. Typing an Arr argument as an Arr result is a reasonable design and not
  # the one that was implemented, so it propagated a confident wrong type.
  if bytes.equal(name, "slice") { return Some(TStr) }
  if bytes.equal(name, "dict_new") { return Some(TDict(DictType { key: None, val: None })) }
  if bytes.equal(name, "dict_keys") { return Some(arr_of(TStr)) }
  if bytes.equal(name, "dict_get") {
    if len(args) > 0 {
      match args[0] {
        TDict(d) => {
          match d.val {
            Some(v) => return Some(opt_of(v)),
            None => unit,
          }
        },
        _ => unit,
      }
    }
    let a: Arr[Opt[Type]] = arr_new()
    push(a, None)
    return Some(TEnum(EnumType { name: "Opt", args: a }))
  }
  if in_set(name, "dict_has is_same is_tty_stdout all_finite path_exists path_is_dir path_is_abs mem_counters_available") {
    return Some(TBool)
  }
  if in_set(name, "path_join path_base path_dir path_ext path_stem path_normalize") {
    return Some(TStr)
  }
  if in_set(name, "mkdir_all remove_file remove_dir remove_all rename") {
    return Some(res_of(TUnit, TStr))
  }
  if in_set(name, "temp_dir cwd read_file_at run") { return Some(res_of(TStr, TStr)) }
  if bytes.equal(name, "bytes_new") { return Some(TBytes) }
  if bytes.equal(name, "read_file") { return Some(res_of(TStr, TStr)) }
  if bytes.equal(name, "write_file") { return Some(res_of(TUnit, TStr)) }
  if bytes.equal(name, "i64_of_str") { return Some(opt_of(TInt)) }
  if bytes.equal(name, "str_to_f64") { return Some(opt_of(scalar())) }
  if bytes.equal(name, "env") { return Some(opt_of(TStr)) }
  if bytes.equal(name, "args") { return Some(arr_of(TStr)) }
  None
}

# report_const_rebinds refuses a second binding of a name that a `const` binds in
# the same statement list.
#
# The rule exists because the alternative is a silent revocation. Constness is
# held in a per-scope dict, and the first cut of it had a plain `let` of the same
# name delete the entry, so `const HEX` followed by `let HEX` turned the
# guarantee off with nothing said. It was order-dependent on top of that: the
# prelude registers top-level consts before the walk starts, so a `let` above the
# `const` was refused and a `let` below it was not. Moving a line changed what
# the checker promised.
#
# Order is not consulted here at all: the whole list is scanned for the first
# `const` binding of each name, and every other binding of those names is
# reported, whichever side of it they sit on. Two plain `let`s of one name stay
# legal, because that is an idiom this language allows and this rule is about
# `const`. An inner scope is not this list, so shadowing is untouched.
#
# A destructuring `let` is a binding too, and it is counted here for the same
# reason a plain one is. The first cut of tuples looked only at SLet, so
# `const A = 1.0` followed by `let (A, b) = (2.0, 3.0)` rebound A with nothing
# said while `let A = 2.0` on the same line was refused with the full message. A
# rule that a second shape of binding walks around is not a rule.
fn report_const_rebinds(c: Checker, body: Arr[ast.Stmt]) {
  # Indices rather than lines: two statements can share a line, so a line number
  # cannot tell the const's own binding apart from a second one.
  let first: Dict[Str, I64] = dict_new()
  let any: Bool = false
  let i: I64 = 0
  while i < len(body) {
    match body[i] {
      SLet(st) => {
        if st.is_const and not dict_has(first, st.name) {
          dict_set(first, st.name, i)
          any = true
        }
      },
      _ => unit,
    }
    i = i + 1
  }
  if not any { return }
  # A const's own binding is the one at first[name], and only an SLet can be it:
  # there is no `const (a, b) = ...`. So an SLetTuple naming a const name is
  # always a second binding, with no index to excuse it.
  let j: I64 = 0
  while j < len(body) {
    match body[j] {
      SLet(st) => {
        match dict_get(first, st.name) {
          Some(at) => {
            if at != j {
              report_const_rebind(c, st.name, st.line, stmt_line(body[at]))
            }
          },
          None => unit,
        }
      },
      SLetTuple(st) => {
        let k: I64 = 0
        while k < len(st.names) {
          if not bytes.equal(st.names[k], "_") {
            match dict_get(first, st.names[k]) {
              Some(at) => report_const_rebind(c, st.names[k], st.line, stmt_line(body[at])),
              None => unit,
            }
          }
          k = k + 1
        }
      },
      _ => unit,
    }
    j = j + 1
  }
}

# The one message, written once, so the two shapes of binding cannot drift apart
# in their wording the way they drifted apart in whether they were checked.
fn report_const_rebind(c: Checker, name: Str, line: I64, decl_line: I64) {
  report(c, line, bytes.concat(name,
    bytes.concat(" is declared const on line ",
    bytes.concat(str(decl_line),
    bytes.concat(", so the name cannot be bound a second time in the same scope: a second binding would take its place and everything after it would be assignable again. Rename one of them, or declare line ",
    bytes.concat(str(decl_line), " with let if the name is meant to change."))))))
}

# The line a statement was written on, for the one caller that has a statement in
# hand rather than the `let` inside it.
fn stmt_line(s: ast.Stmt) -> I64 {
  match s {
    SLet(st) => st.line,
    _ => 0,
  }
}

# The name an assignment target ultimately reaches: `x` for `x`, for `x.f`, for
# `x[i]` and for `a.d[i]`. An assignment through a call or any other expression
# has no base name, and reports nothing.
fn lvalue_base(target: ast.Expr) -> Opt[Str] {
  let cur: ast.Expr = target
  while true {
    match cur {
      EIdent(x) => return Some(x.name),
      EField(x) => cur = x.target,
      EIndex(x) => cur = x.target,
      _ => return None,
    }
  }
  None
}

# check_let_tuple judges `let (lo, hi) = span(xs)`. The names are bound whatever
# happens, so a mistake here reports once rather than once more for every use of
# a name the destructuring did not manage to bind.
# report_repeated_tuple_names refuses `let (a, a) = (1.0, 2.0)`.
#
# Positional binding has no way to say what a repeat means. Nothing merges the
# two values and nothing reads them apart, so the second define simply lands on
# top of the first and the last position wins, which is a typo answered with a
# number rather than a diagnostic. `_` repeats freely, because `_` binds nothing
# and is the written way to skip a position.
#
# It runs before the value is inferred so that a program with both faults reads
# in the order it was written: the names are wrong on their own terms, whatever
# the right-hand side turns out to be.
fn report_repeated_tuple_names(c: Checker, st: ast.LetTuple) {
  let seen: Dict[Str, Bool] = dict_new()
  let i: I64 = 0
  while i < len(st.names) {
    let name: Str = st.names[i]
    if not bytes.equal(name, "_") {
      if dict_has(seen, name) {
        report(c, st.line, bytes.concat("this let binds ",
          bytes.concat(name, " twice, and the later position would take the earlier one's place with nothing said. Rename one of them, or write _ for a position whose value the program does not want.")))
      } else {
        dict_set(seen, name, true)
      }
    }
    i = i + 1
  }
}

fn check_let_tuple(c: Checker, st: ast.LetTuple, env: CheckEnv) {
  report_repeated_tuple_names(c, st)
  let rhs: Type = infer_expr(c, st.value, env)
  let tup: TupleType = match rhs {
    TTuple(t) => t,
    _ => {
      # Only a definite mismatch is reported. An unknown right-hand side -- a
      # call into a module this single-file checker never read -- says nothing
      # about how many values come back, so it binds unknowns and stays quiet,
      # which is the policy everywhere else in this file.
      if not is_unknown_type(rhs) {
        report(c, st.line, bytes.concat("this let destructures a tuple of ",
          bytes.concat(str(len(st.names)),
          bytes.concat(" values, but the value is ", type_text(c, rhs)))))
      }
      bind_tuple_names(st, env, TUnknown)
      return
    },
  }
  if len(tup.elems) != len(st.names) {
    report(c, st.line, bytes.concat("this let binds ",
      bytes.concat(str(len(st.names)),
      bytes.concat(" names, but the value is ",
      bytes.concat(type_text(c, TTuple(tup)),
      bytes.concat(", which has ", str(len(tup.elems))))))))
    bind_tuple_names(st, env, TUnknown)
    return
  }
  let i: I64 = 0
  while i < len(st.names) {
    if not bytes.equal(st.names[i], "_") {
      env_define(env, st.names[i], tup.elems[i])
    }
    i = i + 1
  }
}

# bind_tuple_names binds every name of a destructuring to one type, for the two
# paths where the value did not say what each part is.
fn bind_tuple_names(st: ast.LetTuple, env: CheckEnv, t: Type) {
  for name in st.names {
    if not bytes.equal(name, "_") { env_define(env, name, t) }
  }
}

# ---- statements ------------------------------------------------------------

fn infer_stmt(c: Checker, s: ast.Stmt, env: CheckEnv) {
  match s {
    SLet(st) => {
      let rhs: Type = infer_expr(c, st.value, env)
      # A type annotation, in either slot the parser may have put it: the
      # binding is declared to be that type, and the value has to be one. A
      # qualified or generic name arrives as text and a bare one as a
      # one-factor unit annotation.
      let type_anno: Bool = len(st.type_name) > 0
      if not type_anno {
        match st.unit {
          Some(u) => type_anno = is_advisory_type_anno(c, u),
          None => unit,
        }
      }
      if type_anno {
        let want: Type = parse_type(c, ret_type_name(st.type_name, st.unit))
        let what: Str = quoted(st.name)
        if check_assignable(c, st.line, what, want, rhs) {
          fractional_literal_at_int(c, st.line, what, want, st.value)
        }
        env_define(env, st.name, binding_type(want, rhs))
      } else {
      match st.unit {
        Some(anno) => {
          let want: Dict[Str, I64] = resolve_unit(c, anno, st.line)
          match as_tensor(rhs) {
            Some(t) => {
              # A dimensionless value adopts the declared unit: `let px: USD =
              # 10.0` is the normal way to introduce a quantity. Only a value
              # that already carries a conflicting unit is a mistake.
              if len(t.unit) != 0 and not unit_equal(t.unit, want) {
                report(c, st.line, bytes.concat(quoted(st.name),
                  bytes.concat(" declares unit ", bytes.concat(unit_string(want),
                  bytes.concat(" but the value has unit ", unit_string(t.unit))))))
              }
              env_define(env, st.name, set_dtype(tensor_with_unit(t.dims, want), t.dtype))
            },
            None => env_define(env, st.name, tensor_with_unit(arr_new(), want)),
          }
        },
        None => env_define(env, st.name, rhs),
      }
      }
      # `const` binds in this scope, whichever of the three branches above did
      # the binding. A top-level one is already recorded by the prelude; this is
      # what makes a `const` inside a function work, and what lets an inner `let`
      # of the same name shadow an outer `const` and stay mutable.
      #
      # Nothing here revokes constness. A second binding of the name in this same
      # scope is refused outright by report_const_rebinds, which is what keeps
      # the guarantee from depending on statement order.
      if st.is_const {
        dict_set(env.consts, st.name, st.line)
      }
    },
    SLetTuple(st) => check_let_tuple(c, st, env),
    SFn(st) => {
      env_define(env, st.name, TFn(FnType {
        node_id: st.id, params: st.params, ret: st.ret, ret_unit: st.ret_unit,
        ret_type: st.ret_type, body: st.body, env: env,
      }))
      # Check the body once at definition using the parameter annotations, so
      # mistakes are caught even if the function is never called. Unannotated
      # parameters are unknown, so this only reports definite errors.
      check_fn_def(c, st, env)
    },
    SAssign(st) => {
      let v: Type = infer_expr(c, st.value, env)
      # A `const` is bound once, and the name is the whole of the guarantee:
      # `HEX = other()` swaps the table, and `HEX[0] = "#000"` edits the one
      # everybody is reading, so both are refused. What cannot be refused here is
      # a mutation that does not go through the name, `push(HEX, x)` or a
      # function handed the handle, because `Arr` has reference semantics and
      # nothing tracks where a handle goes. docs/language-guide.md says so where
      # `const` is introduced; docs/roadmap.md entry 28.
      match lvalue_base(st.target) {
        Some(base) => {
          match env_const_line(env, base) {
            Some(at) => report(c, st.line, bytes.concat(base,
              bytes.concat(" is declared const on line ",
              bytes.concat(str(at),
                ", so nothing may be assigned through that name: not the binding, and not an element or field of it. Bind a new name for the changed value, or declare it with let if it is meant to change.")))),
            None => unit,
          }
        },
        None => unit,
      }
      match st.target {
        # A bare name rebinds where it was defined, walking outward.
        EIdent(id) => env_assign(env, id.name, v),
        # A field or index target: infer it so a malformed one is still checked,
        # but there is no name to rebind. A struct field keeps its declared type
        # across the assignment, so the value is checked against it.
        _ => {
          let target: Type = infer_expr(c, st.target, env)
          match st.target {
            EField(fld) => {
              match as_record(infer_expr(c, fld.target, env)) {
                Some(rec) => {
                  if len(rec.name) > 0 {
                    let what: Str = bytes.concat("field ", bytes.concat(quoted(fld.name),
                      bytes.concat(" of ", rec.name)))
                    if check_assignable(c, st.line, what, target, v) {
                      fractional_literal_at_int(c, st.line, what, target, st.value)
                    }
                  }
                },
                None => unit,
              }
            },
            _ => unit,
          }
        },
      }
    },
    SWhile(st) => {
      infer_expr(c, st.cond, env)
      c.loop_depth = c.loop_depth + 1
      infer_block(c, st.body, new_env(Some(env)))
      c.loop_depth = c.loop_depth - 1
    },
    SFor(st) => {
      let iter: Type = infer_expr(c, st.iter, env)
      let scope: CheckEnv = new_env(Some(env))
      scope_define_elem(scope, st.name, iter)
      c.loop_depth = c.loop_depth + 1
      infer_block(c, st.body, scope)
      c.loop_depth = c.loop_depth - 1
    },
    SReturn(st) => {
      match st.value {
        Some(v) => check_return_type(c, st.line, infer_expr(c, v, env), v),
        None => unit,
      }
    },
    SImport(st) => {
      # Imported definitions are resolved at run time. For a namespaced import,
      # bind the alias so field access on it stays unknown rather than being
      # reported as an undefined name.
      if len(st.alias) > 0 {
        env_define(env, st.alias, TUnknown)
      }
    },
    STypeDecl(_) => unit,
    SStruct(_) => unit,
    SUnitDecl(_) => unit,
    # Enum cases were registered in the pre-pass, so the declaration is a no-op
    # here, the same as a type or unit declaration.
    SEnum(_) => unit,
    SExpr(st) => infer_expr(c, st.x, env),
    SBlock(b) => infer_block(c, b, new_env(Some(env))),
    # Loop control binds to the innermost enclosing loop only and never crosses
    # a function boundary, so outside any loop (depth zero) it is an error.
    SBreak(st) => if c.loop_depth == 0 { report(c, st.line, "break outside a loop") },
    SContinue(st) => if c.loop_depth == 0 { report(c, st.line, "continue outside a loop") },
  }
}

fn scope_define_elem(scope: CheckEnv, name: Str, iter: Type) {
  env_define(scope, name, elem_type(iter))
}

# A block's value is its last expression statement. A declaration or a loop
# leaves it Unit, which is why `fn f() { let x = 1 }` returns unit rather than 1.
fn infer_block(c: Checker, b: ast.Block, env: CheckEnv) -> Type {
  report_const_rebinds(c, b.body)
  let last: Type = TUnit
  for s in b.body {
    match s {
      SExpr(es) => last = infer_expr(c, es.x, env),
      _ => {
        infer_stmt(c, s, env)
        last = TUnit
      },
    }
  }
  last
}

# elem_type returns the element type produced by iterating a value. Iterating a
# matrix yields its rows; iterating a list yields something the checker cannot
# name, because a list is heterogeneous.
fn elem_type(t: Type) -> Type {
  match t {
    TTensor(v) => {
      # A row of a tensor keeps its dtype; iterating does not re-round.
      if len(v.dims) == 1 { return tensor_with_dtype(arr_new(), v.dtype) }
      if len(v.dims) > 1 { return tensor_with_dtype(tail(v.dims), v.dtype) }
      TUnknown
    },
    TList(_) => TUnknown,
    TArr(v) => {
      match v.elem {
        Some(e) => e,
        None => TUnknown,
      }
    },
    _ => TUnknown,
  }
}

fn tail(xs: Arr[I64]) -> Arr[I64] {
  let out: Arr[I64] = arr_new()
  let i: I64 = 1
  while i < len(xs) {
    push(out, xs[i])
    i = i + 1
  }
  out
}

fn copy_dims(xs: Arr[I64]) -> Arr[I64] {
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(xs) {
    push(out, xs[i])
    i = i + 1
  }
  out
}

# ---- expressions -----------------------------------------------------------

fn infer_expr(c: Checker, e: ast.Expr, env: CheckEnv) -> Type {
  match e {
    ENumber(_) => scalar(),
    EString(_) => TStr,
    EBool(_) => TBool,
    EIdent(ex) => {
      match env_get(env, ex.name) {
        Some(t) => t,
        None => {
          # A name that resolves to nothing is a typo, and it was the one
          # mistake the checker could see plainly and said nothing about.
          # Builtins are not in the environment because they are not values, so
          # they are checked against the table instead.
          if not is_builtin(ex.name) and not c.blind_import and not cross_module_variant(c, ex.name) {
            report(c, ex.line, bytes.concat("unknown name ", quoted(ex.name)))
          }
          TUnknown
        },
      }
    },
    ETensor(ex) => infer_tensor_lit(c, ex),
    EList(ex) => {
      let elems: Arr[Type] = arr_new()
      let i: I64 = 0
      while i < len(ex.elements) {
        push(elems, infer_expr(c, ex.elements[i], env))
        i = i + 1
      }
      TList(ListType { elems: Some(elems) })
    },
    ETuple(ex) => {
      let elems: Arr[Type] = arr_new()
      let i: I64 = 0
      while i < len(ex.elements) {
        push(elems, infer_expr(c, ex.elements[i], env))
        i = i + 1
      }
      TTuple(TupleType { elems: elems })
    },
    ELambda(ex) => TFn(FnType {
      node_id: ex.id, params: ex.params, ret: ex.ret, ret_unit: ex.ret_unit,
      ret_type: ex.ret_type, body: ex.body, env: env,
    }),
    EUnary(ex) => infer_unary(c, ex, env),
    EBinary(ex) => infer_binary(c, ex, env),
    ECall(ex) => infer_call(c, ex, env),
    EIndex(ex) => infer_index(c, ex, env),
    ESlice(ex) => infer_slice(c, ex, env),
    ERecord(ex) => infer_record_lit(c, ex, env),
    EField(ex) => {
      let target: Type = infer_expr(c, ex.target, env)
      match as_record(target) {
        Some(rec) => {
          match dict_get(rec.fields, ex.name) {
            Some(ft) => ft,
            None => {
              report(c, ex.line, bytes.concat("record has no field ", quoted(ex.name)))
              TUnknown
            },
          }
        },
        None => {
          # A field of something that cannot have one. The record case above was
          # checked and this one was not, though the checker knows the type just
          # as well.
          #
          # Not when it is a call's callee, though: `a.push(v)` is uniform call
          # syntax for `push(a, v)` and works on any value, so a field there is a
          # function name and not a field at all. A tensor is excluded for the
          # same family of reasons, since `t.to(f32)` is written this way.
          if not c.in_callee and is_definite_non_record(target) {
            report(c, ex.line, bytes.concat("cannot read field ",
              bytes.concat(quoted(ex.name), bytes.concat(" of ", type_text(c, target)))))
            return TUnknown
          }
          # Field access on anything else the checker could not resolve to a
          # record is not evidence of a mistake: it is usually a namespaced
          # import.
          TUnknown
        },
      }
    },
    EIf(ex) => infer_if(c, ex, env),
    EMatch(ex) => infer_match(c, ex, env),
    # The success payload's type is not tracked (Res/Opt are advisory), so the
    # unwrapped value is left unknown; the subject is still checked.
    ETry(ex) => {
      # `?` yields the success payload: a Res[T, E] gives a T and an Opt[T] a T,
      # so what it is bound to is checked against that.
      let subject: Type = infer_expr(c, ex.expr, env)
      check_try_context(c, ex.line)
      match subject {
        TEnum(en) => {
          if bytes.equal(en.name, "Res") or bytes.equal(en.name, "Opt") {
            if len(en.args) > 0 {
              match en.args[0] {
                Some(t) => return t,
                None => return TUnknown,
              }
            }
            return TUnknown
          }
        },
        _ => unit,
      }
      if not is_unknown_type(subject) {
        report(c, ex.line, bytes.concat("`?` needs a Res or an Opt, but the value is ",
          type_text(c, subject)))
      }
      TUnknown
    },
    EBlock(b) => infer_block(c, b, new_env(Some(env))),
  }
}

# A match's subject is inferred, then each arm body is checked as a statement in
# its own scope with the pattern's binding present (its type is unknown, since
# the payload type is advisory). The match's type is left unknown rather than
# unified across arms, which keeps the dialect's records-and-enums permissive.
fn infer_match(c: Checker, ex: ast.Match, env: CheckEnv) -> Type {
  let subject: Type = infer_expr(c, ex.subject, env)
  check_match_arms(c, ex)
  let i: I64 = 0
  while i < len(ex.arms) {
    let arm: ast.MatchArm = ex.arms[i]
    let scope: CheckEnv = new_env(Some(env))
    bind_pattern(c, arm.pattern, subject, scope)
    if len(arm.guard) > 0 {
      infer_expr(c, arm.guard[0], scope)
    }
    infer_stmt(c, arm.body, scope)
    i = i + 1
  }
  TUnknown
}

# check_try_context is the rule for `?`: it returns the failure from the
# enclosing function, so that function must be one, and it must return a Res
# or an Opt for the failure to be returnable. A function with no return
# annotation is not judged.
fn check_try_context(c: Checker, line: I64) {
  if len(c.fn_ret) == 0 {
    report(c, line, "`?` outside a function: there is nothing to return the failure from")
    return
  }
  let ret: Str = c.fn_ret[len(c.fn_ret) - 1]
  if len(ret) == 0 { return }
  let head: Str = ret
  let i: I64 = bytes.index_of(ret, "[")
  if i >= 0 { head = ret[0:i] }
  if not bytes.equal(head, "Res") and not bytes.equal(head, "Opt") {
    report(c, line, bytes.concat("`?` in a function that returns ", bytes.concat(ret,
      ": the failure it propagates needs a Res or Opt return type")))
  }
}

# ret_type_name is a function's named return type whichever slot the parser put
# it in: a qualified or generic name arrives as text, a bare one as a
# one-factor unit annotation. "" when there is none.
fn ret_type_name(ret_type: Str, u: Opt[ast.UnitAnno]) -> Str {
  if len(ret_type) > 0 { return ret_type }
  match u {
    Some(anno) => {
      if len(anno.factors) == 1 and anno.factors[0].exp == 1 { return anno.factors[0].name }
      ""
    },
    None => "",
  }
}

# check_match_arms is the exhaustiveness check: every variant of the matched
# enum has an arm, or a `_` stands for the rest. The enum is the one that owns
# the variants the arms name, so the subject's static type is not needed; a
# match naming variants of two enums, a variant twice, or a `_` after every
# variant is already listed, is reported too. A variant this file cannot see --
# one declared in an aliased module -- leaves the match unjudged, since the
# checker reports only what it can prove (docs/type-system.md, "match").
fn check_match_arms(c: Checker, m: ast.Match) {
  let owner: Str = ""
  let covered: Dict[Str, Bool] = dict_new()
  let catch_all_at: I64 = -1
  # judgeable is the set of arms exhaustiveness is computed from: the ones whose
  # running depends on nothing but the value's shape. A guard is a condition
  # this checker cannot evaluate, so a guarded arm is checked for reachability
  # and then set aside. `before` is the same set truncated at the catch-all,
  # because what makes a catch-all redundant is the arms BEFORE it covering
  # everything already; the arms after it are unreachable and prove nothing.
  let judgeable: Arr[ast.MatchPattern] = arr_new()
  let before: Arr[ast.MatchPattern] = arr_new()
  let i: I64 = 0
  while i < len(m.arms) {
    let arm: ast.MatchArm = m.arms[i]
    let pat: ast.MatchPattern = arm.pattern
    let guarded: Bool = len(arm.guard) > 0
    if catch_all_at >= 0 {
      report(c, pat.line, bytes.concat("unreachable match arm: ", bytes.concat(pattern_text(pat),
        bytes.concat(" comes after ", bytes.concat(pattern_text(m.arms[catch_all_at].pattern),
        ", which already matches everything")))))
    }
    if not guarded {
      if ast.pat_catch_all(pat) and catch_all_at < 0 {
        before = arr_copy(judgeable)
        catch_all_at = i
      }
      push(judgeable, pat)
    }
    if ast.pat_catch_all(pat) and not guarded {
      i = i + 1
      continue
    }
    # A literal says nothing about which enum is being matched, and a binder
    # under a guard covers nothing.
    if pat.kind != ast.PAT_VARIANT {
      i = i + 1
      continue
    }
    if not guarded and ast.pat_covers_case(pat) {
      if dict_has(covered, pat.variant) {
        report(c, pat.line, bytes.concat("duplicate match arm: ", bytes.concat(pat.variant, " is already handled")))
      }
      dict_set(covered, pat.variant, true)
    }
    # Not an enum this file declares (or an ambiguous name): the match cannot
    # be judged.
    let en: Str = match dict_get(c.variant_owner, pat.variant) {
      Some(name) => name,
      None => return,
    }
    if len(en) == 0 { return }
    if len(owner) == 0 {
      owner = en
    } else if not bytes.equal(owner, en) {
      report(c, pat.line, bytes.concat("match arm ", bytes.concat(pat.variant,
        bytes.concat(" belongs to enum ", bytes.concat(en,
        bytes.concat(", but the earlier arms match ", owner))))))
      return
    }
    i = i + 1
  }
  if len(owner) == 0 { return }
  let tally: Arr[ast.MatchPattern] = judgeable
  if catch_all_at >= 0 { tally = before }
  let result: Missing = missing_cases(c, tally)
  if not result.judged { return }
  let n_missing: I64 = len(result.names)
  if catch_all_at >= 0 {
    if n_missing == 0 {
      let w: ast.MatchArm = m.arms[catch_all_at]
      report(c, w.pattern.line, bytes.concat("unreachable match arm: ", bytes.concat(pattern_text(w.pattern),
        bytes.concat(" matches nothing, every variant of ", bytes.concat(owner, " is already handled")))))
    }
    return
  }
  if n_missing > 0 {
    report(c, m.line, bytes.concat("match on ", bytes.concat(owner,
      bytes.concat(" is not exhaustive: missing ", bytes.join(result.names, ", ")))))
  }
}

# arr_copy is a shallow copy of a pattern list. `before` has to be a snapshot:
# the list it is taken from keeps growing after the catch-all, and sharing the
# handle would let those later arms count towards a tally that is defined as
# stopping there.
fn arr_copy(xs: Arr[ast.MatchPattern]) -> Arr[ast.MatchPattern] {
  let out: Arr[ast.MatchPattern] = arr_new()
  for x in xs { push(out, x) }
  out
}

# Missing is what missing_cases answers with: the values that reach no pattern,
# and whether the question could be answered at all.
struct Missing {
  names: Arr[Str],
  judged: Bool,
}

# pattern_text names a pattern in a diagnostic. It is deliberately shallow: the
# diagnostics that use it are about which arm, not about what the arm looks like
# all the way down.
fn pattern_text(pat: ast.MatchPattern) -> Str {
  if pat.kind == ast.PAT_BINDING {
    if len(pat.binding) == 0 { return "`_`" }
    return bytes.concat("`", bytes.concat(pat.binding, "`"))
  }
  if pat.kind == ast.PAT_LITERAL { return "this literal pattern" }
  if len(pat.sub) > 0 { return bytes.concat(pat.variant, "(...)") }
  pat.variant
}

# missing_cases answers, for the set of patterns offered at one position, which
# values reach none of them. It recurses into payloads, so
# `Some(Ok(v)), Some(Err(e)), None` is exhaustive over `Opt[Res[..]]` while
# dropping the `Err` arm reports the value that gets through by name,
# `Some(Err)`.
#
# A position holding only literals, or naming a variant of an enum this file
# cannot see, is not judged -- the checker reports what it can prove, and a
# guess here would be a false "not exhaustive" on a correct program. The one
# exception is Bool, the only domain small enough for a finite set of literals
# to exhaust.
fn missing_cases(c: Checker, pats: Arr[ast.MatchPattern]) -> Missing {
  let by_variant: Dict[Str, Arr[ast.MatchPattern]] = dict_new()
  let whole: Dict[Str, Bool] = dict_new()
  let saw_true: Bool = false
  let saw_false: Bool = false
  let literals: Bool = false
  let owner: Str = ""
  let none: Arr[Str] = arr_new()
  for pat in pats {
    if ast.pat_catch_all(pat) {
      # A binder or `_` at this position takes every value there is.
      return Missing { names: none, judged: true }
    }
    if pat.kind == ast.PAT_LITERAL {
      literals = true
      match pat.lit[0] {
        ast.EBool(b) => {
          if b.value { saw_true = true } else { saw_false = true }
        },
        _ => unit,
      }
      continue
    }
    let en: Str = match dict_get(c.variant_owner, pat.variant) {
      Some(name) => name,
      None => return Missing { names: none, judged: false },
    }
    if len(en) == 0 { return Missing { names: none, judged: false } }
    if len(owner) > 0 and not bytes.equal(en, owner) {
      return Missing { names: none, judged: false }
    }
    owner = en
    if len(pat.sub) == 0 or ast.pat_catch_all(pat.sub[0]) {
      dict_set(whole, pat.variant, true)
      continue
    }
    let subs: Arr[ast.MatchPattern] = match dict_get(by_variant, pat.variant) {
      Some(existing) => existing,
      None => arr_new(),
    }
    push(subs, pat.sub[0])
    dict_set(by_variant, pat.variant, subs)
  }
  if len(owner) == 0 {
    # Two literals do cover a Bool, and it is the only domain small enough for
    # that to be true.
    if saw_true and saw_false { return Missing { names: none, judged: true } }
    if literals {
      # Literals over a domain that is not Bool leave values behind however many
      # are written, and `...` is what those values are called in the
      # diagnostic.
      let dots: Arr[Str] = arr_new()
      push(dots, "...")
      return Missing { names: dots, judged: true }
    }
    return Missing { names: none, judged: false }
  }
  let variants: Arr[Str] = match dict_get(c.enums, owner) {
    Some(vs) => vs,
    None => return Missing { names: none, judged: false },
  }
  let missing: Arr[Str] = arr_new()
  for v in variants {
    if dict_has(whole, v) { continue }
    match dict_get(by_variant, v) {
      None => push(missing, v),
      Some(subs) => {
        let inner: Missing = missing_cases(c, subs)
        if not inner.judged { return Missing { names: none, judged: false } }
        for name in inner.names {
          push(missing, bytes.concat(v, bytes.concat("(", bytes.concat(name, ")"))))
        }
      },
    }
  }
  Missing { names: missing, judged: true }
}

fn as_record(t: Type) -> Opt[RecordType] {
  match t {
    TRecord(r) => Some(r),
    _ => None,
  }
}

# An `if` with no `else` has no value on one path, so its type is unknown rather
# than the then-branch's. Joining the two branches only produces a type when
# they agree.
fn infer_if(c: Checker, ex: ast.IfExpr, env: CheckEnv) -> Type {
  infer_expr(c, ex.cond, env)
  let then_type: Type = infer_block(c, ex.then_block, new_env(Some(env)))
  match ex.else_branch {
    ElseBlock(alt) => join(then_type, infer_block(c, alt, new_env(Some(env)))),
    ElseIf(alt) => join(then_type, infer_if(c, alt, env)),
    NoElse => TUnknown,
  }
}

# join returns the shape both branches agree on, and Unknown otherwise. It does
# not widen: two different shapes have no common shape in this lattice and
# inventing one would be a guess.
fn join(a: Type, b: Type) -> Type {
  match as_tensor(a) {
    Some(at) => {
      match as_tensor(b) {
        Some(bt) => {
          if shape_match(at, bt) {
            # The branches agree on shape and may still disagree on dtype,
            # and then the checker cannot name one.
            let dt: I64 = DT_UNKNOWN
            if at.dtype == bt.dtype { dt = at.dtype }
            return TTensor(TensorType { dims: at.dims, unit: at.unit, dtype: dt })
          }
          TUnknown
        },
        None => TUnknown,
      }
    },
    None => TUnknown,
  }
}

fn shape_match(a: TensorType, b: TensorType) -> Bool {
  if len(a.dims) != len(b.dims) { return false }
  let i: I64 = 0
  while i < len(a.dims) {
    if a.dims[i] != b.dims[i] { return false }
    i = i + 1
  }
  true
}

fn same_dims(a: Arr[I64], b: Arr[I64]) -> Bool {
  if len(a) != len(b) { return false }
  let i: I64 = 0
  while i < len(a) {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}

# A tensor literal's shape is read by walking the nesting and requiring every
# row at a given depth to have the same length. Ragged input is reported here
# and typed Unknown, because a shape invented from the first row would produce a
# second, imaginary error downstream instead of this real one.
fn infer_tensor_lit(c: Checker, ex: ast.TensorLit) -> Type {
  # `[]` evaluates to an empty list, not to a tensor of shape [0]: the evaluator
  # has no elements to read a shape from, so it builds the container that does
  # not need one. Typing it as a tensor made the checker confidently wrong at
  # the dimension-0 boundary, where a shape checker is supposed to earn its
  # keep, and `sum([])` checked clean and then failed at run time.
  if len(ex.elements) == 0 {
    return TList(ListType { elems: None })
  }
  let dims: Arr[I64] = arr_new()
  let ok: Arr[Bool] = arr_new()
  push(ok, true)
  walk_tensor_lit(ex.elements, 0, dims, ok)
  if not ok[0] {
    report(c, ex.line, "ragged tensor literal: rows have inconsistent lengths")
    return TUnknown
  }
  # A tensor literal is f64, the documented default (docs/dtypes.md): narrow
  # dtypes are always asked for and never inferred.
  tensor_with_dtype(dims, tensor.DT_F64)
}

# dims and ok are carried as mutable handles rather than returned, because this
# walks depth-first and every level contributes to the same two answers. The Go
# version closes over them; a struct would say the same thing with more words.
fn walk_tensor_lit(elems: Arr[ast.Expr], depth: I64, dims: Arr[I64], ok: Arr[Bool]) {
  if depth == len(dims) {
    push(dims, len(elems))
  } else {
    if dims[depth] != len(elems) {
      ok[0] = false
    }
  }
  let i: I64 = 0
  while i < len(elems) {
    match elems[i] {
      ETensor(inner) => walk_tensor_lit(inner.elements, depth + 1, dims, ok),
      _ => unit,
    }
    i = i + 1
  }
}

fn infer_unary(c: Checker, ex: ast.Unary, env: CheckEnv) -> Type {
  let t: Type = infer_expr(c, ex.operand, env)
  if bytes.equal(ex.op, "-") {
    match as_tensor(t) {
      Some(tt) => return TTensor(tt),
      None => return TUnknown,
    }
  }
  # `!` and `not` produce a boolean whatever they are given. The truthiness rule
  # is the evaluator's business.
  TBool
}

fn infer_binary(c: Checker, ex: ast.Binary, env: CheckEnv) -> Type {
  let op: Str = ex.op

  # Logical operators short-circuit and their result is whichever operand was
  # returned, so the type is not necessarily boolean and the checker does not
  # claim it is.
  if bytes.equal(op, "and") or bytes.equal(op, "or") or bytes.equal(op, "&&") or bytes.equal(op, "||") {
    infer_expr(c, ex.left, env)
    infer_expr(c, ex.right, env)
    return TUnknown
  }
  # The bitwise words take two integers and give one back. They are scalar-only
  # (the builtin form truncates each operand to I64), so the result is a scalar
  # whatever the operands were inferred as.
  # `//` is scalar integer division; like the bitwise words it takes two numbers
  # and gives one back.
  if bytes.equal(op, "//") {
    infer_expr(c, ex.left, env)
    infer_expr(c, ex.right, env)
    return scalar()
  }
  let bitwise: Bool = bytes.equal(op, "band") or bytes.equal(op, "bor")
    or bytes.equal(op, "xor") or bytes.equal(op, "shl") or bytes.equal(op, "shr")
  if bitwise {
    infer_expr(c, ex.left, env)
    infer_expr(c, ex.right, env)
    return scalar()
  }

  let l: Type = infer_expr(c, ex.left, env)
  let r: Type = infer_expr(c, ex.right, env)

  # An I64 is a scalar to the shape and unit rules; what is I64 about it is the
  # result type. Two I64s (or an I64 and a whole-number literal) give an I64 for
  # the arithmetic operators; an I64 against a fraction, or against a scalar the
  # checker cannot tell is whole, is F64.
  let l_int: Bool = is_int_type(l)
  let r_int: Bool = is_int_type(r)
  if l_int { l = scalar() }
  if r_int { r = scalar() }
  let int_result: Bool = (l_int and r_int) or (l_int and is_whole_literal(ex.right))
    or (r_int and is_whole_literal(ex.left))

  let lt: Opt[TensorType] = as_tensor(l)
  let rt: Opt[TensorType] = as_tensor(r)

  if is_comparison(op) {
    match lt {
      Some(a) => {
        match rt {
          Some(b) => {
            if not unit_equal(a.unit, b.unit) {
              report(c, ex.line, bytes.concat("comparing incompatible units ",
                bytes.concat(unit_string(a.unit), bytes.concat(" and ", unit_string(b.unit)))))
            }
          },
          None => unit,
        }
      },
      None => unit,
    }
    # `==` and `!=` are deep equality and are defined on everything. Ordering is
    # not: it is numbers and strings, and anything else is the runtime's "cannot
    # compare these values". An `Opt[I64]` compared against 0 is the shape that
    # mistake takes, so it is worth catching where it is written.
    if not bytes.equal(op, "==") and not bytes.equal(op, "!=") {
      let bad: Str = unorderable(c, l)
      if len(bad) == 0 { bad = unorderable(c, r) }
      if len(bad) > 0 {
        report(c, ex.line, bytes.concat("cannot order ", bytes.concat(bad,
          bytes.concat(" with ", bytes.concat(quoted(op),
          ": ordering is numbers and strings")))))
      }
    }
    return TBool
  }

  # `+` concatenates strings. When either side is a string the result is a
  # string, provided the other side is a string too (or unknown, left advisory).
  # A string added to a definite number or tensor is still the error below.
  if bytes.equal(op, "+") {
    if is_str_type(l) or is_str_type(r) {
      let l_ok: Bool = is_str_type(l) or is_unknown_type(l)
      let r_ok: Bool = is_str_type(r) or is_unknown_type(r)
      if l_ok and r_ok {
        return TStr
      }
      report(c, ex.line, bytes.concat("operator ", bytes.concat(quoted(op), " joins two strings or two numbers, not a mix")))
      return TUnknown
    }
  }

  if is_definite_non_tensor(l) or is_definite_non_tensor(r) {
    report(c, ex.line, bytes.concat("operator ", bytes.concat(quoted(op), " needs numbers/tensors")))
    return TUnknown
  }

  # Past this point both operands have to be tensors. One that is not is not
  # definitely wrong either, since it may be a TUnknown, so the result is
  # unknown and nothing is reported.
  let a: TensorType = TensorType { dims: arr_new(), unit: dict_new(), dtype: DT_UNKNOWN }
  let b: TensorType = TensorType { dims: arr_new(), unit: dict_new(), dtype: DT_UNKNOWN }
  match lt {
    Some(v) => a = v,
    None => return TUnknown,
  }
  match rt {
    Some(v) => b = v,
    None => return TUnknown,
  }

  # The dtype the runtime would produce, and the widening warning when a
  # narrow float meets a wider one. Every remaining operator goes through
  # tensor.promote at run time, `^` included; comparisons produced bool above
  # and never reach this.
  let dt: I64 = promote_and_warn(c, ex.line, a.dtype, b.dtype)

  if bytes.equal(op, "@") {
    let res: ShapeResult = matmul_result(a, b)
    if len(res.msg) > 0 {
      report(c, ex.line, res.msg)
      return TUnknown
    }
    return set_dtype(with_unit(res.type, unit_mul(a.unit, b.unit)), dt)
  }
  if bytes.equal(op, "^") {
    return set_dtype(pow_unit(c, a, ex), dt)
  }
  # + - * / %
  let res: ShapeResult = elementwise_result(a, b)
  if len(res.msg) > 0 {
    report(c, ex.line, res.msg)
    return TUnknown
  }
  if int_result { return TInt }
  set_dtype(with_unit(res.type, arith_unit(c, op, a, b, ex.line)), dt)
}

fn is_int_type(t: Type) -> Bool {
  match t {
    TInt => true,
    _ => false,
  }
}

# is_whole_literal reports whether an expression is an integer literal (or a
# negated one), which computes as an I64 beside an I64. Truncation rather than a
# round trip through an integer, for the reason fractional_literal_at_int gives.
fn is_whole_literal(e: ast.Expr) -> Bool {
  let inner: ast.Expr = e
  match e {
    EUnary(u) => if bytes.equal(u.op, "-") { inner = u.operand },
    _ => unit,
  }
  let lit: ast.NumberLit = match inner {
    ENumber(n) => n,
    _ => return false,
  }
  if lit.value != f64_trunc(lit.value) { return false }
  bytes.index_of(lit.text, ".") < 0 and bytes.index_of(lit.text, "e") < 0
    and bytes.index_of(lit.text, "E") < 0
}

fn is_comparison(op: Str) -> Bool =
  bytes.equal(op, "==") or bytes.equal(op, "!=") or bytes.equal(op, "<") or
  bytes.equal(op, "<=") or bytes.equal(op, ">") or bytes.equal(op, ">=")

# with_unit attaches a unit to a tensor result and leaves anything else alone.
fn with_unit(res: Type, u: Dict[Str, I64]) -> Type {
  match as_tensor(res) {
    Some(t) => tensor_with_unit(t.dims, u),
    None => res,
  }
}

fn arith_unit(c: Checker, op: Str, a: TensorType, b: TensorType, line: I64) -> Dict[Str, I64] {
  if bytes.equal(op, "+") or bytes.equal(op, "-") or bytes.equal(op, "%") {
    # Adding a length to a price is the mistake units exist to catch.
    if not unit_equal(a.unit, b.unit) {
      report(c, line, bytes.concat("unit mismatch: ", bytes.concat(unit_string(a.unit),
        bytes.concat(" ", bytes.concat(op, bytes.concat(" ", unit_string(b.unit)))))))
    }
    return a.unit
  }
  if bytes.equal(op, "*") { return unit_mul(a.unit, b.unit) }
  if bytes.equal(op, "/") { return unit_div(a.unit, b.unit) }
  dict_new()
}

# A dimensionless base can be raised to anything. A quantity with a unit cannot:
# USD^x has no unit unless x is a constant integer, and reporting that is better
# than silently erasing the unit and letting the mistake continue.
fn pow_unit(c: Checker, lt: TensorType, ex: ast.Binary) -> Type {
  if len(lt.unit) == 0 { return TTensor(lt) }
  match const_int(ex.right) {
    Some(k) => TTensor(TensorType { dims: lt.dims, unit: unit_pow(lt.unit, k), dtype: lt.dtype }),
    None => {
      report(c, ex.line, bytes.concat("a quantity with unit ", bytes.concat(unit_string(lt.unit),
        " can only be raised to a constant integer power")))
      tensor_of(lt.dims)
    },
  }
}

fn infer_index(c: Checker, ex: ast.Index, env: CheckEnv) -> Type {
  let t: Type = infer_expr(c, ex.target, env)
  infer_expr(c, ex.index, env)
  match t {
    TTensor(v) => {
      if is_scalar(v) {
        report(c, ex.line, "cannot index a scalar")
        return TUnknown
      }
      # A constant index into a known-length axis is bounds-checkable: twill
      # indexes from 0 with no negative wraparound, so anything outside [0, len)
      # is the error the runtime raises.
      if v.dims[0] >= 0 {
        match const_int(ex.index) {
          Some(idx) => if idx < 0 or idx >= v.dims[0] {
            report(c, ex.line, bytes.concat("index ", bytes.concat(str(idx),
              bytes.concat(" out of range [0, ", bytes.concat(str(v.dims[0]), ")")))))
          },
          None => unit,
        }
      }
      # Indexing removes the leading axis. The unit and the dtype ride along,
      # because x[0] of a price list is a price and x[0] of a bf16 tensor is
      # a bf16 value.
      if len(v.dims) == 1 {
        return set_dtype(tensor_with_unit(arr_new(), v.unit), v.dtype)
      }
      set_dtype(tensor_with_unit(tail(v.dims), v.unit), v.dtype)
    },
    # A list is heterogeneous, so an element's type is not knowable from the
    # list's.
    TList(_) => TUnknown,
    _ => TUnknown,
  }
}

fn infer_slice(c: Checker, ex: ast.Slice, env: CheckEnv) -> Type {
  let t: Type = infer_expr(c, ex.target, env)
  match ex.start {
    Some(e) => infer_expr(c, e, env),
    None => unit,
  }
  match ex.end {
    Some(e) => infer_expr(c, e, env),
    None => unit,
  }
  match t {
    TTensor(v) => {
      if len(v.dims) == 0 {
        report(c, ex.line, "cannot slice a scalar")
        return TUnknown
      }
      # The trailing axes survive a slice; only the first changes. A negative
      # endpoint counts from the end, then the slice must satisfy
      # 0 <= start <= end <= dim0 -- the runtime's rule, checked here when the
      # first dim and both endpoints are known, so "slice [a:b] out of range for
      # first dim n" is raised before the program runs.
      let first: I64 = -1
      let s: I64 = 0
      let sok: Bool = true
      match ex.start {
        Some(e) => {
          match const_int(e) {
            Some(n) => s = n,
            None => sok = false,
          }
        },
        None => unit,
      }
      let en: I64 = 0
      let eok: Bool = false
      match ex.end {
        Some(e) => {
          match const_int(e) {
            Some(n) => { en = n; eok = true },
            None => unit,
          }
        },
        None => unit,
      }
      let dim0: I64 = v.dims[0]
      if dim0 >= 0 and sok {
        let lo: I64 = s
        if lo < 0 { lo = lo + dim0 }
        let hi: I64 = dim0
        if eok {
          hi = en
          if hi < 0 { hi = hi + dim0 }
        }
        if lo < 0 or hi > dim0 or lo > hi {
          report(c, ex.line, bytes.concat("slice [", bytes.concat(str(lo),
            bytes.concat(":", bytes.concat(str(hi), bytes.concat("] out of range for first dim ", str(dim0)))))))
          return TUnknown
        }
        first = hi - lo
      } else {
        if eok and sok and en - s >= 0 { first = en - s }
      }
      let dims: Arr[I64] = arr_new()
      push(dims, first)
      let i: I64 = 1
      while i < len(v.dims) {
        push(dims, v.dims[i])
        i = i + 1
      }
      set_dtype(tensor_with_unit(dims, v.unit), v.dtype)
    },
    TList(_) => TList(ListType { elems: None }),
    _ => TUnknown,
  }
}

# ---- shape rules -----------------------------------------------------------

# ShapeResult is a type plus a message. An empty message means success; the Go
# side returns (Type, string) and the emptiness is the same signal.
struct ShapeResult {
  type: Type,
  msg: Str,
}

# broadcast_dims applies NumPy broadcasting to two shapes that may contain
# unknown dimensions. It fails only when a mismatch is *certain*: both sizes
# known, unequal, and neither is 1. An unknown against a known 1 stays unknown,
# because the unknown side might be anything and 1 broadcasts to all of it.
struct Broadcast {
  dims: Arr[I64],
  ok: Bool,
}

fn broadcast_dims(a: TensorType, b: TensorType) -> Broadcast {
  let ra: I64 = len(a.dims)
  let rb: I64 = len(b.dims)
  let r: I64 = ra
  if rb > r { r = rb }
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < r {
    push(out, 0)
    i = i + 1
  }
  i = 0
  while i < r {
    # Broadcasting aligns from the trailing axis, so both shapes are read from
    # the right. A missing axis is an implicit 1.
    let da: I64 = 1
    let db: I64 = 1
    let a_known: Bool = true
    let b_known: Bool = true
    if i < ra {
      da = a.dims[ra - 1 - i]
      a_known = da >= 0
    }
    if i < rb {
      db = b.dims[rb - 1 - i]
      b_known = db >= 0
    }
    let d: I64 = 0
    if not a_known and not b_known {
      d = -1
    } else {
      if not a_known {
        if db == 1 { d = -1 } else { d = db }
      } else {
        if not b_known {
          if da == 1 { d = -1 } else { d = da }
        } else {
          if da == db {
            d = da
          } else {
            if da == 1 {
              d = db
            } else {
              if db == 1 {
                d = da
              } else {
                return Broadcast { dims: arr_new(), ok: false }
              }
            }
          }
        }
      }
    }
    out[r - 1 - i] = d
    i = i + 1
  }
  Broadcast { dims: out, ok: true }
}

fn elementwise_result(a: TensorType, b: TensorType) -> ShapeResult {
  let bc: Broadcast = broadcast_dims(a, b)
  if not bc.ok {
    return ShapeResult {
      type: TUnknown,
      msg: bytes.concat("shape mismatch: ", bytes.concat(dims_string(a),
        bytes.concat(" vs ", bytes.concat(dims_string(b), " cannot broadcast")))),
    }
  }
  ShapeResult { type: tensor_of(bc.dims), msg: "" }
}

# A rank-1 operand to `@` is promoted: on the left it is a row, on the right a
# column, and the result drops the promoted axis again. That is the numpy rule
# and it is what makes `v @ M` and `M @ v` both mean what a reader expects.
fn matmul_result(a: TensorType, b: TensorType) -> ShapeResult {
  # `@` is a plain matrix product: it takes 1-D or 2-D operands and has no
  # batched form, so a scalar (rank 0) or a rank-3-or-higher operand is a certain
  # runtime error, not an unknown shape to leave alone. The rank is structural and
  # known even when the sizes are not, so it is caught here rather than only when
  # the program runs.
  if len(a.dims) < 1 or len(a.dims) > 2 or len(b.dims) < 1 or len(b.dims) > 2 {
    return ShapeResult {
      type: TUnknown,
      msg: bytes.concat("@ (matmul) requires 1-D or 2-D operands, got ",
        bytes.concat(dims_string(a), bytes.concat(" @ ", dims_string(b)))),
    }
  }
  let a2: Arr[I64] = a.dims
  if len(a.dims) == 1 {
    a2 = arr_new()
    push(a2, 1)
    push(a2, a.dims[0])
  }
  let b2: Arr[I64] = b.dims
  if len(b.dims) == 1 {
    b2 = arr_new()
    push(b2, b.dims[0])
    push(b2, 1)
  }
  # A rank-0 (scalar) operand reaches here, which `@` also rejects, but the sizes
  # tell nothing useful, so it says nothing rather than guessing. This returns
  # Unknown with no message, a success with no information, not a failure.
  if len(a2) != 2 or len(b2) != 2 {
    return ShapeResult { type: TUnknown, msg: "" }
  }
  let k: I64 = a2[1]
  let k2: I64 = b2[0]
  if k >= 0 and k2 >= 0 and k != k2 {
    return ShapeResult {
      type: TUnknown,
      msg: bytes.concat("shape mismatch in @: ", bytes.concat(dims_string(a),
        bytes.concat(" @ ", bytes.concat(dims_string(b),
        bytes.concat(" (inner ", bytes.concat(str(k),
        bytes.concat(" != ", bytes.concat(str(k2), ")")))))))),
    }
  }
  let m: I64 = a2[0]
  let n: I64 = b2[1]
  if len(a.dims) == 1 and len(b.dims) == 1 {
    return ShapeResult { type: scalar(), msg: "" }
  }
  let dims: Arr[I64] = arr_new()
  if len(a.dims) == 1 {
    push(dims, n)
    return ShapeResult { type: tensor_of(dims), msg: "" }
  }
  if len(b.dims) == 1 {
    push(dims, m)
    return ShapeResult { type: tensor_of(dims), msg: "" }
  }
  push(dims, m)
  push(dims, n)
  ShapeResult { type: tensor_of(dims), msg: "" }
}

# linear(x, W) = x @ transpose(W). x is 1-D [k] or 2-D [m,k]; W is the dense
# weight, 2-D [n,k]. The contracted dim is the last of each. Mirrors the Go
# checker's linearResult so the two report the same shape errors.
fn linear_result(a: TensorType, w: TensorType) -> ShapeResult {
  if len(a.dims) < 1 or len(a.dims) > 2 {
    return ShapeResult {
      type: TUnknown,
      msg: bytes.concat("linear requires a 1-D or 2-D input, got ", dims_string(a)),
    }
  }
  if len(w.dims) != 2 {
    return ShapeResult {
      type: TUnknown,
      msg: bytes.concat("linear requires a 2-D weight, got ", dims_string(w)),
    }
  }
  let k: I64 = a.dims[len(a.dims) - 1]
  let n: I64 = w.dims[0]
  let k2: I64 = w.dims[1]
  if k >= 0 and k2 >= 0 and k != k2 {
    return ShapeResult {
      type: TUnknown,
      msg: bytes.concat("shape mismatch in linear: ", bytes.concat(dims_string(a),
        bytes.concat(" @ ", bytes.concat(dims_string(w),
        bytes.concat("ᵀ (inner ", bytes.concat(str(k),
        bytes.concat(" != ", bytes.concat(str(k2), ")")))))))),
    }
  }
  let dims: Arr[I64] = arr_new()
  if len(a.dims) == 1 {
    push(dims, n)
    return ShapeResult { type: tensor_of(dims), msg: "" }
  }
  push(dims, a.dims[0])
  push(dims, n)
  ShapeResult { type: tensor_of(dims), msg: "" }
}

# element_count multiplies a shape out, when every dimension is known.
#
# An unknown dimension makes the product meaningless rather than small, so this
# reports nothing instead of a number that would produce a confident wrong
# answer about a reshape.
struct Count {
  n: I64,
  ok: Bool,
}

# report_neg_dim flags a constructor asked for a negative dimension. Untyped it
# reaches the runtime as an allocation with a negative length and panics there
# ("makeslice: len out of range"), which names nothing; caught here it reads like
# any other shape diagnostic.
fn report_neg_dim(c: Checker, line: I64, name: Str, dims: Arr[I64]) -> Bool {
  let i: I64 = 0
  while i < len(dims) {
    if dims[i] < 0 {
      report(c, line, bytes.concat(name, bytes.concat(": dimension ",
        bytes.concat(str(dims[i]), " is negative"))))
      return true
    }
    i = i + 1
  }
  false
}

fn element_count(dims: Arr[I64]) -> Count {
  let n: I64 = 1
  let i: I64 = 0
  while i < len(dims) {
    if dims[i] < 0 { return Count { n: 0, ok: false } }
    n = n * dims[i]
    i = i + 1
  }
  Count { n: n, ok: true }
}

# list_dims reads the shape of a nested list literal, when it is one a tensor
# can be built from.
#
# Ragged input reports no shape rather than the first row's. `[[1, 2], [3]]` is
# an error at run time, and inventing a shape for it here would produce a
# second, imaginary error somewhere downstream instead of the real one.
struct Dims {
  dims: Arr[I64],
  ok: Bool,
}

fn no_dims() -> Dims = Dims { dims: arr_new(), ok: false }

fn list_dims(t: Type) -> Dims {
  let lst: ListType = ListType { elems: None }
  match t {
    TList(v) => lst = v,
    _ => return no_dims(),
  }
  let elems: Arr[Type] = arr_new()
  match lst.elems {
    Some(v) => elems = v,
    None => return no_dims(),
  }
  if len(elems) == 0 {
    let d: Arr[I64] = arr_new()
    push(d, 0)
    return Dims { dims: d, ok: true }
  }

  # Every element has to agree, both on being a list and on its shape, or the
  # literal is ragged.
  let nested: Bool = false
  match elems[0] {
    TList(_) => nested = true,
    _ => nested = false,
  }
  if nested {
    let first: Dims = list_dims(elems[0])
    if not first.ok { return no_dims() }
    let i: I64 = 1
    while i < len(elems) {
      let d: Dims = list_dims(elems[i])
      if not d.ok or not same_dims(d.dims, first.dims) { return no_dims() }
      i = i + 1
    }
    let out: Arr[I64] = arr_new()
    push(out, len(elems))
    let k: I64 = 0
    while k < len(first.dims) {
      push(out, first.dims[k])
      k = k + 1
    }
    return Dims { dims: out, ok: true }
  }

  # A flat list of scalars is one dimension. A scalar here is a tensor with no
  # dimensions, which is how a number types in this checker.
  let i: I64 = 0
  while i < len(elems) {
    match as_tensor(elems[i]) {
      Some(e) => {
        if len(e.dims) != 0 { return no_dims() }
      },
      None => return no_dims(),
    }
    i = i + 1
  }
  let out: Arr[I64] = arr_new()
  push(out, len(elems))
  Dims { dims: out, ok: true }
}

# ---- calls -----------------------------------------------------------------

# `x.to(f32)` casts x, lowering to tensor.cast (docs/dtypes.md). NEEDS-110
# adds the surface syntax; here it is only a call whose callee is field access
# named `to` with exactly one dtype-name argument, which is what it parses to
# today. The dims and the unit ride through unchanged, because a cast changes
# the values' format and nothing about what they mean. A target the checker
# cannot see as a tensor makes the whole thing unknown and says nothing: `to`
# may be a record field, and the runtime is the one that gets to reject a
# cast of the uncastable.
fn infer_cast(c: Checker, ex: ast.Call, env: CheckEnv) -> Opt[Type] {
  match ex.callee {
    EField(fld) => {
      if not bytes.equal(fld.name, "to") { return None }
      if len(ex.args) != 1 { return None }
      let dt: I64 = dtype_token(env, ex.args[0])
      if not dtype_known(dt) { return None }
      let target: Type = infer_expr(c, fld.target, env)
      match as_tensor(target) {
        Some(t) => Some(TTensor(TensorType { dims: t.dims, unit: t.unit, dtype: dt })),
        None => Some(TUnknown),
      }
    },
    _ => None,
  }
}

fn infer_call(c: Checker, ex: ast.Call, env: CheckEnv) -> Type {
  match infer_cast(c, ex, env) {
    Some(t) => return t,
    None => unit,
  }
  let saved_in_callee: Bool = c.in_callee
  c.in_callee = true
  let callee: Type = infer_expr(c, ex.callee, env)
  c.in_callee = saved_in_callee
  # A trailing dtype name on a constructor, `bf16` in `zeros([784, 128],
  # bf16)`, is an argument in the source and not a value in the program. It is
  # not meant to resolve, so inferring it would report a typo that is not one.
  let ctor_dt: I64 = DT_UNKNOWN
  match callee {
    TBuiltin(b) => {
      if in_set(b.name, "zeros ones fill randn rand eye scalar tensor") and len(ex.args) > 0 {
        ctor_dt = dtype_token(env, ex.args[len(ex.args) - 1])
      }
    },
    _ => unit,
  }
  # With a trailing dtype, the maker sees only the arguments before it: its shape
  # comes from them and its arity is counted over them, so `scalar(1.5, f32)` and
  # `eye(3, f32)` pass the fixed-arity check the same as without the dtype.
  let n: I64 = len(ex.args)
  if dtype_known(ctor_dt) { n = n - 1 }
  let call_args: Arr[ast.Expr] = arr_new()
  let arg_types: Arr[Type] = arr_new()
  let i: I64 = 0
  while i < n {
    push(call_args, ex.args[i])
    push(arg_types, infer_expr(c, ex.args[i], env))
    i = i + 1
  }
  let call_ex: ast.Call = ex
  if dtype_known(ctor_dt) {
    call_ex = ast.Call { id: ex.id, callee: ex.callee, args: call_args, line: ex.line }
  }
  match callee {
    TBuiltin(fn_) => {
      # A builtin whose result type is fixed is typed from the table, so a value
      # from one of them can be checked where it lands. The arity check the
      # shape cases would have made still applies.
      match systems_builtin_result(fn_.name, arg_types) {
        Some(t) => {
          let arity: I64 = builtin_fixed_arity(fn_.name)
          if arity >= 0 and len(call_ex.args) != arity {
            report(c, ex.line, bytes.concat(fn_.name, bytes.concat(" expects ",
              bytes.concat(str(arity), bytes.concat(" argument(s), got ", str(len(call_ex.args)))))))
            return TUnknown
          }
          return t
        },
        None => unit,
      }
      infer_builtin_call(c, fn_.name, call_ex, arg_types, ctor_dt)
    },
    TFn(fn_) => infer_user_call(c, fn_, call_ex, arg_types),
    TCtor(ctor) => call_ctor(c, ctor, ex.line, arg_types, call_ex.args),
    TFnType(ft) => call_fn_type(c, ft, ex.line, arg_types),
    TUnknown => TUnknown,
    # A number is not callable either, but `f(x)` where f is a tensor is a
    # plausible typo for indexing and worth naming. TFn and TBuiltin are handled
    # above; everything left is a definite mistake.
    _ => {
      report(c, ex.line, "value is not callable")
      TUnknown
    },
  }
}

# call_ctor is the type of applying a variant constructor to its payload:
# Some(x) is Opt[type of x], Ok(x) a Res whose error type is not yet known, and
# a user variant its enum.
fn call_ctor(c: Checker, ctor: CtorType, line: I64, args: Arr[Type],
             arg_exprs: Arr[ast.Expr]) -> Type {
  let bare: Type = TEnum(EnumType { name: ctor.owner, args: arr_new() })
  if len(args) != 1 {
    report(c, line, bytes.concat(ctor.variant, bytes.concat(" expects 1 argument(s), got ",
      str(len(args)))))
    return bare
  }
  if bytes.equal(ctor.owner, "Opt") {
    let a: Arr[Opt[Type]] = arr_new()
    push(a, Some(args[0]))
    return TEnum(EnumType { name: "Opt", args: a })
  }
  if bytes.equal(ctor.owner, "Res") {
    let a: Arr[Opt[Type]] = arr_new()
    if bytes.equal(ctor.variant, "Ok") {
      push(a, Some(args[0]))
      push(a, None)
    } else {
      push(a, None)
      push(a, Some(args[0]))
    }
    return TEnum(EnumType { name: "Res", args: a })
  }
  match ctor.payload {
    Some(pl) => {
      let params: Arr[Str] = match dict_get(c.type_params, ctor.owner) {
        Some(ps) => ps,
        None => arr_new(),
      }
      if len(params) > 0 {
        # `Leaf(7)` is a `Tree[I64]`: the argument is read back out of the
        # payload rather than written at the call, which is the only way a
        # constructor can produce a generic value at all. A parameter the
        # payload does not mention stays unknown.
        let binding: Dict[Str, Type] = dict_new()
        infer_params(pl, args[0], binding)
        let inferred: Arr[Opt[Type]] = arr_new()
        for p in params {
          push(inferred, dict_get(binding, p))
        }
        return TEnum(EnumType { name: ctor.owner, args: inferred })
      }
      let what: Str = bytes.concat("the payload of ", ctor.variant)
      if check_assignable(c, line, what, pl, args[0]) and len(arg_exprs) == 1 {
        fractional_literal_at_int(c, line, what, pl, arg_exprs[0])
      }
    },
    None => unit,
  }
  bare
}

# call_fn_type is a call through a value whose type is a declared function type
# rather than a body this checker can walk: the arity and the argument types
# are all it knows, and the result is the declared return type.
fn call_fn_type(c: Checker, ft: FnTypeAnno, line: I64, arg_types: Arr[Type]) -> Type {
  if len(ft.params) != len(arg_types) {
    report(c, line, bytes.concat("function expects ", bytes.concat(str(len(ft.params)),
      bytes.concat(" argument(s), got ", str(len(arg_types))))))
    return TUnknown
  }
  let i: I64 = 0
  while i < len(ft.params) {
    check_assignable(c, line, bytes.concat("argument ", str(i + 1)), ft.params[i], arg_types[i])
    i = i + 1
  }
  ft.ret
}

# param_type gives a parameter's type from its annotation alone, for checking a
# body at its definition. Shape variables and unannotated params are unknown,
# which is why a definition-time check reports only definite errors.
fn param_type(c: Checker, p: ast.Param) -> Type {
  match p.unit {
    Some(u) => return tensor_with_unit(arr_new(), unit_from_anno(u)),
    None => unit,
  }
  if len(p.type_name) > 0 {
    match dict_get(c.types, p.type_name) {
      Some(t) => return TRecord(t),
      None => unit,
    }
    if dict_has(c.units, p.type_name) {
      let u: Dict[Str, I64] = dict_new()
      dict_set(u, p.type_name, 1)
      return tensor_with_unit(arr_new(), u)
    }
    return parse_type(c, p.type_name)
  }
  match p.shape {
    Some(s) => tensor_of(ast.concrete_dims(s)),
    None => TUnknown,
  }
}

fn check_fn_def(c: Checker, fd: ast.FnDecl, env: CheckEnv) {
  if dict_has(c.stack, fd.id) { return }
  # A generic function's parameters are in scope for its signature and its body
  # alike, so `fn first[T](xs: Arr[T]) -> T` reads both the annotation and the
  # return type in terms of T.
  let shadowed: Dict[Str, Bool] = with_params(c, fd.type_params)
  let scope: CheckEnv = new_env(Some(env))
  let i: I64 = 0
  while i < len(fd.params) {
    let p: ast.Param = fd.params[i]
    match p.unit {
      Some(u) => resolve_unit(c, u, fd.line),
      None => unit,
    }
    env_define(scope, p.name, param_type(c, p))
    i = i + 1
  }
  match fd.ret_unit {
    Some(u) => if not is_advisory_type_anno(c, u) { resolve_unit(c, u, fd.line) },
    None => unit,
  }

  dict_set(c.stack, fd.id, true)
  let body_type: Type = infer_fn_body(c, fd.body, scope, ret_type_name(fd.ret_type, fd.ret_unit))
  dict_del(c.stack, fd.id)

  match fd.ret {
    Some(anno) => {
      let expected: TensorType = TensorType { dims: ast.concrete_dims(anno), unit: dict_new(), dtype: DT_UNKNOWN }
      match as_tensor(body_type) {
        Some(got) => {
          # Both sides must be fully known before this is a certain mismatch. A
          # signature with a shape variable in it is checked at the call site
          # instead, where the variable has a value.
          if fully_known(expected) and fully_known(got) and not shape_match(expected, got) {
            report(c, fd.line, bytes.concat("function ", bytes.concat(quoted(fd.name),
              bytes.concat(" returns ", bytes.concat(dims_string(got),
              bytes.concat(" but its signature declares ", dims_string(expected)))))))
          }
        },
        None => unit,
      }
    },
    None => unit,
  }
  match fd.ret_unit {
    Some(u) => if not is_advisory_type_anno(c, u) { check_return_unit(c, fd.line, fd.name, u, body_type) },
    None => unit,
  }
  check_body_return_type(c, fd.line, fd.name, ret_type_name(fd.ret_type, fd.ret_unit),
    body_type, fd.body)
  end_params(c, shadowed)
}

# A body is either a block, whose type is its last expression statement, or a
# single expression after `=`.
fn infer_fn_body(c: Checker, body: ast.Expr, scope: CheckEnv, ret: Str) -> Type {
  # A function body is a fresh scope for loop control, even when the call or the
  # definition sits inside a loop: a `break` in a `fn` written inside a loop is
  # an error, not a way out of that loop.
  let saved: I64 = c.loop_depth
  c.loop_depth = 0
  push(c.fn_ret, ret)
  let t: Type = match body {
    EBlock(blk) => infer_block(c, blk, scope),
    _ => infer_expr(c, body, scope),
  }
  pop(c.fn_ret)
  c.loop_depth = saved
  t
}

# is_advisory_type_anno reports whether a single-name return annotation is a type
# name rather than a unit, and only in a systems-mode file. A `-> Bool` or
# `-> Str`, whose name no `unit` declaration introduced, is a type return the
# dialect writes, advisory because the bootstrap has no such type. A `-> USD`
# where USD is a declared unit stays a unit and is checked; a compound
# annotation is always a unit; and in numeric mode nothing is advisory.
fn is_advisory_type_anno(c: Checker, u: ast.UnitAnno) -> Bool {
  if len(u.factors) != 1 or u.factors[0].exp != 1 or dict_has(c.units, u.factors[0].name) {
    return false
  }
  if c.systems { return true }
  # In numeric mode a bare name is ordinarily a unit, and an undeclared one is a
  # typo worth reporting. A name that is one of the dialect's own types is not:
  # `let b: Bool = true` is a correct numeric-mode program, and reporting it as
  # an unknown unit was a false positive in the default mode. The types exist at
  # run time in both modes; only the annotation syntax is systems-mode.
  is_known_type_name(u.factors[0].name)
}

# anno_head_name is a type annotation's head: `Arr` for `Arr[I64]`, and the
# whole text when there is no argument list.
fn anno_head_name(text: Str) -> Str {
  let i: I64 = bytes.index_of(text, "[")
  if i >= 0 { return text[0:i] }
  text
}

# is_known_type_name reports whether a bare annotation names one of the
# language's types rather than a unit of measure.
fn is_known_type_name(name: Str) -> Bool =
  in_set(name, "I64 F64 Bool Str Bytes Byte Unit Arr Dict Opt Res Tensor List")

fn check_return_unit(c: Checker, line: I64, name: Str, ret_unit: ast.UnitAnno, body_type: Type) {
  let want: Dict[Str, I64] = unit_from_anno(ret_unit)
  match as_tensor(body_type) {
    Some(got) => {
      if not unit_equal(got.unit, want) {
        let who: Str = "function"
        if len(name) > 0 {
          who = bytes.concat("function ", quoted(name))
        }
        report(c, line, bytes.concat(who, bytes.concat(" returns unit ",
          bytes.concat(unit_string(got.unit), bytes.concat(" but its signature declares ",
          unit_string(want))))))
      }
    },
    None => unit,
  }
}

fn infer_user_call(c: Checker, fn_: FnType, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  if len(fn_.params) != len(arg_types) {
    report(c, ex.line, bytes.concat("function expects ", bytes.concat(str(len(fn_.params)),
      bytes.concat(" argument(s), got ", str(len(arg_types))))))
    return TUnknown
  }

  # subst maps shape variables (n, k, ...) to the concrete sizes learned from
  # the arguments, so a variable used in several places must agree.
  let subst: Dict[Str, I64] = dict_new()
  let scope: CheckEnv = new_env(Some(fn_.env))
  let i: I64 = 0
  while i < len(fn_.params) {
    let p: ast.Param = fn_.params[i]
    let bound: Bool = false
    match p.unit {
      Some(u) => {
        let want: Dict[Str, I64] = unit_from_anno(u)
        check_arg_unit(c, ex.line, i, p.name, want, arg_types[i])
        env_define(scope, p.name, tensor_with_unit(arr_new(), want))
        bound = true
      },
      None => unit,
    }
    if not bound and len(p.type_name) > 0 {
      bound = true
      match dict_get(c.types, p.type_name) {
        Some(expected) => {
          check_record_arg(c, ex.line, i, p.name, expected, arg_types[i])
          # The body sees the declared type, so field access in it is typed even
          # when the caller passed something the checker could not read.
          env_define(scope, p.name, TRecord(expected))
        },
        None => {
          if dict_has(c.units, p.type_name) {
            let want: Dict[Str, I64] = dict_new()
            dict_set(want, p.type_name, 1)
            check_arg_unit(c, ex.line, i, p.name, want, arg_types[i])
            env_define(scope, p.name, tensor_with_unit(arr_new(), want))
          } else {
            # In systems mode the name is a type the bootstrap has no definition
            # for (I64, Str, Arr[I64], cp.Caps). The annotation is advisory and
            # the type genuinely unknown, so the parameter is left unknown rather
            # than pinned to whatever the argument happened to be: pinning would
            # make indexing an `Arr[I64]` param a false error when a scalar was
            # passed. In numeric mode an unknown type name is still reported.
            # A systems-mode type (I64, Str, Arr[I64], fn(I64) -> F64) or a
            # name from another module (cp.Caps). The argument is checked
            # against the declared type when the checker knows it, and the
            # parameter is bound as the declared type, not as whatever the
            # argument happened to be, so a body indexing an Arr[I64] is not
            # judged by a scalar a test passed in. A name that is one of the
            # language's own types is a type in either mode, so numeric mode
            # does not report it as unknown.
            if c.systems or is_known_type_name(anno_head_name(p.type_name)) {
              let want: Type = parse_type(c, p.type_name)
              let what: Str = bytes.concat("argument ", bytes.concat(str(i + 1),
                bytes.concat(" (", bytes.concat(quoted(p.name), ")"))))
              if check_assignable(c, ex.line, what, want, arg_types[i]) and i < len(ex.args) {
                fractional_literal_at_int(c, ex.line, what, want, ex.args[i])
              }
              env_define(scope, p.name, want)
            } else {
              report(c, ex.line, bytes.concat("unknown type ", bytes.concat(quoted(p.type_name),
                bytes.concat(" on parameter ", quoted(p.name)))))
              env_define(scope, p.name, arg_types[i])
            }
          }
        },
      }
    }
    if not bound {
      match p.shape {
        Some(anno) => {
          bound = true
          match as_tensor(arg_types[i]) {
            Some(got) => {
              unify(c, ex.line, i, p.name, anno.dims, got.dims, subst)
              # Use the concrete argument shape in the body, not the annotation:
              # the annotation may contain variables and the argument does not.
              env_define(scope, p.name, TTensor(got))
            },
            None => env_define(scope, p.name, tensor_of(ast.concrete_dims(anno))),
          }
        },
        None => unit,
      }
    }
    if not bound {
      env_define(scope, p.name, arg_types[i])
    }
    i = i + 1
  }

  # Guard against infinite recursion during inference. A recursive function is
  # answered from its signature, which is the only thing available without
  # running the inference that is already in progress.
  if dict_has(c.stack, fn_.node_id) {
    match fn_.ret {
      Some(anno) => return tensor_of(substitute(anno.dims, subst)),
      None => unit,
    }
    match fn_.ret_unit {
      Some(u) => if not is_advisory_type_anno(c, u) { return tensor_with_unit(arr_new(), unit_from_anno(u)) },
      None => unit,
    }
    return TUnknown
  }

  dict_set(c.stack, fn_.node_id, true)
  let body_type: Type = infer_fn_body(c, fn_.body, scope, ret_type_name(fn_.ret_type, fn_.ret_unit))
  dict_del(c.stack, fn_.node_id)
  check_body_return_type(c, ex.line, "", ret_type_name(fn_.ret_type, fn_.ret_unit),
    body_type, fn_.body)

  match fn_.ret {
    Some(anno) => {
      let expected_dims: Arr[I64] = substitute(anno.dims, subst)
      let expected: TensorType = TensorType { dims: expected_dims, unit: dict_new(), dtype: DT_UNKNOWN }
      match as_tensor(body_type) {
        Some(got) => {
          if fully_known(expected) and fully_known(got) and not shape_match(expected, got) {
            report(c, ex.line, bytes.concat("function returns ", bytes.concat(dims_string(got),
              bytes.concat(" but its signature declares ", dims_string(expected)))))
          }
          # Carry the body's unit and dtype through a shape return: a
          # signature that declares a shape says nothing about either, so
          # erasing them here would lose information the caller can use.
          return set_dtype(tensor_with_unit(expected_dims, got.unit), got.dtype)
        },
        None => return TTensor(expected),
      }
    },
    None => unit,
  }
  match fn_.ret_unit {
    Some(u) => if not is_advisory_type_anno(c, u) {
      check_return_unit(c, ex.line, "", u, body_type)
      return tensor_with_unit(arr_new(), unit_from_anno(u))
    },
    None => unit,
  }
  # A declared return type is what the call produces, whatever walking the body
  # concluded. That matters for a block body ending in `return`, which evaluates
  # to Unit as an expression: taking that as the call's type made a `read(p)?`
  # report that `?` needs a Res, on the commonest shape the feature has. The
  # signature is the contract; the body is checked against it separately.
  let declared: Type = parse_type(c, ret_type_name(fn_.ret_type, fn_.ret_unit))
  if not is_unknown_type(declared) { return declared }
  body_type
}

# A dimensionless value (a bare literal, or a computed quantity that carries no
# unit) is adopted into the parameter's unit; only a value that already carries
# a conflicting unit is an error.
fn check_arg_unit(c: Checker, line: I64, arg_idx: I64, name: Str,
                  want: Dict[Str, I64], arg: Type) {
  match as_tensor(arg) {
    Some(got) => {
      if len(got.unit) != 0 and not unit_equal(got.unit, want) {
        report(c, line, bytes.concat("argument ", bytes.concat(str(arg_idx + 1),
          bytes.concat(" (", bytes.concat(quoted(name),
          bytes.concat(") has unit ", bytes.concat(unit_string(got.unit),
          bytes.concat(" but the signature expects ", unit_string(want)))))))))
      }
    },
    None => unit,
  }
}

# check_record_arg verifies a record argument against a declared record type:
# every declared field must be present with a matching shape. Extra fields are
# allowed, because a record with more than the declared fields still satisfies
# everything the body can ask of it.
fn check_record_arg(c: Checker, line: I64, arg_idx: I64, name: Str,
                    expected: RecordType, arg: Type) {
  let rec: RecordType = RecordType { fields: dict_new(), name: "", args: [] }
  match as_record(arg) {
    Some(r) => rec = r,
    None => {
      # An unknown argument is not evidence of a mistake; anything else is.
      match arg {
        TUnknown => return,
        _ => {
          report(c, line, bytes.concat("argument ", bytes.concat(str(arg_idx + 1),
            bytes.concat(" (", bytes.concat(quoted(name), ") should be a record")))))
          return
        },
      }
    },
  }
  for field in dict_keys(expected.fields) {
    let ft: Type = dict_must(expected.fields, field)
    match dict_get(rec.fields, field) {
      None => report(c, line, bytes.concat("argument ", bytes.concat(str(arg_idx + 1),
        bytes.concat(" (", bytes.concat(quoted(name),
        bytes.concat(") is missing field ", quoted(field))))))),
      Some(got) => {
        match as_tensor(ft) {
          Some(want) => {
            match as_tensor(got) {
              Some(gt) => {
                if fully_known(want) and fully_known(gt) and not shape_match(want, gt) {
                  report(c, line, bytes.concat("argument ", bytes.concat(str(arg_idx + 1),
                    bytes.concat(" (", bytes.concat(quoted(name),
                    bytes.concat(") field ", bytes.concat(quoted(field),
                    bytes.concat(" is ", bytes.concat(dims_string(gt),
                    bytes.concat(" but the type declares ", dims_string(want)))))))))))
                }
              },
              None => unit,
            }
          },
          None => unit,
        }
      },
    }
  }
}

# unify checks an argument's shape against a parameter's annotation, recording
# shape variables in subst and reporting any definite mismatch.
fn unify(c: Checker, line: I64, arg_idx: I64, name: Str, pattern: Arr[ast.Dim],
         actual: Arr[I64], subst: Dict[Str, I64]) {
  if len(pattern) != len(actual) {
    # Only a definite mismatch when the argument's rank is fully known, which it
    # is here: actual comes from a tensor type, and a tensor always knows its
    # rank even when it does not know its sizes.
    report(c, line, bytes.concat("argument ", bytes.concat(str(arg_idx + 1),
      bytes.concat(" (", bytes.concat(quoted(name),
      bytes.concat(") has rank ", bytes.concat(str(len(actual)),
      bytes.concat(" but the signature expects rank ", str(len(pattern))))))))))
    return
  }
  let i: I64 = 0
  while i < len(pattern) {
    let pd: ast.Dim = pattern[i]
    let ad: I64 = actual[i]
    if ast.dim_is_concrete(pd) {
      if ad >= 0 and ad != pd.size {
        report(c, line, bytes.concat("argument ", bytes.concat(str(arg_idx + 1),
          bytes.concat(" (", bytes.concat(quoted(name),
          bytes.concat(") axis ", bytes.concat(str(i),
          bytes.concat(" is ", bytes.concat(str(ad),
          bytes.concat(" but the signature expects ", str(pd.size)))))))))))
      }
    } else {
      if len(pd.name) > 0 and ad >= 0 {
        match dict_get(subst, pd.name) {
          Some(prev) => {
            if prev != ad {
              report(c, line, bytes.concat("shape variable ", bytes.concat(quoted(pd.name),
                bytes.concat(" is ", bytes.concat(str(prev),
                bytes.concat(" elsewhere but ", bytes.concat(str(ad),
                bytes.concat(" in argument ", str(arg_idx + 1)))))))))
            }
          },
          None => dict_set(subst, pd.name, ad),
        }
      }
    }
    i = i + 1
  }
}

# substitute resolves an annotation's dims using known shape variables, leaving
# -1 for anything still unknown.
fn substitute(dims: Arr[ast.Dim], subst: Dict[Str, I64]) -> Arr[I64] {
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(dims) {
    let d: ast.Dim = dims[i]
    if ast.dim_is_concrete(d) {
      push(out, d.size)
    } else {
      if len(d.name) > 0 {
        match dict_get(subst, d.name) {
          Some(v) => push(out, v),
          None => push(out, -1),
        }
      } else {
        push(out, -1)
      }
    }
    i = i + 1
  }
  out
}

# ---- builtins --------------------------------------------------------------

# The names come from src/builtins.tw, the one list the evaluator reads too, so
# the checker's known-name set and the evaluator's dispatch set cannot drift
# (NEEDS-52). The Dict below stays, because is_builtin is called per identifier
# and the O(1) lookup is worth keeping; only the source of the names moved.
fn builtin_names() -> Arr[Str] {
  let a: Arr[Str] = arr_new()
  for name in split_words(builtins.NAMES) {
    push(a, name)
  }
  a
}

fn builtin_set() -> Dict[Str, Bool] {
  let d: Dict[Str, Bool] = dict_new()
  for name in builtin_names() {
    dict_set(d, name, true)
  }
  d
}

let BUILTINS: Dict[Str, Bool] = builtin_set()

fn is_builtin(name: Str) -> Bool = dict_has(BUILTINS, name)

fn split_words(s: Str) -> Arr[Str] {
  let out: Arr[Str] = arr_new()
  let start: I64 = 0
  let i: I64 = 0
  while i <= len(s) {
    if i == len(s) or s[i] == 32 {
      if i > start {
        push(out, s[start:i])
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn arg_tensor(arg_types: Arr[Type], i: I64) -> Opt[TensorType] {
  if i >= len(arg_types) { return None }
  as_tensor(arg_types[i])
}

# dt is the dtype named by a trailing dtype argument on a constructor call,
# `bf16` in `zeros([784, 128], bf16)`, or DT_UNKNOWN when there was none.
# infer_call read it before inferring the arguments, so when it is known the
# last entry of arg_types is a placeholder and the last entry of ex.args is
# not part of the shape.
# builtin_fixed_arity returns the argument count of a builtin the runtime
# registers with a fixed arity, or -1 for a variadic one (or a non-builtin).
# It mirrors the def(name, n, ...) calls in the interpreter; the variadic
# builtins -- those taking an optional axis, a run of dimensions, or a trailing
# flag -- are deliberately left out so their per-shape cases govern. Keep this in
# step with the Go checker's builtinArity table.
fn builtin_fixed_arity(name: Str) -> I64 {
  if in_set(name, "args arr_new bytes_new clock_now_ms dict_new gpu_available gpu_device_count is_tty_stdout rng_normal rng_uniform window_size") {
    return 0
  }
  if in_set(name, "relu exp log log1p expm1 sha256 sha256_bytes f64_log1p f64_expm1 sin cos tanh sigmoid sqrt square floor ceil round abort abs arr_clear black_box bnot buf_len buf_new bytes_to_str chr columns dict_keys emit_line enumerate env eye arr_of_tensor f64_bits f64_bits_hi f64_bits_lo f64_from_bits f64_hex f64_of_i64 f64_signbit f64_to_str gbm_describe grad grads hessian hvp jvp vjp dtype i64_of_f64 i64_of_str int item jacobian len list_dir load load_value module_source nbytes num_to_text permutation pop read_csv read_file read_frame rng_perm rng_seed scalar seed shape str str_quote str_to_f64 tensor value_and_grad write_err write_out") {
    return 1
  }
  if in_set(name, "matmul dot conv2d maximum minimum greater less greater_equal less_equal equal and or band bor xor shl shr ushr append arr_push buf_get8 bytes_push concat dict_del dict_get dict_has dict_must f64_from_halves f64_mod f64_pow field gather is_same linear map map_leaves maxpool2d pow push save save_value write_file write_frame zip_leaves") {
    return 2
  }
  if in_set(name, "arange buf_set8 clip dict_or dict_set fold linspace run slice where with_field") {
    return 3
  }
  -1
}

# The builtins whose arguments the runtime requires to be tensors or numbers.
# Deliberately a short, checked list rather than everything: len, map, fold,
# concat, append, sort, zip and the rest take lists on purpose, and reporting
# those would be the false positive that makes a checker worth turning off.
let TENSOR_ONLY: Str = "sum mean prod median max min argmax argmin exp log log1p expm1 sin cos tanh sigmoid sqrt square abs relu softmax logsumexp transpose reshape shape matmul dot linear broadcast_to cumsum cumprod flip roll diff"

# Whether a type certainly is not a tensor. TUnknown is not, which is what keeps
# an unannotated program silent.
fn definite_non_tensor(t: Type) -> Bool {
  match t {
    TBool => true,
    TStr => true,
    TUnit => true,
    TList(_) => true,
    TRecord(_) => true,
    TFn(_) => true,
    TBuiltin(_) => true,
    TArr(_) => true,
    TDict(_) => true,
    TEnum(_) => true,
    TBytes => true,
    TCtor(_) => true,
    TFnType(_) => true,
    TTuple(_) => true,
    # An I64 is a number, so it is not a definite non-tensor: it stands where a
    # scalar is wanted, the same softness the Go checker keeps. A type parameter
    # is whatever the use site chose, so it is not definitely anything.
    TInt => false,
    TTensor(_) => false,
    TParam(_) => false,
    TUnknown => false,
  }
}

# A type as a diagnostic names it. The wording matches the Go checker's
# typeString case for case, because the two implementations' diagnostics are
# compared byte for byte. A rank-0 tensor is F64 in a systems-mode file and
# "a scalar" elsewhere, which is why the checker is a parameter here.
fn type_text(c: Checker, t: Type) -> Str {
  match t {
    TInt => "I64",
    TTensor(v) => {
      if is_scalar(v) {
        if c.systems { return "F64" }
        return "a scalar"
      }
      bytes.concat("a tensor of shape ", dims_string(v))
    },
    TBool => "Bool",
    TStr => "Str",
    TBytes => "Bytes",
    TUnit => "Unit",
    TList(_) => "a list",
    TArr(v) => {
      match v.elem {
        Some(e) => bytes.concat("Arr[", bytes.concat(type_text(c, e), "]")),
        None => "Arr",
      }
    },
    TDict(v) => {
      let k: Type = match v.key {
        Some(x) => x,
        None => return "Dict",
      }
      let val: Type = match v.val {
        Some(x) => x,
        None => return "Dict",
      }
      bytes.concat("Dict[", bytes.concat(type_text(c, k),
        bytes.concat(", ", bytes.concat(type_text(c, val), "]"))))
    },
    TEnum(v) => {
      if len(v.args) == 0 { return v.name }
      let parts: Arr[Str] = arr_new()
      for a in v.args {
        match a {
          Some(x) => push(parts, type_text(c, x)),
          None => push(parts, "_"),
        }
      }
      bytes.concat(v.name, bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]")))
    },
    TCtor(v) => bytes.concat("the constructor ", v.variant),
    TRecord(v) => {
      if len(v.name) == 0 { return "a record" }
      if len(v.args) == 0 { return v.name }
      let parts: Arr[Str] = arr_new()
      for a in v.args {
        match a {
          Some(x) => push(parts, type_text(c, x)),
          None => push(parts, "_"),
        }
      }
      bytes.concat(v.name, bytes.concat("[", bytes.concat(bytes.join(parts, ", "), "]")))
    },
    TTuple(v) => {
      let parts: Arr[Str] = arr_new()
      for e in v.elems { push(parts, type_text(c, e)) }
      bytes.concat("(", bytes.concat(bytes.join(parts, ", "), ")"))
    },
    TParam(v) => v.name,
    TFn(_) => "a function",
    TBuiltin(_) => "a function",
    TFnType(_) => "a function",
    TUnknown => "an unknown value",
  }
}

fn infer_builtin_call(c: Checker, name: Str, ex: ast.Call, arg_types: Arr[Type], dt: I64) -> Type {
  # Every builtin the runtime registers with a fixed argument count rejects the
  # wrong count; that is decidable here, and this function is reached only when
  # the name is the real builtin (a same-named user function resolves elsewhere),
  # so a shadow keeps its own arity. Variadic builtins are absent from the table.
  let arity: I64 = builtin_fixed_arity(name)
  if arity >= 0 and len(ex.args) != arity {
    report(c, ex.line, bytes.concat(name, bytes.concat(" expects ", bytes.concat(str(arity),
      bytes.concat(" argument(s), got ", str(len(ex.args)))))))
    return TUnknown
  }
  # A builtin that works on tensors, handed something that is definitely not
  # one. Only the operands are checked, not the trailing arguments: reshape and
  # broadcast_to take their shape as a list of dimensions, and an axis is an
  # ordinary number.
  if in_set(name, TENSOR_ONLY) and len(arg_types) > 0 {
    let operands: I64 = 1
    if in_set(name, "matmul dot linear") {
      operands = 2
    }
    let i: I64 = 0
    while i < operands and i < len(arg_types) {
      if definite_non_tensor(arg_types[i]) {
        report(c, ex.line, bytes.concat(name, bytes.concat(" expects a tensor, but argument ",
          bytes.concat(str(i + 1), bytes.concat(" is ", type_text(c, arg_types[i]))))))
        return TUnknown
      }
      i = i + 1
    }
  }
  # Shape and unit preserved. So is the dtype: relu and clip preserve
  # integrality and keep it (tensor.unary_result_dtype).
  # Shape, unit and dtype ride through: stop_grad changes what a value
  # remembers, not what it is.
  if bytes.equal(name, "stop_grad") {
    match arg_tensor(arg_types, 0) {
      Some(t) => return TTensor(t),
      None => return TUnknown,
    }
  }
  if in_set(name, "relu clip") {
    match arg_tensor(arg_types, 0) {
      Some(t) => return TTensor(t),
      None => return TUnknown,
    }
  }
  # abs preserves shape and unit, but not an integer dtype; see
  # float_result_dtype for why that is unknown here rather than f32.
  if in_set(name, "abs") {
    match arg_tensor(arg_types, 0) {
      Some(t) => return set_dtype(TTensor(t), float_result_dtype(t.dtype)),
      None => return TUnknown,
    }
  }
  # softmax likewise preserves shape and dtype, but it normalises over one axis
  # and the runtime rejects an out-of-range one, so a constant axis is checked
  # here the same way the reductions check theirs.
  if in_set(name, "softmax") {
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        if len(ex.args) >= 2 and len(t.dims) > 0 {
          match const_int(ex.args[1]) {
            Some(ax0) => {
              let ax: I64 = ax0
              if ax < 0 { ax = ax + len(t.dims) }
              if ax < 0 or ax >= len(t.dims) { report_axis(c, ex, t) }
            },
            None => unit,
          }
        }
        return set_dtype(TTensor(t), float_result_dtype(t.dtype))
      },
      None => return TUnknown,
    }
  }
  # Transcendental functions need a dimensionless argument: exp(USD) is not a
  # quantity. The result is dimensionless whatever the input was.
  if in_set(name, "exp log log1p expm1 sin cos tanh sigmoid") {
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        if len(t.unit) != 0 {
          report(c, ex.line, bytes.concat(name, bytes.concat(
            " expects a dimensionless argument but got unit ", unit_string(t.unit))))
        }
        return set_dtype(tensor_of(t.dims), float_result_dtype(t.dtype))
      },
      None => return TUnknown,
    }
  }
  if bytes.equal(name, "sqrt") {
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        let r: UnitSqrt = unit_sqrt(t.unit)
        if not r.ok {
          report(c, ex.line, bytes.concat("sqrt of unit ", bytes.concat(unit_string(t.unit),
            " is not a whole unit")))
        }
        return set_dtype(tensor_with_unit(t.dims, r.unit), float_result_dtype(t.dtype))
      },
      None => return TUnknown,
    }
  }
  if bytes.equal(name, "square") {
    match arg_tensor(arg_types, 0) {
      Some(t) => return set_dtype(tensor_with_unit(t.dims, unit_pow(t.unit, 2)), t.dtype),
      None => return TUnknown,
    }
  }
  if bytes.equal(name, "int") { return tensor_of(arr_new()) }
  if bytes.equal(name, "item") {
    # item reads the sole element out, so a known count other than one is the
    # runtime error, caught here.
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        let cnt: Count = element_count(t.dims)
        if cnt.ok and cnt.n != 1 {
          report(c, ex.line, bytes.concat("item expects a single-element tensor, got ",
            dims_string(TensorType { dims: t.dims, unit: dict_new(), dtype: DT_UNKNOWN })))
        }
      },
      None => unit,
    }
    return scalar()
  }
  if bytes.equal(name, "len") { return scalar() }
  if in_set(name, "sum mean max min prod median") { return reduce_result(c, name, ex, arg_types) }
  if in_set(name, "argmax argmin logsumexp") { return axis_reduce_result(c, name, ex, arg_types) }
  if in_set(name, "maximum minimum greater less greater_equal less_equal equal") {
    return broadcast_two(c, name, ex, arg_types)
  }
  if bytes.equal(name, "where") { return broadcast_where(c, ex, arg_types) }
  if in_set(name, "reshape broadcast_to") { return reshape_result(c, name, ex, arg_types) }
  if bytes.equal(name, "einsum") { return infer_einsum(c, ex, arg_types) }
  if bytes.equal(name, "concat") { return infer_concat(c, ex, arg_types) }
  # fold's result is whatever the folded function returns, which depends on a
  # value the checker does not have.
  if bytes.equal(name, "fold") { return TUnknown }
  if bytes.equal(name, "split") { return infer_split(c, ex, arg_types) }
  if in_set(name, "append enumerate columns shape range list map zip permutation") {
    return TList(ListType { elems: None })
  }
  if in_set(name, "write_frame print save") { return TUnit }
  if bytes.equal(name, "scalar") {
    # scalar(x) really is f64 (tensor.tw), unlike a bare literal, whose
    # eventual dtype is still an open question; see the scalar() helper.
    if dtype_known(dt) { return tensor_with_dtype(arr_new(), dt) }
    return tensor_with_dtype(arr_new(), tensor.DT_F64)
  }
  if bytes.equal(name, "pow") { return pow_result(c, ex, arg_types) }
  if in_set(name, "matmul dot") {
    if len(arg_types) == 2 {
      match arg_tensor(arg_types, 0) {
        Some(a) => {
          match arg_tensor(arg_types, 1) {
            Some(b) => {
              let res: ShapeResult = matmul_result(a, b)
              if len(res.msg) > 0 {
                report(c, ex.line, res.msg)
                return TUnknown
              }
              return set_dtype(with_unit(res.type, unit_mul(a.unit, b.unit)),
                promote_and_warn(c, ex.line, a.dtype, b.dtype))
            },
            None => return TUnknown,
          }
        },
        None => return TUnknown,
      }
    }
    return TUnknown
  }
  # quantize(W) packs a weight to int8/int4 on the Go bootstrap; its result is an
  # opaque frozen weight, not a shaped tensor, so it types Unknown here exactly as
  # in the Go checker. nbytes(v) is a byte count, a scalar.
  if bytes.equal(name, "quantize") {
    # Quantisation packs a 2-D weight; any other rank is the runtime error, and a
    # tensor argument always carries its rank here.
    match arg_tensor(arg_types, 0) {
      Some(w) => {
        if len(w.dims) != 2 {
          report(c, ex.line, bytes.concat("quantize expects a 2-D weight, got rank ", str(len(w.dims))))
          return TUnknown
        }
      },
      None => unit,
    }
    return TUnknown
  }
  if bytes.equal(name, "nbytes") { return scalar() }
  if bytes.equal(name, "linear") {
    if len(arg_types) == 2 {
      match arg_tensor(arg_types, 0) {
        Some(a) => {
          match arg_tensor(arg_types, 1) {
            Some(w) => {
              let res: ShapeResult = linear_result(a, w)
              if len(res.msg) > 0 {
                report(c, ex.line, res.msg)
                return TUnknown
              }
              return set_dtype(with_unit(res.type, unit_mul(a.unit, w.unit)),
                promote_and_warn(c, ex.line, a.dtype, w.dtype))
            },
            None => return TUnknown,
          }
        },
        None => return TUnknown,
      }
    }
    return TUnknown
  }
  if bytes.equal(name, "transpose") { return transpose_result(c, ex, arg_types) }
  # A constructor without a dtype argument builds f64, the documented default
  # (docs/dtypes.md). With one, it builds what was named.
  #
  # `ex` arrives ALREADY STRIPPED of the trailing dtype -- infer_call removes it
  # before inferring the argument types, and passes what it found as `dt`. This
  # used to call drop_last_arg here as well, which took a second argument off:
  # `zeros(2, 3, bf16)` became `zeros(2)` and the checker reported the shape as
  # [2] where the runtime builds [2, 3], so a correct program was told its
  # shapes did not broadcast. The list form `zeros([2, 3], bf16)` lost its only
  # argument instead and degraded to unknown, which is why this hid.
  let ctor_dt: I64 = tensor.DT_F64
  let ctor_args: Arr[ast.Expr] = ex.args
  if dtype_known(dt) {
    ctor_dt = dt
  }
  if in_set(name, "zeros ones randn rand") {
    let s: Dims = const_shape(ctor_args, 0)
    if s.ok {
      if report_neg_dim(c, ex.line, name, s.dims) { return TUnknown }
      return tensor_with_dtype(s.dims, ctor_dt)
    }
    return TUnknown
  }
  if bytes.equal(name, "fill") {
    if len(ctor_args) >= 1 {
      let s: Dims = const_shape(ctor_args, 1)
      if s.ok {
        if report_neg_dim(c, ex.line, name, s.dims) { return TUnknown }
        return tensor_with_dtype(s.dims, ctor_dt)
      }
    }
    return TUnknown
  }
  if bytes.equal(name, "eye") {
    if len(ctor_args) == 1 {
      match const_int(ctor_args[0]) {
        Some(n) => {
          let one: Arr[I64] = arr_new()
          push(one, n)
          if report_neg_dim(c, ex.line, name, one) { return TUnknown }
          let d: Arr[I64] = arr_new()
          push(d, n)
          push(d, n)
          return tensor_with_dtype(d, ctor_dt)
        },
        None => return TUnknown,
      }
    }
    return TUnknown
  }
  # linspace(start, stop, n): a 1-D tensor whose length is the third argument,
  # known when it is a literal. arange's length depends on the values, so it has
  # a known rank and an unknown size.
  if bytes.equal(name, "linspace") {
    if len(ctor_args) == 3 {
      match const_int(ctor_args[2]) {
        Some(n) => {
          let one: Arr[I64] = arr_new()
          push(one, n)
          if report_neg_dim(c, ex.line, name, one) { return TUnknown }
          let d: Arr[I64] = arr_new()
          push(d, n)
          return tensor_with_dtype(d, ctor_dt)
        },
        None => unit,
      }
    }
    let du: Arr[I64] = arr_new()
    push(du, -1)
    return tensor_with_dtype(du, ctor_dt)
  }
  if bytes.equal(name, "arange") {
    let da: Arr[I64] = arr_new()
    push(da, -1)
    return tensor_with_dtype(da, ctor_dt)
  }
  # The loaded value's type depends on the file, so leave it unknown.
  if bytes.equal(name, "load") { return TUnknown }
  if bytes.equal(name, "str") { return TStr }
  # dtype(t) reads a tensor's dtype back as its name. A string, because a dtype
  # is a contextual name and not a value; see the builtin in src/eval.tw.
  if bytes.equal(name, "dtype") { return TStr }
  if bytes.equal(name, "tensor") { return tensor_builtin_result(arg_types, dt) }
  # These return values whose shape depends on runtime data; treat the result as
  # unknown so downstream code is not falsely flagged.
  if in_set(name, "grad grads value_and_grad jacobian hessian jvp vjp hvp gbm_fit") { return TUnknown }
  # A cumulative scan, a reversal, or elementwise rounding all preserve the
  # input's shape and dtype but not necessarily its unit, so the unit is
  # dropped.
  if in_set(name, "floor ceil round") {
    match arg_tensor(arg_types, 0) {
      Some(t) => return set_dtype(tensor_of(t.dims), t.dtype),
      None => return TUnknown,
    }
  }
  # A cumulative scan, a reversal, or a sort preserve the input's shape and take
  # the axis in the second argument; roll puts the shift first, so its axis is
  # the third. An out-of-range axis is the error the runtime raises.
  if in_set(name, "cumsum cumprod cummax cummin flip sort") {
    return axis_preserve_result(c, ex, arg_types, 1)
  }
  if bytes.equal(name, "roll") {
    return axis_preserve_result(c, ex, arg_types, 2)
  }
  # Take the k largest (or smallest) values along an axis. The result keeps the
  # input's shape with that axis shortened to k, so a k larger than the axis -- or
  # a non-positive k, or an out-of-range axis -- is the runtime error, all knowable
  # here when k, the axis and the dims are constant. The axis defaults to the last.
  if in_set(name, "topk argtopk") {
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        if len(t.dims) > 0 {
          let axis: I64 = len(t.dims) - 1
          if len(ex.args) > 2 {
            match const_int(ex.args[2]) {
              Some(a) => axis = a,
              None => return TUnknown,
            }
          }
          if axis < 0 { axis = axis + len(t.dims) }
          if axis < 0 or axis >= len(t.dims) {
            report_axis(c, ex, t)
            return TUnknown
          }
          if len(ex.args) > 1 {
            match const_int(ex.args[1]) {
              Some(k) => {
                let el: I64 = t.dims[axis]
                if k <= 0 {
                  report(c, ex.line, bytes.concat(name, bytes.concat(": k must be positive, got ", str(k))))
                  return TUnknown
                }
                if el >= 0 and k > el {
                  report(c, ex.line, bytes.concat(name, bytes.concat(": k is ", bytes.concat(str(k),
                    bytes.concat(" but axis ", bytes.concat(str(axis),
                    bytes.concat(" has length ", str(el))))))))
                  return TUnknown
                }
                let d: Arr[I64] = copy_dims(t.dims)
                d[axis] = k
                return tensor_of(d)
              },
              None => return TUnknown,
            }
          }
        }
        return TUnknown
      },
      None => return TUnknown,
    }
  }
  if bytes.equal(name, "diff") {
    # diff takes successive differences along an axis (second argument), shrinking
    # that axis by one. An out-of-range axis is the runtime error; it was
    # previously unchecked while flip, roll and the scans were not.
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        if len(t.dims) > 0 {
          # The axis defaults to the last one; only a constant is foldable.
          let a: I64 = len(t.dims) - 1
          let known: Bool = true
          if len(ex.args) > 1 {
            match const_int(ex.args[1]) {
              Some(ax) => a = ax,
              None => known = false,
            }
          }
          if known {
            if a < 0 { a = a + len(t.dims) }
            if a < 0 or a >= len(t.dims) {
              report_axis(c, ex, t)
              return TUnknown
            }
            # Successive differences need at least two elements along the axis;
            # one leaves nothing to subtract, the error the runtime raises.
            let el: I64 = t.dims[a]
            if el >= 0 and el < 2 {
              report(c, ex.line, bytes.concat("diff needs at least 2 elements along axis ",
                bytes.concat(str(a), bytes.concat(", got ", str(el)))))
              return TUnknown
            }
            let d: Arr[I64] = copy_dims(t.dims)
            if d[a] > 0 { d[a] = d[a] - 1 }
            return set_dtype(tensor_of(d), t.dtype)
          }
        }
        return TUnknown
      },
      None => return TUnknown,
    }
  }
  # Selecting rows keeps the trailing dims and the dtype, but the row count is
  # dynamic.
  if bytes.equal(name, "gather") {
    # The index selects rows, so it must be a 1-D list of positions; a rank-2 or
    # higher index is the runtime error, and its rank is known here.
    match arg_tensor(arg_types, 1) {
      Some(idx) => {
        if len(idx.dims) > 1 {
          report(c, ex.line, bytes.concat("gather expects a 1-D tensor or list of indices, got ",
            dims_string(TensorType { dims: idx.dims, unit: dict_new(), dtype: DT_UNKNOWN })))
          return TUnknown
        }
      },
      None => unit,
    }
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        if len(t.dims) >= 1 {
          let dims: Arr[I64] = copy_dims(t.dims)
          dims[0] = -1
          # A constant index list pins the row count and lets every position be
          # checked against the first dimension, the out-of-range runtime error.
          if len(ex.args) >= 2 {
            let idx: Dims = const_index_list(ex.args[1])
            if idx.ok {
              let n: I64 = t.dims[0]
              if n >= 0 {
                let i: I64 = 0
                while i < len(idx.dims) {
                  let ix: I64 = idx.dims[i]
                  if ix < 0 or ix >= n {
                    report(c, ex.line, bytes.concat("gather: index ", bytes.concat(str(ix),
                      bytes.concat(" out of range [0, ", bytes.concat(str(n), ")")))))
                    return TUnknown
                  }
                  i = i + 1
                }
              }
              dims[0] = len(idx.dims)
            }
          }
          return set_dtype(tensor_of(dims), t.dtype)
        }
        return TUnknown
      },
      None => return TUnknown,
    }
  }
  if bytes.equal(name, "conv2d") { return conv_result(c, ex, arg_types) }
  # [C, H, W] -> [C, H/k, W/k]; only the channel count is statically known.
  # A pool selects, so the dtype is the input's, unrounded.
  if bytes.equal(name, "maxpool2d") {
    # The arity (exactly the tensor and the window) is settled by the fixed table
    # above; here a non-rank-3 input is the error the runtime raises.
    let dims: Arr[I64] = arr_new()
    push(dims, -1)
    push(dims, -1)
    push(dims, -1)
    let pdt: I64 = DT_UNKNOWN
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        pdt = t.dtype
        if len(t.dims) == 3 {
          dims[0] = t.dims[0]
          # A constant window settles the pooled height and width, and the two
          # runtime rejections: a window below one, or one so large it pools
          # nothing (h/k or w/k rounds to zero).
          match const_int(ex.args[1]) {
            Some(k) => {
              if k < 1 {
                report(c, ex.line, bytes.concat("maxpool2d: window must be >= 1, got ", str(k)))
                return TUnknown
              }
              let h: I64 = t.dims[1]
              let w: I64 = t.dims[2]
              # h / k rounds to zero exactly when h < k (both non-negative); the
              # self-hosted `/` is float division, so the comparison is written
              # directly and the floor is taken with int() for the output dims.
              let h_empty: Bool = h >= 0 and h < k
              let w_empty: Bool = w >= 0 and w < k
              if h_empty or w_empty {
                report(c, ex.line, bytes.concat("maxpool2d: window ", bytes.concat(str(k),
                  bytes.concat(" is larger than input ", bytes.concat(str(h),
                  bytes.concat("x", str(w)))))))
                return TUnknown
              }
              if h >= 0 { dims[1] = int(h / k) }
              if w >= 0 { dims[2] = int(w / k) }
            },
            None => unit,
          }
        } else {
          report(c, ex.line, bytes.concat("maxpool2d: input must be [channels, height, width], got ", dims_string(t)))
        }
      },
      None => unit,
    }
    return set_dtype(tensor_of(dims), pdt)
  }
  # One score per row of the feature matrix, which is the second argument.
  if bytes.equal(name, "gbm_predict") {
    let dims: Arr[I64] = arr_new()
    push(dims, -1)
    if len(arg_types) == 2 {
      match arg_tensor(arg_types, 1) {
        Some(t) => {
          if len(t.dims) >= 1 {
            dims[0] = t.dims[0]
          }
        },
        None => unit,
      }
    }
    return tensor_of(dims)
  }
  TUnknown
}

fn in_set(name: Str, words: Str) -> Bool {
  for w in split_words(words) {
    if bytes.equal(w, name) { return true }
  }
  false
}

# The argument list without its trailing dtype name, for reading a
# constructor's shape once the dtype has been read off the end.
fn drop_last_arg(args: Arr[ast.Expr]) -> Arr[ast.Expr] {
  let out: Arr[ast.Expr] = arr_new()
  let i: I64 = 0
  while i < len(args) - 1 {
    push(out, args[i])
    i = i + 1
  }
  out
}

# A reshape has to preserve the element count, and when both sides are known
# that is arithmetic the checker can do. This is the second most common shape
# mistake after a bad matmul and it used to reach the runtime untouched.
fn reshape_result(c: Checker, name: Str, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  if len(ex.args) < 2 { return TUnknown }
  let s: Dims = const_shape(ex.args, 1)
  if not s.ok { return TUnknown }
  if bytes.equal(name, "reshape") {
    match arg_tensor(arg_types, 0) {
      Some(in_) => {
        let from: Count = element_count(in_.dims)
        if from.ok {
          # A negative target dimension is not an inferred axis: twill has no -1
          # reshape, so it is a certain error rather than the silent pass
          # element_count(s.dims) gives it (it bails on any negative).
          let neg: Bool = false
          let ni: I64 = 0
          while ni < len(s.dims) {
            if s.dims[ni] < 0 { neg = true }
            ni = ni + 1
          }
          if neg {
            report(c, ex.line, bytes.concat("reshape: cannot fit ",
              bytes.concat(str(from.n), bytes.concat(" elements into ",
              bytes.concat(dims_string(TensorType { dims: s.dims, unit: dict_new(), dtype: DT_UNKNOWN }),
              "; twill has no -1 dimension inference")))))
          } else {
            let to: Count = element_count(s.dims)
            if to.ok and from.n != to.n {
              report(c, ex.line, bytes.concat("reshape changes the number of elements: ",
                bytes.concat(dims_string(TensorType { dims: in_.dims, unit: dict_new(), dtype: DT_UNKNOWN }),
                bytes.concat(" has ", bytes.concat(str(from.n),
                bytes.concat(", ", bytes.concat(dims_string(TensorType { dims: s.dims, unit: dict_new(), dtype: DT_UNKNOWN }),
                bytes.concat(" needs ", str(to.n)))))))))
            }
          }
        }
      },
      None => unit,
    }
  }
  if bytes.equal(name, "broadcast_to") {
    # A source shape broadcasts to the target when, right-aligned, each of its
    # axes is 1 or equals the target's, and it has no more axes than the target.
    match arg_tensor(arg_types, 0) {
      Some(in_) => {
        if len(in_.dims) > len(s.dims) {
          report(c, ex.line, bytes.concat("cannot broadcast ",
            bytes.concat(dims_string(TensorType { dims: in_.dims, unit: dict_new(), dtype: DT_UNKNOWN }),
            bytes.concat(" to ", bytes.concat(dims_string(TensorType { dims: s.dims, unit: dict_new(), dtype: DT_UNKNOWN }),
            ": fewer axes in target")))))
        } else if not dims_broadcastable(in_.dims, s.dims) {
          report(c, ex.line, bytes.concat("cannot broadcast ",
            bytes.concat(dims_string(TensorType { dims: in_.dims, unit: dict_new(), dtype: DT_UNKNOWN }),
            bytes.concat(" to ", dims_string(TensorType { dims: s.dims, unit: dict_new(), dtype: DT_UNKNOWN })))))
        }
      },
      None => unit,
    }
  }
  # A reshape or a broadcast rearranges elements without re-rounding them, so
  # the dtype rides through.
  let rdt: I64 = DT_UNKNOWN
  match arg_tensor(arg_types, 0) {
    Some(in_) => rdt = in_.dtype,
    None => unit,
  }
  set_dtype(tensor_of(s.dims), rdt)
}

# Reports whether src, right-aligned against target, can broadcast to it: every
# known axis pair is equal or the source's is 1. The caller has already checked
# that src has no more axes than target. An unknown dimension is skipped.
fn dims_broadcastable(src: Arr[I64], target: Arr[I64]) -> Bool {
  let i: I64 = 1
  while i <= len(src) {
    let sd: I64 = src[len(src) - i]
    let td: I64 = target[len(target) - i]
    if sd >= 0 and td >= 0 and sd != td and sd != 1 { return false }
    i = i + 1
  }
  true
}

fn pow_result(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      # pow is a binary operation at run time, so it promotes like one.
      let edt: I64 = DT_UNKNOWN
      match arg_tensor(arg_types, 1) {
        Some(e) => edt = e.dtype,
        None => unit,
      }
      let dt: I64 = promote_and_warn(c, ex.line, t.dtype, edt)
      if len(t.unit) == 0 { return set_dtype(TTensor(t), dt) }
      if len(ex.args) >= 2 {
        match const_int(ex.args[1]) {
          Some(k) => return set_dtype(tensor_with_unit(t.dims, unit_pow(t.unit, k)), dt),
          None => unit,
        }
      }
      report(c, ex.line, bytes.concat("pow of a quantity with unit ",
        bytes.concat(unit_string(t.unit), " needs a constant integer exponent")))
      set_dtype(tensor_of(t.dims), dt)
    },
    None => TUnknown,
  }
}

# A tensor built from a literal has a shape the checker can read, and reading it
# is most of what makes the checker worth running. The mistake people actually
# make is `tensor([[1, 2], [3, 4]]) @ tensor([[1, 2, 3]])`, and it used to pass
# because this returned unknown for every argument. Anything that is not a
# literal still does.
fn tensor_builtin_result(arg_types: Arr[Type], dt: I64) -> Type {
  # When a trailing dtype argument was read, its placeholder entry is not part
  # of the value being built.
  let n: I64 = len(arg_types)
  if dtype_known(dt) { n = n - 1 }
  if n != 1 { return TUnknown }
  # A tensor literal was already given a shape on the way in, and `tensor(...)`
  # around it was throwing that away.
  match as_tensor(arg_types[0]) {
    Some(t) => {
      if dtype_known(dt) { return set_dtype(TTensor(t), dt) }
      return TTensor(t)
    },
    None => unit,
  }
  let d: Dims = list_dims(arg_types[0])
  if d.ok {
    let cdt: I64 = tensor.DT_F64
    if dtype_known(dt) { cdt = dt }
    return tensor_with_dtype(d.dims, cdt)
  }
  TUnknown
}

# contains_int reports whether a small integer list already holds a value; used
# to spot a repeated axis in a permutation, where the lists are a few elements.
fn contains_int(xs: Arr[I64], v: I64) -> Bool {
  let i: I64 = 0
  while i < len(xs) {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

# ints_bracketed renders a list of integers the way Go prints an []int with %v,
# space-separated in square brackets, so a diagnostic matches the runtime wording.
fn ints_bracketed(xs: Arr[I64]) -> Str {
  let out: Str = "["
  let i: I64 = 0
  while i < len(xs) {
    if i > 0 { out = bytes.concat(out, " ") }
    out = bytes.concat(out, str(xs[i]))
    i = i + 1
  }
  bytes.concat(out, "]")
}

fn transpose_result(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      if len(ex.args) == 1 {
        let rev: Arr[I64] = arr_new()
        let i: I64 = 0
        while i < len(t.dims) {
          push(rev, t.dims[len(t.dims) - 1 - i])
          i = i + 1
        }
        return set_dtype(tensor_of(rev), t.dtype)
      }
      let axes: Arr[I64] = arr_new()
      let i: I64 = 1
      while i < len(ex.args) {
        match const_int(ex.args[i]) {
          Some(ax) => push(axes, ax),
          None => return TUnknown,
        }
        i = i + 1
      }
      if len(axes) != len(t.dims) {
        # A permutation must name every axis exactly once, so a count other than
        # the rank is a certain error the runtime raises.
        if len(t.dims) > 0 {
          report(c, ex.line, bytes.concat("transpose: got ",
            bytes.concat(str(len(axes)), bytes.concat(" axes for a rank-",
            bytes.concat(str(len(t.dims)), " tensor")))))
        }
        return TUnknown
      }
      let perm: Arr[I64] = arr_new()
      let seen: Arr[I64] = arr_new()
      let k: I64 = 0
      while k < len(axes) {
        let ax: I64 = axes[k]
        # An axis outside the rank is the same mistake every other axis-taking
        # builtin reports through report_axis; transpose stayed silent, so a
        # permutation naming a nonexistent axis passed the check and failed only
        # at run time.
        if ax < 0 or ax >= len(t.dims) {
          report_axis(c, ex, t)
          return TUnknown
        }
        # A repeated axis leaves another unnamed, so it is not a permutation; the
        # runtime rejects it word for word.
        if contains_int(seen, ax) {
          report(c, ex.line, bytes.concat("transpose: invalid axis permutation ", ints_bracketed(axes)))
          return TUnknown
        }
        push(seen, ax)
        push(perm, t.dims[ax])
        k = k + 1
      }
      set_dtype(tensor_of(perm), t.dtype)
    },
    None => TUnknown,
  }
}

# report_axis names an axis that does not exist on the tensor it was given.
#
# This used to be detected and then swallowed: both reduction paths already
# worked out that the axis was out of range and returned an unknown type, which
# silences everything downstream as well. Detecting a mistake and saying nothing
# is the worst of the three options.
fn report_axis(c: Checker, ex: ast.Call, t: TensorType) {
  # A scalar has no axes at all, so the "numbered 0 to -1" the general form
  # would produce is nonsense. It is also the case the axis checks skipped, each
  # guarding on rank > 0 before validating, so `sum(1.0, 0)` reached the runtime.
  if len(t.dims) == 0 {
    report(c, ex.line, bytes.concat("a scalar has no axes, so there is no axis ",
      bytes.concat(axis_text(ex), " to reduce over")))
    return unit
  }
  report(c, ex.line, bytes.concat("axis out of range for ", bytes.concat(dims_string(t),
    bytes.concat(": it has ", bytes.concat(str(len(t.dims)),
    bytes.concat(" ", bytes.concat(plural(len(t.dims), "axis", "axes"),
    bytes.concat(", numbered 0 to ", str(len(t.dims) - 1)))))))))
}

# An axis given for a scalar, which has none. True when it reported, so the
# caller stops.
fn rank0_axis(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Bool {
  if len(arg_types) < 2 {
    return false
  }
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      if len(t.dims) != 0 {
        return false
      }
      match const_int(ex.args[1]) {
        Some(_) => {
          report_axis(c, ex, t)
          true
        },
        None => false,
      }
    },
    None => false,
  }
}

# The axis argument as written, for the scalar diagnostic.
fn axis_text(ex: ast.Call) -> Str {
  if len(ex.args) > 1 {
    match const_int(ex.args[1]) {
      Some(n) => return str(n),
      None => unit,
    }
  }
  "there"
}

fn plural(n: I64, one: Str, many: Str) -> Str {
  if n == 1 { return one }
  many
}

# reduce_result handles sum/mean/max/min/prod/median: no axis reduces to a
# scalar; a constant axis over a known shape removes that dimension. Reductions
# preserve the input's unit, because the mean of a list of prices is a price.
fn reduce_result(c: Checker, name: Str, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  let u: Dict[Str, I64] = dict_new()
  let rdt: I64 = DT_UNKNOWN
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      u = t.unit
      rdt = t.dtype
    },
    None => unit,
  }
  # A sum, a max or a prod stores the input's dtype. A mean or a median need
  # not be an integer (tensor.reduce_result_dtype), and float_result_dtype
  # explains why an integer input becomes unknown here rather than f32.
  if in_set(name, "mean median") { rdt = float_result_dtype(rdt) }
  if len(arg_types) == 1 {
    return set_dtype(tensor_with_unit(arr_new(), u), rdt)
  }
  if len(arg_types) == 2 {
    if rank0_axis(c, ex, arg_types) {
      return TUnknown
    }
    match arg_tensor(arg_types, 0) {
      Some(t) => {
        if len(t.dims) > 0 {
          match const_int(ex.args[1]) {
            Some(ax0) => {
              let ax: I64 = ax0
              # A negative axis counts from the end, which is the runtime's rule
              # and the one people write when they mean "the last axis".
              if ax < 0 { ax = ax + len(t.dims) }
              if ax >= 0 and ax < len(t.dims) {
                return set_dtype(tensor_with_unit(remove_dim(t.dims, ax), u), rdt)
              }
              report_axis(c, ex, t)
            },
            None => unit,
          }
        }
      },
      None => unit,
    }
  }
  TUnknown
}

# axis_preserve_result validates the optional axis of a shape-preserving axis op
# and returns the input tensor unchanged. axis_arg is the argument index the axis
# is passed in -- 1 for flip/cumsum/sort, 2 for roll, which puts the shift first.
# A constant axis outside the rank is the error the runtime raises; a non-constant
# axis, or a non-tensor argument (a list sorted by sort), is left alone.
fn axis_preserve_result(c: Checker, ex: ast.Call, arg_types: Arr[Type], axis_arg: I64) -> Type {
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      if len(ex.args) > axis_arg and len(t.dims) > 0 {
        match const_int(ex.args[axis_arg]) {
          Some(ax0) => {
            let ax: I64 = ax0
            if ax < 0 { ax = ax + len(t.dims) }
            if ax < 0 or ax >= len(t.dims) { report_axis(c, ex, t) }
          },
          None => unit,
        }
      }
      set_dtype(TTensor(t), t.dtype)
    },
    None => TUnknown,
  }
}

# axis_reduce_result handles argmax/argmin/logsumexp, which always reduce one
# axis and default to the last. The result is dimensionless: an index has no
# unit, and logsumexp's argument had to be dimensionless anyway.
fn axis_reduce_result(c: Checker, name: Str, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      if len(t.dims) == 0 { return TUnknown }
      let axis: I64 = len(t.dims) - 1
      if len(ex.args) == 2 {
        match const_int(ex.args[1]) {
          Some(ax) => axis = ax,
          None => return TUnknown,
        }
      }
      if axis < 0 { axis = axis + len(t.dims) }
      if axis < 0 or axis >= len(t.dims) {
        report_axis(c, ex, t)
        return TUnknown
      }
      # An index is i32 whatever it was taken over (tensor.tw); logsumexp
      # keeps a float dtype and declines an integer one.
      let rdt: I64 = float_result_dtype(t.dtype)
      if in_set(name, "argmax argmin") { rdt = tensor.DT_I32 }
      set_dtype(tensor_of(remove_dim(t.dims, axis)), rdt)
    },
    None => TUnknown,
  }
}

fn remove_dim(dims: Arr[I64], axis: I64) -> Arr[I64] {
  let out: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(dims) {
    if i != axis {
      push(out, dims[i])
    }
    i = i + 1
  }
  out
}

fn broadcast_two(c: Checker, name: Str, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  if len(arg_types) != 2 { return TUnknown }
  match arg_tensor(arg_types, 0) {
    Some(a) => {
      match arg_tensor(arg_types, 1) {
        Some(b) => {
          let res: ShapeResult = elementwise_result(a, b)
          if len(res.msg) > 0 {
            report(c, ex.line, res.msg)
            return TUnknown
          }
          # A comparison produces bool whatever it was handed; maximum and
          # minimum promote like any other binary operation.
          if in_set(name, "greater less greater_equal less_equal equal") {
            return set_dtype(res.type, tensor.DT_BOOL)
          }
          set_dtype(res.type, promote_and_warn(c, ex.line, a.dtype, b.dtype))
        },
        None => TUnknown,
      }
    },
    None => TUnknown,
  }
}

# where(cond, a, b) broadcasts all three arguments together at runtime, so the
# condition's shape is checked against the chosen elements here as well.
fn broadcast_where(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  if len(arg_types) != 3 { return TUnknown }
  match arg_tensor(arg_types, 1) {
    Some(a) => {
      match arg_tensor(arg_types, 2) {
        Some(b) => {
          let res: ShapeResult = elementwise_result(a, b)
          if len(res.msg) > 0 {
            report(c, ex.line, res.msg)
            return TUnknown
          }
          # The condition is broadcast against the chosen elements at runtime, so
          # a shape that cannot broadcast is a shape error to raise here rather
          # than leaving it to the interpreter.
          let out: Type = res.type
          match arg_tensor(arg_types, 0) {
            Some(cond) => {
              match as_tensor(res.type) {
                Some(rt) => {
                  let cres: ShapeResult = elementwise_result(cond, rt)
                  if len(cres.msg) > 0 {
                    report(c, ex.line, cres.msg)
                    return TUnknown
                  }
                  out = cres.type
                },
                None => {},
              }
            },
            None => {},
          }
          # The condition's dtype does not enter the promotion; it is read for
          # its truthiness (tensor.where3). No warning here: `where` is a
          # selector, not the arithmetic the widening warning is about.
          set_dtype(out, promote_dtype(a.dtype, b.dtype))
        },
        None => TUnknown,
      }
    },
    None => TUnknown,
  }
}

# conv_result infers the output shape of conv2d: input [Cin, H, W] and weight
# [Cout, Cin, KH, KW] give [Cout, H-KH+1, W-KW+1], with any unknown dimension
# left unknown. There is no padding and no stride, so the arithmetic is exact.
fn conv_result(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  let dims: Arr[I64] = arr_new()
  push(dims, -1)
  push(dims, -1)
  push(dims, -1)
  if len(arg_types) != 2 { return tensor_of(dims) }
  # The three shape contracts the runtime enforces -- a rank-3 input, a rank-4
  # weight, and matching channel counts -- are the mistakes people make wiring a
  # net together, so a statically knowable violation is reported here with the
  # message the runtime would have raised.
  match arg_tensor(arg_types, 0) {
    Some(in_) => if len(in_.dims) != 3 {
      report(c, ex.line, bytes.concat("conv2d: input must be [channels, height, width], got ", dims_string(in_)))
    },
    None => unit,
  }
  match arg_tensor(arg_types, 1) {
    Some(w) => {
      if len(w.dims) != 4 {
        report(c, ex.line, bytes.concat("conv2d: weight must be [out, in, kh, kw], got ", dims_string(w)))
      }
      if len(w.dims) == 4 {
        dims[0] = w.dims[0]
        match arg_tensor(arg_types, 0) {
          Some(in_) => {
            if len(in_.dims) == 3 {
              if in_.dims[0] >= 0 and w.dims[1] >= 0 and in_.dims[0] != w.dims[1] {
                report(c, ex.line, bytes.concat("conv2d: input has ",
                  bytes.concat(str(in_.dims[0]), bytes.concat(" channels but weight expects ", str(w.dims[1])))))
              }
              # A kernel wider or taller than the input gives an empty output,
              # which the runtime rejects; certain when both spatial pairs known.
              let spatial_known: Bool = in_.dims[1] >= 0 and in_.dims[2] >= 0 and w.dims[2] >= 0 and w.dims[3] >= 0
              let kernel_too_big: Bool = w.dims[2] > in_.dims[1] or w.dims[3] > in_.dims[2]
              if spatial_known and kernel_too_big {
                report(c, ex.line, bytes.concat("conv2d: kernel ",
                  bytes.concat(str(w.dims[2]), bytes.concat("x", bytes.concat(str(w.dims[3]),
                  bytes.concat(" is larger than input ", bytes.concat(str(in_.dims[1]),
                  bytes.concat("x", str(in_.dims[2])))))))))
              }
              if in_.dims[1] >= 0 and w.dims[2] >= 0 {
                dims[1] = in_.dims[1] - w.dims[2] + 1
              }
              if in_.dims[2] >= 0 and w.dims[3] >= 0 {
                dims[2] = in_.dims[2] - w.dims[3] + 1
              }
            }
          },
          None => unit,
        }
      }
    },
    None => unit,
  }
  tensor_of(dims)
}

# infer_einsum validates a literal einsum spec and, when the input shapes are
# known, resolves the output shape. The spec parser is shared with the runtime,
# so an invalid spec is reported here in the runtime's own words rather than in
# a second wording that a reader would have to learn.
fn infer_einsum(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  if len(ex.args) < 2 { return TUnknown }
  let spec: Str = ""
  match ex.args[0] {
    EString(lit) => spec = lit.value,
    _ => return TUnknown,
  }
  match tensor.parse_einsum(spec, len(ex.args) - 1) {
    Ok(parsed) => infer_einsum_dims(c, ex, arg_types, parsed),
    Err(msg) => {
      report(c, ex.line, msg)
      TUnknown
    },
  }
}

fn infer_einsum_dims(c: Checker, ex: ast.Call, arg_types: Arr[Type],
                     parsed: tensor.EinsumSpec) -> Type {
  let dims: Arr[Arr[I64]] = arr_new()
  let i: I64 = 0
  while i < len(parsed.inputs) {
    match arg_tensor(arg_types, i + 1) {
      Some(t) => push(dims, t.dims),
      None => {
        # The spec is valid but an operand's shape is unknown, so the rank of
        # the result is known and nothing else is.
        let od: Arr[I64] = arr_new()
        let j: I64 = 0
        while j < len(parsed.output) {
          push(od, -1)
          j = j + 1
        }
        return tensor_of(od)
      },
    }
    i = i + 1
  }
  match tensor.einsum_output_dims(parsed.inputs, parsed.output, dims) {
    Ok(out) => tensor_of(out),
    Err(msg) => {
      report(c, ex.line, msg)
      TUnknown
    },
  }
}

# infer_concat works out the shape of a concatenation, and reports the pieces
# that cannot be joined.
#
# Worth doing twice over: the mismatch itself reached the runtime, and the
# unknown type it used to return blinded everything downstream of it as well, so
# a whole pipeline built on a concat was unchecked from that point on.
fn infer_concat(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  if len(arg_types) < 1 { return TUnknown }
  # A written-out empty list has nothing to join, which the runtime rejects with
  # "need at least one tensor". Only the literal is certain -- a list whose length
  # is dynamic may be non-empty at runtime -- so this keys on the syntax.
  if len(ex.args) >= 1 {
    match ex.args[0] {
      EList(lst) => {
        if len(lst.elements) == 0 {
          report(c, ex.line, "concat: need at least one tensor")
          return TUnknown
        }
      },
      _ => unit,
    }
  }
  let elems: Arr[Type] = arr_new()
  match arg_types[0] {
    TList(lst) => {
      match lst.elems {
        Some(v) => elems = v,
        None => return TUnknown,
      }
    },
    _ => return TUnknown,
  }
  if len(elems) == 0 { return TUnknown }

  # Every piece has to be a tensor whose shape is known. One that is not makes
  # the result unknowable rather than wrong, so this says nothing.
  let parts: Arr[TensorType] = arr_new()
  let i: I64 = 0
  while i < len(elems) {
    match as_tensor(elems[i]) {
      Some(t) => {
        if len(t.dims) == 0 { return TUnknown }
        let k: I64 = 0
        while k < len(t.dims) {
          if t.dims[k] < 0 { return TUnknown }
          k = k + 1
        }
        push(parts, t)
      },
      None => return TUnknown,
    }
    i = i + 1
  }

  let rank: I64 = len(parts[0].dims)
  i = 1
  while i < len(parts) {
    if len(parts[i].dims) != rank {
      report(c, ex.line, bytes.concat("concat needs pieces of the same rank: ",
        bytes.concat(dims_string(parts[0]), bytes.concat(" has ", bytes.concat(str(rank),
        bytes.concat(", ", bytes.concat(dims_string(parts[i]),
        bytes.concat(" has ", str(len(parts[i].dims))))))))))
      return TUnknown
    }
    i = i + 1
  }

  let axis: I64 = 0
  if len(ex.args) >= 2 {
    match const_int(ex.args[1]) {
      Some(ax) => axis = ax,
      None => return TUnknown,
    }
  }
  if axis < 0 { axis = axis + rank }
  if axis < 0 or axis >= rank {
    report_axis(c, ex, parts[0])
    return TUnknown
  }

  # Every axis but the joined one has to agree. This is the runtime's rule and
  # its wording, so a reader who has seen one message recognises the other.
  let total: I64 = 0
  i = 0
  while i < len(parts) {
    let p: TensorType = parts[i]
    total = total + p.dims[axis]
    let k: I64 = 0
    while k < len(p.dims) {
      if k != axis and p.dims[k] != parts[0].dims[k] {
        report(c, ex.line, bytes.concat("concat: shapes differ on axis ",
          bytes.concat(str(k), bytes.concat(": ", bytes.concat(dims_string(parts[0]),
          bytes.concat(" and ", dims_string(p)))))))
        return TUnknown
      }
      k = k + 1
    }
    i = i + 1
  }

  let dims: Arr[I64] = copy_dims(parts[0].dims)
  dims[axis] = total
  tensor_with_unit(dims, parts[0].unit)
}

# const_split_sizes reads split's second argument as an explicit list of sizes:
# a list literal, an all-numeric bracket literal (which parses as a tensor), or a
# list(...) call of integer literals. A bare integer is the equal-pieces count, a
# different case, so this returns ok=false for it.
fn const_split_sizes(e: ast.Expr) -> Dims {
  match e {
    EList(lst) => return const_int_elems(lst.elements),
    ETensor(tl) => return const_int_elems(tl.elements),
    ECall(call) => {
      match call.callee {
        EIdent(id) => if bytes.equal(id.name, "list") { return const_int_elems(call.args) },
        _ => unit,
      }
    },
    _ => unit,
  }
  no_dims()
}

# const_index_list reads gather's index argument as a constant list of integers:
# a bracket literal, a list(...) call (both handled by const_split_sizes), or the
# tensor([...]) form the standard library tends to write. Anything else is not
# foldable and comes back with ok = false.
fn const_index_list(e: ast.Expr) -> Dims {
  let base: Dims = const_split_sizes(e)
  if base.ok { return base }
  match e {
    ECall(call) => {
      match call.callee {
        EIdent(id) => {
          if bytes.equal(id.name, "tensor") and len(call.args) == 1 {
            return const_index_list(call.args[0])
          }
        },
        _ => unit,
      }
    },
    _ => unit,
  }
  no_dims()
}

# infer_split checks concat's inverse. When the axis length, the piece count or
# the explicit sizes are constant, the same mismatches the runtime raises are
# knowable here: an axis out of range, a count that does not divide the axis
# evenly, or sizes that do not sum to it. Anything dynamic is an unknown list.
fn infer_split(c: Checker, ex: ast.Call, arg_types: Arr[Type]) -> Type {
  let unknown_list: Type = TList(ListType { elems: None })
  match arg_tensor(arg_types, 0) {
    Some(t) => {
      if len(t.dims) == 0 { return unknown_list }
      let axis: I64 = 0
      if len(ex.args) >= 3 {
        match const_int(ex.args[2]) {
          Some(a) => axis = a,
          None => return unknown_list,
        }
      }
      if axis < 0 { axis = axis + len(t.dims) }
      if axis < 0 or axis >= len(t.dims) {
        report_axis(c, ex, t)
        return TUnknown
      }
      let el: I64 = t.dims[axis]
      if len(ex.args) >= 2 {
        let sizes: Dims = const_split_sizes(ex.args[1])
        if sizes.ok {
          if len(sizes.dims) == 0 {
            report(c, ex.line, "split: need at least one piece")
            return TUnknown
          }
          let total: I64 = 0
          let i: I64 = 0
          while i < len(sizes.dims) {
            if sizes.dims[i] < 0 {
              report(c, ex.line, bytes.concat("split: negative size ", str(sizes.dims[i])))
              return TUnknown
            }
            total = total + sizes.dims[i]
            i = i + 1
          }
          if el >= 0 and total != el {
            report(c, ex.line, bytes.concat("split: sizes sum to ", bytes.concat(str(total),
              bytes.concat(" but axis ", bytes.concat(str(axis),
              bytes.concat(" has length ", str(el)))))))
            return TUnknown
          }
        } else {
          match const_int(ex.args[1]) {
            Some(n) => {
              if n <= 0 {
                report(c, ex.line, bytes.concat("split: piece count must be positive, got ", str(n)))
                return TUnknown
              }
              if el >= 0 and el % n != 0 {
                report(c, ex.line, bytes.concat("split: axis ", bytes.concat(str(axis),
                  bytes.concat(" has length ", bytes.concat(str(el),
                  bytes.concat(", which ", bytes.concat(str(n), " does not divide evenly")))))))
                return TUnknown
              }
            },
            None => unit,
          }
        }
      }
      unknown_list
    },
    None => unknown_list,
  }
}

# ---- literal shape extraction ---------------------------------------------

# const_int reads an integer from a literal, and only from a literal. A named
# constant is not folded, because the checker does not evaluate.
fn const_int(e: ast.Expr) -> Opt[I64] {
  match e {
    ENumber(n) => {
      let iv: I64 = i64_of_f64(n.value)
      if f64_of_i64(iv) == n.value { return Some(iv) }
      None
    },
    # A negated literal like `-1` parses as unary minus over a number, not a
    # negative literal, so read through it. This is what lets the reshape check
    # see the -1 in `reshape(x, -1, 4)`, the numpy habit twill does not honour.
    EUnary(u) => {
      if bytes.equal(u.op, "-") {
        match const_int(u.operand) {
          Some(v) => Some(0 - v),
          None => None,
        }
      } else {
        None
      }
    },
    _ => None,
  }
}

# const_shape reads a shape from integer-literal arguments starting at `from`,
# or from a single list literal of integer literals. Both spellings are accepted
# because both are in use: `zeros(2, 3)` and `zeros([2, 3])`.
fn const_shape(args: Arr[ast.Expr], from: I64) -> Dims {
  let rest: Arr[ast.Expr] = arr_new()
  let i: I64 = from
  while i < len(args) {
    push(rest, args[i])
    i = i + 1
  }
  if len(rest) == 1 {
    match rest[0] {
      EList(lst) => return const_int_elems(lst.elements),
      # list(2, 3): the idiomatic shape argument, a call to the list builtin with
      # integer literals. Reading it lets the reshape and broadcast checks fire
      # for the form the library and examples use, not only separate arguments.
      ECall(call) => {
        match call.callee {
          EIdent(id) => if bytes.equal(id.name, "list") { return const_int_elems(call.args) },
          _ => unit,
        }
      },
      _ => unit,
    }
  }
  const_int_elems(rest)
}

# Reads a run of expressions as integer literals, all or nothing.
fn const_int_elems(elems: Arr[ast.Expr]) -> Dims {
  let dims: Arr[I64] = arr_new()
  let i: I64 = 0
  while i < len(elems) {
    match const_int(elems[i]) {
      Some(n) => push(dims, n),
      None => return no_dims(),
    }
    i = i + 1
  }
  Dims { dims: dims, ok: true }
}

fn quoted(s: Str) -> Str = str_quote(s)
